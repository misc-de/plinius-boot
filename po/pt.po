#: plinius-boot:269
msgid "Phone Backups"
msgstr "Cópias de segurança do telemóvel"

#: plinius-boot:293
msgid "Device identity"
msgstr "Identidade do dispositivo"

#: plinius-boot:294
msgid ""
"IMEI, MAC addresses and calibration. Unique to this phone and not available "
"for download anywhere. Keep this backup safe."
msgstr ""
"IMEI, endereços MAC e calibração. Exclusivos deste telemóvel e não "
"disponíveis para transferência em lado nenhum. Guarde bem esta cópia de "
"segurança."

#: plinius-boot:296
msgid "Boot chain and firmware"
msgstr "Cadeia de arranque e firmware"

#: plinius-boot:296
msgid "Bootloader, kernel, modem and other firmware."
msgstr "Bootloader, kernel, modem e outro firmware."

#: plinius-boot:297 plinius-boot:660 plinius-boot:5818 plinius-boot:6385
#: plinius-boot:6704 plinius-boot:6753 plinius-boot:7236 plinius-boot:7269
#: plinius-boot:7273 plinius-boot:7299
msgid "System"
msgstr "Sistema"

#: plinius-boot:297
msgid "The Android system and vendor partitions."
msgstr "As partições do sistema Android e do fabricante (vendor)."

#: plinius-boot:298 plinius-boot:6704 plinius-boot:7236
msgid "User data"
msgstr "Dados do utilizador"

#: plinius-boot:298
msgid "Your files, apps and settings. Very large and often encrypted."
msgstr ""
"Os seus ficheiros, aplicações e definições. Muito grandes e frequentemente "
"encriptados."

#: plinius-boot:299 plinius-boot:6712 plinius-boot:6714 plinius-boot:7102
#: plinius-boot:7274 plinius-boot:7326 plinius-boot:7364 plinius-boot:8538
msgid "Memory card"
msgstr "Cartão de memória"

#: plinius-boot:299
msgid ""
"Systems on the memory card, for example Ubuntu Touch or Arch via multi-boot."
msgstr ""
"Sistemas no cartão de memória, por exemplo Ubuntu Touch ou Arch via "
"multiboot."

#: plinius-boot:300
msgid "Logs"
msgstr "Registos"

#: plinius-boot:300
msgid "Crash logs and temporary data, usually not needed."
msgstr "Registos de falhas e dados temporários, normalmente desnecessários."

#: plinius-boot:316
msgid "Not checked"
msgstr "Não verificado"

#: plinius-boot:317
msgid "Probably empty"
msgstr "Provavelmente vazio"

#: plinius-boot:318
msgid "Android boot image"
msgstr "Imagem de arranque Android"

#: plinius-boot:319
msgid "Android init boot image"
msgstr "Imagem de arranque init Android"

#: plinius-boot:320
msgid "Vendor boot image"
msgstr "Imagem de arranque vendor"

#: plinius-boot:321
msgid "Verified boot metadata"
msgstr "Metadados do Verified Boot"

#: plinius-boot:322
msgid "Android sparse image"
msgstr "Imagem sparse Android"

#: plinius-boot:323
msgid "Dynamic partitions (super)"
msgstr "Partições dinâmicas (super)"

#: plinius-boot:324
msgid "ext4 file system"
msgstr "Sistema de ficheiros ext4"

#: plinius-boot:325
msgid "F2FS file system"
msgstr "Sistema de ficheiros F2FS"

#: plinius-boot:326
msgid "Encrypted (LUKS)"
msgstr "Encriptado (LUKS)"

#: plinius-boot:327
msgid "LVM volume"
msgstr "Volume LVM"

#: plinius-boot:328
msgid "MediaTek image"
msgstr "Imagem MediaTek"

#: plinius-boot:329
msgid "MediaTek preloader"
msgstr "Preloader MediaTek"

#: plinius-boot:330
msgid "Device tree overlays"
msgstr "Overlays de device tree"

#: plinius-boot:331
msgid "Device tree"
msgstr "Device tree"

#: plinius-boot:332
msgid "Partition table (GPT)"
msgstr "Tabela de partições (GPT)"

#: plinius-boot:333
msgid "Program (ELF)"
msgstr "Programa (ELF)"

#: plinius-boot:334
msgid "Unknown data"
msgstr "Dados desconhecidos"

#: plinius-boot:337
msgid "in use (mounted)"
msgstr "em uso (montada)"

#: plinius-boot:338
msgid "in use by the system"
msgstr "em uso pelo sistema"

#: plinius-boot:339
msgid "in use as swap"
msgstr "em uso como swap"

#: plinius-boot:342
msgid "Linux on the phone, USB network"
msgstr "Linux no telemóvel, rede USB"

#: plinius-boot:343
msgid "Rescue system, USB network"
msgstr "Sistema de recuperação, rede USB"

#: plinius-boot:344
msgid "Android, USB debugging"
msgstr "Android, depuração USB"

#: plinius-boot:345
msgid "Bootloader (fastboot)"
msgstr "Bootloader (fastboot)"

#: plinius-boot:346
msgid "MediaTek download mode"
msgstr "Modo de transferência MediaTek"

#: plinius-boot:348
msgid "Not connected"
msgstr "Não ligado"

#: plinius-boot:646 plinius-boot:6697
#, python-brace-format
msgid "build {number}"
msgstr "compilação {number}"

#: plinius-boot:650 plinius-boot:6698
#, python-brace-format
msgid "security patch {date}"
msgstr "patch de segurança {date}"

#: plinius-boot:657
#, python-brace-format
msgid "Partition {name}"
msgstr "Partição {name}"

#: plinius-boot:659
#, python-brace-format
msgid "Slot {slot} (active)"
msgstr "Slot {slot} (ativo)"

#: plinius-boot:659
#, python-brace-format
msgid "Slot {slot}"
msgstr "Slot {slot}"

#: plinius-boot:703
msgid "Not a regular file"
msgstr "Não é um ficheiro normal"

#: plinius-boot:912 plinius-boot:5909 plinius-boot:5919 plinius-boot:5936
#: plinius-boot:5953 plinius-boot:6012 plinius-boot:6177 plinius-boot:7529
msgid "Rescue system"
msgstr "Sistema de recuperação"

#: plinius-boot:929
msgid "Talks to Android on the phone"
msgstr "Comunica com o Android no telemóvel"

#: plinius-boot:930
msgid "Talks to the phone's bootloader"
msgstr "Comunica com o bootloader do telemóvel"

#: plinius-boot:931
msgid "Talks to Linux and the rescue system on the phone"
msgstr "Comunica com o Linux e o sistema de recuperação no telemóvel"

#: plinius-boot:932
msgid "Creates the key for the rescue system"
msgstr "Cria a chave para o sistema de recuperação"

#: plinius-boot:933
msgid "Finds the phone's USB network"
msgstr "Encontra a rede USB do telemóvel"

#: plinius-boot:955
msgid "Not installed."
msgstr "Não instalado."

#: plinius-boot:957
msgid "Cannot be run."
msgstr "Não pode ser executado."

#: plinius-boot:959
msgid "Does not answer."
msgstr "Não responde."

#: plinius-boot:961
#, python-brace-format
msgid "Does not work: {error}"
msgstr "Não funciona: {error}"

#: plinius-boot:1332 plinius-boot:4011 plinius-boot:4028 plinius-boot:4134
#: plinius-boot:4225 plinius-boot:4229 plinius-boot:4324 plinius-boot:4326
#: plinius-boot:4336 plinius-boot:4858
msgid "Reading the partition table"
msgstr "A leitura da tabela de partições"

#: plinius-boot:1376
msgid "Could not read the partition list."
msgstr "Não foi possível ler a lista de partições."

#: plinius-boot:1455 plinius-boot:6295
msgid "The phone was disconnected."
msgstr "A ligação ao telemóvel foi interrompida."

#: plinius-boot:1631 plinius-boot:8536
msgid "Bootloader"
msgstr "Bootloader"

#: plinius-boot:1690 plinius-boot:2694 plinius-boot:9207
msgid "Unknown phone"
msgstr "Telemóvel desconhecido"

#: plinius-boot:1761
msgid ""
"No administrator access. Log in with your password so the app can use sudo."
msgstr ""
"Sem acesso de administrador. Inicie sessão com a sua palavra-passe para que "
"a aplicação possa usar o sudo."

#: plinius-boot:1771
msgid "Unlock the phone and allow USB debugging in the prompt shown there."
msgstr ""
"Desbloqueie o telemóvel e permita a depuração USB no pedido apresentado no "
"ecrã."

#: plinius-boot:1773
msgid "The phone is not ready yet."
msgstr "O telemóvel ainda não está pronto."

#: plinius-boot:1777
msgid ""
"Android does not allow reading the partitions without root. Restart the "
"phone into the bootloader and start the rescue system there, or start a "
"Linux system on the phone."
msgstr ""
"O Android não permite ler as partições sem root. Reinicie o telemóvel no "
"bootloader e inicie aí o sistema de recuperação, ou inicie um sistema Linux "
"no telemóvel."

#: plinius-boot:1786
msgid "In fastboot mode backups can only be restored, not created."
msgstr ""
"No modo fastboot, as cópias de segurança só podem ser restauradas, não "
"criadas."

#: plinius-boot:1789
msgid ""
"The bootloader is locked. Unlock it to start the rescue system or restore "
"backups."
msgstr ""
"O bootloader está bloqueado. Desbloqueie-o para iniciar o sistema de "
"recuperação ou restaurar cópias de segurança."

#: plinius-boot:1791
msgid ""
"The bootloader does not report whether it is unlocked. Restoring is not "
"possible."
msgstr ""
"O bootloader não indica se está desbloqueado. Não é possível restaurar."

#: plinius-boot:1892
msgid ""
"Its system lets in SSH keys only, no password. Start the bootloader on the "
"phone; the app then starts the rescue system there."
msgstr ""
"O seu sistema só aceita chaves SSH, sem palavra-passe. Inicia o bootloader "
"no telefone; a aplicação arranca lá o sistema de recuperação."

#: plinius-boot:1895
msgid "Log in to read the partitions."
msgstr "Inicie sessão para ler as partições."

#: plinius-boot:1919
msgid ""
"The phone is in MediaTek download mode. This app cannot use this mode. "
"Disconnect the cable and hold the power button to restart the phone."
msgstr ""
"O telemóvel está no modo de transferência MediaTek. Esta aplicação não pode "
"usar este modo. Desligue o cabo e mantenha premido o botão de ligar/desligar "
"para reiniciar o telemóvel."

#: plinius-boot:2049 plinius-boot:2053
msgid "The rescue system is not built yet (rescue/mkrescue.sh)."
msgstr ""
"O sistema de recuperação ainda não foi construído (rescue/mkrescue.sh)."

#: plinius-boot:2071
msgid "This is not an Android boot image."
msgstr "Isto não é uma imagem de arranque Android."

#: plinius-boot:2103
msgid "This boot image contains no kernel."
msgstr "Esta imagem de arranque não contém kernel."

#: plinius-boot:2121
#, python-brace-format
msgid "The boot image in the backup cannot be read ({error})."
msgstr ""
"Não é possível ler a imagem de arranque da cópia de segurança ({error})."

#: plinius-boot:2123
msgid "The boot image in the backup is damaged (checksum does not match)."
msgstr ""
"A imagem de arranque da cópia de segurança está danificada (a soma de "
"verificação não coincide)."

#: plinius-boot:2140
#, python-brace-format
msgid "{name} from the backup of {date}"
msgstr "{name} da cópia de segurança de {date}"

#: plinius-boot:2157
#, python-brace-format
msgid "fastboot could not start the rescue system: {error}"
msgstr "fastboot não conseguiu iniciar o sistema de recuperação: {error}"

#: plinius-boot:2165 plinius-boot:8671
msgid "Confirm on the phone: press Volume up to unlock."
msgstr "Confirme no telemóvel: prima Aumentar volume para desbloquear."

#: plinius-boot:2169
#, python-brace-format
msgid "The bootloader was not unlocked: {error}"
msgstr "O bootloader não foi desbloqueado: {error}"

#: plinius-boot:2171
msgid "Waiting for the bootloader…"
msgstr "A aguardar o bootloader…"

#: plinius-boot:2175
msgid ""
"The phone does not report itself as unlocked. If the question on the phone "
"was declined, start again. Otherwise restart the phone into the bootloader "
"and check it here again."
msgstr ""
"O telemóvel não indica que está desbloqueado. Se a pergunta no telemóvel foi "
"recusada, comece de novo. Caso contrário, reinicie o telemóvel no bootloader "
"e verifique-o aqui novamente."

#: plinius-boot:2180 plinius-boot:4527
msgid "Formatting the data partition…"
msgstr "A formatar a partição de dados…"

#: plinius-boot:2183
#, python-brace-format
msgid ""
"The bootloader is unlocked, but the data partition could not be formatted: "
"{error}\n"
"Run “fastboot -w” in the bootloader, otherwise Volla OS keeps restarting."
msgstr ""
"O bootloader está desbloqueado, mas não foi possível formatar a partição de "
"dados: {error}\n"
"Execute «fastboot -w» no bootloader; caso contrário, o Volla OS reinicia-se "
"continuamente."

#: plinius-boot:2241 plinius-boot:2244
msgid "This is not an update package (zip)."
msgstr "Isto não é um pacote de atualização (zip)."

#: plinius-boot:2253 plinius-boot:2266 plinius-boot:2273 plinius-boot:2276
msgid "The update package has no usable payload.bin."
msgstr "O pacote de atualização não tem um payload.bin utilizável."

#: plinius-boot:2288 plinius-boot:2302
#, python-brace-format
msgid "{name} in the update package is too large."
msgstr "{name} no pacote de atualização é demasiado grande."

#: plinius-boot:2305 plinius-boot:2321 plinius-boot:2325
msgid "The update package is damaged (checksum does not match)."
msgstr ""
"O pacote de atualização está danificado (a soma de verificação não "
"corresponde)."

#: plinius-boot:2314
#, python-brace-format
msgid ""
"This is an incremental update package; only full packages contain {name}."
msgstr ""
"É um pacote de atualização incremental; só os pacotes completos contêm "
"{name}."

#: plinius-boot:2327
#, python-brace-format
msgid "The update package contains no {name}."
msgstr "O pacote de atualização não contém {name}."

#: plinius-boot:2421 plinius-boot:2493
msgid "Asking the update server…"
msgstr "A consultar o servidor de atualizações…"

#: plinius-boot:2425 plinius-boot:2496
#, python-brace-format
msgid "Downloading {name} from {package}…"
msgstr "A transferir {name} de {package}…"

#: plinius-boot:2444
#, python-brace-format
msgid ""
"{file} is not the original {name} of this phone: its checksum does not match "
"the one the phone expects."
msgstr ""
"{file} não é o {name} original deste telemóvel: a soma de verificação não "
"corresponde à que o telemóvel espera."

#: plinius-boot:2469
msgid "This is not an init_boot image."
msgstr "Isto não é uma imagem init_boot."

#: plinius-boot:2483
msgid "The bootloader is locked."
msgstr "O bootloader está bloqueado."

#: plinius-boot:2487
#, python-brace-format
msgid "This phone has no partition {name}."
msgstr "Este telemóvel não tem a partição {name}."

#: plinius-boot:2500
#, python-brace-format
msgid ""
"No {name} of this phone is known and the update server cannot be reached. "
"Without one the app could not write the original back later."
msgstr ""
"Não se conhece nenhum {name} deste telemóvel e o servidor de atualizações "
"não está acessível. Sem ele, a aplicação não poderia repor o original depois."

#: plinius-boot:2504
#, python-brace-format
msgid "The rescue system does not fit into {name}."
msgstr "O sistema de recuperação não cabe em {name}."

#: plinius-boot:2511
#, python-brace-format
msgid "Writing the rescue system to {name}…"
msgstr "A escrever o sistema de recuperação em {name}…"

#: plinius-boot:2515 plinius-boot:2561
#, python-brace-format
msgid "fastboot could not write {name}: {error}"
msgstr "O fastboot não conseguiu escrever {name}: {error}"

#: plinius-boot:2525
msgid "The app does not know which partition holds the rescue system."
msgstr "A aplicação não sabe que partição contém o sistema de recuperação."

#: plinius-boot:2528
msgid "The original does not match the checksum the phone expects."
msgstr ""
"O original não corresponde à soma de verificação que o telemóvel espera."

#: plinius-boot:2531
msgid ""
"The image to write back is this app's rescue system, not the original. "
"Nothing was written."
msgstr ""
"A imagem a escrever é o sistema de recuperação desta app, não o original. "
"Nada foi escrito."

#: plinius-boot:2536 plinius-boot:5445
msgid "Restarting into the bootloader…"
msgstr "A reiniciar no bootloader…"

#: plinius-boot:2541
msgid ""
"The phone did not appear in the bootloader. Start it there by hand (Power "
"and Volume down) and write the original back from the phone's page."
msgstr ""
"O telemóvel não apareceu no bootloader. Inicie-o lá à mão (ligar e diminuir "
"volume) e reponha o original na página do telemóvel."

#: plinius-boot:2549
#, python-brace-format
msgid ""
"The phone in the bootloader is not in the expected state (slot {slot}, "
"partition {name}). Nothing was written."
msgstr ""
"O telemóvel no bootloader não está no estado esperado (slot {slot}, partição "
"{name}). Nada foi escrito."

#: plinius-boot:2556
#, python-brace-format
msgid "Writing the original {name}…"
msgstr "A escrever o {name} original…"

#: plinius-boot:2565 plinius-boot:5445
msgid "Starting the phone…"
msgstr "A iniciar o telemóvel…"

#: plinius-boot:2776
msgid "Backup only. Restoring this area is not supported."
msgstr "Só cópia de segurança. O restauro desta área não é suportado."

#: plinius-boot:2778
msgid ""
"Holds the rescue system, not the original. Restoring it would keep the phone "
"from starting."
msgstr ""
"Contém o sistema de recuperação, não o original. Repô-lo impediria o "
"telemóvel de arrancar."

#: plinius-boot:2780
msgid "Not present on this phone."
msgstr "Não existe neste telemóvel."

#: plinius-boot:2782
msgid "The partition has a different size on this phone."
msgstr "A partição tem um tamanho diferente neste telemóvel."

#: plinius-boot:2784
msgid "In use by the running system. Restore it in fastboot mode."
msgstr "Em uso pelo sistema em execução. Restaure-a no modo fastboot."

#: plinius-boot:2787
msgid ""
"Belongs to another phone. Restoring it would copy that phone's IMEI and MAC "
"addresses."
msgstr ""
"Pertence a outro telemóvel. Restaurá-la copiaria o IMEI e os endereços MAC "
"desse telemóvel."

#: plinius-boot:2804
#, python-brace-format
msgid ""
"A different phone is connected now (serial number {serial}). Nothing was "
"changed."
msgstr ""
"Está agora ligado um telemóvel diferente (número de série {serial}). Nada "
"foi alterado."

#: plinius-boot:2954
#, python-brace-format
msgid "Saving {name} ({i} of {n})"
msgstr "A guardar {name} ({i} de {n})"

#: plinius-boot:2958 plinius-boot:2978 plinius-boot:2981 plinius-boot:2985
#, python-brace-format
msgid "Reading {name} failed: {error}"
msgstr "Falha ao ler {name}: {error}"

#: plinius-boot:2959
msgid "the partition name is invalid or appears twice"
msgstr "o nome da partição é inválido ou aparece duas vezes"

#: plinius-boot:2979
msgid "the phone sent more data than the partition holds"
msgstr "o telemóvel enviou mais dados do que a partição contém"

#: plinius-boot:2982 plinius-boot:3649 plinius-boot:3669 plinius-boot:4258
msgid "the data is incomplete"
msgstr "os dados estão incompletos"

#: plinius-boot:2986
msgid "the checksum on the phone does not match"
msgstr "a soma de verificação no telemóvel não coincide"

#: plinius-boot:2996
#, python-brace-format
msgid "{name}: {size}, saved as {file}"
msgstr "{name}: {size}, guardada como {file}"

#: plinius-boot:3006 plinius-boot:3052
#, python-brace-format
msgid "Checking {name} ({i} of {n})"
msgstr "A verificar {name} ({i} de {n})"

#: plinius-boot:3021
#, python-brace-format
msgid "{name}: checksum does not match"
msgstr "{name}: a soma de verificação não coincide"

#: plinius-boot:3024
#, python-brace-format
msgid "{name}: OK"
msgstr "{name}: OK"

#: plinius-boot:3035 plinius-boot:6198 plinius-boot:6473 plinius-boot:6474
msgid "Reading the partition list…"
msgstr "A ler a lista de partições…"

#: plinius-boot:3039 plinius-boot:6458
#, python-brace-format
msgid ""
"This backup belongs to a {backup}, but the connected phone is a {device}."
msgstr ""
"Esta cópia de segurança pertence a um {backup}, mas o telemóvel ligado é um "
"{device}."

#: plinius-boot:3044
#, python-brace-format
msgid "{name}: {problem} Nothing was written."
msgstr "{name}: {problem} Nada foi escrito."

#: plinius-boot:3062
#, python-brace-format
msgid ""
"The backup of {name} is damaged (the file is too large). Nothing was written "
"to this partition."
msgstr ""
"A cópia de segurança de {name} está danificada (o ficheiro é demasiado "
"grande). Nada foi escrito nesta partição."

#: plinius-boot:3065
#, python-brace-format
msgid "Not enough free space in {dir} for a temporary copy of {name}."
msgstr ""
"Espaço livre insuficiente em {dir} para uma cópia temporária de {name}."

#: plinius-boot:3082
#, python-brace-format
msgid ""
"The backup of {name} cannot be read ({error}). Nothing was written to this "
"partition."
msgstr ""
"Não é possível ler a cópia de segurança de {name} ({error}). Nada foi "
"escrito nesta partição."

#: plinius-boot:3087
#, python-brace-format
msgid ""
"The backup of {name} is damaged (checksum does not match). Nothing was "
"written to this partition."
msgstr ""
"A cópia de segurança de {name} está danificada (a soma de verificação não "
"coincide). Nada foi escrito nesta partição."

#: plinius-boot:3090
#, python-brace-format
msgid "Writing {name} ({i} of {n})"
msgstr "A escrever {name} ({i} de {n})"

#: plinius-boot:3099
#, python-brace-format
msgid "fastboot could not write {name}."
msgstr "fastboot não conseguiu escrever {name}."

#: plinius-boot:3113 plinius-boot:4257
#, python-brace-format
msgid "Writing {name} failed: {error}"
msgstr "Falha ao escrever {name}: {error}"

#: plinius-boot:3115 plinius-boot:4259
#, python-brace-format
msgid "Verifying {name} on the phone"
msgstr "A comparar {name} no telemóvel"

#: plinius-boot:3118
#, python-brace-format
msgid ""
"{name} was written, but the content on the phone does not match the backup."
msgstr ""
"{name} foi escrita, mas o conteúdo no telemóvel não coincide com a cópia de "
"segurança."

#: plinius-boot:3120
#, python-brace-format
msgid "{name}: written and verified"
msgstr "{name}: escrita e verificada"

#: plinius-boot:3359 plinius-boot:3367
#, python-brace-format
msgid ""
"This image needs {need}, but partition {number} holds {size}. Nothing was "
"changed."
msgstr ""
"Esta imagem precisa de {need}, mas a partição {number} tem {size}. Nada foi "
"alterado."

#: plinius-boot:3370
#, python-brace-format
msgid ""
"This image has blocks of {size} bytes, and the phone's own storage needs "
"{need}. It would not start there. Nothing was changed."
msgstr ""
"Esta imagem tem blocos de {size} bytes e o armazenamento do telemóvel "
"precisa de {need}. Não arrancaria aí. Nada foi alterado."

#: plinius-boot:3386
#, python-brace-format
msgid "This image lacks {name}, so it cannot start on this phone."
msgstr ""
"Falta {name} a esta imagem, por isso não pode arrancar neste telemóvel."

#: plinius-boot:3390
msgid "This image has no os-release, so it is not a Linux system."
msgstr "Esta imagem não tem os-release, por isso não é um sistema Linux."

#: plinius-boot:3399
msgid "This image is incomplete."
msgstr "Esta imagem está incompleta."

#: plinius-boot:3401
#, python-brace-format
