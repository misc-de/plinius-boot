msgstr "Выбрать файл…"

#: plinius-boot:8868
#, python-brace-format
msgid "{done} of {total}"
msgstr "{done} из {total}"

#: plinius-boot:8880 plinius-boot:9358
msgid "Install Plinius"
msgstr "Установить Plinius"

#: plinius-boot:8883
msgid "Back to Volla OS or Ubuntu Touch…"
msgstr "Вернуться к Volla OS или Ubuntu Touch…"

#: plinius-boot:8884
