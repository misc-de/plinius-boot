#: plinius-boot:269
msgid "Phone Backups"
msgstr "Резервные копии телефона"

#: plinius-boot:293
msgid "Device identity"
msgstr "Идентификаторы устройства"

#: plinius-boot:294
msgid ""
"IMEI, MAC addresses and calibration. Unique to this phone and not available "
"for download anywhere. Keep this backup safe."
msgstr ""
"IMEI, MAC-адреса и калибровка. Уникальны для этого телефона, их нигде нельзя "
"скачать. Храните эту резервную копию в надёжном месте."

#: plinius-boot:296
msgid "Boot chain and firmware"
msgstr "Цепочка загрузки и прошивки"

#: plinius-boot:296
msgid "Bootloader, kernel, modem and other firmware."
msgstr "Загрузчик, ядро, модем и другие прошивки."

#: plinius-boot:297 plinius-boot:660 plinius-boot:6018 plinius-boot:6585
#: plinius-boot:6904 plinius-boot:6953 plinius-boot:7446 plinius-boot:7479
#: plinius-boot:7483 plinius-boot:7509 plinius-boot:8479
msgid "System"
msgstr "Система"

#: plinius-boot:297
msgid "The Android system and vendor partitions."
msgstr "Разделы системы Android и производителя (vendor)."

#: plinius-boot:298 plinius-boot:6904 plinius-boot:7446
msgid "User data"
msgstr "Данные пользователя"

#: plinius-boot:298
msgid "Your files, apps and settings. Very large and often encrypted."
msgstr ""
"Ваши файлы, приложения и настройки. Очень большой объём, часто зашифрованы."

#: plinius-boot:299 plinius-boot:6912 plinius-boot:6914 plinius-boot:7312
#: plinius-boot:7484 plinius-boot:7536 plinius-boot:7574 plinius-boot:9013
msgid "Memory card"
msgstr "Карта памяти"

#: plinius-boot:299
msgid ""
"Systems on the memory card, for example Ubuntu Touch or Arch via multi-boot."
msgstr ""
"Системы на карте памяти, например Ubuntu Touch или Arch через мультизагрузку."

#: plinius-boot:300
msgid "Logs"
msgstr "Журналы"

#: plinius-boot:300
msgid "Crash logs and temporary data, usually not needed."
msgstr "Журналы сбоев и временные данные, обычно не нужны."

#: plinius-boot:316
msgid "Not checked"
msgstr "Не проверено"

#: plinius-boot:317
msgid "Probably empty"
msgstr "Вероятно, пусто"

#: plinius-boot:318
msgid "Android boot image"
msgstr "Загрузочный образ Android"

#: plinius-boot:319
msgid "Android init boot image"
msgstr "Загрузочный образ init Android"

#: plinius-boot:320
msgid "Vendor boot image"
msgstr "Загрузочный образ vendor"

#: plinius-boot:321
msgid "Verified boot metadata"
msgstr "Метаданные Verified Boot"

#: plinius-boot:322
msgid "Android sparse image"
msgstr "Разреженный образ Android (sparse)"

#: plinius-boot:323
msgid "Dynamic partitions (super)"
msgstr "Динамические разделы (super)"

#: plinius-boot:324
msgid "ext4 file system"
msgstr "Файловая система ext4"

#: plinius-boot:325
msgid "F2FS file system"
msgstr "Файловая система F2FS"

#: plinius-boot:326
msgid "Encrypted (LUKS)"
msgstr "Зашифровано (LUKS)"

#: plinius-boot:327
msgid "LVM volume"
msgstr "Том LVM"

#: plinius-boot:328
msgid "MediaTek image"
msgstr "Образ MediaTek"

#: plinius-boot:329
msgid "MediaTek preloader"
msgstr "Предзагрузчик MediaTek (preloader)"

#: plinius-boot:330
msgid "Device tree overlays"
msgstr "Оверлеи дерева устройств"

#: plinius-boot:331
msgid "Device tree"
msgstr "Дерево устройств"

#: plinius-boot:332
msgid "Partition table (GPT)"
msgstr "Таблица разделов (GPT)"

#: plinius-boot:333
msgid "Program (ELF)"
msgstr "Программа (ELF)"

#: plinius-boot:334
msgid "Unknown data"
msgstr "Неизвестные данные"

#: plinius-boot:337
msgid "in use (mounted)"
msgstr "используется (смонтирован)"

#: plinius-boot:338
msgid "in use by the system"
msgstr "используется системой"

#: plinius-boot:339
msgid "in use as swap"
msgstr "используется как подкачка"

#: plinius-boot:342
msgid "Linux on the phone, USB network"
msgstr "Linux на телефоне, сеть USB"

#: plinius-boot:343
msgid "Rescue system, USB network"
msgstr "Аварийная система, сеть USB"

#: plinius-boot:344
msgid "Android, USB debugging"
msgstr "Android, отладка по USB"

#: plinius-boot:345
msgid "Bootloader (fastboot)"
msgstr "Загрузчик (fastboot)"

#: plinius-boot:346
msgid "MediaTek download mode"
msgstr "Режим загрузки MediaTek"

#: plinius-boot:348
msgid "Not connected"
msgstr "Не подключён"

#: plinius-boot:646 plinius-boot:6897
#, python-brace-format
msgid "build {number}"
msgstr "сборка {number}"

#: plinius-boot:650 plinius-boot:6898
#, python-brace-format
msgid "security patch {date}"
msgstr "патч безопасности {date}"

#: plinius-boot:657
#, python-brace-format
msgid "Partition {name}"
msgstr "Раздел {name}"

#: plinius-boot:659
#, python-brace-format
msgid "Slot {slot} (active)"
msgstr "Слот {slot} (активный)"

#: plinius-boot:659
#, python-brace-format
msgid "Slot {slot}"
msgstr "Слот {slot}"

#: plinius-boot:703
msgid "Not a regular file"
msgstr "Не обычный файл"

#: plinius-boot:912 plinius-boot:6109 plinius-boot:6119 plinius-boot:6136
#: plinius-boot:6153 plinius-boot:6212 plinius-boot:6377 plinius-boot:7739
msgid "Rescue system"
msgstr "Аварийная система"

#: plinius-boot:929
msgid "Talks to Android on the phone"
msgstr "Связывается с Android на телефоне"

#: plinius-boot:930
msgid "Talks to the phone's bootloader"
msgstr "Связывается с загрузчиком телефона"

#: plinius-boot:931
msgid "Talks to Linux and the rescue system on the phone"
msgstr "Связывается с Linux и аварийной системой на телефоне"

#: plinius-boot:932
msgid "Creates the key for the rescue system"
msgstr "Создаёт ключ для аварийной системы"

#: plinius-boot:933
msgid "Finds the phone's USB network"
msgstr "Находит сеть USB телефона"

#: plinius-boot:955
msgid "Not installed."
msgstr "Не установлено."

#: plinius-boot:957
msgid "Cannot be run."
msgstr "Не удаётся запустить."

#: plinius-boot:959
msgid "Does not answer."
msgstr "Не отвечает."

#: plinius-boot:961
#, python-brace-format
msgid "Does not work: {error}"
msgstr "Не работает: {error}"

#: plinius-boot:1332 plinius-boot:4014 plinius-boot:4031 plinius-boot:4137
#: plinius-boot:4228 plinius-boot:4232 plinius-boot:4327 plinius-boot:4329
#: plinius-boot:4339 plinius-boot:4993
msgid "Reading the partition table"
msgstr "Чтение таблицы разделов"

#: plinius-boot:1376
msgid "Could not read the partition list."
msgstr "Не удалось прочитать список разделов."

#: plinius-boot:1455 plinius-boot:6495
msgid "The phone was disconnected."
msgstr "Телефон отключён."

#: plinius-boot:1631 plinius-boot:9011
msgid "Bootloader"
msgstr "Загрузчик"

#: plinius-boot:1690 plinius-boot:2694 plinius-boot:9683
msgid "Unknown phone"
msgstr "Неизвестный телефон"

#: plinius-boot:1761
msgid ""
"No administrator access. Log in with your password so the app can use sudo."
msgstr ""
"Нет прав администратора. Войдите со своим паролем, чтобы приложение могло "
"использовать sudo."

#: plinius-boot:1771
msgid "Unlock the phone and allow USB debugging in the prompt shown there."
msgstr ""
"Разблокируйте телефон и разрешите отладку по USB в появившемся на нём "
"запросе."

#: plinius-boot:1773
msgid "The phone is not ready yet."
msgstr "Телефон ещё не готов."

#: plinius-boot:1777
msgid ""
"Android does not allow reading the partitions without root. Restart the "
"phone into the bootloader and start the rescue system there, or start a "
"Linux system on the phone."
msgstr ""
"Android не позволяет читать разделы без root. Перезагрузите телефон в "
"загрузчик и запустите там аварийную систему или запустите на телефоне "
"систему Linux."

#: plinius-boot:1786
msgid "In fastboot mode backups can only be restored, not created."
msgstr ""
"В режиме fastboot резервные копии можно только восстанавливать, но не "
"создавать."

#: plinius-boot:1789
msgid ""
"The bootloader is locked. Unlock it to start the rescue system or restore "
"backups."
msgstr ""
"Загрузчик заблокирован. Разблокируйте его, чтобы запустить аварийную систему "
"или восстановить резервные копии."

#: plinius-boot:1791
msgid ""
"The bootloader does not report whether it is unlocked. Restoring is not "
"possible."
msgstr "Загрузчик не сообщает, разблокирован ли он. Восстановление невозможно."

#: plinius-boot:1892
msgid ""
"Its system lets in SSH keys only, no password. Start the bootloader on the "
"phone; the app then starts the rescue system there."
msgstr ""
"Его система пускает только по SSH-ключам, без пароля. Запусти загрузчик на "
"телефоне; приложение запустит там систему восстановления."

#: plinius-boot:1895
msgid "Log in to read the partitions."
msgstr "Войдите, чтобы прочитать разделы."

#: plinius-boot:1919
msgid ""
"The phone is in MediaTek download mode. This app cannot use this mode. "
"Disconnect the cable and hold the power button to restart the phone."
msgstr ""
"Телефон находится в режиме загрузки MediaTek. Это приложение не может "
"работать в этом режиме. Отсоедините кабель и удерживайте кнопку питания, "
"чтобы перезапустить телефон."

#: plinius-boot:2049 plinius-boot:2053
msgid "The rescue system is not built yet (rescue/mkrescue.sh)."
msgstr "Аварийная система ещё не собрана (rescue/mkrescue.sh)."

#: plinius-boot:2071
msgid "This is not an Android boot image."
msgstr "Это не загрузочный образ Android."

#: plinius-boot:2103
msgid "This boot image contains no kernel."
msgstr "Этот загрузочный образ не содержит ядра."

#: plinius-boot:2121
#, python-brace-format
msgid "The boot image in the backup cannot be read ({error})."
msgstr "Не удаётся прочитать загрузочный образ из резервной копии ({error})."

#: plinius-boot:2123
msgid "The boot image in the backup is damaged (checksum does not match)."
msgstr ""
"Загрузочный образ в резервной копии повреждён (контрольная сумма не "
"совпадает)."

#: plinius-boot:2140
#, python-brace-format
msgid "{name} from the backup of {date}"
msgstr "{name} из резервной копии от {date}"

#: plinius-boot:2157
#, python-brace-format
msgid "fastboot could not start the rescue system: {error}"
msgstr "fastboot не смог запустить аварийную систему: {error}"

#: plinius-boot:2165 plinius-boot:9149
msgid "Confirm on the phone: press Volume up to unlock."
msgstr ""
"Подтвердите на телефоне: нажмите кнопку увеличения громкости, чтобы "
"разблокировать."

#: plinius-boot:2169
#, python-brace-format
msgid "The bootloader was not unlocked: {error}"
msgstr "Загрузчик не разблокирован: {error}"

#: plinius-boot:2171
msgid "Waiting for the bootloader…"
msgstr "Ожидание загрузчика…"

#: plinius-boot:2175
msgid ""
"The phone does not report itself as unlocked. If the question on the phone "
"was declined, start again. Otherwise restart the phone into the bootloader "
"and check it here again."
msgstr ""
"Телефон не сообщает, что он разблокирован. Если запрос на телефоне был "
"отклонён, начните заново. Иначе перезагрузите телефон в загрузчик и "
"проверьте его здесь ещё раз."

#: plinius-boot:2180 plinius-boot:4470 plinius-boot:4662
msgid "Formatting the data partition…"
msgstr "Форматирование раздела данных…"

#: plinius-boot:2183
#, python-brace-format
msgid ""
"The bootloader is unlocked, but the data partition could not be formatted: "
"{error}\n"
"Run “fastboot -w” in the bootloader, otherwise Volla OS keeps restarting."
msgstr ""
"Загрузчик разблокирован, но раздел данных не удалось отформатировать: "
"{error}\n"
"Выполните «fastboot -w» в загрузчике, иначе Volla OS будет постоянно "
"перезагружаться."

#: plinius-boot:2241 plinius-boot:2244
msgid "This is not an update package (zip)."
msgstr "Это не пакет обновления (zip)."

#: plinius-boot:2253 plinius-boot:2266 plinius-boot:2273 plinius-boot:2276
msgid "The update package has no usable payload.bin."
msgstr "В пакете обновления нет пригодного payload.bin."

#: plinius-boot:2288 plinius-boot:2302
#, python-brace-format
msgid "{name} in the update package is too large."
msgstr "{name} в пакете обновления слишком велик."

#: plinius-boot:2305 plinius-boot:2321 plinius-boot:2325
msgid "The update package is damaged (checksum does not match)."
msgstr "Пакет обновления повреждён (контрольная сумма не совпадает)."

#: plinius-boot:2314
#, python-brace-format
msgid ""
"This is an incremental update package; only full packages contain {name}."
msgstr ""
"Это инкрементный пакет обновления; {name} есть только в полных пакетах."

#: plinius-boot:2327
#, python-brace-format
msgid "The update package contains no {name}."
msgstr "В пакете обновления нет {name}."

#: plinius-boot:2421 plinius-boot:2493
msgid "Asking the update server…"
msgstr "Запрос к серверу обновлений…"

#: plinius-boot:2425 plinius-boot:2496
#, python-brace-format
msgid "Downloading {name} from {package}…"
msgstr "Загрузка {name} из {package}…"

#: plinius-boot:2444
#, python-brace-format
msgid ""
"{file} is not the original {name} of this phone: its checksum does not match "
"the one the phone expects."
msgstr ""
"{file} — не исходный {name} этого телефона: контрольная сумма не совпадает с "
"ожидаемой телефоном."

#: plinius-boot:2469
msgid "This is not an init_boot image."
msgstr "Это не образ init_boot."

#: plinius-boot:2483
msgid "The bootloader is locked."
msgstr "Загрузчик заблокирован."

#: plinius-boot:2487
#, python-brace-format
msgid "This phone has no partition {name}."
msgstr "На этом телефоне нет раздела {name}."

#: plinius-boot:2500
#, python-brace-format
msgid ""
"No {name} of this phone is known and the update server cannot be reached. "
"Without one the app could not write the original back later."
msgstr ""
"Ни один {name} этого телефона не известен, а сервер обновлений недоступен. "
"Без него приложение не сможет потом вернуть оригинал."

#: plinius-boot:2504
#, python-brace-format
msgid "The rescue system does not fit into {name}."
msgstr "Аварийная система не помещается в {name}."

#: plinius-boot:2511
#, python-brace-format
msgid "Writing the rescue system to {name}…"
msgstr "Запись аварийной системы в {name}…"

#: plinius-boot:2515 plinius-boot:2561
#, python-brace-format
msgid "fastboot could not write {name}: {error}"
msgstr "fastboot не смог записать {name}: {error}"

#: plinius-boot:2525
msgid "The app does not know which partition holds the rescue system."
msgstr "Приложение не знает, в каком разделе находится аварийная система."

#: plinius-boot:2528
msgid "The original does not match the checksum the phone expects."
msgstr "Оригинал не совпадает с контрольной суммой, которую ожидает телефон."

#: plinius-boot:2531
msgid ""
"The image to write back is this app's rescue system, not the original. "
"Nothing was written."
msgstr ""
"Записываемый образ — это аварийная система этого приложения, а не оригинал. "
"Ничего не записано."

#: plinius-boot:2536 plinius-boot:4468 plinius-boot:5645
msgid "Restarting into the bootloader…"
msgstr "Перезагрузка в загрузчик…"

#: plinius-boot:2541
msgid ""
"The phone did not appear in the bootloader. Start it there by hand (Power "
"and Volume down) and write the original back from the phone's page."
msgstr ""
"Телефон не появился в загрузчике. Запустите его туда вручную (питание и "
"уменьшение громкости) и верните оригинал со страницы телефона."

#: plinius-boot:2549
#, python-brace-format
msgid ""
"The phone in the bootloader is not in the expected state (slot {slot}, "
"partition {name}). Nothing was written."
msgstr ""
"Телефон в загрузчике не в ожидаемом состоянии (слот {slot}, раздел {name}). "
"Ничего не записано."

#: plinius-boot:2556 plinius-boot:4468
#, python-brace-format
msgid "Writing the original {name}…"
msgstr "Запись исходного {name}…"

#: plinius-boot:2565 plinius-boot:4471 plinius-boot:5645
msgid "Starting the phone…"
msgstr "Запуск телефона…"

#: plinius-boot:2776
msgid "Backup only. Restoring this area is not supported."
msgstr ""
"Только резервное копирование. Восстановление этой области не поддерживается."

#: plinius-boot:2778
msgid ""
"Holds the rescue system, not the original. Restoring it would keep the phone "
"from starting."
msgstr ""
"Содержит аварийную систему, а не оригинал. Его восстановление не даст "
"телефону запуститься."

#: plinius-boot:2780
msgid "Not present on this phone."
msgstr "Отсутствует на этом телефоне."

#: plinius-boot:2782
msgid "The partition has a different size on this phone."
msgstr "На этом телефоне раздел имеет другой размер."

#: plinius-boot:2784
msgid "In use by the running system. Restore it in fastboot mode."
msgstr "Используется работающей системой. Восстановите его в режиме fastboot."

#: plinius-boot:2787
msgid ""
"Belongs to another phone. Restoring it would copy that phone's IMEI and MAC "
"addresses."
msgstr ""
"Принадлежит другому телефону. Восстановление скопировало бы IMEI и MAC-"
"адреса того телефона."

#: plinius-boot:2804
#, python-brace-format
msgid ""
"A different phone is connected now (serial number {serial}). Nothing was "
"changed."
msgstr ""
"Сейчас подключён другой телефон (серийный номер {serial}). Ничего не "
"изменено."

#: plinius-boot:2954
#, python-brace-format
msgid "Saving {name} ({i} of {n})"
msgstr "Сохранение {name} ({i} из {n})"

#: plinius-boot:2958 plinius-boot:2978 plinius-boot:2981 plinius-boot:2985
#, python-brace-format
msgid "Reading {name} failed: {error}"
msgstr "Не удалось прочитать {name}: {error}"

#: plinius-boot:2959
msgid "the partition name is invalid or appears twice"
msgstr "имя раздела недопустимо или встречается дважды"

#: plinius-boot:2979
msgid "the phone sent more data than the partition holds"
msgstr "телефон прислал больше данных, чем вмещает раздел"

#: plinius-boot:2982 plinius-boot:3652 plinius-boot:3672 plinius-boot:4261
msgid "the data is incomplete"
msgstr "данные неполные"

#: plinius-boot:2986
msgid "the checksum on the phone does not match"
msgstr "контрольная сумма на телефоне не совпадает"

#: plinius-boot:2996
#, python-brace-format
msgid "{name}: {size}, saved as {file}"
msgstr "{name}: {size}, сохранено как {file}"

#: plinius-boot:3006 plinius-boot:3052 plinius-boot:4466
#, python-brace-format
msgid "Checking {name} ({i} of {n})"
msgstr "Проверка {name} ({i} из {n})"

#: plinius-boot:3021
#, python-brace-format
msgid "{name}: checksum does not match"
msgstr "{name}: контрольная сумма не совпадает"

#: plinius-boot:3024
#, python-brace-format
msgid "{name}: OK"
msgstr "{name}: OK"

#: plinius-boot:3035 plinius-boot:6398 plinius-boot:6673 plinius-boot:6674
msgid "Reading the partition list…"
msgstr "Чтение списка разделов…"

#: plinius-boot:3039 plinius-boot:6658
#, python-brace-format
msgid ""
"This backup belongs to a {backup}, but the connected phone is a {device}."
msgstr ""
"Эта резервная копия относится к устройству {backup}, а подключённый телефон "
"— {device}."

#: plinius-boot:3044
#, python-brace-format
msgid "{name}: {problem} Nothing was written."
msgstr "{name}: {problem} Ничего не записано."

#: plinius-boot:3062
#, python-brace-format
msgid ""
"The backup of {name} is damaged (the file is too large). Nothing was written "
"to this partition."
msgstr ""
"Резервная копия {name} повреждена (файл слишком большой). В этот раздел "
"ничего не записано."

#: plinius-boot:3065
#, python-brace-format
msgid "Not enough free space in {dir} for a temporary copy of {name}."
msgstr "Недостаточно свободного места в {dir} для временной копии {name}."

#: plinius-boot:3082
#, python-brace-format
msgid ""
"The backup of {name} cannot be read ({error}). Nothing was written to this "
"partition."
msgstr ""
