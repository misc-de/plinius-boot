#: plinius-boot:269
msgid "Phone Backups"
msgstr "Kopie zapasowe telefonu"

#: plinius-boot:293
msgid "Device identity"
msgstr "Tożsamość urządzenia"

#: plinius-boot:294
msgid ""
"IMEI, MAC addresses and calibration. Unique to this phone and not available "
"for download anywhere. Keep this backup safe."
msgstr ""
"IMEI, adresy MAC i kalibracja. Unikalne dla tego telefonu i nigdzie "
"niedostępne do pobrania. Przechowuj tę kopię zapasową w bezpiecznym miejscu."

#: plinius-boot:296
msgid "Boot chain and firmware"
msgstr "Łańcuch rozruchu i oprogramowanie sprzętowe"

#: plinius-boot:296
msgid "Bootloader, kernel, modem and other firmware."
msgstr "Bootloader, jądro, modem i inne oprogramowanie sprzętowe."

#: plinius-boot:297 plinius-boot:660 plinius-boot:5541 plinius-boot:6108
#: plinius-boot:6427 plinius-boot:6476 plinius-boot:6933 plinius-boot:6966
#: plinius-boot:6970 plinius-boot:6996
msgid "System"
msgstr "System"

#: plinius-boot:297
msgid "The Android system and vendor partitions."
msgstr "Partycje systemu Android i producenta (vendor)."

#: plinius-boot:298 plinius-boot:6427 plinius-boot:6933
msgid "User data"
msgstr "Dane użytkownika"

#: plinius-boot:298
msgid "Your files, apps and settings. Very large and often encrypted."
msgstr ""
"Twoje pliki, aplikacje i ustawienia. Bardzo duże i często zaszyfrowane."

#: plinius-boot:299 plinius-boot:6435 plinius-boot:6437 plinius-boot:6799
#: plinius-boot:6971 plinius-boot:7023 plinius-boot:7061 plinius-boot:8235
msgid "Memory card"
msgstr "Karta pamięci"

#: plinius-boot:299
msgid ""
"Systems on the memory card, for example Ubuntu Touch or Arch via multi-boot."
msgstr ""
"Systemy na karcie pamięci, na przykład Ubuntu Touch lub Arch w trybie multi-"
"boot."

#: plinius-boot:300
msgid "Logs"
msgstr "Dzienniki"

#: plinius-boot:300
msgid "Crash logs and temporary data, usually not needed."
msgstr "Dzienniki awarii i dane tymczasowe, zwykle niepotrzebne."

#: plinius-boot:316
msgid "Not checked"
msgstr "Niesprawdzone"

#: plinius-boot:317
msgid "Probably empty"
msgstr "Prawdopodobnie puste"

#: plinius-boot:318
msgid "Android boot image"
msgstr "Obraz rozruchowy Androida"

#: plinius-boot:319
msgid "Android init boot image"
msgstr "Obraz rozruchowy init Androida"

#: plinius-boot:320
msgid "Vendor boot image"
msgstr "Obraz rozruchowy vendor"

#: plinius-boot:321
msgid "Verified boot metadata"
msgstr "Metadane Verified Boot"

#: plinius-boot:322
msgid "Android sparse image"
msgstr "Obraz sparse Androida"

#: plinius-boot:323
msgid "Dynamic partitions (super)"
msgstr "Partycje dynamiczne (super)"

#: plinius-boot:324
msgid "ext4 file system"
msgstr "System plików ext4"

#: plinius-boot:325
msgid "F2FS file system"
msgstr "System plików F2FS"

#: plinius-boot:326
msgid "Encrypted (LUKS)"
msgstr "Zaszyfrowane (LUKS)"

#: plinius-boot:327
msgid "LVM volume"
msgstr "Wolumin LVM"

#: plinius-boot:328
msgid "MediaTek image"
msgstr "Obraz MediaTek"

#: plinius-boot:329
msgid "MediaTek preloader"
msgstr "Preloader MediaTek"

#: plinius-boot:330
msgid "Device tree overlays"
msgstr "Nakładki drzewa urządzeń"

#: plinius-boot:331
msgid "Device tree"
msgstr "Drzewo urządzeń"

#: plinius-boot:332
msgid "Partition table (GPT)"
msgstr "Tablica partycji (GPT)"

#: plinius-boot:333
msgid "Program (ELF)"
msgstr "Program (ELF)"

#: plinius-boot:334
msgid "Unknown data"
msgstr "Nieznane dane"

#: plinius-boot:337
msgid "in use (mounted)"
msgstr "w użyciu (zamontowana)"

#: plinius-boot:338
msgid "in use by the system"
msgstr "używana przez system"

#: plinius-boot:339
msgid "in use as swap"
msgstr "używana jako swap"

#: plinius-boot:342
msgid "Linux on the phone, USB network"
msgstr "Linux na telefonie, sieć USB"

#: plinius-boot:343
msgid "Rescue system, USB network"
msgstr "System ratunkowy, sieć USB"

#: plinius-boot:344
msgid "Android, USB debugging"
msgstr "Android, debugowanie USB"

#: plinius-boot:345
msgid "Bootloader (fastboot)"
msgstr "Bootloader (fastboot)"

#: plinius-boot:346
msgid "MediaTek download mode"
msgstr "Tryb pobierania MediaTek"

#: plinius-boot:348
msgid "Not connected"
msgstr "Nie podłączony"

#: plinius-boot:646 plinius-boot:6420
#, python-brace-format
msgid "build {number}"
msgstr "kompilacja {number}"

#: plinius-boot:650 plinius-boot:6421
#, python-brace-format
msgid "security patch {date}"
msgstr "poprawka zabezpieczeń {date}"

#: plinius-boot:657
#, python-brace-format
msgid "Partition {name}"
msgstr "Partycja {name}"

#: plinius-boot:659
#, python-brace-format
msgid "Slot {slot} (active)"
msgstr "Slot {slot} (aktywny)"

#: plinius-boot:659
#, python-brace-format
msgid "Slot {slot}"
msgstr "Slot {slot}"

#: plinius-boot:703
msgid "Not a regular file"
msgstr "Nie jest zwykłym plikiem"

#: plinius-boot:912 plinius-boot:5632 plinius-boot:5642 plinius-boot:5659
#: plinius-boot:5676 plinius-boot:5735 plinius-boot:5900 plinius-boot:7226
msgid "Rescue system"
msgstr "System ratunkowy"

#: plinius-boot:929
msgid "Talks to Android on the phone"
msgstr "Komunikuje się z systemem Android na telefonie"

#: plinius-boot:930
msgid "Talks to the phone's bootloader"
msgstr "Komunikuje się z bootloaderem telefonu"

#: plinius-boot:931
msgid "Talks to Linux and the rescue system on the phone"
msgstr "Komunikuje się z Linuksem i systemem ratunkowym na telefonie"

#: plinius-boot:932
msgid "Creates the key for the rescue system"
msgstr "Tworzy klucz do systemu ratunkowego"

#: plinius-boot:933
msgid "Finds the phone's USB network"
msgstr "Znajduje sieć USB telefonu"

#: plinius-boot:955
msgid "Not installed."
msgstr "Nie zainstalowano."

#: plinius-boot:957
msgid "Cannot be run."
msgstr "Nie można uruchomić."

#: plinius-boot:959
msgid "Does not answer."
msgstr "Nie odpowiada."

#: plinius-boot:961
#, python-brace-format
msgid "Does not work: {error}"
msgstr "Nie działa: {error}"

#: plinius-boot:1303 plinius-boot:3936 plinius-boot:3953 plinius-boot:4059
#: plinius-boot:4150 plinius-boot:4153 plinius-boot:4204 plinius-boot:4206
#: plinius-boot:4216 plinius-boot:4759
msgid "Reading the partition table"
msgstr "Odczytywanie tablicy partycji"

#: plinius-boot:1347
msgid "Could not read the partition list."
msgstr "Nie udało się odczytać listy partycji."

#: plinius-boot:1426 plinius-boot:6018
msgid "The phone was disconnected."
msgstr "Telefon został odłączony."

#: plinius-boot:1602 plinius-boot:8233
msgid "Bootloader"
msgstr "Bootloader"

#: plinius-boot:1661 plinius-boot:2665 plinius-boot:8903
msgid "Unknown phone"
msgstr "Nieznany telefon"

#: plinius-boot:1732
msgid ""
"No administrator access. Log in with your password so the app can use sudo."
msgstr ""
"Brak uprawnień administratora. Zaloguj się swoim hasłem, aby aplikacja mogła "
"używać sudo."

#: plinius-boot:1742
msgid "Unlock the phone and allow USB debugging in the prompt shown there."
msgstr "Odblokuj telefon i zezwól na debugowanie USB w wyświetlonym tam oknie."

#: plinius-boot:1744
msgid "The phone is not ready yet."
msgstr "Telefon nie jest jeszcze gotowy."

#: plinius-boot:1748
msgid ""
"Android does not allow reading the partitions without root. Restart the "
"phone into the bootloader and start the rescue system there, or start a "
"Linux system on the phone."
msgstr ""
"Android nie pozwala odczytać partycji bez uprawnień roota. Uruchom ponownie "
"telefon w bootloaderze i uruchom tam system ratunkowy albo uruchom na "
"telefonie system Linux."

#: plinius-boot:1757
msgid "In fastboot mode backups can only be restored, not created."
msgstr "W trybie fastboot kopie zapasowe można tylko przywracać, nie tworzyć."

#: plinius-boot:1760
msgid ""
"The bootloader is locked. Unlock it to start the rescue system or restore "
"backups."
msgstr ""
"Bootloader jest zablokowany. Odblokuj go, aby uruchomić system ratunkowy lub "
"przywrócić kopie zapasowe."

#: plinius-boot:1762
msgid ""
"The bootloader does not report whether it is unlocked. Restoring is not "
"possible."
msgstr ""
"Bootloader nie informuje, czy jest odblokowany. Przywracanie nie jest "
"możliwe."

#: plinius-boot:1863
msgid ""
"Its system lets in SSH keys only, no password. Start the bootloader on the "
"phone; the app then starts the rescue system there."
msgstr "Jego system wpuszcza tylko klucze SSH, bez hasła. Uruchom bootloader na telefonie; aplikacja uruchomi tam system ratunkowy."

#: plinius-boot:1866
msgid "Log in to read the partitions."
msgstr "Zaloguj się, aby odczytać partycje."

#: plinius-boot:1890
msgid ""
"The phone is in MediaTek download mode. This app cannot use this mode. "
"Disconnect the cable and hold the power button to restart the phone."
msgstr ""
"Telefon jest w trybie pobierania MediaTek. Ta aplikacja nie może korzystać z "
"tego trybu. Odłącz kabel i przytrzymaj przycisk zasilania, aby uruchomić "
"telefon ponownie."

#: plinius-boot:2020 plinius-boot:2024
msgid "The rescue system is not built yet (rescue/mkrescue.sh)."
msgstr "System ratunkowy nie został jeszcze zbudowany (rescue/mkrescue.sh)."

#: plinius-boot:2042
msgid "This is not an Android boot image."
msgstr "To nie jest obraz rozruchowy Androida."

#: plinius-boot:2074
msgid "This boot image contains no kernel."
msgstr "Ten obraz rozruchowy nie zawiera jądra."

#: plinius-boot:2092
#, python-brace-format
msgid "The boot image in the backup cannot be read ({error})."
msgstr "Nie można odczytać obrazu rozruchowego z kopii zapasowej ({error})."

#: plinius-boot:2094
msgid "The boot image in the backup is damaged (checksum does not match)."
msgstr ""
"Obraz rozruchowy w kopii zapasowej jest uszkodzony (suma kontrolna się nie "
"zgadza)."

#: plinius-boot:2111
#, python-brace-format
msgid "{name} from the backup of {date}"
msgstr "{name} z kopii zapasowej z {date}"

#: plinius-boot:2128
#, python-brace-format
msgid "fastboot could not start the rescue system: {error}"
msgstr "fastboot nie mógł uruchomić systemu ratunkowego: {error}"

#: plinius-boot:2136 plinius-boot:8368
msgid "Confirm on the phone: press Volume up to unlock."
msgstr ""
"Potwierdź na telefonie: naciśnij przycisk zwiększania głośności, aby "
"odblokować."

#: plinius-boot:2140
#, python-brace-format
msgid "The bootloader was not unlocked: {error}"
msgstr "Bootloader nie został odblokowany: {error}"

#: plinius-boot:2142
msgid "Waiting for the bootloader…"
msgstr "Oczekiwanie na bootloader…"

#: plinius-boot:2146
msgid ""
"The phone does not report itself as unlocked. If the question on the phone "
"was declined, start again. Otherwise restart the phone into the bootloader "
"and check it here again."
msgstr ""
"Telefon nie zgłasza, że jest odblokowany. Jeśli pytanie na telefonie zostało "
"odrzucone, zacznij od nowa. W przeciwnym razie uruchom ponownie telefon w "
"bootloaderze i sprawdź go tu jeszcze raz."

#: plinius-boot:2151 plinius-boot:4428
msgid "Formatting the data partition…"
msgstr "Formatowanie partycji danych…"

#: plinius-boot:2154
#, python-brace-format
msgid ""
"The bootloader is unlocked, but the data partition could not be formatted: "
"{error}\n"
"Run “fastboot -w” in the bootloader, otherwise Volla OS keeps restarting."
msgstr ""
"Bootloader jest odblokowany, ale nie udało się sformatować partycji danych: "
"{error}\n"
"Uruchom w bootloaderze „fastboot -w”, w przeciwnym razie Volla OS będzie "
"ciągle uruchamiać się ponownie."

#: plinius-boot:2212 plinius-boot:2215
msgid "This is not an update package (zip)."
msgstr "To nie jest pakiet aktualizacji (zip)."

#: plinius-boot:2224 plinius-boot:2237 plinius-boot:2244 plinius-boot:2247
msgid "The update package has no usable payload.bin."
msgstr "Pakiet aktualizacji nie zawiera użytecznego payload.bin."

#: plinius-boot:2259 plinius-boot:2273
#, python-brace-format
msgid "{name} in the update package is too large."
msgstr "{name} w pakiecie aktualizacji jest za duży."

#: plinius-boot:2276 plinius-boot:2292 plinius-boot:2296
msgid "The update package is damaged (checksum does not match)."
msgstr "Pakiet aktualizacji jest uszkodzony (suma kontrolna się nie zgadza)."

#: plinius-boot:2285
#, python-brace-format
msgid ""
"This is an incremental update package; only full packages contain {name}."
msgstr ""
"To przyrostowy pakiet aktualizacji; {name} zawierają tylko pełne pakiety."

#: plinius-boot:2298
#, python-brace-format
msgid "The update package contains no {name}."
msgstr "Pakiet aktualizacji nie zawiera {name}."

#: plinius-boot:2392 plinius-boot:2464
msgid "Asking the update server…"
msgstr "Odpytywanie serwera aktualizacji…"

#: plinius-boot:2396 plinius-boot:2467
#, python-brace-format
msgid "Downloading {name} from {package}…"
msgstr "Pobieranie {name} z {package}…"

#: plinius-boot:2415
#, python-brace-format
msgid ""
"{file} is not the original {name} of this phone: its checksum does not match "
"the one the phone expects."
msgstr ""
"{file} nie jest oryginalnym {name} tego telefonu: jego suma kontrolna nie "
"zgadza się z oczekiwaną przez telefon."

#: plinius-boot:2440
msgid "This is not an init_boot image."
msgstr "To nie jest obraz init_boot."

#: plinius-boot:2454
msgid "The bootloader is locked."
msgstr "Bootloader jest zablokowany."

#: plinius-boot:2458
#, python-brace-format
msgid "This phone has no partition {name}."
msgstr "Ten telefon nie ma partycji {name}."

#: plinius-boot:2471
#, python-brace-format
msgid ""
"No {name} of this phone is known and the update server cannot be reached. "
"Without one the app could not write the original back later."
msgstr ""
"Nie jest znany żaden {name} tego telefonu, a serwer aktualizacji jest "
"nieosiągalny. Bez niego aplikacja nie mogłaby później przywrócić oryginału."

#: plinius-boot:2475
#, python-brace-format
msgid "The rescue system does not fit into {name}."
msgstr "System ratunkowy nie mieści się w {name}."

#: plinius-boot:2482
#, python-brace-format
msgid "Writing the rescue system to {name}…"
msgstr "Zapisywanie systemu ratunkowego do {name}…"

#: plinius-boot:2486 plinius-boot:2532
#, python-brace-format
msgid "fastboot could not write {name}: {error}"
msgstr "fastboot nie mógł zapisać {name}: {error}"

#: plinius-boot:2496
msgid "The app does not know which partition holds the rescue system."
msgstr "Aplikacja nie wie, która partycja zawiera system ratunkowy."

#: plinius-boot:2499
msgid "The original does not match the checksum the phone expects."
msgstr "Oryginał nie zgadza się z sumą kontrolną oczekiwaną przez telefon."

#: plinius-boot:2502
msgid ""
"The image to write back is this app's rescue system, not the original. "
"Nothing was written."
msgstr ""
"Obraz do zapisania to system ratunkowy tej aplikacji, a nie oryginał. Nic "
"nie zostało zapisane."

#: plinius-boot:2507
msgid "Restarting into the bootloader…"
msgstr "Ponowne uruchamianie w bootloaderze…"

#: plinius-boot:2512
msgid ""
"The phone did not appear in the bootloader. Start it there by hand (Power "
"and Volume down) and write the original back from the phone's page."
msgstr ""
"Telefon nie pojawił się w bootloaderze. Uruchom go tam ręcznie (zasilanie i "
"ściszanie) i przywróć oryginał ze strony telefonu."

#: plinius-boot:2520
#, python-brace-format
msgid ""
"The phone in the bootloader is not in the expected state (slot {slot}, "
"partition {name}). Nothing was written."
msgstr ""
"Telefon w bootloaderze nie jest w oczekiwanym stanie (slot {slot}, partycja "
"{name}). Niczego nie zapisano."

#: plinius-boot:2527
#, python-brace-format
msgid "Writing the original {name}…"
msgstr "Zapisywanie oryginalnego {name}…"

#: plinius-boot:2536
msgid "Starting the phone…"
msgstr "Uruchamianie telefonu…"

#: plinius-boot:2747
msgid "Backup only. Restoring this area is not supported."
msgstr "Tylko kopia zapasowa. Przywracanie tego obszaru nie jest obsługiwane."

#: plinius-boot:2749
msgid ""
"Holds the rescue system, not the original. Restoring it would keep the phone "
"from starting."
msgstr ""
"Zawiera system ratunkowy, nie oryginał. Przywrócenie go uniemożliwiłoby "
"uruchomienie telefonu."

#: plinius-boot:2751
msgid "Not present on this phone."
msgstr "Brak na tym telefonie."

#: plinius-boot:2753
msgid "The partition has a different size on this phone."
msgstr "Partycja ma na tym telefonie inny rozmiar."

#: plinius-boot:2755
msgid "In use by the running system. Restore it in fastboot mode."
msgstr "Używana przez działający system. Przywróć ją w trybie fastboot."

#: plinius-boot:2758
msgid ""
"Belongs to another phone. Restoring it would copy that phone's IMEI and MAC "
"addresses."
msgstr ""
"Należy do innego telefonu. Przywrócenie skopiowałoby numer IMEI i adresy MAC "
"tamtego telefonu."

#: plinius-boot:2775
#, python-brace-format
msgid ""
"A different phone is connected now (serial number {serial}). Nothing was "
"changed."
msgstr ""
"Teraz podłączony jest inny telefon (numer seryjny {serial}). Niczego nie "
"zmieniono."

#: plinius-boot:2920
#, python-brace-format
msgid "Saving {name} ({i} of {n})"
msgstr "Tworzenie kopii {name} ({i} z {n})"

#: plinius-boot:2924 plinius-boot:2944 plinius-boot:2947 plinius-boot:2951
#, python-brace-format
msgid "Reading {name} failed: {error}"
msgstr "Odczyt {name} nie powiódł się: {error}"

#: plinius-boot:2925
msgid "the partition name is invalid or appears twice"
msgstr "nazwa partycji jest nieprawidłowa lub występuje dwukrotnie"

#: plinius-boot:2945
msgid "the phone sent more data than the partition holds"
msgstr "telefon wysłał więcej danych, niż mieści partycja"

#: plinius-boot:2948 plinius-boot:3583 plinius-boot:3603 plinius-boot:4182
msgid "the data is incomplete"
msgstr "dane są niekompletne"

#: plinius-boot:2952
msgid "the checksum on the phone does not match"
msgstr "suma kontrolna na telefonie się nie zgadza"

#: plinius-boot:2962
#, python-brace-format
msgid "{name}: {size}, saved as {file}"
msgstr "{name}: {size}, zapisano jako {file}"

#: plinius-boot:2972 plinius-boot:3018
#, python-brace-format
msgid "Checking {name} ({i} of {n})"
msgstr "Sprawdzanie {name} ({i} z {n})"

#: plinius-boot:2987
#, python-brace-format
msgid "{name}: checksum does not match"
msgstr "{name}: suma kontrolna się nie zgadza"

#: plinius-boot:2990
#, python-brace-format
msgid "{name}: OK"
msgstr "{name}: OK"

#: plinius-boot:3001 plinius-boot:5921 plinius-boot:6196 plinius-boot:6197
msgid "Reading the partition list…"
msgstr "Odczytywanie listy partycji…"

#: plinius-boot:3005 plinius-boot:6181
#, python-brace-format
msgid ""
"This backup belongs to a {backup}, but the connected phone is a {device}."
msgstr ""
"Ta kopia zapasowa pochodzi z urządzenia {backup}, ale podłączony telefon to "
"{device}."

#: plinius-boot:3010
#, python-brace-format
msgid "{name}: {problem} Nothing was written."
msgstr "{name}: {problem} Niczego nie zapisano."

#: plinius-boot:3028
#, python-brace-format
msgid ""
"The backup of {name} is damaged (the file is too large). Nothing was written "
"to this partition."
msgstr ""
"Kopia zapasowa {name} jest uszkodzona (plik jest za duży). Na tę partycję "
"niczego nie zapisano."

#: plinius-boot:3031
#, python-brace-format
msgid "Not enough free space in {dir} for a temporary copy of {name}."
msgstr "Za mało wolnego miejsca w {dir} na tymczasową kopię {name}."

#: plinius-boot:3048
#, python-brace-format
msgid ""
"The backup of {name} cannot be read ({error}). Nothing was written to this "
"partition."
msgstr ""
"Nie można odczytać kopii zapasowej {name} ({error}). Na tę partycję niczego "
"nie zapisano."

#: plinius-boot:3053
#, python-brace-format
msgid ""
"The backup of {name} is damaged (checksum does not match). Nothing was "
"written to this partition."
msgstr ""
"Kopia zapasowa {name} jest uszkodzona (suma kontrolna się nie zgadza). Na tę "
"partycję niczego nie zapisano."

#: plinius-boot:3056
#, python-brace-format
msgid "Writing {name} ({i} of {n})"
msgstr "Zapisywanie {name} ({i} z {n})"

#: plinius-boot:3065
#, python-brace-format
msgid "fastboot could not write {name}."
msgstr "fastboot nie mógł zapisać {name}."

#: plinius-boot:3079 plinius-boot:4181
#, python-brace-format
msgid "Writing {name} failed: {error}"
msgstr "Zapis {name} nie powiódł się: {error}"

#: plinius-boot:3081 plinius-boot:4183
#, python-brace-format
msgid "Verifying {name} on the phone"
msgstr "Weryfikowanie {name} na telefonie"

#: plinius-boot:3084
#, python-brace-format
msgid ""
"{name} was written, but the content on the phone does not match the backup."
msgstr ""
"Zapisano {name}, ale zawartość na telefonie nie zgadza się z kopią zapasową."

#: plinius-boot:3086
#, python-brace-format
msgid "{name}: written and verified"
msgstr "{name}: zapisano i zweryfikowano"

#: plinius-boot:3309
#, python-brace-format
msgid ""
"This image needs {need}, but partition {number} holds {size}. Nothing was "
"changed."
