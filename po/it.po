#: plinius-boot:269
msgid "Phone Backups"
msgstr "Backup del telefono"

#: plinius-boot:293
msgid "Device identity"
msgstr "Identità del dispositivo"

#: plinius-boot:294
msgid ""
"IMEI, MAC addresses and calibration. Unique to this phone and not available "
"for download anywhere. Keep this backup safe."
msgstr ""
"IMEI, indirizzi MAC e calibrazione. Unici per questo telefono e non "
"scaricabili da nessuna parte. Conserva questo backup al sicuro."

#: plinius-boot:296
msgid "Boot chain and firmware"
msgstr "Catena di avvio e firmware"

#: plinius-boot:296
msgid "Bootloader, kernel, modem and other firmware."
msgstr "Bootloader, kernel, modem e altro firmware."

#: plinius-boot:297 plinius-boot:660 plinius-boot:5338 plinius-boot:5882
#: plinius-boot:6201 plinius-boot:6250 plinius-boot:6707 plinius-boot:6740
#: plinius-boot:6744 plinius-boot:6770
msgid "System"
msgstr "Sistema"

#: plinius-boot:297
msgid "The Android system and vendor partitions."
msgstr "Le partizioni di sistema e del produttore (vendor) di Android."

#: plinius-boot:298 plinius-boot:6201 plinius-boot:6707
msgid "User data"
msgstr "Dati utente"

#: plinius-boot:298
msgid "Your files, apps and settings. Very large and often encrypted."
msgstr "I tuoi file, app e impostazioni. Molto grandi e spesso cifrati."

#: plinius-boot:299 plinius-boot:6209 plinius-boot:6211 plinius-boot:6573
#: plinius-boot:6745 plinius-boot:6797 plinius-boot:6835 plinius-boot:7999
msgid "Memory card"
msgstr "Scheda di memoria"

#: plinius-boot:299
msgid ""
"Systems on the memory card, for example Ubuntu Touch or Arch via multi-boot."
msgstr ""
"Sistemi sulla scheda di memoria, ad esempio Ubuntu Touch o Arch tramite "
"multi-boot."

#: plinius-boot:300
msgid "Logs"
msgstr "Log"

#: plinius-boot:300
msgid "Crash logs and temporary data, usually not needed."
msgstr "Log degli arresti anomali e dati temporanei, di solito non necessari."

#: plinius-boot:316
msgid "Not checked"
msgstr "Non controllato"

#: plinius-boot:317
msgid "Probably empty"
msgstr "Probabilmente senza dati"

#: plinius-boot:318
msgid "Android boot image"
msgstr "Immagine di avvio Android"

#: plinius-boot:319
msgid "Android init boot image"
msgstr "Immagine init boot Android"

#: plinius-boot:320
msgid "Vendor boot image"
msgstr "Immagine vendor boot"

#: plinius-boot:321
msgid "Verified boot metadata"
msgstr "Metadati di Verified Boot"

#: plinius-boot:322
msgid "Android sparse image"
msgstr "Immagine sparse Android"

#: plinius-boot:323
msgid "Dynamic partitions (super)"
msgstr "Partizioni dinamiche (super)"

#: plinius-boot:324
msgid "ext4 file system"
msgstr "File system ext4"

#: plinius-boot:325
msgid "F2FS file system"
msgstr "File system F2FS"

#: plinius-boot:326
msgid "Encrypted (LUKS)"
msgstr "Cifrato (LUKS)"

#: plinius-boot:327
msgid "LVM volume"
msgstr "Volume LVM"

#: plinius-boot:328
msgid "MediaTek image"
msgstr "Immagine MediaTek"

#: plinius-boot:329
msgid "MediaTek preloader"
msgstr "Preloader MediaTek"

#: plinius-boot:330
msgid "Device tree overlays"
msgstr "Overlay del device tree"

#: plinius-boot:331
msgid "Device tree"
msgstr "Device tree"

#: plinius-boot:332
msgid "Partition table (GPT)"
msgstr "Tabella delle partizioni (GPT)"

#: plinius-boot:333
msgid "Program (ELF)"
msgstr "Programma (ELF)"

#: plinius-boot:334
msgid "Unknown data"
msgstr "Dati sconosciuti"

#: plinius-boot:337
msgid "in use (mounted)"
msgstr "in uso (montata)"

#: plinius-boot:338
msgid "in use by the system"
msgstr "in uso dal sistema"

#: plinius-boot:339
msgid "in use as swap"
msgstr "in uso come swap"

#: plinius-boot:342
msgid "Linux on the phone, USB network"
msgstr "Linux sul telefono, rete USB"

#: plinius-boot:343
msgid "Rescue system, USB network"
msgstr "Sistema di emergenza, rete USB"

#: plinius-boot:344
msgid "Android, USB debugging"
msgstr "Android, debug USB"

#: plinius-boot:345
msgid "Bootloader (fastboot)"
msgstr "Bootloader (fastboot)"

#: plinius-boot:346
msgid "MediaTek download mode"
msgstr "Modalità download MediaTek"

#: plinius-boot:348
msgid "Not connected"
msgstr "Non collegato"

#: plinius-boot:646 plinius-boot:6194
#, python-brace-format
msgid "build {number}"
msgstr "build {number}"

#: plinius-boot:650 plinius-boot:6195
#, python-brace-format
msgid "security patch {date}"
msgstr "patch di sicurezza {date}"

#: plinius-boot:657
#, python-brace-format
msgid "Partition {name}"
msgstr "Partizione {name}"

#: plinius-boot:659
#, python-brace-format
msgid "Slot {slot} (active)"
msgstr "Slot {slot} (attivo)"

#: plinius-boot:659
#, python-brace-format
msgid "Slot {slot}"
msgstr "Slot {slot}"

#: plinius-boot:703
msgid "Not a regular file"
msgstr "Non è un file regolare"

#: plinius-boot:912 plinius-boot:5429 plinius-boot:5439 plinius-boot:5456
#: plinius-boot:5473 plinius-boot:5532 plinius-boot:5695 plinius-boot:7000
msgid "Rescue system"
msgstr "Sistema di emergenza"

#: plinius-boot:929
msgid "Talks to Android on the phone"
msgstr "Comunica con Android sul telefono"

#: plinius-boot:930
msgid "Talks to the phone's bootloader"
msgstr "Comunica con il bootloader del telefono"

#: plinius-boot:931
msgid "Talks to Linux and the rescue system on the phone"
msgstr "Comunica con Linux e il sistema di emergenza sul telefono"

#: plinius-boot:932
msgid "Creates the key for the rescue system"
msgstr "Crea la chiave per il sistema di emergenza"

#: plinius-boot:933
msgid "Finds the phone's USB network"
msgstr "Trova la rete USB del telefono"

#: plinius-boot:955
msgid "Not installed."
msgstr "Non installato."

#: plinius-boot:957
msgid "Cannot be run."
msgstr "Non può essere eseguito."

#: plinius-boot:959
msgid "Does not answer."
msgstr "Non risponde."

#: plinius-boot:961
#, python-brace-format
msgid "Does not work: {error}"
msgstr "Non funziona: {error}"

#: plinius-boot:1268
msgid "Could not read the partition list."
msgstr "Impossibile leggere l’elenco delle partizioni."

#: plinius-boot:1333 plinius-boot:5792
msgid "The phone was disconnected."
msgstr "Il telefono è stato scollegato."

#: plinius-boot:1505 plinius-boot:7997
msgid "Bootloader"
msgstr "Bootloader"

#: plinius-boot:1561 plinius-boot:2555 plinius-boot:8626
msgid "Unknown phone"
msgstr "Telefono sconosciuto"

#: plinius-boot:1632
msgid ""
"No administrator access. Log in with your password so the app can use sudo."
msgstr ""
"Nessun accesso da amministratore. Accedi con la tua password per permettere "
"all’app di usare sudo."

#: plinius-boot:1642
msgid "Unlock the phone and allow USB debugging in the prompt shown there."
msgstr ""
"Sblocca il telefono e consenti il debug USB nella richiesta che appare sul "
"telefono."

#: plinius-boot:1644
msgid "The phone is not ready yet."
msgstr "Il telefono non è ancora pronto."

#: plinius-boot:1648
msgid ""
"Android does not allow reading the partitions without root. Restart the "
"phone into the bootloader and start the rescue system there, or start a "
"Linux system on the phone."
msgstr ""
"Android non consente di leggere le partizioni senza root. Riavvia il "
"telefono nel bootloader e avvia lì il sistema di emergenza, oppure avvia un "
"sistema Linux sul telefono."

#: plinius-boot:1657
msgid "In fastboot mode backups can only be restored, not created."
msgstr ""
"In modalità fastboot i backup possono solo essere ripristinati, non creati."

#: plinius-boot:1660
msgid ""
"The bootloader is locked. Unlock it to start the rescue system or restore "
"backups."
msgstr ""
"Il bootloader è bloccato. Sbloccalo per avviare il sistema di emergenza o "
"ripristinare i backup."

#: plinius-boot:1662
msgid ""
"The bootloader does not report whether it is unlocked. Restoring is not "
"possible."
msgstr ""
"Il bootloader non indica se è sbloccato. Il ripristino non è possibile."

#: plinius-boot:1760
msgid "Log in to read the partitions."
msgstr "Accedi per leggere le partizioni."

#: plinius-boot:1784
msgid ""
"The phone is in MediaTek download mode. This app cannot use this mode. "
"Disconnect the cable and hold the power button to restart the phone."
msgstr ""
"Il telefono è in modalità download MediaTek. Questa app non può usare questa "
"modalità. Scollega il cavo e tieni premuto il tasto di accensione per "
"riavviare il telefono."

#: plinius-boot:1914 plinius-boot:1918
msgid "The rescue system is not built yet (rescue/mkrescue.sh)."
msgstr ""
"Il sistema di emergenza non è ancora stato compilato (rescue/mkrescue.sh)."

#: plinius-boot:1936
msgid "This is not an Android boot image."
msgstr "Questa non è un’immagine di avvio Android."

#: plinius-boot:1968
msgid "This boot image contains no kernel."
msgstr "Questa immagine di avvio non contiene alcun kernel."

#: plinius-boot:1986
#, python-brace-format
msgid "The boot image in the backup cannot be read ({error})."
msgstr "Impossibile leggere l’immagine di avvio nel backup ({error})."

#: plinius-boot:1988
msgid "The boot image in the backup is damaged (checksum does not match)."
msgstr ""
"L’immagine di avvio nel backup è danneggiata (il checksum non corrisponde)."

#: plinius-boot:2005
#, python-brace-format
msgid "{name} from the backup of {date}"
msgstr "{name} dal backup del {date}"

#: plinius-boot:2022
#, python-brace-format
msgid "fastboot could not start the rescue system: {error}"
msgstr "fastboot non è riuscito ad avviare il sistema di emergenza: {error}"

#: plinius-boot:2030 plinius-boot:8131
msgid "Confirm on the phone: press Volume up to unlock."
msgstr "Conferma sul telefono: premi Volume su per sbloccare."

#: plinius-boot:2034
#, python-brace-format
msgid "The bootloader was not unlocked: {error}"
msgstr "Il bootloader non è stato sbloccato: {error}"

#: plinius-boot:2036
msgid "Waiting for the bootloader…"
msgstr "In attesa del bootloader…"

#: plinius-boot:2040
msgid ""
"The phone does not report itself as unlocked. If the question on the phone "
"was declined, start again. Otherwise restart the phone into the bootloader "
"and check it here again."
msgstr ""
"Il telefono non risulta sbloccato. Se la domanda sul telefono è stata "
"rifiutata, ricomincia. Altrimenti riavvia il telefono nel bootloader e "
"controlla di nuovo qui."

#: plinius-boot:2045 plinius-boot:4277
msgid "Formatting the data partition…"
msgstr "Formattazione della partizione dati…"

#: plinius-boot:2048
#, python-brace-format
msgid ""
"The bootloader is unlocked, but the data partition could not be formatted: "
"{error}\n"
"Run “fastboot -w” in the bootloader, otherwise Volla OS keeps restarting."
msgstr ""
"Il bootloader è sbloccato, ma non è stato possibile formattare la partizione "
"dati: {error}\n"
"Esegui “fastboot -w” nel bootloader, altrimenti Volla OS continua a "
"riavviarsi."

#: plinius-boot:2106 plinius-boot:2109
msgid "This is not an update package (zip)."
msgstr "Questo non è un pacchetto di aggiornamento (zip)."

#: plinius-boot:2118 plinius-boot:2131 plinius-boot:2138 plinius-boot:2141
msgid "The update package has no usable payload.bin."
msgstr ""
"Il pacchetto di aggiornamento non contiene un payload.bin utilizzabile."

#: plinius-boot:2153 plinius-boot:2167
#, python-brace-format
msgid "{name} in the update package is too large."
msgstr "{name} nel pacchetto di aggiornamento è troppo grande."

#: plinius-boot:2170 plinius-boot:2186 plinius-boot:2190
msgid "The update package is damaged (checksum does not match)."
msgstr ""
"Il pacchetto di aggiornamento è danneggiato (il checksum non corrisponde)."

#: plinius-boot:2179
#, python-brace-format
msgid ""
"This is an incremental update package; only full packages contain {name}."
msgstr ""
"È un pacchetto di aggiornamento incrementale; solo i pacchetti completi "
"contengono {name}."

#: plinius-boot:2192
#, python-brace-format
msgid "The update package contains no {name}."
msgstr "Il pacchetto di aggiornamento non contiene {name}."

#: plinius-boot:2286 plinius-boot:2358
msgid "Asking the update server…"
msgstr "Interrogazione del server degli aggiornamenti…"

#: plinius-boot:2290 plinius-boot:2361
#, python-brace-format
msgid "Downloading {name} from {package}…"
msgstr "Download di {name} da {package}…"

#: plinius-boot:2309
#, python-brace-format
msgid ""
"{file} is not the original {name} of this phone: its checksum does not match "
"the one the phone expects."
msgstr ""
"{file} non è il {name} originale di questo telefono: il suo checksum non "
"corrisponde a quello atteso dal telefono."

#: plinius-boot:2334
msgid "This is not an init_boot image."
msgstr "Questa non è un’immagine init_boot."

#: plinius-boot:2348
msgid "The bootloader is locked."
msgstr "Il bootloader è bloccato."

#: plinius-boot:2352
#, python-brace-format
msgid "This phone has no partition {name}."
msgstr "Questo telefono non ha la partizione {name}."

#: plinius-boot:2365
#, python-brace-format
msgid ""
"No {name} of this phone is known and the update server cannot be reached. "
"Without one the app could not write the original back later."
msgstr ""
"Non è noto alcun {name} di questo telefono e il server degli aggiornamenti "
"non è raggiungibile. Senza, l’app non potrebbe riscrivere l’originale in "
"seguito."

#: plinius-boot:2369
#, python-brace-format
msgid "The rescue system does not fit into {name}."
msgstr "Il sistema di emergenza non entra in {name}."

#: plinius-boot:2376
#, python-brace-format
msgid "Writing the rescue system to {name}…"
msgstr "Scrittura del sistema di emergenza in {name}…"

#: plinius-boot:2380 plinius-boot:2422
#, python-brace-format
msgid "fastboot could not write {name}: {error}"
msgstr "fastboot non è riuscito a scrivere {name}: {error}"

#: plinius-boot:2390
msgid "The app does not know which partition holds the rescue system."
msgstr "L’app non sa quale partizione contiene il sistema di emergenza."

#: plinius-boot:2393
msgid "The original does not match the checksum the phone expects."
msgstr "L’originale non corrisponde al checksum atteso dal telefono."

#: plinius-boot:2397
msgid "Restarting into the bootloader…"
msgstr "Riavvio nel bootloader…"

#: plinius-boot:2402
msgid ""
"The phone did not appear in the bootloader. Start it there by hand (Power "
"and Volume down) and write the original back from the phone's page."
msgstr ""
"Il telefono non è comparso nel bootloader. Avvialo lì a mano (accensione e "
"volume giù) e riscrivi l’originale dalla pagina del telefono."

#: plinius-boot:2410
#, python-brace-format
msgid ""
"The phone in the bootloader is not in the expected state (slot {slot}, "
"partition {name}). Nothing was written."
msgstr ""
"Il telefono nel bootloader non è nello stato atteso (slot {slot}, partizione "
"{name}). Non è stato scritto nulla."

#: plinius-boot:2417
#, python-brace-format
msgid "Writing the original {name}…"
msgstr "Scrittura del {name} originale…"

#: plinius-boot:2426
msgid "Starting the phone…"
msgstr "Avvio del telefono…"

#: plinius-boot:2637
msgid "Backup only. Restoring this area is not supported."
msgstr "Solo backup. Il ripristino di quest’area non è supportato."

#: plinius-boot:2639
msgid ""
"Holds the rescue system, not the original. Restoring it would keep the phone "
"from starting."
msgstr ""
"Contiene il sistema di emergenza, non l’originale. Ripristinarlo impedirebbe "
"l’avvio del telefono."

#: plinius-boot:2641
msgid "Not present on this phone."
msgstr "Non presente su questo telefono."

#: plinius-boot:2643
msgid "The partition has a different size on this phone."
msgstr "La partizione ha una dimensione diversa su questo telefono."

#: plinius-boot:2645
msgid "In use by the running system. Restore it in fastboot mode."
msgstr "In uso dal sistema in esecuzione. Ripristinala in modalità fastboot."

#: plinius-boot:2648
msgid ""
"Belongs to another phone. Restoring it would copy that phone's IMEI and MAC "
"addresses."
msgstr ""
"Appartiene a un altro telefono. Ripristinarla copierebbe l’IMEI e gli "
"indirizzi MAC di quel telefono."

#: plinius-boot:2665
#, python-brace-format
msgid ""
"A different phone is connected now (serial number {serial}). Nothing was "
"changed."
msgstr ""
"Ora è collegato un altro telefono (numero di serie {serial}). Non è stato "
"modificato nulla."

#: plinius-boot:2805
#, python-brace-format
msgid "Saving {name} ({i} of {n})"
msgstr "Salvataggio di {name} ({i} di {n})"

#: plinius-boot:2809 plinius-boot:2829 plinius-boot:2832 plinius-boot:2836
#, python-brace-format
msgid "Reading {name} failed: {error}"
msgstr "Lettura di {name} non riuscita: {error}"

#: plinius-boot:2810
msgid "the partition name is invalid or appears twice"
msgstr "il nome della partizione non è valido o compare due volte"

#: plinius-boot:2830
msgid "the phone sent more data than the partition holds"
msgstr "il telefono ha inviato più dati di quanti ne contenga la partizione"

#: plinius-boot:2833 plinius-boot:3468 plinius-boot:3488 plinius-boot:4032
msgid "the data is incomplete"
msgstr "i dati sono incompleti"

#: plinius-boot:2837
msgid "the checksum on the phone does not match"
msgstr "il checksum sul telefono non corrisponde"

#: plinius-boot:2847
#, python-brace-format
msgid "{name}: {size}, saved as {file}"
msgstr "{name}: {size}, salvato come {file}"

#: plinius-boot:2857 plinius-boot:2903
#, python-brace-format
msgid "Checking {name} ({i} of {n})"
msgstr "Controllo di {name} ({i} di {n})"

#: plinius-boot:2872
#, python-brace-format
msgid "{name}: checksum does not match"
msgstr "{name}: il checksum non corrisponde"

#: plinius-boot:2875
#, python-brace-format
msgid "{name}: OK"
msgstr "{name}: OK"

#: plinius-boot:2886 plinius-boot:5715 plinius-boot:5970 plinius-boot:5971
msgid "Reading the partition list…"
msgstr "Lettura dell’elenco delle partizioni…"

#: plinius-boot:2890 plinius-boot:5955
#, python-brace-format
msgid ""
"This backup belongs to a {backup}, but the connected phone is a {device}."
msgstr ""
"Questo backup proviene da un {backup}, ma il telefono collegato è un "
"{device}."

#: plinius-boot:2895
#, python-brace-format
msgid "{name}: {problem} Nothing was written."
msgstr "{name}: {problem} Non è stato scritto nulla."

#: plinius-boot:2913
#, python-brace-format
msgid ""
"The backup of {name} is damaged (the file is too large). Nothing was written "
"to this partition."
msgstr ""
"Il backup di {name} è danneggiato (il file è troppo grande). Non è stato "
"scritto nulla su questa partizione."

#: plinius-boot:2916
#, python-brace-format
msgid "Not enough free space in {dir} for a temporary copy of {name}."
msgstr ""
"Spazio libero insufficiente in {dir} per una copia temporanea di {name}."

#: plinius-boot:2933
#, python-brace-format
msgid ""
"The backup of {name} cannot be read ({error}). Nothing was written to this "
"partition."
msgstr ""
"Impossibile leggere il backup di {name} ({error}). Non è stato scritto nulla "
"su questa partizione."

#: plinius-boot:2938
#, python-brace-format
msgid ""
"The backup of {name} is damaged (checksum does not match). Nothing was "
"written to this partition."
msgstr ""
"Il backup di {name} è danneggiato (il checksum non corrisponde). Non è stato "
"scritto nulla su questa partizione."

#: plinius-boot:2941
#, python-brace-format
msgid "Writing {name} ({i} of {n})"
msgstr "Scrittura di {name} ({i} di {n})"

#: plinius-boot:2950
#, python-brace-format
msgid "fastboot could not write {name}."
msgstr "fastboot non è riuscito a scrivere {name}."

#: plinius-boot:2964 plinius-boot:4031
#, python-brace-format
msgid "Writing {name} failed: {error}"
msgstr "Scrittura di {name} non riuscita: {error}"

#: plinius-boot:2966 plinius-boot:4033
#, python-brace-format
msgid "Verifying {name} on the phone"
msgstr "Verifica di {name} sul telefono"

#: plinius-boot:2969
#, python-brace-format
msgid ""
"{name} was written, but the content on the phone does not match the backup."
msgstr ""
"{name} è stato scritto, ma il contenuto sul telefono non corrisponde al "
"backup."

#: plinius-boot:2971
#, python-brace-format
msgid "{name}: written and verified"
msgstr "{name}: scritto e verificato"

#: plinius-boot:3194
#, python-brace-format
msgid ""
"This image needs {need}, but partition {number} holds {size}. Nothing was "
"changed."
msgstr ""
"Questa immagine richiede {need}, ma la partizione {number} ne contiene "
"{size}. Non è stato modificato nulla."

#: plinius-boot:3197
#, python-brace-format
msgid ""
"This image has blocks of {size} bytes, and the phone's own storage needs "
"{need}. It would not start there. Nothing was changed."
msgstr ""
"Questa immagine ha blocchi da {size} byte, la memoria del telefono ne "
"richiede {need}. Lì non si avvierebbe. Non è stato modificato nulla."

#: plinius-boot:3213
#, python-brace-format
msgid "This image lacks {name}, so it cannot start on this phone."
msgstr ""
"In questa immagine manca {name}, quindi non può avviarsi su questo telefono."

#: plinius-boot:3217
msgid "This image has no os-release, so it is not a Linux system."
msgstr "Questa immagine non ha os-release, quindi non è un sistema Linux."

#: plinius-boot:3224
msgid "This image is incomplete."
msgstr "Questa immagine è incompleta."

#: plinius-boot:3226
#, python-brace-format
msgid "This is not a usable ext4 image ({error})."
msgstr "Questa non è un’immagine ext4 utilizzabile ({error})."

#: plinius-boot:3240
#, python-brace-format
msgid "Not enough free space in {dir} to unpack it."
msgstr "Spazio libero insufficiente in {dir} per decomprimerla."

#: plinius-boot:3253
#, python-brace-format
msgid "This image does not bring {name}, so it can only go on the memory card."
msgstr ""
"Questa immagine non contiene {name}, quindi può andare solo sulla scheda di "
"memoria."

#: plinius-boot:3257
#, python-brace-format
msgid "{name} in this image is not a boot image."
msgstr "{name} in questa immagine non è un’immagine di avvio."

#: plinius-boot:3260
#, python-brace-format
msgid ""
"{name} in this image still names a system partition, so the system on the "
"data partition would never start."
msgstr ""
"{name} in questa immagine indica ancora una partizione di sistema, quindi il "
"sistema sulla partizione dati non si avvierebbe mai."

#: plinius-boot:3282 plinius-boot:3827 plinius-boot:3876 plinius-boot:3956
#: plinius-boot:4231 plinius-boot:4397 plinius-boot:4462 plinius-boot:4560
#: plinius-boot:4564 plinius-boot:4845 plinius-boot:4888
