#: plinius-boot:269
msgid "Phone Backups"
msgstr "Handy-Sicherungen"

#: plinius-boot:293
msgid "Device identity"
msgstr "Gerätedaten"

#: plinius-boot:294
msgid ""
"IMEI, MAC addresses and calibration. Unique to this phone and not available "
"for download anywhere. Keep this backup safe."
msgstr ""
"IMEI, MAC-Adressen und Kalibrierung. Gibt es nur für dieses Telefon und "
"nirgends zum Herunterladen. Bewahre diese Sicherung gut auf."

#: plinius-boot:296
msgid "Boot chain and firmware"
msgstr "Start und Firmware"

#: plinius-boot:296
msgid "Bootloader, kernel, modem and other firmware."
msgstr "Bootloader, Kernel, Modem und weitere Firmware."

#: plinius-boot:297 plinius-boot:660 plinius-boot:5473 plinius-boot:6040
#: plinius-boot:6359 plinius-boot:6408 plinius-boot:6865 plinius-boot:6898
#: plinius-boot:6902 plinius-boot:6928
msgid "System"
msgstr "System"

#: plinius-boot:297
msgid "The Android system and vendor partitions."
msgstr "Die Android-System- und Hersteller-Partitionen."

#: plinius-boot:298 plinius-boot:6359 plinius-boot:6865
msgid "User data"
msgstr "Benutzerdaten"

#: plinius-boot:298
msgid "Your files, apps and settings. Very large and often encrypted."
msgstr ""
"Deine Dateien, Apps und Einstellungen. Sehr groß und oft verschlüsselt."

#: plinius-boot:299 plinius-boot:6367 plinius-boot:6369 plinius-boot:6731
#: plinius-boot:6903 plinius-boot:6955 plinius-boot:6993 plinius-boot:8167
msgid "Memory card"
msgstr "Speicherkarte"

#: plinius-boot:299
msgid ""
"Systems on the memory card, for example Ubuntu Touch or Arch via multi-boot."
msgstr ""
"Systeme auf der Speicherkarte, zum Beispiel Ubuntu Touch oder Arch per Multi-"
"Boot."

#: plinius-boot:300
msgid "Logs"
msgstr "Protokolle"

#: plinius-boot:300
msgid "Crash logs and temporary data, usually not needed."
msgstr "Absturzprotokolle und temporäre Daten, meist nicht nötig."

#: plinius-boot:316
msgid "Not checked"
msgstr "Nicht geprüft"

#: plinius-boot:317
msgid "Probably empty"
msgstr "Vermutlich leer"

#: plinius-boot:318
msgid "Android boot image"
msgstr "Android-Boot-Image"

#: plinius-boot:319
msgid "Android init boot image"
msgstr "Android-Init-Boot-Image"

#: plinius-boot:320
msgid "Vendor boot image"
msgstr "Vendor-Boot-Image"

#: plinius-boot:321
msgid "Verified boot metadata"
msgstr "Daten für Verified Boot"

#: plinius-boot:322
msgid "Android sparse image"
msgstr "Android-Sparse-Image"

#: plinius-boot:323
msgid "Dynamic partitions (super)"
msgstr "Dynamische Partitionen (super)"

#: plinius-boot:324
msgid "ext4 file system"
msgstr "ext4-Dateisystem"

#: plinius-boot:325
msgid "F2FS file system"
msgstr "F2FS-Dateisystem"

#: plinius-boot:326
msgid "Encrypted (LUKS)"
msgstr "Verschlüsselt (LUKS)"

#: plinius-boot:327
msgid "LVM volume"
msgstr "LVM-Datenträger"

#: plinius-boot:328
msgid "MediaTek image"
msgstr "MediaTek-Image"

#: plinius-boot:329
msgid "MediaTek preloader"
msgstr "MediaTek-Preloader"

#: plinius-boot:330
msgid "Device tree overlays"
msgstr "Device-Tree-Overlays"

#: plinius-boot:331
msgid "Device tree"
msgstr "Device-Tree"

#: plinius-boot:332
msgid "Partition table (GPT)"
msgstr "Partitionstabelle (GPT)"

#: plinius-boot:333
msgid "Program (ELF)"
msgstr "Programm (ELF)"

#: plinius-boot:334
msgid "Unknown data"
msgstr "Unbekannte Daten"

#: plinius-boot:337
msgid "in use (mounted)"
msgstr "in Benutzung (eingehängt)"

#: plinius-boot:338
msgid "in use by the system"
msgstr "vom System belegt"

#: plinius-boot:339
msgid "in use as swap"
msgstr "als Auslagerung belegt"

#: plinius-boot:342
msgid "Linux on the phone, USB network"
msgstr "Linux auf dem Telefon, USB-Netz"

#: plinius-boot:343
msgid "Rescue system, USB network"
msgstr "Rettungssystem, USB-Netz"

#: plinius-boot:344
msgid "Android, USB debugging"
msgstr "Android, USB-Debugging"

#: plinius-boot:345
msgid "Bootloader (fastboot)"
msgstr "Bootloader (fastboot)"

#: plinius-boot:346
msgid "MediaTek download mode"
msgstr "MediaTek-Download-Modus"

#: plinius-boot:348
msgid "Not connected"
msgstr "Nicht verbunden"

#: plinius-boot:646 plinius-boot:6352
#, python-brace-format
msgid "build {number}"
msgstr "Build {number}"

#: plinius-boot:650 plinius-boot:6353
#, python-brace-format
msgid "security patch {date}"
msgstr "Sicherheitspatch {date}"

#: plinius-boot:657
#, python-brace-format
msgid "Partition {name}"
msgstr "Partition {name}"

#: plinius-boot:659
#, python-brace-format
msgid "Slot {slot} (active)"
msgstr "Slot {slot} (aktiv)"

#: plinius-boot:659
#, python-brace-format
msgid "Slot {slot}"
msgstr "Slot {slot}"

#: plinius-boot:703
msgid "Not a regular file"
msgstr "Keine normale Datei"

#: plinius-boot:912 plinius-boot:5564 plinius-boot:5574 plinius-boot:5591
#: plinius-boot:5608 plinius-boot:5667 plinius-boot:5832 plinius-boot:7158
msgid "Rescue system"
msgstr "Rettungssystem"

#: plinius-boot:929
msgid "Talks to Android on the phone"
msgstr "Spricht mit Android auf dem Telefon"

#: plinius-boot:930
msgid "Talks to the phone's bootloader"
msgstr "Spricht mit dem Bootloader des Telefons"

#: plinius-boot:931
msgid "Talks to Linux and the rescue system on the phone"
msgstr "Spricht mit Linux und dem Rettungssystem auf dem Telefon"

#: plinius-boot:932
msgid "Creates the key for the rescue system"
msgstr "Erstellt den Schlüssel für das Rettungssystem"

#: plinius-boot:933
msgid "Finds the phone's USB network"
msgstr "Findet das USB-Netzwerk des Telefons"

#: plinius-boot:955
msgid "Not installed."
msgstr "Nicht installiert."

#: plinius-boot:957
msgid "Cannot be run."
msgstr "Lässt sich nicht ausführen."

#: plinius-boot:959
msgid "Does not answer."
msgstr "Antwortet nicht."

#: plinius-boot:961
#, python-brace-format
msgid "Does not work: {error}"
msgstr "Funktioniert nicht: {error}"

#: plinius-boot:1303 plinius-boot:3905 plinius-boot:3922 plinius-boot:4028
#: plinius-boot:4117 plinius-boot:4168 plinius-boot:4170 plinius-boot:4180
#: plinius-boot:4723
msgid "Reading the partition table"
msgstr "Lesen der Partitionstabelle"

#: plinius-boot:1347
msgid "Could not read the partition list."
msgstr "Die Partitionsliste ließ sich nicht lesen."

#: plinius-boot:1412 plinius-boot:5950
msgid "The phone was disconnected."
msgstr "Die Verbindung zum Telefon ist getrennt."

#: plinius-boot:1584 plinius-boot:8165
msgid "Bootloader"
msgstr "Bootloader"

#: plinius-boot:1640 plinius-boot:2634 plinius-boot:8835
msgid "Unknown phone"
msgstr "Unbekanntes Telefon"

#: plinius-boot:1711
msgid ""
"No administrator access. Log in with your password so the app can use sudo."
msgstr ""
"Keine Administratorrechte. Melde dich mit deinem Passwort an, damit die App "
"sudo nutzen kann."

#: plinius-boot:1721
msgid "Unlock the phone and allow USB debugging in the prompt shown there."
msgstr "Entsperre das Telefon und erlaube dort das USB-Debugging."

#: plinius-boot:1723
msgid "The phone is not ready yet."
msgstr "Das Telefon ist noch nicht bereit."

#: plinius-boot:1727
msgid ""
"Android does not allow reading the partitions without root. Restart the "
"phone into the bootloader and start the rescue system there, or start a "
"Linux system on the phone."
msgstr ""
"Android erlaubt das Lesen der Partitionen nur mit Root. Starte das Telefon "
"in den Bootloader neu und dort das Rettungssystem, oder starte ein Linux auf "
"dem Telefon."

#: plinius-boot:1736
msgid "In fastboot mode backups can only be restored, not created."
msgstr ""
"Im fastboot-Modus lassen sich Sicherungen nur einspielen, nicht erstellen."

#: plinius-boot:1739
msgid ""
"The bootloader is locked. Unlock it to start the rescue system or restore "
"backups."
msgstr ""
"Der Bootloader ist gesperrt. Entsperre ihn, um das Rettungssystem zu starten "
"oder Sicherungen einzuspielen."

#: plinius-boot:1741
msgid ""
"The bootloader does not report whether it is unlocked. Restoring is not "
"possible."
msgstr ""
"Der Bootloader meldet nicht, ob er entsperrt ist. Einspielen ist nicht "
"möglich."

#: plinius-boot:1839
msgid "Log in to read the partitions."
msgstr "Melde dich an, um die Partitionen zu lesen."

#: plinius-boot:1863
msgid ""
"The phone is in MediaTek download mode. This app cannot use this mode. "
"Disconnect the cable and hold the power button to restart the phone."
msgstr ""
"Das Telefon ist im MediaTek-Download-Modus. Diesen Modus kann die App nicht "
"nutzen. Zieh das Kabel ab und halte die Ein-/Aus-Taste gedrückt, um das "
"Telefon neu zu starten."

#: plinius-boot:1993 plinius-boot:1997
msgid "The rescue system is not built yet (rescue/mkrescue.sh)."
msgstr "Das Rettungssystem ist noch nicht gebaut (rescue/mkrescue.sh)."

#: plinius-boot:2015
msgid "This is not an Android boot image."
msgstr "Das ist kein Android-Boot-Image."

#: plinius-boot:2047
msgid "This boot image contains no kernel."
msgstr "Dieses Boot-Image enthält keinen Kernel."

#: plinius-boot:2065
#, python-brace-format
msgid "The boot image in the backup cannot be read ({error})."
msgstr "Das Boot-Image in der Sicherung kann nicht gelesen werden ({error})."

#: plinius-boot:2067
msgid "The boot image in the backup is damaged (checksum does not match)."
msgstr ""
"Das Boot-Image in der Sicherung ist beschädigt (Prüfsumme stimmt nicht)."

#: plinius-boot:2084
#, python-brace-format
msgid "{name} from the backup of {date}"
msgstr "{name} aus der Sicherung vom {date}"

#: plinius-boot:2101
#, python-brace-format
msgid "fastboot could not start the rescue system: {error}"
msgstr "fastboot konnte das Rettungssystem nicht starten: {error}"

#: plinius-boot:2109 plinius-boot:8300
msgid "Confirm on the phone: press Volume up to unlock."
msgstr "Bestätige am Telefon: Drück die Lauter-Taste, um zu entsperren."

#: plinius-boot:2113
#, python-brace-format
msgid "The bootloader was not unlocked: {error}"
msgstr "Der Bootloader wurde nicht entsperrt: {error}"

#: plinius-boot:2115
msgid "Waiting for the bootloader…"
msgstr "Warte auf den Bootloader …"

#: plinius-boot:2119
msgid ""
"The phone does not report itself as unlocked. If the question on the phone "
"was declined, start again. Otherwise restart the phone into the bootloader "
"and check it here again."
msgstr ""
"Das Telefon meldet sich nicht als entsperrt. Wurde die Frage am Telefon "
"abgelehnt, fang noch einmal an. Sonst starte das Telefon in den Bootloader "
"neu und prüfe es hier noch einmal."

#: plinius-boot:2124 plinius-boot:4392
msgid "Formatting the data partition…"
msgstr "Die Datenpartition wird formatiert …"

#: plinius-boot:2127
#, python-brace-format
msgid ""
"The bootloader is unlocked, but the data partition could not be formatted: "
"{error}\n"
"Run “fastboot -w” in the bootloader, otherwise Volla OS keeps restarting."
msgstr ""
"Der Bootloader ist entsperrt, aber die Datenpartition ließ sich nicht "
"formatieren: {error}\n"
"Führe im Bootloader „fastboot -w“ aus, sonst startet Volla OS immer wieder "
"neu."

#: plinius-boot:2185 plinius-boot:2188
msgid "This is not an update package (zip)."
msgstr "Das ist kein Updatepaket (zip)."

#: plinius-boot:2197 plinius-boot:2210 plinius-boot:2217 plinius-boot:2220
msgid "The update package has no usable payload.bin."
msgstr "Das Updatepaket enthält keine brauchbare payload.bin."

#: plinius-boot:2232 plinius-boot:2246
#, python-brace-format
msgid "{name} in the update package is too large."
msgstr "{name} im Updatepaket ist zu groß."

#: plinius-boot:2249 plinius-boot:2265 plinius-boot:2269
msgid "The update package is damaged (checksum does not match)."
msgstr "Das Updatepaket ist beschädigt (Prüfsumme stimmt nicht)."

#: plinius-boot:2258
#, python-brace-format
msgid ""
"This is an incremental update package; only full packages contain {name}."
msgstr ""
"Das ist ein inkrementelles Updatepaket; {name} steht nur in vollständigen "
"Paketen."

#: plinius-boot:2271
#, python-brace-format
msgid "The update package contains no {name}."
msgstr "Das Updatepaket enthält kein {name}."

#: plinius-boot:2365 plinius-boot:2437
msgid "Asking the update server…"
msgstr "Update-Server wird gefragt …"

#: plinius-boot:2369 plinius-boot:2440
#, python-brace-format
msgid "Downloading {name} from {package}…"
msgstr "{name} wird aus {package} geladen …"

#: plinius-boot:2388
#, python-brace-format
msgid ""
"{file} is not the original {name} of this phone: its checksum does not match "
"the one the phone expects."
msgstr ""
"{file} ist nicht das originale {name} dieses Telefons: Die Prüfsumme stimmt "
"nicht mit der überein, die das Telefon erwartet."

#: plinius-boot:2413
msgid "This is not an init_boot image."
msgstr "Das ist kein init_boot-Abbild."

#: plinius-boot:2427
msgid "The bootloader is locked."
msgstr "Der Bootloader ist gesperrt."

#: plinius-boot:2431
#, python-brace-format
msgid "This phone has no partition {name}."
msgstr "Dieses Telefon hat keine Partition {name}."

#: plinius-boot:2444
#, python-brace-format
msgid ""
"No {name} of this phone is known and the update server cannot be reached. "
"Without one the app could not write the original back later."
msgstr ""
"Von diesem Telefon ist kein {name} bekannt, und der Update-Server ist nicht "
"erreichbar. Ohne eines könnte die App das Original später nicht "
"zurückschreiben."

#: plinius-boot:2448
#, python-brace-format
msgid "The rescue system does not fit into {name}."
msgstr "Das Rettungssystem passt nicht in {name}."

#: plinius-boot:2455
#, python-brace-format
msgid "Writing the rescue system to {name}…"
msgstr "Rettungssystem wird nach {name} geschrieben …"

#: plinius-boot:2459 plinius-boot:2501
#, python-brace-format
msgid "fastboot could not write {name}: {error}"
msgstr "fastboot konnte {name} nicht schreiben: {error}"

#: plinius-boot:2469
msgid "The app does not know which partition holds the rescue system."
msgstr "Die App weiß nicht, in welcher Partition das Rettungssystem liegt."

#: plinius-boot:2472
msgid "The original does not match the checksum the phone expects."
msgstr "Das Original passt nicht zur Prüfsumme, die das Telefon erwartet."

#: plinius-boot:2476
msgid "Restarting into the bootloader…"
msgstr "Neustart in den Bootloader …"

#: plinius-boot:2481
msgid ""
"The phone did not appear in the bootloader. Start it there by hand (Power "
"and Volume down) and write the original back from the phone's page."
msgstr ""
"Das Telefon ist nicht im Bootloader aufgetaucht. Starte es dort von Hand "
"(Ein/Aus und Leiser) und schreibe das Original auf der Seite des Telefons "
"zurück."

#: plinius-boot:2489
#, python-brace-format
msgid ""
"The phone in the bootloader is not in the expected state (slot {slot}, "
"partition {name}). Nothing was written."
msgstr ""
"Das Telefon im Bootloader ist nicht im erwarteten Zustand (Slot {slot}, "
"Partition {name}). Es wurde nichts geschrieben."

#: plinius-boot:2496
#, python-brace-format
msgid "Writing the original {name}…"
msgstr "Originales {name} wird geschrieben …"

#: plinius-boot:2505
msgid "Starting the phone…"
msgstr "Telefon startet …"

#: plinius-boot:2716
msgid "Backup only. Restoring this area is not supported."
msgstr "Nur Sicherung. Diesen Bereich spielt die App nicht zurück."

#: plinius-boot:2718
msgid ""
"Holds the rescue system, not the original. Restoring it would keep the phone "
"from starting."
msgstr ""
"Enthält das Rettungssystem, nicht das Original. Zurückgeschrieben würde das "
"Telefon nicht mehr starten."

#: plinius-boot:2720
msgid "Not present on this phone."
msgstr "Gibt es auf diesem Telefon nicht."

#: plinius-boot:2722
msgid "The partition has a different size on this phone."
msgstr "Die Partition ist auf diesem Telefon anders groß."

#: plinius-boot:2724
msgid "In use by the running system. Restore it in fastboot mode."
msgstr "Vom laufenden System belegt. Spiele sie im fastboot-Modus ein."

#: plinius-boot:2727
msgid ""
"Belongs to another phone. Restoring it would copy that phone's IMEI and MAC "
"addresses."
msgstr ""
"Gehört zu einem anderen Telefon. Einspielen würde dessen IMEI und MAC-"
"Adressen kopieren."

#: plinius-boot:2744
#, python-brace-format
msgid ""
"A different phone is connected now (serial number {serial}). Nothing was "
"changed."
msgstr ""
"Inzwischen ist ein anderes Telefon verbunden (Seriennummer {serial}). Es "
"wurde nichts verändert."

#: plinius-boot:2889
#, python-brace-format
msgid "Saving {name} ({i} of {n})"
msgstr "Sichere {name} ({i} von {n})"

#: plinius-boot:2893 plinius-boot:2913 plinius-boot:2916 plinius-boot:2920
#, python-brace-format
msgid "Reading {name} failed: {error}"
msgstr "Lesen von {name} fehlgeschlagen: {error}"

#: plinius-boot:2894
msgid "the partition name is invalid or appears twice"
msgstr "der Partitionsname ist ungültig oder kommt doppelt vor"

#: plinius-boot:2914
msgid "the phone sent more data than the partition holds"
msgstr "das Telefon hat mehr Daten geschickt, als die Partition enthält"

#: plinius-boot:2917 plinius-boot:3552 plinius-boot:3572 plinius-boot:4146
msgid "the data is incomplete"
msgstr "die Daten sind unvollständig"

#: plinius-boot:2921
msgid "the checksum on the phone does not match"
msgstr "die Prüfsumme auf dem Telefon stimmt nicht"

#: plinius-boot:2931
#, python-brace-format
msgid "{name}: {size}, saved as {file}"
msgstr "{name}: {size}, gespeichert als {file}"

#: plinius-boot:2941 plinius-boot:2987
#, python-brace-format
msgid "Checking {name} ({i} of {n})"
msgstr "Prüfe {name} ({i} von {n})"

#: plinius-boot:2956
#, python-brace-format
msgid "{name}: checksum does not match"
msgstr "{name}: Prüfsumme stimmt nicht"

#: plinius-boot:2959
#, python-brace-format
msgid "{name}: OK"
msgstr "{name}: in Ordnung"

#: plinius-boot:2970 plinius-boot:5853 plinius-boot:6128 plinius-boot:6129
msgid "Reading the partition list…"
msgstr "Partitionsliste wird gelesen …"

#: plinius-boot:2974 plinius-boot:6113
#, python-brace-format
msgid ""
"This backup belongs to a {backup}, but the connected phone is a {device}."
msgstr ""
"Diese Sicherung stammt von einem {backup}, angeschlossen ist aber ein "
"{device}."

#: plinius-boot:2979
#, python-brace-format
msgid "{name}: {problem} Nothing was written."
msgstr "{name}: {problem} Es wurde nichts geschrieben."

#: plinius-boot:2997
#, python-brace-format
msgid ""
"The backup of {name} is damaged (the file is too large). Nothing was written "
"to this partition."
msgstr ""
"Die Sicherung von {name} ist beschädigt (die Datei ist zu groß). Auf diese "
"Partition wurde nichts geschrieben."

#: plinius-boot:3000
#, python-brace-format
msgid "Not enough free space in {dir} for a temporary copy of {name}."
msgstr ""
"In {dir} ist nicht genug Platz für eine vorübergehende Kopie von {name}."

#: plinius-boot:3017
#, python-brace-format
msgid ""
"The backup of {name} cannot be read ({error}). Nothing was written to this "
"partition."
msgstr ""
"Die Sicherung von {name} lässt sich nicht lesen ({error}). Auf diese "
"Partition wurde nichts geschrieben."

#: plinius-boot:3022
#, python-brace-format
msgid ""
"The backup of {name} is damaged (checksum does not match). Nothing was "
"written to this partition."
msgstr ""
"Die Sicherung von {name} ist beschädigt (Prüfsumme stimmt nicht). Auf diese "
"Partition wurde nichts geschrieben."

#: plinius-boot:3025
#, python-brace-format
msgid "Writing {name} ({i} of {n})"
msgstr "Schreibe {name} ({i} von {n})"

#: plinius-boot:3034
#, python-brace-format
msgid "fastboot could not write {name}."
msgstr "fastboot konnte {name} nicht schreiben."

#: plinius-boot:3048 plinius-boot:4145
#, python-brace-format
msgid "Writing {name} failed: {error}"
msgstr "Schreiben von {name} fehlgeschlagen: {error}"

#: plinius-boot:3050 plinius-boot:4147
#, python-brace-format
msgid "Verifying {name} on the phone"
msgstr "Vergleiche {name} auf dem Telefon"

#: plinius-boot:3053
#, python-brace-format
msgid ""
"{name} was written, but the content on the phone does not match the backup."
msgstr ""
"{name} wurde geschrieben, aber der Inhalt auf dem Telefon stimmt nicht mit "
"der Sicherung überein."

#: plinius-boot:3055
#, python-brace-format
msgid "{name}: written and verified"
msgstr "{name}: geschrieben und geprüft"

#: plinius-boot:3278
#, python-brace-format
msgid ""
"This image needs {need}, but partition {number} holds {size}. Nothing was "
"changed."
msgstr ""
"Dieses Image braucht {need}, Partition {number} fasst aber nur {size}. Es "
"wurde nichts verändert."

#: plinius-boot:3281
#, python-brace-format
msgid ""
"This image has blocks of {size} bytes, and the phone's own storage needs "
"{need}. It would not start there. Nothing was changed."
msgstr ""
"Dieses Image hat Blöcke von {size} Byte, der Speicher des Telefons braucht "
"{need}. Es würde dort nicht starten. Es wurde nichts geändert."

#: plinius-boot:3297
#, python-brace-format
msgid "This image lacks {name}, so it cannot start on this phone."
msgstr ""
"Diesem Image fehlt {name}, deshalb kann es auf diesem Telefon nicht starten."

#: plinius-boot:3301
msgid "This image has no os-release, so it is not a Linux system."
msgstr "Dieses Image hat kein os-release, es ist also kein Linux-System."

#: plinius-boot:3308
msgid "This image is incomplete."
msgstr "Dieses Image ist unvollständig."

#: plinius-boot:3310
#, python-brace-format
msgid "This is not a usable ext4 image ({error})."
msgstr "Das ist kein brauchbares ext4-Image ({error})."

#: plinius-boot:3324
#, python-brace-format
msgid "Not enough free space in {dir} to unpack it."
msgstr "In {dir} ist nicht genug Platz zum Entpacken."

#: plinius-boot:3337
#, python-brace-format
msgid "This image does not bring {name}, so it can only go on the memory card."
msgstr ""
"Dieses Image bringt {name} nicht mit und kann deshalb nur auf die "
"Speicherkarte."

#: plinius-boot:3341
#, python-brace-format
msgid "{name} in this image is not a boot image."
msgstr "{name} in diesem Image ist kein Boot-Image."

#: plinius-boot:3344
#, python-brace-format
msgid ""
"{name} in this image still names a system partition, so the system on the "
"data partition would never start."
msgstr ""
"{name} in diesem Image nennt noch eine Systempartition, das System auf der "
"Datenpartition würde also nie starten."

#: plinius-boot:3366 plinius-boot:3911 plinius-boot:3960 plinius-boot:4040
