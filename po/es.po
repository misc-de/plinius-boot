#: plinius-boot:269
msgid "Phone Backups"
msgstr "Copias del teléfono"

#: plinius-boot:293
msgid "Device identity"
msgstr "Identidad del dispositivo"

#: plinius-boot:294
msgid ""
"IMEI, MAC addresses and calibration. Unique to this phone and not available "
"for download anywhere. Keep this backup safe."
msgstr ""
"IMEI, direcciones MAC y calibración. Son exclusivos de este teléfono y no se "
"pueden descargar de ningún sitio. Guarda bien esta copia de seguridad."

#: plinius-boot:296
msgid "Boot chain and firmware"
msgstr "Cadena de arranque y firmware"

#: plinius-boot:296
msgid "Bootloader, kernel, modem and other firmware."
msgstr "Bootloader, kernel, módem y otro firmware."

#: plinius-boot:297 plinius-boot:660 plinius-boot:5670 plinius-boot:6237
#: plinius-boot:6556 plinius-boot:6605 plinius-boot:7062 plinius-boot:7095
#: plinius-boot:7099 plinius-boot:7125
msgid "System"
msgstr "Sistema"

#: plinius-boot:297
msgid "The Android system and vendor partitions."
msgstr "Las particiones del sistema Android y del fabricante (vendor)."

#: plinius-boot:298 plinius-boot:6556 plinius-boot:7062
msgid "User data"
msgstr "Datos de usuario"

#: plinius-boot:298
msgid "Your files, apps and settings. Very large and often encrypted."
msgstr "Tus archivos, aplicaciones y ajustes. Muy grandes y a menudo cifrados."

#: plinius-boot:299 plinius-boot:6564 plinius-boot:6566 plinius-boot:6928
#: plinius-boot:7100 plinius-boot:7152 plinius-boot:7190 plinius-boot:8364
msgid "Memory card"
msgstr "Tarjeta de memoria"

#: plinius-boot:299
msgid ""
"Systems on the memory card, for example Ubuntu Touch or Arch via multi-boot."
msgstr ""
"Sistemas en la tarjeta de memoria, por ejemplo Ubuntu Touch o Arch mediante "
"arranque múltiple."

#: plinius-boot:300
msgid "Logs"
msgstr "Registros"

#: plinius-boot:300
msgid "Crash logs and temporary data, usually not needed."
msgstr "Registros de fallos y datos temporales; normalmente no hacen falta."

#: plinius-boot:316
msgid "Not checked"
msgstr "Sin comprobar"

#: plinius-boot:317
msgid "Probably empty"
msgstr "Probablemente sin datos"

#: plinius-boot:318
msgid "Android boot image"
msgstr "Imagen de arranque de Android"

#: plinius-boot:319
msgid "Android init boot image"
msgstr "Imagen init boot de Android"

#: plinius-boot:320
msgid "Vendor boot image"
msgstr "Imagen vendor boot"

#: plinius-boot:321
msgid "Verified boot metadata"
msgstr "Metadatos de Verified Boot"

#: plinius-boot:322
msgid "Android sparse image"
msgstr "Imagen sparse de Android"

#: plinius-boot:323
msgid "Dynamic partitions (super)"
msgstr "Particiones dinámicas (super)"

#: plinius-boot:324
msgid "ext4 file system"
msgstr "Sistema de archivos ext4"

#: plinius-boot:325
msgid "F2FS file system"
msgstr "Sistema de archivos F2FS"

#: plinius-boot:326
msgid "Encrypted (LUKS)"
msgstr "Cifrado (LUKS)"

#: plinius-boot:327
msgid "LVM volume"
msgstr "Volumen LVM"

#: plinius-boot:328
msgid "MediaTek image"
msgstr "Imagen de MediaTek"

#: plinius-boot:329
msgid "MediaTek preloader"
msgstr "Preloader de MediaTek"

#: plinius-boot:330
msgid "Device tree overlays"
msgstr "Overlays de device tree"

#: plinius-boot:331
msgid "Device tree"
msgstr "Device tree"

#: plinius-boot:332
msgid "Partition table (GPT)"
msgstr "Tabla de particiones (GPT)"

#: plinius-boot:333
msgid "Program (ELF)"
msgstr "Programa (ELF)"

#: plinius-boot:334
msgid "Unknown data"
msgstr "Datos desconocidos"

#: plinius-boot:337
msgid "in use (mounted)"
msgstr "en uso (montada)"

#: plinius-boot:338
msgid "in use by the system"
msgstr "en uso por el sistema"

#: plinius-boot:339
msgid "in use as swap"
msgstr "en uso como swap"

#: plinius-boot:342
msgid "Linux on the phone, USB network"
msgstr "Linux en el teléfono, red USB"

#: plinius-boot:343
msgid "Rescue system, USB network"
msgstr "Sistema de rescate, red USB"

#: plinius-boot:344
msgid "Android, USB debugging"
msgstr "Android, depuración USB"

#: plinius-boot:345
msgid "Bootloader (fastboot)"
msgstr "Bootloader (fastboot)"

#: plinius-boot:346
msgid "MediaTek download mode"
msgstr "Modo de descarga de MediaTek"

#: plinius-boot:348
msgid "Not connected"
msgstr "No conectado"

#: plinius-boot:646 plinius-boot:6549
#, python-brace-format
msgid "build {number}"
msgstr "compilación {number}"

#: plinius-boot:650 plinius-boot:6550
#, python-brace-format
msgid "security patch {date}"
msgstr "parche de seguridad {date}"

#: plinius-boot:657
#, python-brace-format
msgid "Partition {name}"
msgstr "Partición {name}"

#: plinius-boot:659
#, python-brace-format
msgid "Slot {slot} (active)"
msgstr "Ranura {slot} (activa)"

#: plinius-boot:659
#, python-brace-format
msgid "Slot {slot}"
msgstr "Ranura {slot}"

#: plinius-boot:703
msgid "Not a regular file"
msgstr "No es un archivo normal"

#: plinius-boot:912 plinius-boot:5761 plinius-boot:5771 plinius-boot:5788
#: plinius-boot:5805 plinius-boot:5864 plinius-boot:6029 plinius-boot:7355
msgid "Rescue system"
msgstr "Sistema de rescate"

#: plinius-boot:929
msgid "Talks to Android on the phone"
msgstr "Se comunica con Android en el teléfono"

#: plinius-boot:930
msgid "Talks to the phone's bootloader"
msgstr "Se comunica con el bootloader del teléfono"

#: plinius-boot:931
msgid "Talks to Linux and the rescue system on the phone"
msgstr "Se comunica con Linux y el sistema de rescate en el teléfono"

#: plinius-boot:932
msgid "Creates the key for the rescue system"
msgstr "Crea la clave para el sistema de rescate"

#: plinius-boot:933
msgid "Finds the phone's USB network"
msgstr "Encuentra la red USB del teléfono"

#: plinius-boot:955
msgid "Not installed."
msgstr "No instalado."

#: plinius-boot:957
msgid "Cannot be run."
msgstr "No se puede ejecutar."

#: plinius-boot:959
msgid "Does not answer."
msgstr "No responde."

#: plinius-boot:961
#, python-brace-format
msgid "Does not work: {error}"
msgstr "No funciona: {error}"

#: plinius-boot:1303 plinius-boot:3941 plinius-boot:3958 plinius-boot:4064
#: plinius-boot:4155 plinius-boot:4158 plinius-boot:4209 plinius-boot:4211
#: plinius-boot:4221 plinius-boot:4770
msgid "Reading the partition table"
msgstr "La lectura de la tabla de particiones"

#: plinius-boot:1347
msgid "Could not read the partition list."
msgstr "No se pudo leer la lista de particiones."

#: plinius-boot:1426 plinius-boot:6147
msgid "The phone was disconnected."
msgstr "Se ha perdido la conexión con el teléfono."

#: plinius-boot:1602 plinius-boot:8362
msgid "Bootloader"
msgstr "Bootloader"

#: plinius-boot:1661 plinius-boot:2665 plinius-boot:9033
msgid "Unknown phone"
msgstr "Teléfono desconocido"

#: plinius-boot:1732
msgid ""
"No administrator access. Log in with your password so the app can use sudo."
msgstr ""
"Sin acceso de administrador. Inicia sesión con tu contraseña para que la "
"aplicación pueda usar sudo."

#: plinius-boot:1742
msgid "Unlock the phone and allow USB debugging in the prompt shown there."
msgstr ""
"Desbloquea el teléfono y permite la depuración USB en el aviso que aparece "
"en él."

#: plinius-boot:1744
msgid "The phone is not ready yet."
msgstr "El teléfono aún no está listo."

#: plinius-boot:1748
msgid ""
"Android does not allow reading the partitions without root. Restart the "
"phone into the bootloader and start the rescue system there, or start a "
"Linux system on the phone."
msgstr ""
"Android no permite leer las particiones sin root. Reinicia el teléfono en el "
"bootloader y arranca allí el sistema de rescate, o arranca un sistema Linux "
"en el teléfono."

#: plinius-boot:1757
msgid "In fastboot mode backups can only be restored, not created."
msgstr ""
"En el modo fastboot las copias de seguridad solo se pueden restaurar, no "
"crear."

#: plinius-boot:1760
msgid ""
"The bootloader is locked. Unlock it to start the rescue system or restore "
"backups."
msgstr ""
"El bootloader está bloqueado. Desbloquéalo para arrancar el sistema de "
"rescate o restaurar copias de seguridad."

#: plinius-boot:1762
msgid ""
"The bootloader does not report whether it is unlocked. Restoring is not "
"possible."
msgstr "El bootloader no indica si está desbloqueado. No es posible restaurar."

#: plinius-boot:1863
msgid ""
"Its system lets in SSH keys only, no password. Start the bootloader on the "
"phone; the app then starts the rescue system there."
msgstr ""
"Su sistema solo admite claves SSH, no contraseñas. Inicia el bootloader en "
"el teléfono; la aplicación arrancará allí el sistema de rescate."

#: plinius-boot:1866
msgid "Log in to read the partitions."
msgstr "Inicia sesión para leer las particiones."

#: plinius-boot:1890
msgid ""
"The phone is in MediaTek download mode. This app cannot use this mode. "
"Disconnect the cable and hold the power button to restart the phone."
msgstr ""
"El teléfono está en modo de descarga de MediaTek. Esta aplicación no puede "
"usar este modo. Desconecta el cable y mantén pulsado el botón de encendido "
"para reiniciar el teléfono."

#: plinius-boot:2020 plinius-boot:2024
msgid "The rescue system is not built yet (rescue/mkrescue.sh)."
msgstr "El sistema de rescate aún no está compilado (rescue/mkrescue.sh)."

#: plinius-boot:2042
msgid "This is not an Android boot image."
msgstr "Esto no es una imagen de arranque de Android."

#: plinius-boot:2074
msgid "This boot image contains no kernel."
msgstr "Esta imagen de arranque no contiene ningún kernel."

#: plinius-boot:2092
#, python-brace-format
msgid "The boot image in the backup cannot be read ({error})."
msgstr ""
"No se puede leer la imagen de arranque de la copia de seguridad ({error})."

#: plinius-boot:2094
msgid "The boot image in the backup is damaged (checksum does not match)."
msgstr ""
"La imagen de arranque de la copia de seguridad está dañada (la suma de "
"comprobación no coincide)."

#: plinius-boot:2111
#, python-brace-format
msgid "{name} from the backup of {date}"
msgstr "{name} de la copia de seguridad del {date}"

#: plinius-boot:2128
#, python-brace-format
msgid "fastboot could not start the rescue system: {error}"
msgstr "fastboot no pudo arrancar el sistema de rescate: {error}"

#: plinius-boot:2136 plinius-boot:8497
msgid "Confirm on the phone: press Volume up to unlock."
msgstr "Confirma en el teléfono: pulsa Subir volumen para desbloquear."

#: plinius-boot:2140
#, python-brace-format
msgid "The bootloader was not unlocked: {error}"
msgstr "El bootloader no se ha desbloqueado: {error}"

#: plinius-boot:2142
msgid "Waiting for the bootloader…"
msgstr "Esperando al bootloader…"

#: plinius-boot:2146
msgid ""
"The phone does not report itself as unlocked. If the question on the phone "
"was declined, start again. Otherwise restart the phone into the bootloader "
"and check it here again."
msgstr ""
"El teléfono no indica que esté desbloqueado. Si se rechazó la pregunta en el "
"teléfono, vuelve a empezar. Si no, reinicia el teléfono en el bootloader y "
"vuelve a comprobarlo aquí."

#: plinius-boot:2151 plinius-boot:4439
msgid "Formatting the data partition…"
msgstr "Formateando la partición de datos…"

#: plinius-boot:2154
#, python-brace-format
msgid ""
"The bootloader is unlocked, but the data partition could not be formatted: "
"{error}\n"
"Run “fastboot -w” in the bootloader, otherwise Volla OS keeps restarting."
msgstr ""
"El bootloader está desbloqueado, pero no se pudo formatear la partición de "
"datos: {error}\n"
"Ejecuta «fastboot -w» en el bootloader; si no, Volla OS se reiniciará una y "
"otra vez."

#: plinius-boot:2212 plinius-boot:2215
msgid "This is not an update package (zip)."
msgstr "Esto no es un paquete de actualización (zip)."

#: plinius-boot:2224 plinius-boot:2237 plinius-boot:2244 plinius-boot:2247
msgid "The update package has no usable payload.bin."
msgstr "El paquete de actualización no tiene un payload.bin utilizable."

#: plinius-boot:2259 plinius-boot:2273
#, python-brace-format
msgid "{name} in the update package is too large."
msgstr "{name} en el paquete de actualización es demasiado grande."

#: plinius-boot:2276 plinius-boot:2292 plinius-boot:2296
msgid "The update package is damaged (checksum does not match)."
msgstr ""
"El paquete de actualización está dañado (la suma de comprobación no "
"coincide)."

#: plinius-boot:2285
#, python-brace-format
msgid ""
"This is an incremental update package; only full packages contain {name}."
msgstr ""
"Es un paquete de actualización incremental; solo los paquetes completos "
"contienen {name}."

#: plinius-boot:2298
#, python-brace-format
msgid "The update package contains no {name}."
msgstr "El paquete de actualización no contiene {name}."

#: plinius-boot:2392 plinius-boot:2464
msgid "Asking the update server…"
msgstr "Consultando el servidor de actualizaciones…"

#: plinius-boot:2396 plinius-boot:2467
#, python-brace-format
msgid "Downloading {name} from {package}…"
msgstr "Descargando {name} de {package}…"

#: plinius-boot:2415
#, python-brace-format
msgid ""
"{file} is not the original {name} of this phone: its checksum does not match "
"the one the phone expects."
msgstr ""
"{file} no es el {name} original de este teléfono: su suma de comprobación no "
"coincide con la que espera el teléfono."

#: plinius-boot:2440
msgid "This is not an init_boot image."
msgstr "Esto no es una imagen init_boot."

#: plinius-boot:2454
msgid "The bootloader is locked."
msgstr "El bootloader está bloqueado."

#: plinius-boot:2458
#, python-brace-format
msgid "This phone has no partition {name}."
msgstr "Este teléfono no tiene la partición {name}."

#: plinius-boot:2471
#, python-brace-format
msgid ""
"No {name} of this phone is known and the update server cannot be reached. "
"Without one the app could not write the original back later."
msgstr ""
"No se conoce ningún {name} de este teléfono y no se puede acceder al "
"servidor de actualizaciones. Sin él, la aplicación no podría restaurar el "
"original después."

#: plinius-boot:2475
#, python-brace-format
msgid "The rescue system does not fit into {name}."
msgstr "El sistema de rescate no cabe en {name}."

#: plinius-boot:2482
#, python-brace-format
msgid "Writing the rescue system to {name}…"
msgstr "Escribiendo el sistema de rescate en {name}…"

#: plinius-boot:2486 plinius-boot:2532
#, python-brace-format
msgid "fastboot could not write {name}: {error}"
msgstr "fastboot no pudo escribir {name}: {error}"

#: plinius-boot:2496
msgid "The app does not know which partition holds the rescue system."
msgstr "La aplicación no sabe qué partición contiene el sistema de rescate."

#: plinius-boot:2499
msgid "The original does not match the checksum the phone expects."
msgstr ""
"El original no coincide con la suma de comprobación que espera el teléfono."

#: plinius-boot:2502
msgid ""
"The image to write back is this app's rescue system, not the original. "
"Nothing was written."
msgstr ""
"La imagen que se iba a escribir es el sistema de rescate de esta app, no el "
"original. No se ha escrito nada."

#: plinius-boot:2507 plinius-boot:5297
msgid "Restarting into the bootloader…"
msgstr "Reiniciando en el bootloader…"

#: plinius-boot:2512
msgid ""
"The phone did not appear in the bootloader. Start it there by hand (Power "
"and Volume down) and write the original back from the phone's page."
msgstr ""
"El teléfono no apareció en el bootloader. Inícialo allí a mano (encendido y "
"bajar volumen) y restaura el original desde la página del teléfono."

#: plinius-boot:2520
#, python-brace-format
msgid ""
"The phone in the bootloader is not in the expected state (slot {slot}, "
"partition {name}). Nothing was written."
msgstr ""
"El teléfono en el bootloader no está en el estado esperado (ranura {slot}, "
"partición {name}). No se escribió nada."

#: plinius-boot:2527
#, python-brace-format
msgid "Writing the original {name}…"
msgstr "Escribiendo el {name} original…"

#: plinius-boot:2536 plinius-boot:5297
msgid "Starting the phone…"
msgstr "Iniciando el teléfono…"

#: plinius-boot:2747
msgid "Backup only. Restoring this area is not supported."
msgstr "Solo copia de seguridad. No se admite restaurar esta área."

#: plinius-boot:2749
msgid ""
"Holds the rescue system, not the original. Restoring it would keep the phone "
"from starting."
msgstr ""
"Contiene el sistema de rescate, no el original. Restaurarlo impediría que el "
"teléfono arranque."

#: plinius-boot:2751
msgid "Not present on this phone."
msgstr "No existe en este teléfono."

#: plinius-boot:2753
msgid "The partition has a different size on this phone."
msgstr "La partición tiene otro tamaño en este teléfono."

#: plinius-boot:2755
msgid "In use by the running system. Restore it in fastboot mode."
msgstr "En uso por el sistema en ejecución. Restáurala en modo fastboot."

#: plinius-boot:2758
msgid ""
"Belongs to another phone. Restoring it would copy that phone's IMEI and MAC "
"addresses."
msgstr ""
"Pertenece a otro teléfono. Restaurarla copiaría el IMEI y las direcciones "
"MAC de ese teléfono."

#: plinius-boot:2775
#, python-brace-format
msgid ""
"A different phone is connected now (serial number {serial}). Nothing was "
"changed."
msgstr ""
"Ahora hay otro teléfono conectado (número de serie {serial}). No se ha "
"cambiado nada."

#: plinius-boot:2925
#, python-brace-format
msgid "Saving {name} ({i} of {n})"
msgstr "Guardando {name} ({i} de {n})"

#: plinius-boot:2929 plinius-boot:2949 plinius-boot:2952 plinius-boot:2956
#, python-brace-format
msgid "Reading {name} failed: {error}"
msgstr "Error al leer {name}: {error}"

#: plinius-boot:2930
msgid "the partition name is invalid or appears twice"
msgstr "el nombre de la partición no es válido o aparece dos veces"

#: plinius-boot:2950
msgid "the phone sent more data than the partition holds"
msgstr "el teléfono envió más datos de los que contiene la partición"

#: plinius-boot:2953 plinius-boot:3588 plinius-boot:3608 plinius-boot:4187
msgid "the data is incomplete"
msgstr "los datos están incompletos"

#: plinius-boot:2957
msgid "the checksum on the phone does not match"
msgstr "la suma de comprobación en el teléfono no coincide"

#: plinius-boot:2967
#, python-brace-format
msgid "{name}: {size}, saved as {file}"
msgstr "{name}: {size}, guardado como {file}"

#: plinius-boot:2977 plinius-boot:3023
#, python-brace-format
msgid "Checking {name} ({i} of {n})"
msgstr "Comprobando {name} ({i} de {n})"

#: plinius-boot:2992
#, python-brace-format
msgid "{name}: checksum does not match"
msgstr "{name}: la suma de comprobación no coincide"

#: plinius-boot:2995
#, python-brace-format
msgid "{name}: OK"
msgstr "{name}: correcto"

#: plinius-boot:3006 plinius-boot:6050 plinius-boot:6325 plinius-boot:6326
msgid "Reading the partition list…"
msgstr "Leyendo la lista de particiones…"

#: plinius-boot:3010 plinius-boot:6310
#, python-brace-format
msgid ""
"This backup belongs to a {backup}, but the connected phone is a {device}."
msgstr ""
"Esta copia de seguridad es de un {backup}, pero el teléfono conectado es un "
"{device}."

#: plinius-boot:3015
#, python-brace-format
msgid "{name}: {problem} Nothing was written."
msgstr "{name}: {problem} No se ha escrito nada."

#: plinius-boot:3033
#, python-brace-format
msgid ""
"The backup of {name} is damaged (the file is too large). Nothing was written "
"to this partition."
msgstr ""
"La copia de seguridad de {name} está dañada (el archivo es demasiado "
"grande). No se ha escrito nada en esta partición."

#: plinius-boot:3036
#, python-brace-format
msgid "Not enough free space in {dir} for a temporary copy of {name}."
msgstr ""
"No hay suficiente espacio libre en {dir} para una copia temporal de {name}."

#: plinius-boot:3053
#, python-brace-format
msgid ""
"The backup of {name} cannot be read ({error}). Nothing was written to this "
"partition."
msgstr ""
"No se puede leer la copia de seguridad de {name} ({error}). No se ha escrito "
"nada en esta partición."

#: plinius-boot:3058
#, python-brace-format
msgid ""
"The backup of {name} is damaged (checksum does not match). Nothing was "
"written to this partition."
msgstr ""
"La copia de seguridad de {name} está dañada (la suma de comprobación no "
"coincide). No se ha escrito nada en esta partición."

#: plinius-boot:3061
#, python-brace-format
msgid "Writing {name} ({i} of {n})"
msgstr "Escribiendo {name} ({i} de {n})"

#: plinius-boot:3070
#, python-brace-format
msgid "fastboot could not write {name}."
msgstr "fastboot no pudo escribir {name}."

#: plinius-boot:3084 plinius-boot:4186
#, python-brace-format
msgid "Writing {name} failed: {error}"
msgstr "Error al escribir {name}: {error}"

#: plinius-boot:3086 plinius-boot:4188
#, python-brace-format
msgid "Verifying {name} on the phone"
msgstr "Verificando {name} en el teléfono"

#: plinius-boot:3089
#, python-brace-format
msgid ""
"{name} was written, but the content on the phone does not match the backup."
msgstr ""
"Se ha escrito {name}, pero el contenido del teléfono no coincide con la "
"copia de seguridad."

#: plinius-boot:3091
#, python-brace-format
msgid "{name}: written and verified"
msgstr "{name}: escrito y verificado"

#: plinius-boot:3314
#, python-brace-format
msgid ""
"This image needs {need}, but partition {number} holds {size}. Nothing was "
"changed."
msgstr ""
"Esta imagen necesita {need}, pero la partición {number} tiene {size}. No se "
"ha cambiado nada."

#: plinius-boot:3317
#, python-brace-format
msgid ""
"This image has blocks of {size} bytes, and the phone's own storage needs "
"{need}. It would not start there. Nothing was changed."
msgstr ""
"Esta imagen tiene bloques de {size} bytes y el almacenamiento del teléfono "
"necesita {need}. Ahí no arrancaría. No se ha cambiado nada."

#: plinius-boot:3333
#, python-brace-format
msgid "This image lacks {name}, so it cannot start on this phone."
msgstr ""
"A esta imagen le falta {name}, así que no puede arrancar en este teléfono."

#: plinius-boot:3337
msgid "This image has no os-release, so it is not a Linux system."
msgstr "Esta imagen no tiene os-release, así que no es un sistema Linux."

#: plinius-boot:3344
msgid "This image is incomplete."
msgstr "Esta imagen está incompleta."

#: plinius-boot:3346
#, python-brace-format
msgid "This is not a usable ext4 image ({error})."
msgstr "Esta no es una imagen ext4 utilizable ({error})."

#: plinius-boot:3360
#, python-brace-format
msgid "Not enough free space in {dir} to unpack it."
