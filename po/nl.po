msgid "Log in to the phone"
msgstr "Aanmelden op de telefoon"

#: plinius-boot:9842
msgid ""
"Use the user name and password of the system on the phone. The password is "
"only kept while this app is running."
msgstr ""
"Gebruik de gebruikersnaam en het wachtwoord van het systeem op de telefoon. "
"Het wachtwoord wordt alleen bewaard zolang deze app draait."

#: plinius-boot:9844
msgid "Log in"
msgstr "Aanmelden"

#: plinius-boot:9868
msgid "Storage location for backups"
msgstr "Opslaglocatie voor back-ups"

#: plinius-boot:9887
msgid "Inspect image file"
msgstr "Imagebestand onderzoeken"

#: plinius-boot:9899
#, python-brace-format
msgid "Content: {kind}"
msgstr "Inhoud: {kind}"

#: plinius-boot:9900
#, python-brace-format
msgid "File size: {size}"
msgstr "Bestandsgrootte: {size}"

#: plinius-boot:9902
