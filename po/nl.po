#: plinius-boot:269
msgid "Phone Backups"
msgstr "Telefoonback-ups"

#: plinius-boot:293
msgid "Device identity"
msgstr "Apparaatidentiteit"

#: plinius-boot:294
msgid ""
"IMEI, MAC addresses and calibration. Unique to this phone and not available "
"for download anywhere. Keep this backup safe."
msgstr ""
"IMEI, MAC-adressen en kalibratie. Uniek voor deze telefoon en nergens te "
"downloaden. Bewaar deze back-up goed."

#: plinius-boot:296
msgid "Boot chain and firmware"
msgstr "Opstartketen en firmware"

#: plinius-boot:296
msgid "Bootloader, kernel, modem and other firmware."
msgstr "Bootloader, kernel, modem en andere firmware."

#: plinius-boot:297 plinius-boot:660 plinius-boot:5338 plinius-boot:5905
#: plinius-boot:6224 plinius-boot:6273 plinius-boot:6730 plinius-boot:6763
#: plinius-boot:6767 plinius-boot:6793
msgid "System"
msgstr "Systeem"

#: plinius-boot:297
msgid "The Android system and vendor partitions."
msgstr "De partities van het Android-systeem en van de fabrikant (vendor)."

#: plinius-boot:298 plinius-boot:6224 plinius-boot:6730
msgid "User data"
msgstr "Gebruikersgegevens"

#: plinius-boot:298
msgid "Your files, apps and settings. Very large and often encrypted."
msgstr "Je bestanden, apps en instellingen. Zeer groot en vaak versleuteld."

#: plinius-boot:299 plinius-boot:6232 plinius-boot:6234 plinius-boot:6596
#: plinius-boot:6768 plinius-boot:6820 plinius-boot:6858 plinius-boot:8022
msgid "Memory card"
msgstr "Geheugenkaart"

#: plinius-boot:299
msgid ""
"Systems on the memory card, for example Ubuntu Touch or Arch via multi-boot."
msgstr ""
"Systemen op de geheugenkaart, bijvoorbeeld Ubuntu Touch of Arch via "
"multiboot."

#: plinius-boot:300
msgid "Logs"
msgstr "Logboeken"

#: plinius-boot:300
msgid "Crash logs and temporary data, usually not needed."
msgstr "Crashlogboeken en tijdelijke gegevens, meestal niet nodig."

#: plinius-boot:316
msgid "Not checked"
msgstr "Niet gecontroleerd"

#: plinius-boot:317
msgid "Probably empty"
msgstr "Waarschijnlijk leeg"

#: plinius-boot:318
msgid "Android boot image"
msgstr "Android-bootimage"

#: plinius-boot:319
msgid "Android init boot image"
msgstr "Android-init-bootimage"

#: plinius-boot:320
msgid "Vendor boot image"
msgstr "Vendor-bootimage"

#: plinius-boot:321
msgid "Verified boot metadata"
msgstr "Metagegevens voor Verified Boot"

#: plinius-boot:322
msgid "Android sparse image"
msgstr "Android-sparse-image"

#: plinius-boot:323
msgid "Dynamic partitions (super)"
msgstr "Dynamische partities (super)"

#: plinius-boot:324
msgid "ext4 file system"
msgstr "ext4-bestandssysteem"

#: plinius-boot:325
msgid "F2FS file system"
msgstr "F2FS-bestandssysteem"

#: plinius-boot:326
msgid "Encrypted (LUKS)"
msgstr "Versleuteld (LUKS)"

#: plinius-boot:327
msgid "LVM volume"
msgstr "LVM-volume"

#: plinius-boot:328
msgid "MediaTek image"
msgstr "MediaTek-image"

#: plinius-boot:329
msgid "MediaTek preloader"
msgstr "MediaTek-preloader"

#: plinius-boot:330
msgid "Device tree overlays"
msgstr "Device-tree-overlays"

#: plinius-boot:331
msgid "Device tree"
msgstr "Device-tree"

#: plinius-boot:332
msgid "Partition table (GPT)"
msgstr "Partitietabel (GPT)"

#: plinius-boot:333
msgid "Program (ELF)"
msgstr "Programma (ELF)"

#: plinius-boot:334
msgid "Unknown data"
msgstr "Onbekende gegevens"

#: plinius-boot:337
msgid "in use (mounted)"
msgstr "in gebruik (aangekoppeld)"

#: plinius-boot:338
msgid "in use by the system"
msgstr "in gebruik door het systeem"

#: plinius-boot:339
msgid "in use as swap"
msgstr "in gebruik als swap"

#: plinius-boot:342
msgid "Linux on the phone, USB network"
msgstr "Linux op de telefoon, USB-netwerk"

#: plinius-boot:343
msgid "Rescue system, USB network"
msgstr "Reddingssysteem, USB-netwerk"

#: plinius-boot:344
msgid "Android, USB debugging"
msgstr "Android, USB-foutopsporing"

#: plinius-boot:345
msgid "Bootloader (fastboot)"
msgstr "Bootloader (fastboot)"

#: plinius-boot:346
msgid "MediaTek download mode"
msgstr "MediaTek-downloadmodus"

#: plinius-boot:348
msgid "Not connected"
msgstr "Niet verbonden"

#: plinius-boot:646 plinius-boot:6217
#, python-brace-format
msgid "build {number}"
msgstr "build {number}"

#: plinius-boot:650 plinius-boot:6218
#, python-brace-format
msgid "security patch {date}"
msgstr "beveiligingspatch {date}"

#: plinius-boot:657
#, python-brace-format
msgid "Partition {name}"
msgstr "Partitie {name}"

#: plinius-boot:659
#, python-brace-format
msgid "Slot {slot} (active)"
msgstr "Slot {slot} (actief)"

#: plinius-boot:659
#, python-brace-format
msgid "Slot {slot}"
msgstr "Slot {slot}"

#: plinius-boot:703
msgid "Not a regular file"
msgstr "Geen gewoon bestand"

#: plinius-boot:912 plinius-boot:5429 plinius-boot:5439 plinius-boot:5456
#: plinius-boot:5473 plinius-boot:5532 plinius-boot:5697 plinius-boot:7023
msgid "Rescue system"
msgstr "Reddingssysteem"

#: plinius-boot:929
msgid "Talks to Android on the phone"
msgstr "Communiceert met Android op de telefoon"

#: plinius-boot:930
msgid "Talks to the phone's bootloader"
msgstr "Communiceert met de bootloader van de telefoon"

#: plinius-boot:931
msgid "Talks to Linux and the rescue system on the phone"
msgstr "Communiceert met Linux en het reddingssysteem op de telefoon"

#: plinius-boot:932
msgid "Creates the key for the rescue system"
msgstr "Maakt de sleutel voor het reddingssysteem"

#: plinius-boot:933
msgid "Finds the phone's USB network"
msgstr "Vindt het USB-netwerk van de telefoon"

#: plinius-boot:955
msgid "Not installed."
msgstr "Niet geïnstalleerd."

#: plinius-boot:957
msgid "Cannot be run."
msgstr "Kan niet worden uitgevoerd."

#: plinius-boot:959
msgid "Does not answer."
msgstr "Reageert niet."

#: plinius-boot:961
#, python-brace-format
msgid "Does not work: {error}"
msgstr "Werkt niet: {error}"

#: plinius-boot:1268
msgid "Could not read the partition list."
msgstr "Kan de partitielijst niet lezen."

#: plinius-boot:1333 plinius-boot:5815
msgid "The phone was disconnected."
msgstr "De verbinding met de telefoon is verbroken."

#: plinius-boot:1505 plinius-boot:8020
msgid "Bootloader"
msgstr "Bootloader"

#: plinius-boot:1561 plinius-boot:2555 plinius-boot:8668
msgid "Unknown phone"
msgstr "Onbekende telefoon"

#: plinius-boot:1632
msgid ""
"No administrator access. Log in with your password so the app can use sudo."
msgstr ""
"Geen beheerdersrechten. Meld je aan met je wachtwoord, zodat de app sudo kan "
"gebruiken."

#: plinius-boot:1642
msgid "Unlock the phone and allow USB debugging in the prompt shown there."
msgstr ""
"Ontgrendel de telefoon en sta USB-foutopsporing toe in de melding die daar "
"verschijnt."

#: plinius-boot:1644
msgid "The phone is not ready yet."
msgstr "De telefoon is nog niet gereed."

#: plinius-boot:1648
msgid ""
"Android does not allow reading the partitions without root. Restart the "
"phone into the bootloader and start the rescue system there, or start a "
"Linux system on the phone."
msgstr ""
"Android staat het lezen van de partities zonder root niet toe. Herstart de "
"telefoon in de bootloader en start daar het reddingssysteem, of start een "
"Linux-systeem op de telefoon."

#: plinius-boot:1657
msgid "In fastboot mode backups can only be restored, not created."
msgstr ""
"In fastboot-modus kunnen back-ups alleen worden teruggezet, niet gemaakt."

#: plinius-boot:1660
msgid ""
"The bootloader is locked. Unlock it to start the rescue system or restore "
"backups."
msgstr ""
"De bootloader is vergrendeld. Ontgrendel hem om het reddingssysteem te "
"starten of back-ups terug te zetten."

#: plinius-boot:1662
msgid ""
"The bootloader does not report whether it is unlocked. Restoring is not "
"possible."
msgstr ""
"De bootloader meldt niet of hij ontgrendeld is. Terugzetten is niet mogelijk."

#: plinius-boot:1760
msgid "Log in to read the partitions."
msgstr "Meld je aan om de partities te lezen."

#: plinius-boot:1784
msgid ""
"The phone is in MediaTek download mode. This app cannot use this mode. "
"Disconnect the cable and hold the power button to restart the phone."
msgstr ""
"De telefoon staat in MediaTek-downloadmodus. Deze app kan die modus niet "
"gebruiken. Koppel de kabel los en houd de aan/uit-knop ingedrukt om de "
"telefoon opnieuw te starten."

#: plinius-boot:1914 plinius-boot:1918
msgid "The rescue system is not built yet (rescue/mkrescue.sh)."
msgstr "Het reddingssysteem is nog niet gebouwd (rescue/mkrescue.sh)."

#: plinius-boot:1936
msgid "This is not an Android boot image."
msgstr "Dit is geen Android-bootimage."

#: plinius-boot:1968
msgid "This boot image contains no kernel."
msgstr "Deze bootimage bevat geen kernel."

#: plinius-boot:1986
#, python-brace-format
msgid "The boot image in the backup cannot be read ({error})."
msgstr "De bootimage in de back-up kan niet worden gelezen ({error})."

#: plinius-boot:1988
msgid "The boot image in the backup is damaged (checksum does not match)."
msgstr ""
"De bootimage in de back-up is beschadigd (controlesom komt niet overeen)."

#: plinius-boot:2005
#, python-brace-format
msgid "{name} from the backup of {date}"
msgstr "{name} uit de back-up van {date}"

#: plinius-boot:2022
#, python-brace-format
msgid "fastboot could not start the rescue system: {error}"
msgstr "fastboot kon het reddingssysteem niet starten: {error}"

#: plinius-boot:2030 plinius-boot:8154
msgid "Confirm on the phone: press Volume up to unlock."
msgstr "Bevestig op de telefoon: druk op volume omhoog om te ontgrendelen."

#: plinius-boot:2034
#, python-brace-format
msgid "The bootloader was not unlocked: {error}"
msgstr "De bootloader is niet ontgrendeld: {error}"

#: plinius-boot:2036
msgid "Waiting for the bootloader…"
msgstr "Wachten op de bootloader…"

#: plinius-boot:2040
msgid ""
"The phone does not report itself as unlocked. If the question on the phone "
"was declined, start again. Otherwise restart the phone into the bootloader "
"and check it here again."
msgstr ""
"De telefoon meldt niet dat hij ontgrendeld is. Is de vraag op de telefoon "
"geweigerd, begin dan opnieuw. Herstart anders de telefoon in de bootloader "
"en controleer het hier opnieuw."

#: plinius-boot:2045 plinius-boot:4277
msgid "Formatting the data partition…"
msgstr "De gegevenspartitie wordt geformatteerd…"

#: plinius-boot:2048
#, python-brace-format
msgid ""
"The bootloader is unlocked, but the data partition could not be formatted: "
"{error}\n"
"Run “fastboot -w” in the bootloader, otherwise Volla OS keeps restarting."
msgstr ""
"De bootloader is ontgrendeld, maar de gegevenspartitie kon niet worden "
"geformatteerd: {error}\n"
"Voer in de bootloader “fastboot -w” uit, anders blijft Volla OS steeds "
"opnieuw opstarten."

#: plinius-boot:2106 plinius-boot:2109
msgid "This is not an update package (zip)."
msgstr "Dit is geen updatepakket (zip)."

#: plinius-boot:2118 plinius-boot:2131 plinius-boot:2138 plinius-boot:2141
msgid "The update package has no usable payload.bin."
msgstr "Het updatepakket bevat geen bruikbare payload.bin."

#: plinius-boot:2153 plinius-boot:2167
#, python-brace-format
msgid "{name} in the update package is too large."
msgstr "{name} in het updatepakket is te groot."

#: plinius-boot:2170 plinius-boot:2186 plinius-boot:2190
msgid "The update package is damaged (checksum does not match)."
msgstr "Het updatepakket is beschadigd (controlesom komt niet overeen)."

#: plinius-boot:2179
#, python-brace-format
msgid ""
"This is an incremental update package; only full packages contain {name}."
msgstr ""
"Dit is een incrementeel updatepakket; alleen volledige pakketten bevatten "
"{name}."

#: plinius-boot:2192
#, python-brace-format
msgid "The update package contains no {name}."
msgstr "Het updatepakket bevat geen {name}."

#: plinius-boot:2286 plinius-boot:2358
msgid "Asking the update server…"
msgstr "Updateserver wordt bevraagd…"

#: plinius-boot:2290 plinius-boot:2361
#, python-brace-format
msgid "Downloading {name} from {package}…"
msgstr "{name} wordt gedownload uit {package}…"

#: plinius-boot:2309
#, python-brace-format
msgid ""
"{file} is not the original {name} of this phone: its checksum does not match "
"the one the phone expects."
msgstr ""
"{file} is niet de originele {name} van deze telefoon: de controlesom komt "
"niet overeen met wat de telefoon verwacht."

#: plinius-boot:2334
msgid "This is not an init_boot image."
msgstr "Dit is geen init_boot-image."

#: plinius-boot:2348
msgid "The bootloader is locked."
msgstr "De bootloader is vergrendeld."

#: plinius-boot:2352
#, python-brace-format
msgid "This phone has no partition {name}."
msgstr "Deze telefoon heeft geen partitie {name}."

#: plinius-boot:2365
#, python-brace-format
msgid ""
"No {name} of this phone is known and the update server cannot be reached. "
"Without one the app could not write the original back later."
msgstr ""
"Er is geen {name} van deze telefoon bekend en de updateserver is niet "
"bereikbaar. Zonder kan de app het origineel later niet terugschrijven."

#: plinius-boot:2369
#, python-brace-format
msgid "The rescue system does not fit into {name}."
msgstr "Het reddingssysteem past niet in {name}."

#: plinius-boot:2376
#, python-brace-format
msgid "Writing the rescue system to {name}…"
msgstr "Reddingssysteem wordt naar {name} geschreven…"

#: plinius-boot:2380 plinius-boot:2422
#, python-brace-format
msgid "fastboot could not write {name}: {error}"
msgstr "fastboot kon {name} niet schrijven: {error}"

#: plinius-boot:2390
msgid "The app does not know which partition holds the rescue system."
msgstr "De app weet niet welke partitie het reddingssysteem bevat."

#: plinius-boot:2393
msgid "The original does not match the checksum the phone expects."
msgstr ""
"Het origineel komt niet overeen met de controlesom die de telefoon verwacht."

#: plinius-boot:2397
msgid "Restarting into the bootloader…"
msgstr "Herstarten in bootloader…"

#: plinius-boot:2402
msgid ""
"The phone did not appear in the bootloader. Start it there by hand (Power "
"and Volume down) and write the original back from the phone's page."
msgstr ""
"De telefoon is niet in de bootloader verschenen. Start hem daar handmatig "
"(Aan/uit en Volume omlaag) en schrijf het origineel terug vanaf de pagina "
"van de telefoon."

#: plinius-boot:2410
#, python-brace-format
msgid ""
"The phone in the bootloader is not in the expected state (slot {slot}, "
"partition {name}). Nothing was written."
msgstr ""
"De telefoon in de bootloader is niet in de verwachte toestand (slot {slot}, "
"partitie {name}). Er is niets geschreven."

#: plinius-boot:2417
#, python-brace-format
msgid "Writing the original {name}…"
msgstr "Originele {name} wordt geschreven…"

#: plinius-boot:2426
msgid "Starting the phone…"
msgstr "Telefoon wordt gestart…"

#: plinius-boot:2637
msgid "Backup only. Restoring this area is not supported."
msgstr "Alleen back-up. Dit gebied terugzetten wordt niet ondersteund."

#: plinius-boot:2639
msgid ""
"Holds the rescue system, not the original. Restoring it would keep the phone "
"from starting."
msgstr ""
"Bevat het reddingssysteem, niet het origineel. Terugzetten zou de telefoon "
"niet meer laten opstarten."

#: plinius-boot:2641
msgid "Not present on this phone."
msgstr "Niet aanwezig op deze telefoon."

#: plinius-boot:2643
msgid "The partition has a different size on this phone."
msgstr "De partitie heeft op deze telefoon een andere grootte."

#: plinius-boot:2645
msgid "In use by the running system. Restore it in fastboot mode."
msgstr ""
"In gebruik door het draaiende systeem. Zet deze terug in fastboot-modus."

#: plinius-boot:2648
msgid ""
"Belongs to another phone. Restoring it would copy that phone's IMEI and MAC "
"addresses."
msgstr ""
"Hoort bij een andere telefoon. Terugzetten zou de IMEI en MAC-adressen van "
"die telefoon kopiëren."

#: plinius-boot:2665
#, python-brace-format
msgid ""
"A different phone is connected now (serial number {serial}). Nothing was "
"changed."
msgstr ""
"Er is nu een andere telefoon verbonden (serienummer {serial}). Er is niets "
"gewijzigd."

#: plinius-boot:2805
#, python-brace-format
msgid "Saving {name} ({i} of {n})"
msgstr "{name} wordt opgeslagen ({i} van {n})"

#: plinius-boot:2809 plinius-boot:2829 plinius-boot:2832 plinius-boot:2836
#, python-brace-format
msgid "Reading {name} failed: {error}"
msgstr "Lezen van {name} mislukt: {error}"

#: plinius-boot:2810
msgid "the partition name is invalid or appears twice"
msgstr "de partitienaam is ongeldig of komt twee keer voor"

#: plinius-boot:2830
msgid "the phone sent more data than the partition holds"
msgstr "de telefoon stuurde meer gegevens dan de partitie bevat"

#: plinius-boot:2833 plinius-boot:3468 plinius-boot:3488 plinius-boot:4032
msgid "the data is incomplete"
msgstr "de gegevens zijn onvolledig"

#: plinius-boot:2837
msgid "the checksum on the phone does not match"
msgstr "de controlesom op de telefoon komt niet overeen"

#: plinius-boot:2847
#, python-brace-format
msgid "{name}: {size}, saved as {file}"
msgstr "{name}: {size}, opgeslagen als {file}"

#: plinius-boot:2857 plinius-boot:2903
#, python-brace-format
msgid "Checking {name} ({i} of {n})"
msgstr "{name} wordt gecontroleerd ({i} van {n})"

#: plinius-boot:2872
#, python-brace-format
msgid "{name}: checksum does not match"
msgstr "{name}: controlesom komt niet overeen"

#: plinius-boot:2875
#, python-brace-format
msgid "{name}: OK"
msgstr "{name}: OK"

#: plinius-boot:2886 plinius-boot:5718 plinius-boot:5993 plinius-boot:5994
msgid "Reading the partition list…"
msgstr "Partitielijst wordt gelezen…"

#: plinius-boot:2890 plinius-boot:5978
#, python-brace-format
msgid ""
"This backup belongs to a {backup}, but the connected phone is a {device}."
msgstr ""
"Deze back-up hoort bij een {backup}, maar de verbonden telefoon is een "
"{device}."

#: plinius-boot:2895
#, python-brace-format
msgid "{name}: {problem} Nothing was written."
msgstr "{name}: {problem} Er is niets geschreven."

#: plinius-boot:2913
#, python-brace-format
msgid ""
"The backup of {name} is damaged (the file is too large). Nothing was written "
"to this partition."
msgstr ""
"De back-up van {name} is beschadigd (het bestand is te groot). Er is niets "
"naar deze partitie geschreven."

#: plinius-boot:2916
#, python-brace-format
msgid "Not enough free space in {dir} for a temporary copy of {name}."
msgstr ""
"Niet genoeg vrije ruimte in {dir} voor een tijdelijke kopie van {name}."

#: plinius-boot:2933
#, python-brace-format
msgid ""
"The backup of {name} cannot be read ({error}). Nothing was written to this "
"partition."
msgstr ""
"De back-up van {name} kan niet worden gelezen ({error}). Er is niets naar "
"deze partitie geschreven."

#: plinius-boot:2938
#, python-brace-format
msgid ""
"The backup of {name} is damaged (checksum does not match). Nothing was "
"written to this partition."
msgstr ""
"De back-up van {name} is beschadigd (controlesom komt niet overeen). Er is "
"niets naar deze partitie geschreven."

#: plinius-boot:2941
#, python-brace-format
msgid "Writing {name} ({i} of {n})"
msgstr "{name} wordt geschreven ({i} van {n})"

#: plinius-boot:2950
#, python-brace-format
msgid "fastboot could not write {name}."
msgstr "fastboot kon {name} niet schrijven."

#: plinius-boot:2964 plinius-boot:4031
#, python-brace-format
msgid "Writing {name} failed: {error}"
msgstr "Schrijven van {name} mislukt: {error}"

#: plinius-boot:2966 plinius-boot:4033
#, python-brace-format
msgid "Verifying {name} on the phone"
msgstr "{name} wordt op de telefoon vergeleken"

#: plinius-boot:2969
#, python-brace-format
msgid ""
"{name} was written, but the content on the phone does not match the backup."
msgstr ""
"{name} is geschreven, maar de inhoud op de telefoon komt niet overeen met de "
"back-up."

#: plinius-boot:2971
#, python-brace-format
msgid "{name}: written and verified"
msgstr "{name}: geschreven en gecontroleerd"

#: plinius-boot:3194
#, python-brace-format
msgid ""
"This image needs {need}, but partition {number} holds {size}. Nothing was "
"changed."
msgstr ""
"Deze image heeft {need} nodig, maar partitie {number} is {size} groot. Er is "
"niets gewijzigd."

#: plinius-boot:3197
#, python-brace-format
msgid ""
"This image has blocks of {size} bytes, and the phone's own storage needs "
"{need}. It would not start there. Nothing was changed."
msgstr ""
"Deze image heeft blokken van {size} bytes, de opslag van de telefoon heeft "
"{need} nodig. Daar zou hij niet starten. Er is niets gewijzigd."

#: plinius-boot:3213
#, python-brace-format
msgid "This image lacks {name}, so it cannot start on this phone."
msgstr ""
"In deze image ontbreekt {name}, dus kan hij op deze telefoon niet starten."

#: plinius-boot:3217
msgid "This image has no os-release, so it is not a Linux system."
msgstr "Deze image heeft geen os-release, dus het is geen Linux-systeem."

#: plinius-boot:3224
msgid "This image is incomplete."
msgstr "Deze image is onvolledig."

#: plinius-boot:3226
#, python-brace-format
msgid "This is not a usable ext4 image ({error})."
msgstr "Dit is geen bruikbare ext4-image ({error})."

#: plinius-boot:3240
#, python-brace-format
msgid "Not enough free space in {dir} to unpack it."
msgstr "Niet genoeg vrije ruimte in {dir} om hem uit te pakken."

#: plinius-boot:3253
#, python-brace-format
msgid "This image does not bring {name}, so it can only go on the memory card."
msgstr "Deze image bevat {name} niet en kan dus alleen op de geheugenkaart."

#: plinius-boot:3257
#, python-brace-format
msgid "{name} in this image is not a boot image."
msgstr "{name} in deze image is geen opstartimage."

#: plinius-boot:3260
#, python-brace-format
msgid ""
"{name} in this image still names a system partition, so the system on the "
"data partition would never start."
msgstr ""
"{name} in deze image noemt nog een systeempartitie, waardoor het systeem op "
"de gegevenspartitie nooit zou starten."

