#: plinius-boot:269
msgid "Phone Backups"
msgstr "Sauvegardes du téléphone"

#: plinius-boot:293
msgid "Device identity"
msgstr "Identité de l’appareil"

#: plinius-boot:294
msgid ""
"IMEI, MAC addresses and calibration. Unique to this phone and not available "
"for download anywhere. Keep this backup safe."
msgstr ""
"IMEI, adresses MAC et calibrage. Propres à ce téléphone, ces données ne sont "
"disponibles au téléchargement nulle part. Conservez précieusement cette "
"sauvegarde."

#: plinius-boot:296
msgid "Boot chain and firmware"
msgstr "Chaîne de démarrage et micrologiciel"

#: plinius-boot:296
msgid "Bootloader, kernel, modem and other firmware."
msgstr "Bootloader, noyau, modem et autres micrologiciels."

#: plinius-boot:297 plinius-boot:660 plinius-boot:6018 plinius-boot:6585
#: plinius-boot:6904 plinius-boot:6953 plinius-boot:7446 plinius-boot:7479
#: plinius-boot:7483 plinius-boot:7509 plinius-boot:8479
msgid "System"
msgstr "Système"

#: plinius-boot:297
msgid "The Android system and vendor partitions."
msgstr "Les partitions système et fabricant (vendor) d’Android."

#: plinius-boot:298 plinius-boot:6904 plinius-boot:7446
msgid "User data"
msgstr "Données utilisateur"

#: plinius-boot:298
msgid "Your files, apps and settings. Very large and often encrypted."
msgstr ""
"Vos fichiers, applications et paramètres. Très volumineux et souvent "
"chiffrés."

#: plinius-boot:299 plinius-boot:6912 plinius-boot:6914 plinius-boot:7312
#: plinius-boot:7484 plinius-boot:7536 plinius-boot:7574 plinius-boot:9013
msgid "Memory card"
msgstr "Carte mémoire"

#: plinius-boot:299
msgid ""
"Systems on the memory card, for example Ubuntu Touch or Arch via multi-boot."
msgstr ""
"Systèmes sur la carte mémoire, par exemple Ubuntu Touch ou Arch en multi-"
"boot."

#: plinius-boot:300
msgid "Logs"
msgstr "Journaux"

#: plinius-boot:300
msgid "Crash logs and temporary data, usually not needed."
msgstr "Journaux de plantage et données temporaires, généralement inutiles."

#: plinius-boot:316
msgid "Not checked"
msgstr "Non vérifié"

#: plinius-boot:317
msgid "Probably empty"
msgstr "Probablement vide"

#: plinius-boot:318
msgid "Android boot image"
msgstr "Image de démarrage Android"

#: plinius-boot:319
msgid "Android init boot image"
msgstr "Image init boot Android"

#: plinius-boot:320
msgid "Vendor boot image"
msgstr "Image vendor boot"

#: plinius-boot:321
msgid "Verified boot metadata"
msgstr "Métadonnées Verified Boot"

#: plinius-boot:322
msgid "Android sparse image"
msgstr "Image sparse Android"

#: plinius-boot:323
msgid "Dynamic partitions (super)"
msgstr "Partitions dynamiques (super)"

#: plinius-boot:324
msgid "ext4 file system"
msgstr "Système de fichiers ext4"

#: plinius-boot:325
msgid "F2FS file system"
msgstr "Système de fichiers F2FS"

#: plinius-boot:326
msgid "Encrypted (LUKS)"
msgstr "Chiffré (LUKS)"

#: plinius-boot:327
msgid "LVM volume"
msgstr "Volume LVM"

#: plinius-boot:328
msgid "MediaTek image"
msgstr "Image MediaTek"

#: plinius-boot:329
msgid "MediaTek preloader"
msgstr "Preloader MediaTek"

#: plinius-boot:330
msgid "Device tree overlays"
msgstr "Overlays de device tree"

#: plinius-boot:331
msgid "Device tree"
msgstr "Device tree"

#: plinius-boot:332
msgid "Partition table (GPT)"
msgstr "Table des partitions (GPT)"

#: plinius-boot:333
msgid "Program (ELF)"
msgstr "Programme (ELF)"

#: plinius-boot:334
msgid "Unknown data"
msgstr "Données inconnues"

#: plinius-boot:337
msgid "in use (mounted)"
msgstr "utilisée (montée)"

#: plinius-boot:338
msgid "in use by the system"
msgstr "utilisée par le système"

#: plinius-boot:339
msgid "in use as swap"
msgstr "utilisée comme swap"

#: plinius-boot:342
msgid "Linux on the phone, USB network"
msgstr "Linux sur le téléphone, réseau USB"

#: plinius-boot:343
msgid "Rescue system, USB network"
msgstr "Système de secours, réseau USB"

#: plinius-boot:344
msgid "Android, USB debugging"
msgstr "Android, débogage USB"

#: plinius-boot:345
msgid "Bootloader (fastboot)"
msgstr "Bootloader (fastboot)"

#: plinius-boot:346
msgid "MediaTek download mode"
msgstr "Mode de téléchargement MediaTek"

#: plinius-boot:348
msgid "Not connected"
msgstr "Non connecté"

#: plinius-boot:646 plinius-boot:6897
#, python-brace-format
msgid "build {number}"
msgstr "build {number}"

#: plinius-boot:650 plinius-boot:6898
#, python-brace-format
msgid "security patch {date}"
msgstr "correctif de sécurité {date}"

#: plinius-boot:657
#, python-brace-format
msgid "Partition {name}"
msgstr "Partition {name}"

#: plinius-boot:659
#, python-brace-format
msgid "Slot {slot} (active)"
msgstr "Emplacement {slot} (actif)"

#: plinius-boot:659
#, python-brace-format
msgid "Slot {slot}"
msgstr "Emplacement {slot}"

#: plinius-boot:703
msgid "Not a regular file"
msgstr "Ce n’est pas un fichier ordinaire"

#: plinius-boot:912 plinius-boot:6109 plinius-boot:6119 plinius-boot:6136
#: plinius-boot:6153 plinius-boot:6212 plinius-boot:6377 plinius-boot:7739
msgid "Rescue system"
msgstr "Système de secours"

#: plinius-boot:929
msgid "Talks to Android on the phone"
msgstr "Communique avec Android sur le téléphone"

#: plinius-boot:930
msgid "Talks to the phone's bootloader"
msgstr "Communique avec le bootloader du téléphone"

#: plinius-boot:931
msgid "Talks to Linux and the rescue system on the phone"
msgstr "Communique avec Linux et le système de secours sur le téléphone"

#: plinius-boot:932
msgid "Creates the key for the rescue system"
msgstr "Crée la clé pour le système de secours"

#: plinius-boot:933
msgid "Finds the phone's USB network"
msgstr "Trouve le réseau USB du téléphone"

#: plinius-boot:955
msgid "Not installed."
msgstr "Non installé."

#: plinius-boot:957
msgid "Cannot be run."
msgstr "Ne peut pas être exécuté."

#: plinius-boot:959
msgid "Does not answer."
msgstr "Ne répond pas."

#: plinius-boot:961
#, python-brace-format
msgid "Does not work: {error}"
msgstr "Ne fonctionne pas : {error}"

#: plinius-boot:1332 plinius-boot:4014 plinius-boot:4031 plinius-boot:4137
#: plinius-boot:4228 plinius-boot:4232 plinius-boot:4327 plinius-boot:4329
#: plinius-boot:4339 plinius-boot:4993
msgid "Reading the partition table"
msgstr "La lecture de la table des partitions"

#: plinius-boot:1376
msgid "Could not read the partition list."
msgstr "Impossible de lire la liste des partitions."

#: plinius-boot:1455 plinius-boot:6495
msgid "The phone was disconnected."
msgstr "Le téléphone a été déconnecté."

#: plinius-boot:1631 plinius-boot:9011
msgid "Bootloader"
msgstr "Bootloader"

#: plinius-boot:1690 plinius-boot:2694 plinius-boot:9683
msgid "Unknown phone"
msgstr "Téléphone inconnu"

#: plinius-boot:1761
msgid ""
"No administrator access. Log in with your password so the app can use sudo."
msgstr ""
"Pas d’accès administrateur. Connectez-vous avec votre mot de passe pour que "
"l’application puisse utiliser sudo."

#: plinius-boot:1771
msgid "Unlock the phone and allow USB debugging in the prompt shown there."
msgstr ""
"Déverrouillez le téléphone et autorisez le débogage USB dans la demande qui "
"s’y affiche."

#: plinius-boot:1773
msgid "The phone is not ready yet."
msgstr "Le téléphone n’est pas encore prêt."

#: plinius-boot:1777
msgid ""
"Android does not allow reading the partitions without root. Restart the "
"phone into the bootloader and start the rescue system there, or start a "
"Linux system on the phone."
msgstr ""
"Android ne permet pas de lire les partitions sans root. Redémarrez le "
"téléphone dans le bootloader et démarrez-y le système de secours, ou "
"démarrez un système Linux sur le téléphone."

#: plinius-boot:1786
msgid "In fastboot mode backups can only be restored, not created."
msgstr ""
"En mode fastboot, les sauvegardes peuvent seulement être restaurées, pas "
"créées."

#: plinius-boot:1789
msgid ""
"The bootloader is locked. Unlock it to start the rescue system or restore "
"backups."
msgstr ""
"Le bootloader est verrouillé. Déverrouillez-le pour démarrer le système de "
"secours ou restaurer des sauvegardes."

#: plinius-boot:1791
msgid ""
"The bootloader does not report whether it is unlocked. Restoring is not "
"possible."
msgstr ""
"Le bootloader n’indique pas s’il est déverrouillé. La restauration est "
"impossible."

#: plinius-boot:1892
msgid ""
"Its system lets in SSH keys only, no password. Start the bootloader on the "
"phone; the app then starts the rescue system there."
msgstr ""
"Son système n’accepte que des clés SSH, pas de mot de passe. Démarre le "
"bootloader sur le téléphone ; l’application y lance alors le système de "
"secours."

#: plinius-boot:1895
msgid "Log in to read the partitions."
msgstr "Connectez-vous pour lire les partitions."

#: plinius-boot:1919
msgid ""
"The phone is in MediaTek download mode. This app cannot use this mode. "
"Disconnect the cable and hold the power button to restart the phone."
msgstr ""
"Le téléphone est en mode de téléchargement MediaTek. Cette application ne "
"peut pas utiliser ce mode. Débranchez le câble et maintenez le bouton "
"d’alimentation enfoncé pour redémarrer le téléphone."

#: plinius-boot:2049 plinius-boot:2053
msgid "The rescue system is not built yet (rescue/mkrescue.sh)."
msgstr "Le système de secours n’est pas encore compilé (rescue/mkrescue.sh)."

#: plinius-boot:2071
msgid "This is not an Android boot image."
msgstr "Ce n’est pas une image de démarrage Android."

#: plinius-boot:2103
msgid "This boot image contains no kernel."
msgstr "Cette image de démarrage ne contient pas de noyau."

#: plinius-boot:2121
#, python-brace-format
msgid "The boot image in the backup cannot be read ({error})."
msgstr "Impossible de lire l’image de démarrage de la sauvegarde ({error})."

#: plinius-boot:2123
msgid "The boot image in the backup is damaged (checksum does not match)."
msgstr ""
"L’image de démarrage de la sauvegarde est endommagée (la somme de contrôle "
"ne correspond pas)."

#: plinius-boot:2140
#, python-brace-format
msgid "{name} from the backup of {date}"
msgstr "{name} de la sauvegarde du {date}"

#: plinius-boot:2157
#, python-brace-format
msgid "fastboot could not start the rescue system: {error}"
msgstr "fastboot n’a pas pu démarrer le système de secours : {error}"

#: plinius-boot:2165 plinius-boot:9149
msgid "Confirm on the phone: press Volume up to unlock."
msgstr ""
"Confirmez sur le téléphone : appuyez sur Volume haut pour déverrouiller."

#: plinius-boot:2169
#, python-brace-format
msgid "The bootloader was not unlocked: {error}"
msgstr "Le bootloader n’a pas été déverrouillé : {error}"

#: plinius-boot:2171
msgid "Waiting for the bootloader…"
msgstr "Attente du bootloader…"

#: plinius-boot:2175
msgid ""
"The phone does not report itself as unlocked. If the question on the phone "
"was declined, start again. Otherwise restart the phone into the bootloader "
"and check it here again."
msgstr ""
"Le téléphone n’indique pas qu’il est déverrouillé. Si la question sur le "
"téléphone a été refusée, recommencez. Sinon, redémarrez le téléphone dans le "
"bootloader et vérifiez-le à nouveau ici."

#: plinius-boot:2180 plinius-boot:4470 plinius-boot:4662
msgid "Formatting the data partition…"
msgstr "Formatage de la partition de données…"

#: plinius-boot:2183
#, python-brace-format
msgid ""
"The bootloader is unlocked, but the data partition could not be formatted: "
"{error}\n"
"Run “fastboot -w” in the bootloader, otherwise Volla OS keeps restarting."
msgstr ""
"Le bootloader est déverrouillé, mais la partition de données n’a pas pu être "
"formatée : {error}\n"
"Exécutez « fastboot -w » dans le bootloader, sinon Volla OS redémarre sans "
"cesse."

#: plinius-boot:2241 plinius-boot:2244
msgid "This is not an update package (zip)."
msgstr "Ce n’est pas un paquet de mise à jour (zip)."

#: plinius-boot:2253 plinius-boot:2266 plinius-boot:2273 plinius-boot:2276
msgid "The update package has no usable payload.bin."
msgstr "Le paquet de mise à jour ne contient pas de payload.bin utilisable."

#: plinius-boot:2288 plinius-boot:2302
#, python-brace-format
msgid "{name} in the update package is too large."
msgstr "{name} dans le paquet de mise à jour est trop volumineux."

#: plinius-boot:2305 plinius-boot:2321 plinius-boot:2325
msgid "The update package is damaged (checksum does not match)."
msgstr ""
"Le paquet de mise à jour est endommagé (la somme de contrôle ne correspond "
"pas)."

#: plinius-boot:2314
#, python-brace-format
msgid ""
"This is an incremental update package; only full packages contain {name}."
msgstr ""
"C’est un paquet de mise à jour incrémentiel ; seuls les paquets complets "
"contiennent {name}."

#: plinius-boot:2327
#, python-brace-format
msgid "The update package contains no {name}."
msgstr "Le paquet de mise à jour ne contient pas {name}."

#: plinius-boot:2421 plinius-boot:2493
msgid "Asking the update server…"
msgstr "Interrogation du serveur de mises à jour…"

#: plinius-boot:2425 plinius-boot:2496
#, python-brace-format
msgid "Downloading {name} from {package}…"
msgstr "Téléchargement de {name} depuis {package}…"

#: plinius-boot:2444
#, python-brace-format
msgid ""
"{file} is not the original {name} of this phone: its checksum does not match "
"the one the phone expects."
msgstr ""
"{file} n’est pas le {name} d’origine de ce téléphone : sa somme de contrôle "
"ne correspond pas à celle qu’attend le téléphone."

#: plinius-boot:2469
msgid "This is not an init_boot image."
msgstr "Ce n’est pas une image init_boot."

#: plinius-boot:2483
msgid "The bootloader is locked."
msgstr "Le bootloader est verrouillé."

#: plinius-boot:2487
#, python-brace-format
msgid "This phone has no partition {name}."
msgstr "Ce téléphone n’a pas de partition {name}."

#: plinius-boot:2500
#, python-brace-format
msgid ""
"No {name} of this phone is known and the update server cannot be reached. "
"Without one the app could not write the original back later."
msgstr ""
"Aucun {name} de ce téléphone n’est connu et le serveur de mises à jour est "
"injoignable. Sans lui, l’application ne pourrait pas réécrire l’original "
"ensuite."

#: plinius-boot:2504
#, python-brace-format
msgid "The rescue system does not fit into {name}."
msgstr "Le système de secours ne tient pas dans {name}."

#: plinius-boot:2511
#, python-brace-format
msgid "Writing the rescue system to {name}…"
msgstr "Écriture du système de secours dans {name}…"

#: plinius-boot:2515 plinius-boot:2561
#, python-brace-format
msgid "fastboot could not write {name}: {error}"
msgstr "fastboot n’a pas pu écrire {name} : {error}"

#: plinius-boot:2525
msgid "The app does not know which partition holds the rescue system."
msgstr ""
"L’application ne sait pas quelle partition contient le système de secours."

#: plinius-boot:2528
msgid "The original does not match the checksum the phone expects."
msgstr ""
"L’original ne correspond pas à la somme de contrôle qu’attend le téléphone."

#: plinius-boot:2531
msgid ""
"The image to write back is this app's rescue system, not the original. "
"Nothing was written."
msgstr ""
"L’image à réécrire est le système de secours de cette appli, pas l’original. "
"Rien n’a été écrit."

#: plinius-boot:2536 plinius-boot:4468 plinius-boot:5645
msgid "Restarting into the bootloader…"
msgstr "Redémarrage dans le bootloader…"

#: plinius-boot:2541
msgid ""
"The phone did not appear in the bootloader. Start it there by hand (Power "
"and Volume down) and write the original back from the phone's page."
msgstr ""
"Le téléphone n’est pas apparu dans le bootloader. Démarrez-le à la main "
"(Marche et Volume bas) et réécrivez l’original depuis la page du téléphone."

#: plinius-boot:2549
#, python-brace-format
msgid ""
"The phone in the bootloader is not in the expected state (slot {slot}, "
"partition {name}). Nothing was written."
msgstr ""
"Le téléphone dans le bootloader n’est pas dans l’état attendu (emplacement "
"{slot}, partition {name}). Rien n’a été écrit."

#: plinius-boot:2556 plinius-boot:4468
#, python-brace-format
msgid "Writing the original {name}…"
msgstr "Écriture du {name} d’origine…"

#: plinius-boot:2565 plinius-boot:4471 plinius-boot:5645
msgid "Starting the phone…"
msgstr "Démarrage du téléphone…"

#: plinius-boot:2776
msgid "Backup only. Restoring this area is not supported."
msgstr ""
"Sauvegarde uniquement. La restauration de cette zone n’est pas prise en "
"charge."

#: plinius-boot:2778
msgid ""
"Holds the rescue system, not the original. Restoring it would keep the phone "
"from starting."
msgstr ""
"Contient le système de secours, pas l’original. Le restaurer empêcherait le "
"téléphone de démarrer."

#: plinius-boot:2780
msgid "Not present on this phone."
msgstr "N’existe pas sur ce téléphone."

#: plinius-boot:2782
msgid "The partition has a different size on this phone."
msgstr "La partition a une taille différente sur ce téléphone."

#: plinius-boot:2784
msgid "In use by the running system. Restore it in fastboot mode."
msgstr ""
"Utilisée par le système en cours d’exécution. Restaurez-la en mode fastboot."

#: plinius-boot:2787
msgid ""
"Belongs to another phone. Restoring it would copy that phone's IMEI and MAC "
"addresses."
msgstr ""
"Appartient à un autre téléphone. La restaurer copierait l’IMEI et les "
"adresses MAC de ce téléphone."

#: plinius-boot:2804
#, python-brace-format
msgid ""
"A different phone is connected now (serial number {serial}). Nothing was "
"changed."
msgstr ""
"Un autre téléphone est maintenant connecté (numéro de série {serial}). Rien "
"n’a été modifié."

#: plinius-boot:2954
#, python-brace-format
msgid "Saving {name} ({i} of {n})"
msgstr "Sauvegarde de {name} ({i} sur {n})"

#: plinius-boot:2958 plinius-boot:2978 plinius-boot:2981 plinius-boot:2985
#, python-brace-format
msgid "Reading {name} failed: {error}"
msgstr "Échec de la lecture de {name} : {error}"

#: plinius-boot:2959
msgid "the partition name is invalid or appears twice"
msgstr "le nom de la partition n’est pas valide ou apparaît deux fois"

#: plinius-boot:2979
msgid "the phone sent more data than the partition holds"
msgstr "le téléphone a envoyé plus de données que n’en contient la partition"

#: plinius-boot:2982 plinius-boot:3652 plinius-boot:3672 plinius-boot:4261
msgid "the data is incomplete"
msgstr "les données sont incomplètes"

#: plinius-boot:2986
msgid "the checksum on the phone does not match"
msgstr "la somme de contrôle sur le téléphone ne correspond pas"

#: plinius-boot:2996
#, python-brace-format
msgid "{name}: {size}, saved as {file}"
msgstr "{name} : {size}, enregistré sous {file}"

#: plinius-boot:3006 plinius-boot:3052 plinius-boot:4466
#, python-brace-format
msgid "Checking {name} ({i} of {n})"
msgstr "Vérification de {name} ({i} sur {n})"

#: plinius-boot:3021
#, python-brace-format
msgid "{name}: checksum does not match"
msgstr "{name} : la somme de contrôle ne correspond pas"

#: plinius-boot:3024
#, python-brace-format
msgid "{name}: OK"
msgstr "{name} : OK"

#: plinius-boot:3035 plinius-boot:6398 plinius-boot:6673 plinius-boot:6674
msgid "Reading the partition list…"
msgstr "Lecture de la liste des partitions…"

#: plinius-boot:3039 plinius-boot:6658
#, python-brace-format
msgid ""
"This backup belongs to a {backup}, but the connected phone is a {device}."
msgstr ""
"Cette sauvegarde provient d’un {backup}, mais le téléphone connecté est un "
"{device}."

#: plinius-boot:3044
#, python-brace-format
msgid "{name}: {problem} Nothing was written."
msgstr "{name} : {problem} Rien n’a été écrit."

#: plinius-boot:3062
#, python-brace-format
msgid ""
"The backup of {name} is damaged (the file is too large). Nothing was written "
"to this partition."
msgstr ""
"La sauvegarde de {name} est endommagée (le fichier est trop volumineux). "
"Rien n’a été écrit sur cette partition."

#: plinius-boot:3065
#, python-brace-format
msgid "Not enough free space in {dir} for a temporary copy of {name}."
msgstr ""
"Pas assez d’espace libre dans {dir} pour une copie temporaire de {name}."

#: plinius-boot:3082
#, python-brace-format
msgid ""
"The backup of {name} cannot be read ({error}). Nothing was written to this "
"partition."
msgstr ""
"Impossible de lire la sauvegarde de {name} ({error}). Rien n’a été écrit sur "
"cette partition."

#: plinius-boot:3087
#, python-brace-format
msgid ""
"The backup of {name} is damaged (checksum does not match). Nothing was "
"written to this partition."
msgstr ""
"La sauvegarde de {name} est endommagée (la somme de contrôle ne correspond "
"pas). Rien n’a été écrit sur cette partition."

#: plinius-boot:3090 plinius-boot:4467
#, python-brace-format
msgid "Writing {name} ({i} of {n})"
msgstr "Écriture de {name} ({i} sur {n})"

#: plinius-boot:3099
#, python-brace-format
msgid "fastboot could not write {name}."
msgstr "fastboot n’a pas pu écrire {name}."

#: plinius-boot:3113 plinius-boot:4260
#, python-brace-format
msgid "Writing {name} failed: {error}"
msgstr "Échec de l’écriture de {name} : {error}"

#: plinius-boot:3115 plinius-boot:4262
#, python-brace-format
msgid "Verifying {name} on the phone"
msgstr "Vérification de {name} sur le téléphone"

#: plinius-boot:3118
#, python-brace-format
msgid ""
"{name} was written, but the content on the phone does not match the backup."
msgstr ""
"{name} a été écrit, mais le contenu du téléphone ne correspond pas à la "
"sauvegarde."

#: plinius-boot:3120
#, python-brace-format
msgid "{name}: written and verified"
msgstr "{name} : écrit et vérifié"

#: plinius-boot:3362 plinius-boot:3370
#, python-brace-format
msgid ""
"This image needs {need}, but partition {number} holds {size}. Nothing was "
"changed."
msgstr ""
"Cette image nécessite {need}, mais la partition {number} ne fait que {size}. "
"Rien n’a été modifié."

#: plinius-boot:3373
#, python-brace-format
msgid ""
"This image has blocks of {size} bytes, and the phone's own storage needs "
"{need}. It would not start there. Nothing was changed."
msgstr ""
