class ImageSource:
    """The image of Plinius for the guided installation, one for the whole app: the newest one on the
    server, or a file the user chose. The newest one is only looked up at the start; it is downloaded
    once the user decides to install (want), not over a metered connection, and is only checked if it is
    here already. Pages that show it register in listeners and get image_changed() and image_progress()."""

    def __init__(self, win):
        self.win = win
        self.image, self.problems, self.checking = None, {}, False
        self.offer, self.offer_error, self.looking = None, "", True
        self.job, self.downloaded, self.download_error = None, (0, 0), ""
        # The user decided to install before the newest image was known: download it once it is
        self.wanted = False
        self.listeners = {}

    def changed(self):
        for listener in list(self.listeners.values()):
            listener.image_changed()

    def look(self):
        in_thread(latest_image, self.show_offer)

    def show_offer(self, offer, error):
        self.looking, self.offer, self.offer_error = False, offer, error or ""
        if offer and not self.image and not self.job:
            path = os.path.join(IMAGES, offer["name"])
            complete = os.path.isfile(path) and os.path.getsize(path) == offer["size"]
            if complete or self.wanted and not metered():
                self.start_download()
                return False
        if not offer and not self.image:
            earlier = downloaded_images()
            if earlier:
                self.check_image(earlier[0])
                return False
        self.changed()
        return False

    def want(self):
        """The user decided to install: now the newest image is downloaded, unless there is one already."""
        self.wanted = True
        if self.offer and not (self.image or self.job or self.checking) and not metered():
            self.start_download()

    def start_download(self):
        self.job = job = Job(DownloadProgress(self))
        self.downloaded, self.download_error = (0, self.offer["size"]), ""
        self.changed()

        def done(path, error):
            self.job = None
            if error:
                if not job.cancelled:
                    self.download_error = error
                self.changed()
            else:
                self.check_image(path)
            return False

        in_thread(lambda: download_image(job, self.offer), done)

    def pause(self):
        """Stops the download; what came so far stays as .part, and start_download goes on from there."""
        if self.job:
            self.job.cancel()

    def part_size(self):
        """How much of the offered image is here from a download that stopped, 0 if none."""
        if not self.offer:
            return 0
        try:
            return os.path.getsize(os.path.join(IMAGES, self.offer["name"]) + ".part")
        except OSError:
            return 0

    def paused(self):
        """A download stopped part way, by the user or by the app closing, and not going on yet."""
        return not (self.job or self.image or self.checking) and self.part_size() > 0

    def download_progress(self, done, total):
        self.downloaded = (done, total)
        for listener in list(self.listeners.values()):
            listener.image_progress()

    def choose_file(self):
        dialog = Gtk.FileDialog(title=_("Image of Plinius"))

        def chosen(dlg, result):
            try:
                path = dlg.open_finish(result).get_path()
            except GLib.Error:
                return
            self.check_image(path)

        dialog.open(self.win, None, chosen)

    def check_image(self, path):
        """Checks an image once, also for both places, so that choosing one later needs no waiting."""
        if self.image:
            self.image.close()
        image, self.image, self.checking = SystemImage(path), None, True
        self.changed()

        def work():
            image.check()
            if image.problem:
                return {"card": image.problem, "phone": image.problem}
            return {"card": card_image_problem(image), "phone": image.phone_problem()}

        def done(problems, error):
            self.checking = False
            if error or not problems or problems["card"] and problems["phone"]:
                image.close()
                alert(self.win, _("This image cannot be installed"), error or problems["card"], [("close", _("Close"))])
            else:
                self.image, self.problems = image, problems
            self.changed()
            return False

        in_thread(work, done)

    def title(self):
        """Plinius with its version for the image from the server, else the name of the file."""
        if self.image and self.offer and os.path.basename(self.image.path) == self.offer["name"] \
                and self.offer["version"]:
            return _("Plinius {version}").format(version=self.offer["version"])
        if self.image:
            return os.path.basename(self.image.path)
        if self.offer and self.offer["version"]:
            return _("Plinius {version}").format(version=self.offer["version"])
        return self.offer["name"] if self.offer else _("Plinius")


def metered():
    try:
        return Gio.NetworkMonitor.get_default().get_network_metered()
    except GLib.Error:
        return False


def image_row(source, owner, change=False, pending=False):
    """One row for where the image stands: looking, downloading (with a bar), checking, ready, or what
    to do. pending: before the user decided to install, the newest image is only named, not offered for
    download. The owner gets image_progress() calls for the bar (see show_image_progress)."""
    owner.download_bar = owner.download_row = None
    if source.checking:
        return spinner_row(_("Checking the image… A compressed one takes a few minutes."))
    if source.job:
        r = row(_("Downloading Plinius"), "")
        r.add_prefix(Adw.Spinner())
        bar = Gtk.ProgressBar(valign=Gtk.Align.CENTER, width_request=120)
        r.add_suffix(bar)
        pause = Gtk.Button(label=_("Pause"), valign=Gtk.Align.CENTER)
        pause.connect("clicked", lambda _b: source.pause())
        r.add_suffix(pause)
        owner.download_row, owner.download_bar = r, bar
        show_image_progress(source, owner)
        return r
    if source.image:
        r = check_row(source.title(), _("{size}, ready").format(size=size_text(source.image.size)), True)
        if change:
            other = Gtk.Button(label=_("Other file…"), valign=Gtk.Align.CENTER)
            other.connect("clicked", lambda _b: source.choose_file())
            r.add_suffix(other)
        return r
    if source.looking:
        return spinner_row(_("Looking for the newest version…"))
    if source.paused() and not source.download_error:
        r = row(source.title(), _("Paused: {done} of {total}").format(
            done=size_text(source.part_size()), total=size_text(source.offer["size"])))
        r.add_prefix(Gtk.Image(icon_name="media-playback-pause-symbolic"))
        if not pending:
            resume = Gtk.Button(label=_("Resume"), valign=Gtk.Align.CENTER, css_classes=["suggested-action"])
            resume.connect("clicked", lambda _b: source.start_download())
            r.add_suffix(resume)
        return r
    if source.offer and pending and not source.download_error:
        r = row(source.title(), _("{size}, downloaded when you check the phone").format(
            size=size_text(source.offer["size"])))
        r.add_prefix(Gtk.Image(icon_name="folder-download-symbolic"))
        if change:
            other = Gtk.Button(label=_("Other file…"), valign=Gtk.Align.CENTER)
            other.connect("clicked", lambda _b: source.choose_file())
            r.add_suffix(other)
        return r
    if source.offer:
        r = row(source.title(), _("The download did not finish: {error}").format(error=source.download_error)
                if source.download_error else _("{size} to download, from {host}").format(
                    size=size_text(source.offer["size"]), host=urllib.parse.urlsplit(IMAGE_INDEX).netloc))
        r.add_prefix(Gtk.Image(icon_name="folder-download-symbolic"))
        download = Gtk.Button(label=_("Try again") if source.download_error else _("Download"),
                              valign=Gtk.Align.CENTER, css_classes=["suggested-action"])
        download.connect("clicked", lambda _b: source.start_download())
        r.add_suffix(download)
        return r
    r = row(_("No download is offered right now"), source.offer_error or _("none published yet"))
    r.add_prefix(Gtk.Image(icon_name="dialog-information-symbolic"))
    choose = Gtk.Button(label=_("Choose a file…"), valign=Gtk.Align.CENTER, css_classes=["suggested-action"])
    choose.connect("clicked", lambda _b: source.choose_file())
    r.add_suffix(choose)
    return r


def show_image_progress(source, owner):
    if getattr(owner, "download_bar", None):
        done, total = source.downloaded
        owner.download_bar.set_fraction(done / total if total else 0)
        owner.download_row.set_subtitle(_("{done} of {total}").format(done=size_text(done), total=size_text(total)))


class InstallPage(FollowingPage):
    """Plinius on the phone in four steps (STEPS). Connect is the start page; here: Check (into the
    bootloader, unlock if needed, start the rescue system and read the memory card), Download (started
    by Check and running meanwhile; shown only if the phone is ready first), then Install (a summary
    with one button, details behind Change). It follows the phone through its
    restarts (see FollowingPage) and does each automatic step once. Unlocking and erasing something
    wait for a click."""

    def __init__(self, win, device):
        super().__init__(win, device, _("Install Plinius"))
        self.source = win.images
        menu = Gio.Menu()
        menu.append(_("Advanced…"), "install.advanced")
        actions = Gio.SimpleActionGroup()
        advanced = Gio.SimpleAction(name="advanced")
        advanced.connect("activate", lambda *_a: self.win.push(PhonePage(self.win, self.device)))
        actions.add_action(advanced)
        self.insert_action_group("install", actions)
        self.header.pack_end(Gtk.MenuButton(icon_name="open-menu-symbolic", menu_model=menu,
                                            tooltip_text=_("Systems, boot menu, backups and the rescue system")))
        self.steps = StepBar(CHECK)
        self.toolbar.add_top_bar(self.steps)
        # Card or phone: asked in the last step, nothing chosen before
        self.target, self.pin, self.pin_again, self.pin_hash = None, "", "", None
        self.language = default_language()
        self.started, self.working, self.finished = False, False, False
        # Automatic steps already done, and the one running now with its last message
        self.done, self.status, self.error = set(), "", ""
        self.choice, self.editing = None, False
        # Unlocking the bootloader on this page erased userdata: there is nothing in it to back up then
        self.erased = False
        # OEM unlocking was off: the phone went to Volla OS to turn it on, and waits there for Continue
        self.need_oem = False
        self.download_bar = self.download_row = self.go_button = self.pin_note = None
        self.current = CHECK
        self.source.listeners[self] = self
        self.render()

    # The image (see ImageSource)

    def image_changed(self):
        if not self.working and not self.finished:
            self.render()

    def image_progress(self):
        show_image_progress(self.source, self)
        self.show_download_detail()

    def show_steps(self, current):
        self.current = current
        self.steps.set_step(current, self.finished, (DOWNLOAD,) if self.source.image else ())
        self.show_download_detail()

    def show_download_detail(self):
        """While the phone is checked, the download shows how far it is under its step."""
        done, total = self.source.downloaded
        if self.source.job and total:
            self.steps.set_detail(DOWNLOAD, f"{done * 100 // total} %")
        else:
            self.steps.set_detail(DOWNLOAD, _("paused") if self.started and self.source.paused() else "")

    # What the page shows

    def render(self):
        d, prefs = self.device, self.new_prefs()
        self.go_button = self.pin_note = None
        self.show_steps(INSTALL if self.working or self.finished else CHECK)
        if self.finished:
            prefs.add(Adw.PreferencesGroup(title=_("Plinius is installed"), description=_(
                "You can disconnect the phone.")))
            return
        if self.working:
            group = Adw.PreferencesGroup()
            group.add(spinner_row(_("Installing… The progress is on the page in front.")))
            prefs.add(group)
            return
        if self.waiting or self.starting and not d.rescue:
            self.add_waiting(prefs)
            return
        self.starting = False
        if is_plinius(d) is False:
            prefs.add(Adw.PreferencesGroup(title=_("This is not a Volla Phone Plinius"), description=_(
                "Plinius is made for the Volla Phone Plinius and Plinius Plus only. Backups of this phone are under "
                "Advanced, in the menu at the top right.")))
            return
        if d.login:
            group = Adw.PreferencesGroup(description=d.problem)
            group.add(button_row(_("Log in…"), "dialog-password-symbolic", lambda: self.win.login(d), suggested=True))
            prefs.add(group)
            return
        if d.problem and not d.access:
            prefs.add(Adw.PreferencesGroup(title=_("The phone cannot be used yet"), description=d.problem))
            return
        # In the rescue system there is nothing to restart, and reading the card changes nothing
        if d.rescue:
            self.started = True
        if not self.started:
            self.add_check(prefs)
            return
        if d.rescue:
            self.load_layout(prefs)
            if d.layout is not None:
                self.after_layout(prefs)
        elif d.mode == "fastboot":
            self.in_bootloader(prefs)
        else:
            self.in_system(prefs)
        # Meanwhile the download: to pause or resume it without waiting for its own step
        if self.current == CHECK and (self.source.job or self.source.paused()):
            group = Adw.PreferencesGroup(title=_("Download"))
            group.add(image_row(self.source, self))
            prefs.add(group)

    # Step 2: check

    def add_check(self, prefs):
        """What is known about the phone so far; the rest shows once it runs the rescue system. The button
        names what is still open: only the memory card, once the phone and its bootloader are known."""
        d = self.device
        plinius, unlocked = is_plinius(d), bootloader_open(d)
        only_card = plinius is True and unlocked is True
        if only_card:
            button = _("Check the memory card")
            text = _("Only the rescue system can read the memory card, so the phone restarts into it. Nothing is "
                     "erased without asking you first.")
        else:
            button = _("Check the phone")
            text = _("Click “Check the phone” below. The phone restarts a few times for this; nothing is erased "
                     "without asking you first.")
        group = Adw.PreferencesGroup(title=_("Check the phone"), description=text)
        group.add(check_row(_("Volla Phone Plinius") if plinius else _("Phone model"),
                            "" if plinius else _("Checked after the click below"), True if plinius else None))
        if unlocked is False:
            group.add(check_row(_("The bootloader is locked"), _(
                "Unlocking it erases all data on the phone. Copy what you still need first."), False))
        else:
            group.add(check_row(_("Bootloader unlocked") if unlocked else _("Bootloader"),
                                "" if unlocked else _("Checked after the click below"), True if unlocked else None))
        group.add(check_row(_("Memory card"), _("Checked after the click below"), None))
        prefs.add(group)
        go = Adw.PreferencesGroup()
        go.add(button_row(button, "system-search-symbolic", self.start, suggested=True))
        prefs.add(go)

    def start(self):
        self.started = True
        self.source.want()
        self.render()

    def add_status(self, prefs, title):
        group = Adw.PreferencesGroup(title=title)
        if self.error:
            group.set_description(self.error)
            group.add(button_row(_("Try again"), "view-refresh-symbolic", self.retry, suggested=True))
        else:
            group.add(spinner_row(self.status or _("One moment…")))
        prefs.add(group)

    def retry(self):
        self.error, self.done = "", set()
        self.render()

    def automatic(self, key, work, then=None):
        """Runs work(step) once per phone and step, in the background; then() afterwards."""
        d, scanner = self.device, self.win.scanner
        key = (d.serial or d.key, key)
        if key in self.done:
            return
        self.done.add(key)
        self.status, self.error = "", ""
        scanner.busy.add(d.key)

        def step(text):
            def show():
                self.status = text
                self.render()
                return False
            GLib.idle_add(show)

        def done(_result, error):
            scanner.busy.discard(d.key)
            if error:
                self.error = error
                self.render()
            elif then:
                then()
            scanner.refresh(d.key)
            return False

        in_thread(lambda: work(step), done)

    def started_restart(self):
        self.starting = True
        self.render()

    def in_system(self, prefs):
        """The phone runs Volla OS or another system: on into the bootloader, by itself if it can."""
        d = self.device
        # It may have new data by now
        self.erased = False
        if self.need_oem:
            group = steps_group(_("Turn on OEM unlocking"), _(
                "On the phone, then continue here. The phone restarts into the bootloader by itself."), (
                _("On the phone, open Settings → About phone and tap “Build number” seven times."),
                _("Open Settings → System → Developer options and turn on “OEM unlocking”.")))
            group.add(button_row(_("Continue"), "go-next-symbolic", self.oem_done, suggested=True))
            prefs.add(group)
            return
        if d.access and (d.mode == "adb" or d.access.root is not None):
            self.add_status(prefs, _("Restarting into the bootloader"))
            # It is gone from USB for a moment and comes back in the bootloader (see FollowingPage)
            self.automatic("bootloader", lambda step: (remember_init_boot(d, self.win.config),
                                                       d.access.reboot("bootloader")))
        else:
            prefs.add(steps_group(_("Start the bootloader"), _(
                "The system on the phone does not let the app restart it. Please start the bootloader by hand."),
                fastboot_steps()))

    def oem_done(self):
        self.need_oem = False
        self.done.discard((self.device.serial or self.device.key, "bootloader"))
        self.render()

    def in_bootloader(self, prefs):
        d, config = self.device, self.win.config
        unlocked = bootloader_open(d)
        if unlocked is False:
            self.add_unlock(prefs)
            return
        if unlocked is None or not rescue_partition(d):
            prefs.add(Adw.PreferencesGroup(title=_("The bootloader does not answer as expected"), description=_(
                "Restart the phone into the bootloader and connect it again.")))
            return
        self.add_status(prefs, _("Starting the rescue system"))
        if pending_rescue(config, d.serial):
            # Still there from an earlier try: starting the phone starts it
            self.automatic("rescue", lambda step: d.access.reboot(), self.started_restart)
        else:
            self.automatic("rescue", lambda step: flash_rescue(d, config, step), self.started_restart)

    def add_unlock(self, prefs):
        d = self.device
        if d.access.unlock_ability is False:
            # Only Volla OS can turn it on: there and back, the app restarts the phone both ways
            group = Adw.PreferencesGroup(title=_("OEM unlocking is still off"), description=_(
                "It is turned on in Volla OS. The phone restarts into it, then this page shows what to do."))
            group.add(button_row(_("Restart into Volla OS"), "system-reboot-symbolic", self.to_system, suggested=True))
            prefs.add(group)
            return
        group = Adw.PreferencesGroup(title=_("Unlock the bootloader"), description=self.error or _(
            "Plinius needs it. Unlocking erases all data on the phone: apps, photos, messages and accounts."))
        if self.status and (d.serial or d.key, "unlock") in self.done and not self.error:
            group.add(spinner_row(self.status))
        else:
            button = button_row(_("Unlock and erase…"), "changes-allow-symbolic", self.confirm_unlock)
            button.add_css_class("destructive-action")
            group.add(button)
        prefs.add(group)

    def to_system(self):
        self.need_oem = True
        d = self.device
        in_thread(lambda: d.access.reboot(""), lambda *_a: False)

    def confirm_unlock(self):
        d = self.device

        def response(rid):
            if rid != "unlock":
                return
            self.done.discard((d.serial or d.key, "unlock"))
            self.status = _("Confirm on the phone: press Volume up to unlock.")
            self.automatic("unlock", lambda step: unlock_bootloader(d, step), self.unlocked)
            self.render()

        alert(self.win, _("Unlock the bootloader?"), _(
            "This erases all personal data on the phone: apps, photos, messages and accounts. It cannot be undone. "
            "The phone then asks once more; press Volume up there to unlock."),
              [("cancel", _("Cancel")), ("unlock", _("Unlock and erase"))], response, Adw.ResponseAppearance.DESTRUCTIVE)

    def unlocked(self):
        self.erased = True
        self.render()

    # Step 3: install, in the rescue system

    def show_layout(self, prefs, layout):
        """Nothing about the systems: only the plan for Plinius (see after_layout)."""

    def after_layout(self, prefs):
        image, card = self.source.image, self.device.layout and self.device.layout["card"]
        if not image:
            self.show_steps(DOWNLOAD)
            group = Adw.PreferencesGroup(title=_("Download Plinius"), description=_(
                "The phone is ready. Once Plinius is downloaded and checked, it goes on by itself."))
            group.add(image_row(self.source, self))
            if self.source.offer:
                group.add(button_row(_("Choose an image file…"), "document-open-symbolic", self.source.choose_file))
            prefs.add(group)
            return
        self.show_steps(INSTALL)
        choices = wizard_card_choices(card, card_choices(card, image)) \
            if card and not self.source.problems.get("card") else []
        if self.choice not in choices:
            # Only a way where nothing is lost is chosen for the user; anything else they choose themselves
            safe = [c for c in choices if c["kind"] in ("free", "add")]
            self.choice = safe[0] if safe else None
        self.add_where(prefs, card, choices)
        self.add_summary(prefs)
        if self.needs_pin():
            self.add_pin_group(prefs)
        if self.target == "phone":
            self.add_phone_plan(prefs)
        else:
            self.add_card_go(prefs, card)
        self.update_install()

    def inside(self):
        """The system inside the phone for the texts: {"name": ..., "Name": ...}, the latter for the start of
        a sentence. Its own name if the rescue system could tell (see phone_system), else "the current system"."""
        found = (self.device.layout or {}).get("phone") or {}
        name = found.get("name") if found.get("kind") != "unknown" else ""
        if name:
            return {"name": name, "Name": name}
        return {"name": _("the current system"), "Name": _("The current system")}

    def add_where(self, prefs, card, choices):
        """The question of this step: on the memory card or inside the phone. Nothing is chosen for the
        user; on the card the app picks a place where nothing is lost. Without one, the user chooses what
        is replaced, and setting the card up anew is not offered here if it holds systems."""
        names = self.inside()
        group = Adw.PreferencesGroup(title=_("Where should Plinius go?"))
        card_row, card_check = radio_row(_("On the memory card"), _(
            "Recommended. {Name} stays inside the phone, and at each start a menu lets you choose.").format(**names),
            active=self.target == "card")
        phone_row, phone_check = radio_row(_("Inside the phone"), _(
            "Replaces {name}: everything on it is erased. Plinius then starts without a memory card, and "
            "faster.").format(**names), group=card_check, active=self.target == "phone")
        # Neither is active at first: a hidden third button of the same group holds that state
        none = Gtk.CheckButton(active=self.target is None)
        none.set_group(card_check)
        problem = self.card_problem(card, choices)
        if problem:
            card_row.set_subtitle(problem)
            card_check.set_sensitive(False)
            card_row.set_activatable(False)
            again = Gtk.Button(label=_("Look again"), valign=Gtk.Align.CENTER)
            again.connect("clicked", lambda _b: self.look_again())
            card_row.add_suffix(again)
        if self.source.problems.get("phone"):
            phone_row.set_subtitle(self.source.problems["phone"])
            phone_row.set_sensitive(False)
        for check, target in ((card_check, "card"), (phone_check, "phone")):
            check.connect("toggled", lambda c, t=target: c.get_active() and self.set_target(t))
        group.add(card_row)
        if self.target == "card" and choices:
            safe = [c for c in choices if c["kind"] in ("free", "add")]
            if not safe:
                r = row(_("There is no free space on the card. Choose what Plinius should replace:"))
                r.add_prefix(Gtk.Image(icon_name="dialog-warning-symbolic", css_classes=["warning"]))
                r.set_margin_start(24)
                group.add(r)
            if len(choices) > 1 or not safe:
                self.add_choice_rows(group, card, choices)
            else:
                r = row(*self.choice_text(card, self.choice))
                r.set_margin_start(24)
                group.add(r)
        group.add(phone_row)
        prefs.add(group)

    def card_problem(self, card, choices):
        """Why Plinius cannot go onto the card, in words for everybody; "" if it can."""
        image = self.source.image
        if self.source.problems.get("card"):
            return self.source.problems["card"]
        if not card:
            return _("No memory card found. Put one of {size} or more into the phone, then look again.").format(
                size=card_size_hint(card_need(image)))
        if not choices and card["size"] < card_need(image):
            return _("The memory card is too small: Plinius needs {need} or more, this one has {size}.").format(
                need=card_size_hint(card_need(image)), size=size_text(card["size"]))
        if not choices:
            return _("There is no free space on the card, and none of its systems can be replaced. Setting it up "
                     "anew would erase everything on it; that is under Advanced in the menu.")
        return ""

    def add_summary(self, prefs):
        group = Adw.PreferencesGroup(title=_("Plinius"))
        change = Gtk.Button(label=_("Done") if self.editing else _("Change"), valign=Gtk.Align.CENTER,
                            css_classes=["flat"])
        change.connect("clicked", lambda _b: self.toggle_editing())
        group.set_header_suffix(change)
        if self.editing:
            group.add(image_row(self.source, self, change=True))
            group.add(self.language_row())
        else:
            r = row(self.source.title(), size_text(self.source.image.size))
            r.add_prefix(Gtk.Image(icon_name="system-software-install-symbolic"))
            group.add(r)
            r = row(_("Language"), self.language_name())
            r.add_prefix(Gtk.Image(icon_name="preferences-desktop-locale-symbolic"))
            group.add(r)
        prefs.add(group)

    def toggle_editing(self):
        self.editing = not self.editing
        self.render()

    def set_target(self, target):
        if target != self.target:
            self.target = target
            self.render()

    def add_choice_rows(self, group, card, choices):
        first = None
        if self.choice is None:
            # Nothing chosen yet: a hidden button of the group holds that state
            first = Gtk.CheckButton(active=True)
        for choice in choices:
            title, text = self.choice_text(card, choice)
            r, check = radio_row(title, text, group=first, active=choice == self.choice)
            r.set_margin_start(24)
            first = first or check
            check.connect("toggled", lambda c, ch=choice: c.get_active() and self.set_choice(ch))
            if choice["kind"] not in ("free", "add"):
                r.add_suffix(Gtk.Image(icon_name="dialog-warning-symbolic", css_classes=["warning"]))
            group.add(r)

    def set_choice(self, choice):
        if choice != self.choice:
            self.choice = choice
            self.render()

    def language_name(self):
        return next(e[1] for e in SYSTEM_LANGUAGES if e[0] == self.language)

    def language_row(self):
        names = [name for _code, name, *_rest in SYSTEM_LANGUAGES]
        combo = Adw.ComboRow(title=_("Language"), subtitle=_("The keyboard follows it. Settings on the phone change "
                                                             "both later."), model=Gtk.StringList.new(names))
        combo.set_selected(next(i for i, e in enumerate(SYSTEM_LANGUAGES) if e[0] == self.language))
        combo.connect("notify::selected", lambda c, _p: setattr(self, "language", SYSTEM_LANGUAGES[c.get_selected()][0]))
        return combo

    def needs_pin(self):
        """Older images: the app sets the PIN, otherwise the lock screen could never be passed."""
        return not (self.source.image and self.source.image.first_start)

    def add_pin_group(self, prefs):
        group = Adw.PreferencesGroup(title=_("PIN"), description=_(
            "Plinius asks for it on the lock screen. Choose 4 to 12 digits and keep it in mind."))
        for attr, title in (("pin", _("PIN")), ("pin_again", _("Repeat PIN"))):
            entry = Adw.PasswordEntryRow(title=title, text=getattr(self, attr))
            entry.set_input_purpose(Gtk.InputPurpose.PIN)
            entry.connect("changed", lambda e, a=attr: (setattr(self, a, e.get_text()), self.update_install()))
            group.add(entry)
        self.pin_note = row("", visible=False)
        self.pin_note.add_prefix(Gtk.Image(icon_name="dialog-information-symbolic"))
        group.add(self.pin_note)
        prefs.add(group)

    def pin_ready(self):
        return not (self.needs_pin() and pin_problem(self.pin, self.pin_again))

    def update_install(self):
        """Whether the PIN is complete; the note says what is missing."""
        if self.pin_note:
            problem = pin_problem(self.pin, self.pin_again) if self.pin or self.pin_again else ""
            self.pin_note.set_title(problem)
            # Not while the second one is still being typed
            typing = 0 < len(self.pin_again) < len(self.pin)
            self.pin_note.set_visible(bool(problem) and (not self.pin.isdigit() or len(self.pin) > 12
                                                         or bool(self.pin_again) and not typing))
        if self.go_button:
            self.go_button.set_sensitive(self.pin_ready() and getattr(self.go_button, "allowed", True))

    def add_card_go(self, prefs, card):
        safe = self.target != "card" or not self.choice or self.choice["kind"] in ("free", "add")
        if not self.target:
            text = _("Choose above where Plinius should go.")
        elif not self.choice:
            text = _("Choose above what Plinius should replace.")
        else:
            text = _("This takes up to an hour. Keep the phone connected.")
        group = Adw.PreferencesGroup(description=text)
        self.go_button = button_row(_("Install Plinius") if safe else _("Erase and install Plinius"),
                                    "system-software-install-symbolic", lambda: self.confirm_card(card))
        self.go_button.add_css_class("suggested-action" if safe else "destructive-action")
        self.go_button.allowed = self.target == "card" and self.choice is not None
        group.add(self.go_button)
        prefs.add(group)

    def add_phone_plan(self, prefs):
        d, config, image = self.device, self.win.config, self.source.image
        size = max(PHONE_SYSTEM_DEFAULT, image.size)
        problem = phone_install_problem(d, config, image, size)
        if problem:
            prefs.add(Adw.PreferencesGroup(title=_("Inside the phone"), description=problem))
            return
        inside = self.inside()
        empty = INTERNAL_CHANGES if self.erased else ()
        names = phone_changes(pending_rescue(config, d.serial)["partition"][len("init_boot"):])
        missing = self.add_volla_backup(prefs, names, empty)
        group = Adw.PreferencesGroup(description=_("This takes up to an hour. Keep the phone connected."))
        self.go_button = button_row(_("Erase {name} and install").format(**inside), "system-software-install-symbolic",
                                    lambda: self.run(lambda job: run_install_phone(
                                        job, d, config, image, size, pin_hash=self.pin_hash, empty=empty,
                                        language=self.language)))
        self.go_button.add_css_class("destructive-action")
        # Unlocking erased the data a moment ago: there is nothing left to copy, only the backup counts
        self.go_button.allowed = self.erased and not missing
        if not self.erased:
            sure = Adw.SwitchRow(title=_("I have copied what I still need"),
                                 subtitle=_("{Name} is erased with all its data.").format(**inside))

            def toggled(s, _p):
                self.go_button.allowed = s.get_active() and not missing
                self.update_install()

            sure.connect("notify::active", toggled)
            group.add(sure)
        group.add(self.go_button)
        prefs.add(group)

    def add_volla_backup(self, prefs, names, empty):
        """The way back to Volla OS, in words for everybody: whether it is backed up, and one button. The
        partitions are the same as on the Advanced pages (see backup_group), only not named here."""
        d, win, inside = self.device, self.win, self.inside()
        missing = missing_backup(win.backups, d, names, empty)
        group = Adw.PreferencesGroup(title=_("Back up {name} first").format(**inside), description=_(
            "That is the way back. The backup is kept on this computer."))
        if missing:
            group.add(check_row(_("Not backed up yet"), "", False))
            title = _("Back up {name}").format(**inside)
            group.add(button_row(title + "…", "document-save-symbolic",
                                 lambda: win.push(BackupCreatePage(win, d, select=missing, simple=title)),
                                 suggested=True, sensitive=d.can_read))
        else:
            group.add(check_row(_("{Name} is backed up").format(**inside), _("On this computer"), True))
        prefs.add(group)
        return missing

    def choice_text(self, card, choice):
        """Where on the card, in words for everybody: no partition numbers, only what is kept and lost."""
        kind = choice["kind"]
        if kind == "free":
            p = choice["place"]
            return _("Into the free space"), _("{size} on the card are unused. Nothing on the card is erased.").format(
                size=size_text(p["system"]["size"] + p["data"]["size"]))
        if kind == "add":
            return _("Into the free space"), _("{system} for Plinius and {data} for your files. Nothing on the card is "
                                               "erased.").format(system=size_text(choice["system"]),
                                                                 data=size_text(choice["data"]))
        if kind == "replace":
            place = choice["place"]
            title = place["title"] or _("Unnamed system")
            users = home_users(card)
            others = sorted({t for part in (place["system"], place["data"]) for t in users.get(part["number"], ())
                             if t != title})
            text = [_("{title} and its files on the card are erased.").format(title=title)]
            text += [_("The personal files of {title} are there as well and are erased too.").format(title=t)
                     for t in others]
            return _("Instead of {title}").format(title=title), " ".join(text)
        data = card["size"] - choice["settings"] - choice["system"]
        return _("Erase the memory card and set it up anew"), _(
            "Everything on the card is erased. {system} for Plinius and about {data} for your files.").format(
            system=size_text(choice["system"]), data=size_text(data))

    def confirm_card(self, card):
        d, choice, image = self.device, self.choice, self.source.image

        def work(job):
            run_install_card(job, d, card, choice, image, None, self.pin_hash, self.language,
                             then=leave_steps(d, self.win.config))
            return leave_rescue(job, d, self.win.config)

        if choice["kind"] in ("free", "add"):
            self.run(work)
            return
        title, text = self.choice_text(card, choice)
        if choice["kind"] == "fresh":
            text += "\n\n" + card_contents(card)
        alert(self.win, _("Erase and install?"), text, [("cancel", _("Cancel")), ("go", _("Erase and install"))],
              lambda rid: rid == "go" and self.run(work), Adw.ResponseAppearance.DESTRUCTIVE)

    def look_again(self):
        self.device.layout = None
        self.render()

    def run(self, work):
        """work(job) on an OperationPage; it returns False if the phone stays in the rescue system."""
        d, win, target, names = self.device, self.win, self.target, self.inside()
        self.pin_hash = sha512_crypt(self.pin) if self.needs_pin() else None
        self.pin = self.pin_again = ""
        page = OperationPage(_("Installing Plinius"), "system-software-install-symbolic")
        job = Job(page)
        win.nav.push(page)
        # The phone changes from the rescue system to the bootloader and on: probe neither meanwhile
        keys = {d.key, "fastboot:" + d.serial}
        win.scanner.busy.update(keys)
        self.working = True
        self.render()

        def body():
            try:
                return "ok" if work(job) is not False else "original"
            except Cancelled:
                return "cancelled"

        def to_main():
            win.nav.pop_to_tag("main")

        def back():
            d.layout = None
            win.nav.pop_to_page(self)
            self.render()

        def done(result, error):
            win.scanner.busy.difference_update(keys)
            self.working = False
            if result == "ok":
                self.finished = True
                self.render()
                if target == "phone":
                    text = _("The phone is starting Plinius. The first start takes a few minutes; unlock it with your "
                             "PIN. With a memory card in the phone, choose VollaOS in its boot menu: that entry now "
                             "starts Plinius.")
                else:
                    text = _("The phone is starting. At every start a menu shows for five seconds, then it starts "
                             "Plinius by itself. Its entry VollaOS starts what is inside the phone: {name}. The first "
                             "start of Plinius takes a few minutes; unlock it with your PIN.").format(**names)
                page.finish(True, _("Plinius is installed"), text, [(_("Done"), to_main, "suggested-action")])
            elif result == "original":
                page.finish(False, _("Almost done"), _(
                    "Plinius is installed, but the phone still holds the rescue system: the original it replaced was "
                    "not found on the update server. Choose it on the next page, as a file."),
                            [(_("Continue"), lambda: (back(), win.push(RescuePage(win, self.device))), "suggested-action")])
            elif result == "cancelled":
                page.finish(False, _("Cancelled"), _(
                    "The boot menu still shows what it showed before. Start again when you are ready."),
                            [(_("Back"), back, None)])
            else:
                page.finish(False, _("Plinius was not installed"), _(
                    "{error}\n\nThe phone still holds the rescue system, so you can try again.").format(error=error),
                            [(_("Back"), back, None)])
            win.scanner.rescan()
            return False

        in_thread(body, done)


class Window(Adw.ApplicationWindow):
    """Main window: how to prepare a phone, then the phones, connected or known from earlier, inside a
    navigation view. A connected phone leads to the guided installation (InstallPage); its systems and
    backups are under Advanced there (see PhonePage)."""

    def __init__(self, app):
        super().__init__(application=app, title=APP_NAME, default_width=760, default_height=860)
        global STEP_CSS_LOADED
        if not STEP_CSS_LOADED:
            load_step_css()
            STEP_CSS_LOADED = True
        self.config = load_config()
        self.listeners = {}
        # The newest image of Plinius is looked up from the start, and downloaded once the user decides
        self.images = ImageSource(self)
        self.download_bar = self.download_row = None
        self.toasts = Adw.ToastOverlay()
        self.nav = Adw.NavigationView()
        self.nav.connect("popped", lambda _nav, page: (self.listeners.pop(page, None),
                                                       self.images.listeners.pop(page, None)))
        self.toasts.set_child(self.nav)
        self.set_content(self.toasts)
        # All backups in the storage location (see refresh_backups); the phone pages pick their own
        self.backups = []

        header = Adw.HeaderBar()
        menu = Gio.Menu()
        menu.append(_("Inspect image file…"), "win.inspect")
        menu.append(_("Search again"), "win.rescan")
        menu.append(_("Check the tools"), "win.tools")
        menu.append(_("About {name}").format(name=APP_NAME), "win.about")
        header.pack_end(Gtk.MenuButton(icon_name="open-menu-symbolic", menu_model=menu))
        for name, callback in (("inspect", self.on_inspect), ("rescan", lambda *_a: self.scanner.rescan()),
                               ("tools", self.on_check_tools),
                               ("about", self.on_about)):
            action = Gio.SimpleAction(name=name)
            action.connect("activate", callback)
            self.add_action(action)
        self.scanner = Scanner(self.config, self.on_devices_changed)
        toolbar = Adw.ToolbarView(content=self.build_devices())
        toolbar.add_top_bar(header)
        self.nav.add(Adw.NavigationPage(title=APP_NAME, tag="main", child=toolbar))
        self.refresh_backups()
        self.scanner.start()
        self.images.listeners["main"] = self
        self.image_changed()
        self.images.look()

    def toast(self, text):
        self.toasts.add_toast(Adw.Toast(title=text, use_markup=False))

    def push(self, page):
        """Push a page; pages with on_devices get device list updates while they are open."""
        if hasattr(page, "on_devices"):
            self.listeners[page] = page.on_devices
        self.nav.push(page)

    def back_to_phone(self, device):
        """Back to the page of this phone, which follows it through restarts; the main page if there is none."""
        stack = self.nav.get_navigation_stack()
        for i in reversed(range(stack.get_n_items())):
            page = stack.get_item(i)
            if isinstance(page, (PhonePage, InstallPage, ChangePage)) and (page.device is device or device.serial and
                                                page.device.serial == device.serial):
                self.nav.pop_to_page(page)
                return
        self.nav.pop_to_tag("main")

    # Phones

    def build_devices(self):
        self.device_stack = Gtk.Stack()
        # Step 1: connect, always the start page, also once phones are known. The phone page that follows
        # is step 2 (see InstallPage). What changes with the phones is drawn by update_phone_list
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=24)
        self.connected_holder = Adw.Bin()
        box.append(self.connected_holder)
        self.image_holder = Adw.Bin()
        box.append(self.image_holder)
        self.known_holder = Adw.Bin()
        box.append(self.known_holder)
        status = Adw.StatusPage(icon_name="phone-symbolic", title=_("Connect the phone"), vexpand=True,
                                description=GLib.markup_escape_text(_(
                                    "Connect the Volla Phone Plinius to this computer with a USB-C cable. The app "
                                    "finds it by itself.")))
        status.set_child(Adw.Clamp(maximum_size=560, child=box))
        start = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        start.append(StepBar(CONNECT))
        start.append(status)
        self.device_stack.add_named(start, "start")
        self.tools_page = Adw.PreferencesPage()
        self.device_stack.add_named(self.tools_page, "tools")
        self.tools_ok, self.guided = False, set()
        self.usb_banner = Adw.Banner()
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        box.append(self.usb_banner)
        self.device_stack.set_vexpand(True)
        box.append(self.device_stack)
        self.check_tools_now()
        return box

    def image_changed(self):
        """The image on the start page: which one, nothing is downloaded yet."""
        group = Adw.PreferencesGroup()
        group.add(image_row(self.images, self, pending=True))
        self.image_holder.set_child(group)

    def image_progress(self):
        show_image_progress(self.images, self)

    def check_tools_now(self, *_args):
        """Whether the programs the app needs are there and run; nothing else works without them."""
        in_thread(check_tools, self.show_tools)

    def show_tools(self, tools, error):
        self.tools_ok = not error and not any(problem for _n, _p, problem in tools)
        if self.tools_ok:
            self.on_devices_changed()
            return False
        self.device_stack.remove(self.tools_page)
        self.tools_page = Adw.PreferencesPage()
        missing = [n for n, _p, problem in tools or () if problem]
        group = Adw.PreferencesGroup(title=_("The app needs a few programs"), description=_(
            "Please provide what is missing here, then check again."))
        for name, purpose, problem in tools or ():
            group.add(check_row(name, problem or purpose, not problem))
        self.tools_page.add(group)
        family = system_family()
        hint = install_hint(missing, family)
        how = Adw.PreferencesGroup(title=_("How to provide them"))
        if IN_FLATPAK:
            how.set_description(_("The Flatpak brings these programs along, so it seems to be damaged. "
                                  "Please install it again."))
        elif hint:
            how.set_description(_("Run this in a terminal:"))
            how.add(info_row(_("Command"), hint))
        else:
            how.set_description(_("Install them with your system's package manager, or use the Flatpak of this "
                                  "app, which brings them along."))
        how.add(button_row(_("Check again"), "view-refresh-symbolic", self.check_tools_now, suggested=True))
        self.tools_page.add(how)
        self.device_stack.add_named(self.tools_page, "tools")
        self.device_stack.set_visible_child_name("tools")
        return False

    def known_phones(self):
        """[(serial number, name)] of the phones known from their backups or from an earlier connection."""
        names = {}
        for b in self.backups:
            serial = b.device.get("serial")
            if serial:
                names.setdefault(clean_text(serial), b.title())
        # The scanner adds to "known" in its own thread
        for serial, profile in list(self.config.get("known", {}).items()):
            if isinstance(serial, str) and serial:
                found = next((p.name for p in PROFILES if p.id == profile), _("Unknown phone"))
                names.setdefault(clean_text(serial), found)
        return sorted(names.items(), key=lambda item: (item[1], item[0]))

    def waiting_box(self):
        """No phone yet: how to make it show up, and that the app is waiting."""
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=24)
        how = Adw.PreferencesGroup()
        usb = Adw.ExpanderRow(title=_("Is USB debugging on?"), subtitle=_("How to turn it on"))
        for n, text in enumerate(prepare_steps(), 1):
            r = row(text)
            r.add_prefix(Gtk.Label(label=str(n), width_chars=2, css_classes=["dim-label"]))
            usb.add_row(r)
        how.add(usb)
        box.append(how)
        searching = Gtk.Box(halign=Gtk.Align.CENTER, spacing=8)
        searching.append(Adw.Spinner())
        searching.append(Gtk.Label(label=_("Waiting for the phone…"), css_classes=["dim-label"]))
        box.append(searching)
        return box

    def phone_row(self, d):
        """A connected phone and what to do with it. Without a login the app knows nothing about it yet,
        so it does not pretend to: it says where it is and asks for the login."""
        if d.keys_only:
            r = row(_("A phone in the USB network"), d.problem)
        elif d.login and not d.info:
            r = row(_("A phone in the USB network"), _(
                "Log in with the user name and password of its system to continue."))
        else:
            parts = [d.mode_text()] + ([d.serial] if d.serial else [])
            if d.mode == "fastboot" and d.access and d.access.vars.get("unlocked") == "no":
                parts.append(_("locked"))
            r = row(d.title(), d.problem if d.login or not d.access and d.problem else " · ".join(parts))
        r.add_prefix(Gtk.Image(icon_name="phone-symbolic", icon_size=Gtk.IconSize.LARGE))
        if d.keys_only:
            b = Gtk.Button(label=_("Start the bootloader…"), valign=Gtk.Align.CENTER, css_classes=["suggested-action"])
            b.connect("clicked", lambda _b: self.bootloader_help())
            r.add_suffix(b)
        elif d.login:
            b = Gtk.Button(label=_("Log in…"), valign=Gtk.Align.CENTER, css_classes=["suggested-action"])
            b.connect("clicked", lambda _b, d=d: self.login(d))
            r.add_suffix(b)
        elif d.access:
            r.add_suffix(Gtk.Image(icon_name="go-next-symbolic"))
            r.set_activatable(True)
            r.connect("activated", lambda _r, d=d: self.push(InstallPage(self, d)))
        return r

    def update_phone_list(self):
        """The connected phones, or how to connect one; below, folded, the known ones that are not
        connected, for their backups. Returns the connected ones and whether any known one is listed."""
        devices = self.scanner.visible()
        if devices:
            group = Adw.PreferencesGroup(title=_("Found"))
            for d in devices:
                group.add(self.phone_row(d))
            self.connected_holder.set_child(group)
        else:
            self.connected_holder.set_child(self.waiting_box())
        connected = {d.serial for d in devices if d.serial}
        known = [(serial, name) for serial, name in self.known_phones() if serial not in connected]
        if known:
            group = Adw.PreferencesGroup()
            earlier = Adw.ExpanderRow(title=_("Earlier phones and backups"), subtitle=_(
                "Their backups, also without a connection"))
            earlier.add_prefix(Gtk.Image(icon_name="drive-harddisk-symbolic"))
            for serial, name in known:
                r = row(name, " · ".join((MODES["offline"], serial)), activatable=True)
                r.add_suffix(Gtk.Image(icon_name="go-next-symbolic"))
                r.connect("activated", lambda _r, s=serial, n=name: self.push(
                    PhonePage(self, offline_device(s, n, self.config))))
                earlier.add_row(r)
            group.add(earlier)
            self.known_holder.set_child(group)
        else:
            self.known_holder.set_child(None)
        return devices, bool(known)

    def on_devices_changed(self):
        devices, known = self.update_phone_list()
        self.update_usb_banner()
        if not self.tools_ok:
            return False
        self.device_stack.set_visible_child_name("start")
        self.open_guide(devices)
        for callback in list(self.listeners.values()):
            callback(devices)
        return False

    def update_usb_banner(self):
        """Nothing else would say why a connected phone does not appear."""
        family = system_family()
        package = UDEV_PACKAGES.get(family)
        self.usb_banner.set_title(_("A phone is connected, but this user may not open it over USB. Install the "
                                    "package {package}, then connect it again.").format(package=package) if package
                                  else _("A phone is connected, but this user may not open it over USB. It needs "
                                         "udev rules for Android devices."))
        self.usb_banner.set_revealed(self.scanner.usb_blocked)

    def open_guide(self, devices):
        """A phone that turns up leads to the installation right away, once per phone. Only from the main
        page: never away from something the user is doing."""
        if self.nav.get_visible_page().get_tag() != "main":
            return
        for d in devices:
            if d.access and d.serial and d.serial not in self.guided:
                self.guided.add(d.serial)
                self.push(InstallPage(self, d))
                return

    def bootloader_help(self):
        """For a system that lets in keys only: how to reach the bootloader, where the app starts the rescue
        system."""
        alert(self, _("Start the rescue system"), _(
            "The system on the phone lets in SSH keys only, so the app cannot log in with a password. In the "
            "bootloader the app starts its rescue system and can then install and restore."),
              [("close", _("Close"))], None, extra=steps_group(None, None, fastboot_steps()))

    def login(self, device):
        """Ask for user name and password, test them, and hand them to the scanner (memory only)."""
        host, port, usbnet, link = device.login
        group = Adw.PreferencesGroup()
        user = Adw.EntryRow(title=_("User name"),
                            text=getattr(device.access, "user", "") or self.config.get("usbnet_user", ""))
        password = Adw.PasswordEntryRow(title=_("Password"))
        group.add(user)
        group.add(password)

        def response(rid):
            if rid != "login" or not user.get_text():
                return
            name, pw = user.get_text().strip(), password.get_text()
            if not valid_user(name):
                self.toast(_("This user name is not valid."))
                return

            def work():
                # Bound to the USB interface the phone was found on: if another phone is plugged
                # in by now, the password is not sent (see SshAccess.command)
                access = SshAccess(host, name, port, pw, usbnet, link)
                if access.check() != "ok":
                    return None
                return access

            def done(access, _error):
                if access is None:
                    self.toast(_("Login failed. Check the user name and password."))
                    return False
                self.scanner.passwords[(host, name)] = pw
                if usbnet:
                    self.config["usbnet_user"] = name
                    save_config(self.config)
                self.scanner.rescan()
                return False

            in_thread(work, done)

        alert(self, _("Log in to the phone"),
              _("Use the user name and password of the system on the phone. The password is only kept "
                "while this app is running."),
              [("cancel", _("Cancel")), ("login", _("Log in"))], response, Adw.ResponseAppearance.SUGGESTED,
              extra=group)

    # Backups

    def refresh_backups(self):
        """Reads the storage location again; the phone list and the open phone pages follow."""
        self.backups = list_backups(backup_dir(self.config))
        # Learn serial -> profile from backups too, so the phone is recognized in fastboot
        known = self.config.setdefault("known", {})
        if any(b.device.get("serial") and b.device.get("profile") and b.device["serial"] not in known
               for b in self.backups):
            for b in self.backups:
                if b.device.get("serial") and b.device.get("profile"):
                    known.setdefault(b.device["serial"], b.device["profile"])
            save_config(self.config)
        self.on_devices_changed()
        for page in list(self.listeners):
            if isinstance(page, PhonePage):
                page.refresh_backups()
            elif isinstance(page, (InstallPage, ChangePage)):
                page.backups_changed()

    def choose_dir(self, then=None):
        dialog = Gtk.FileDialog(title=_("Storage location for backups"))
        dialog.set_initial_folder(Gio.File.new_for_path(GLib.get_home_dir()))

        def chosen(dlg, result):
            try:
                folder = dlg.select_folder_finish(result)
            except GLib.Error:
                return
            self.config["backup_dir"] = folder.get_path()
            save_config(self.config)
            self.refresh_backups()
            if then:
                then()

        dialog.select_folder(self, None, chosen)

    # Menu

    def on_inspect(self, *_args):
        dialog = Gtk.FileDialog(title=_("Inspect image file"))

        def chosen(dlg, result):
            try:
                path = dlg.open_finish(result).get_path()
                head, compressed = read_head(path)
            except (GLib.Error, OSError, zstd.ZstdError) as e:
                if isinstance(e, GLib.Error):
                    return
                self.toast(str(e))
                return
            kind, detail = detect(head)
            body = [_("Content: {kind}").format(kind=describe(kind, detail)),
                    _("File size: {size}").format(size=size_text(os.path.getsize(path)))]
            if compressed:
                body.append(_("The file is compressed with zstd."))
            alert(self, os.path.basename(path), "\n".join(body), [("close", _("Close"))])

        dialog.open(self, None, chosen)

    def on_check_tools(self, *_args):
        def done(tools, error):
            self.show_tools(tools, error)
            if self.tools_ok:
                self.toast(_("All tools work."))
            return False
        in_thread(check_tools, done)

    def on_about(self, *_args):
        Adw.AboutDialog(application_name=APP_NAME, application_icon=APP_ID, version=VERSION,
                        comments=_("Back up and flash Volla and FuriLabs phones."),
                        license_type=Gtk.License.MIT_X11).present(self)


class App(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.DEFAULT_FLAGS)

    def do_activate(self):
        win = self.get_active_window() or Window(self)
        win.present()


def migrate_old_dirs():
    """Moves the data of the time the app was called plinius-backup: the rescue key that the rescue
    systems on phones trust, the key that signs the manifests, and the originals, without which a
    phone may not start again. Never overwrites, and the cache is simply built anew."""
    for base in (CONFIG_HOME, DATA_HOME):
        old, new = os.path.join(base, "plinius-backup"), os.path.join(base, "plinius-boot")
        if os.path.isdir(old) and not os.path.lexists(new):
            try:
                os.rename(old, new)
            except OSError as error:
                print(f"Cannot move {old} to {new}: {error}", file=sys.stderr)


if __name__ == "__main__":
    migrate_old_dirs()
    sys.exit(App().run(sys.argv))
