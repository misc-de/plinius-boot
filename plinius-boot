def default_language(names=None):
    """The language of this PC if Plinius speaks it, else English."""
    codes = [entry[0] for entry in SYSTEM_LANGUAGES]
    for name in GLib.get_language_names() if names is None else names:
        code = name.split(".")[0].split("@")[0].split("_")[0].lower()
        if code in codes:
            return code
    return "en"


def unl0kr_keyboard(keymap):
    """The keyboard of the password prompt at startup for a console keymap, as look-files of plinius-crypt
    writes it to 40-plinius-keyboard.conf; "" where the prompt keeps its US default."""
    layout = keymap.split("-")[0]
    if layout in ("de", "es", "fr"):
        hardware = f"layout={layout}"
    elif layout == "ru":
        # Latin letters stay typeable on a hardware keyboard, Alt+Shift switches
        hardware = "layout=us,ru\noptions=grp:alt_shift_toggle"
    else:
        return ""
    return f"[keyboard]\nlayout={layout}\n\n[hardware keyboard]\n{hardware}\n"


