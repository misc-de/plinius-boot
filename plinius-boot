def alert(parent, heading, body, responses, callback=None, appearance=None, extra=None):
    """Adw.AlertDialog; responses: [(id, text)], the first one closes, the last one is the default."""
    dialog = Adw.AlertDialog(heading=heading, body=body)
    for rid, label in responses:
        dialog.add_response(rid, label)
    if appearance:
        dialog.set_response_appearance(responses[-1][0], appearance)
    dialog.set_default_response(responses[-1][0])
    dialog.set_close_response(responses[0][0])
    if extra:
        dialog.set_extra_child(extra)
    if callback:
        dialog.connect("response", lambda _d, rid: callback(rid))
    dialog.present(parent)
    return dialog


