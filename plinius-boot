            self.add_unlock_group()
        self.add_rescue_group()
        toolbar = Adw.ToolbarView(content=self.prefs)
        toolbar.add_top_bar(Adw.HeaderBar())
        toolbar.add_top_bar(self.banner)
        self.set_child(toolbar)

    def add_unlock_group(self):
        """Locked bootloader: how to unlock it, step by step. The app does the last two steps itself."""
        restart = Gtk.Button(label=_("Restart"), valign=Gtk.Align.CENTER)
        restart.connect("clicked", lambda _b: self.restart(""))
        group = steps_group(_("Unlock the bootloader"), _(
            "The rescue system and restoring need an unlocked bootloader. Unlocking erases all personal data on "
            "the phone: apps, photos, messages and accounts. Device data such as the IMEI is kept. Copy anything "
            "you still need off the phone first."), unlock_steps(restart))
        # get_unlock_ability tells whether steps 1 to 4 are already done
        ability = self.device.access.unlock_ability
        if ability is not None:
            r = row(_("OEM unlocking is turned on: continue with step 5.") if ability else
                    _("OEM unlocking is not turned on yet: start with step 1."))
            r.add_prefix(Gtk.Image(icon_name="object-select-symbolic" if ability else "dialog-information-symbolic"))
            group.add(r)
        self.unlock_status = row("", visible=False)
        self.unlock_status.add_prefix(Adw.Spinner())
        group.add(self.unlock_status)
        self.unlock_button = Adw.ButtonRow(title=_("Unlock bootloader…"), start_icon_name="changes-allow-symbolic",
                                           sensitive=ability is not False)
        self.unlock_button.add_css_class("destructive-action")
        self.unlock_button.connect("activated", self.on_unlock)
        group.add(self.unlock_button)
        self.prefs.add(group)

    def on_unlock(self, *_args):
        d, scanner = self.device, self.win.scanner

        def response(rid):
            if rid != "unlock":
                return
            self.unlock_button.set_sensitive(False)
            self.unlock_status.set_visible(True)
            # No getvar from the scanner while fastboot waits for the answer on the phone
            scanner.busy.add(d.key)

            def done(_result, error):
                scanner.busy.discard(d.key)
                scanner.refresh(d.key)
                self.unlock_status.set_visible(False)
                if error:
                    self.unlock_button.set_sensitive(True)
                    alert(self.win, _("Unlocking did not finish"), error, [("close", _("Close"))])
                    return False
                self.win.back_to_phone(d)
                alert(self.win, _("Bootloader unlocked"), _(
                    "The data partition has been formatted. The rescue system can be started now."),
                      [("close", _("Close"))])
                return False

            in_thread(lambda: unlock_bootloader(d, lambda text: GLib.idle_add(self.unlock_status.set_title, text)),
                      done)

        alert(self.win, _("Unlock the bootloader?"), _(
            "This erases all personal data on the phone: apps, photos, messages and accounts. It cannot be undone. "
            "The phone then asks once more; press Volume up there to unlock."),
              [("cancel", _("Cancel")), ("unlock", _("Unlock and erase"))], response,
              Adw.ResponseAppearance.DESTRUCTIVE)

    def add_rescue_group(self):
        """Rescue system section: leave it (running: normal system or bootloader), start it (fastboot) or
        restart into the bootloader."""
        d = self.device
        if not d.access:
            return
        pending = pending_rescue(self.win.config, d.serial)
        if pending and (d.rescue or d.mode == "fastboot"):
            self.add_original_group(pending)
            if d.rescue:
                return
        if d.mode == "fastboot" and rescue_partition(d):
            self.add_flash_rescue_group(rescue_partition(d), again=bool(pending))
            return
        if d.rescue:
            group = Adw.PreferencesGroup(title=_("Rescue system"), description=_(
                "Runs only in memory. No partition is in use, so all of them can be backed up and restored. "
                "Restart the phone to leave the rescue system."))
            button = Adw.ButtonRow(title=_("Restart phone"), start_icon_name="system-reboot-symbolic")
            button.connect("activated", lambda *_a: self.restart(""))
            group.add(button)
            button = Adw.ButtonRow(title=_("Restart into bootloader"), start_icon_name="system-reboot-symbolic")
            button.connect("activated", lambda *_a: self.restart("bootloader"))
            group.add(button)
        elif d.mode == "fastboot":
            group = Adw.PreferencesGroup(title=_("Rescue system"), description=_(
                "Starts a small system only in memory; nothing is written to the phone. Afterwards all partitions "
                "can be backed up and restored. The kernel comes from a boot image of this phone, for example "
                "from an earlier backup or the boot.img of Ubuntu Touch."))
            self.kernel_row = row(_("Kernel"))
            choose = Gtk.Button(label=_("Choose file…"), valign=Gtk.Align.CENTER)
            choose.connect("clicked", self.on_choose_kernel)
            self.kernel_row.add_suffix(choose)
            group.add(self.kernel_row)
            self.rescue_button = Adw.ButtonRow(title=_("Start rescue system"),
                                               start_icon_name="media-playback-start-symbolic")
            self.rescue_button.add_css_class("suggested-action")
            self.rescue_button.connect("activated", self.on_start_rescue)
            group.add(self.rescue_button)
            sources = kernel_sources(d, backup_dir(self.win.config))
            self.set_kernel(*(sources[0] if sources else (None, None)))
        else:
            group = Adw.PreferencesGroup(title=_("Rescue system"), description=_(
                "For a complete backup without a running system, restart into the bootloader and start the "
                "rescue system there."))
            button = Adw.ButtonRow(title=_("Restart into bootloader"), start_icon_name="system-reboot-symbolic")
            button.connect("activated", lambda *_a: self.restart("bootloader"))
            # adb can do this without root, ssh cannot
            button.set_sensitive(d.mode == "adb" or d.access.root is not None)
            group.add(button)
        self.prefs.add(group)

    def add_flash_rescue_group(self, partition, again=False):
        """Start the rescue system on a phone without "fastboot boot": write it to partition (see flash_rescue).
        again: it is still there from last time (see add_original_group above it)."""
        if again:
            group = Adw.PreferencesGroup(description=_("Or start the rescue system once more, for example for "
                                                       "another backup."))
        else:
            group = Adw.PreferencesGroup(title=_("Rescue system"), description=_(
                "This phone's bootloader cannot start a system from memory. The rescue system is therefore written "
                "to {name} until you are done, and the app writes the original back afterwards. It takes the "
                "original from the update server or a file you choose, and only if it matches the checksum the "
                "phone expects.").format(name=partition))
        self.flash_status = row("")
        self.flash_status.add_prefix(Adw.Spinner())
        self.flash_status.set_visible(False)
        group.add(self.flash_status)
        self.rescue_button = Adw.ButtonRow(title=_("Start rescue system"), start_icon_name="media-playback-start-symbolic",
                                           sensitive=self.device.can_write)
        # Writing the original back is the main action then
        if not again:
            self.rescue_button.add_css_class("suggested-action")
        self.rescue_button.connect("activated", lambda *_a: self.on_flash_rescue(partition))
        group.add(self.rescue_button)
        self.prefs.add(group)

    def on_flash_rescue(self, partition):
        d, scanner = self.device, self.win.scanner

        def response(rid):
            if rid != "start":
                return
            self.rescue_button.set_sensitive(False)
            self.flash_status.set_visible(True)
            scanner.busy.add(d.key)

            def done(_result, error):
                scanner.busy.discard(d.key)
                self.flash_status.set_visible(False)
                if error:
                    self.rescue_button.set_sensitive(True)
                    alert(self.win, _("The rescue system could not be started"), error, [("close", _("Close"))])
                    return False
                self.win.back_to_phone(d)
                self.win.toast(_("The rescue system is starting. The phone appears in a moment."))
                scanner.refresh(d.key)
                return False

            in_thread(lambda: flash_rescue(d, self.win.config,
                                           lambda text: GLib.idle_add(self.flash_status.set_title, text)), done)

        alert(self.win, _("Write the rescue system to {name}?").format(name=partition), _(
            "Until the original is written back, the phone starts only the rescue system. The app does that from "
            "the phone's page when you are done."),
              [("cancel", _("Cancel")), ("start", _("Start rescue system"))], response,
              Adw.ResponseAppearance.SUGGESTED)

    def add_original_group(self, pending):
        """The rescue system is still in a partition of this phone: find the original and write it back."""
        d, partition = self.device, pending["partition"]
        self.original, self.pending = None, pending
        if d.rescue:
            text = _("The rescue system is in {name}, so the phone does not start its own system until the original "
                     "is written back. Back up first; the backup gets the original of {name} as well.")
        else:
            text = _("The rescue system is still in {name}, so the phone does not start its own system until the "
                     "original is written back.")
        group = Adw.PreferencesGroup(title=_("Rescue system"), description=text.format(name=partition))
        self.original_row = row(_("Original {name}").format(name=partition), _("Searching…"))
        self.original_spinner = Adw.Spinner()
        self.original_row.add_prefix(self.original_spinner)
        choose = Gtk.Button(label=_("Choose file…"), valign=Gtk.Align.CENTER)
        choose.connect("clicked", self.on_choose_original)
        self.original_row.add_suffix(choose)
        group.add(self.original_row)
        self.write_button = Adw.ButtonRow(title=_("Write original back and restart"),
                                          start_icon_name="system-reboot-symbolic", sensitive=False)
        self.write_button.add_css_class("suggested-action")
        self.write_button.connect("activated", self.on_write_original)
        group.add(self.write_button)
        if d.rescue:
            button = Adw.ButtonRow(title=_("Restart into bootloader"), start_icon_name="system-reboot-symbolic")
            button.connect("activated", lambda *_a: self.restart("bootloader"))
            group.add(button)
        self.prefs.add(group)
        in_thread(lambda: look_for_original(d, self.win.config, pending,
                                            lambda text: GLib.idle_add(self.original_row.set_subtitle, text)),
                  self.show_original)

    def show_original(self, result, error):
        self.original_spinner.set_visible(False)
        if error:
            self.original_row.set_subtitle(str(error))
        elif result is None:
            self.original_row.set_subtitle(_("Not found on the update server. Choose the init_boot.img or the full "
                                             "update package of the installed system."))
        else:
            self.original = result
            self.original_row.set_subtitle(_("{source}, checksum matches").format(source=result[1]))
            self.write_button.set_sensitive(self.device.can_write)
        return False

    def on_choose_original(self, _button):
        dialog = Gtk.FileDialog(title=_("Original image or update package"))

        def chosen(dlg, result):
            try:
                path = dlg.open_finish(result).get_path()
            except GLib.Error:
                return
            self.original_spinner.set_visible(True)
            self.original_row.set_subtitle(_("Checking…"))

            def check():
                name, expected = expected_original(self.device, self.win.config, self.pending)
                return original_from_file(self.device.serial, name, expected, path)

            in_thread(check, self.show_original)

        dialog.open(self.win, None, chosen)

    def on_write_original(self, *_args):
        d, scanner = self.device, self.win.scanner

        def response(rid):
            if rid != "write":
                return
            self.write_button.set_sensitive(False)
            self.original_spinner.set_visible(True)
            # The phone changes from the rescue system to fastboot: probe neither while writing
            keys = {d.key, "fastboot:" + d.serial}
            scanner.busy.update(keys)

            def done(_result, error):
                scanner.busy.difference_update(keys)
                self.original_spinner.set_visible(False)
                if error:
                    self.write_button.set_sensitive(True)
                    self.original_row.set_subtitle(str(error))
                    alert(self.win, _("The original was not written back"), error, [("close", _("Close"))])
                    return False
                self.win.back_to_phone(d)
                self.win.toast(_("The original is back; the phone is starting its own system."))
                scanner.rescan()
                return False

            in_thread(lambda: write_original(d, self.win.config, self.original,
                                             lambda text: GLib.idle_add(self.original_row.set_subtitle, text)), done)

        alert(self.win, _("Write the original back?"), _(
            "The phone restarts into the bootloader, gets the original {name} and then starts its own system. "
            "The rescue system is gone afterwards.").format(name=self.pending["partition"]),
              [("cancel", _("Cancel")), ("write", _("Write back and restart"))], response,
              Adw.ResponseAppearance.SUGGESTED)

    def set_kernel(self, text, kernel):
        """kernel: (path, size, sha256) as in start_rescue, or None."""
        self.kernel = kernel
        self.kernel_row.set_subtitle(text or _("No boot image found in the backups of this phone. "
                                               "Choose a boot image file."))
        self.rescue_button.set_sensitive(bool(kernel) and self.device.can_write)

    def on_choose_kernel(self, _button):
        dialog = Gtk.FileDialog(title=_("Boot image with kernel"))

        def chosen(dlg, result):
            try:
                path = dlg.open_finish(result).get_path()
            except GLib.Error:
                return
            try:
                kind = detect(read_head(path)[0])[0]
            except (OSError, zstd.ZstdError):
                kind = ""
            if kind != "boot":
                self.win.toast(_("This file is not a boot image with a kernel."))
                return
            # Chosen by the user: no checksum to compare
            self.set_kernel(os.path.basename(path), (path, None, None))

        dialog.open(self.win, None, chosen)

    def on_start_rescue(self, *_args):
        self.rescue_button.set_sensitive(False)

        def done(_result, error):
            if error:
                self.rescue_button.set_sensitive(True)
                alert(self.win, _("The rescue system could not be started"), error, [("close", _("Close"))])
                return False
            self.win.back_to_phone(self.device)
            self.win.toast(_("The rescue system is starting. The phone appears in a moment."))
            self.win.scanner.rescan()
            return False

        in_thread(lambda: start_rescue(self.device, self.win.config, self.kernel), done)

    def restart(self, target):
        heading = _("Restart into bootloader?") if target else _("Restart phone?")
        body = _("The phone restarts into the bootloader (fastboot mode).") if target else _(
            "The phone restarts into its normal system.")

        def response(rid):
            if rid != "restart":
                return
            in_thread(lambda: self.device.access.reboot(target), lambda *_a: False)
            self.win.back_to_phone(self.device)
            self.win.toast(_("The phone is restarting"))

        alert(self.win, heading, body, [("cancel", _("Cancel")), ("restart", _("Restart"))], response,
              Adw.ResponseAppearance.SUGGESTED)


class BackupCreatePage(Adw.NavigationPage):
    """Creating a backup of one phone: where it goes and which partitions. select: the partitions chosen at
    first, by name, or WHOLE_PHONE; without it the usual groups (DEFAULT_GROUPS). simple: the title for the
    backup in the guided installation, select fixed and in words for everybody: no partitions, no rescue
    system, only where it goes, how big it is and the button."""

    def __init__(self, win, device, select=None, simple=False):
        super().__init__(title=simple if simple else _("Create backup"))
        self.win, self.device, self.select, self.simple = win, device, select, simple
        self.parts = []
        self.searching = False
        self.banner = Adw.Banner(title=device.problem, use_markup=False, revealed=bool(device.problem))
        self.prefs = Adw.PreferencesPage()
        # In the rescue system the backup also gets the original of the partition it occupies, once
        # found (see run_backup): otherwise restoring the backup would bring back the rescue system
        self.pending, self.original = None, None
        pending = pending_rescue(win.config, device.serial)
        if pending and device.rescue:
            self.pending = pending
            group = Adw.PreferencesGroup(title=_("Rescue system"), description=_(
                "The rescue system is in {name}. The backup gets the original of {name} as well, if it is found."
            ).format(name=pending["partition"]))
            self.original_row = row(_("Original {name}").format(name=pending["partition"]), _("Searching…"))
            self.original_spinner = Adw.Spinner()
            self.original_row.add_prefix(self.original_spinner)
            group.add(self.original_row)
            if not simple:
                self.prefs.add(group)
            self.searching = True
            in_thread(lambda: look_for_original(device, win.config, pending,
                                                lambda text: GLib.idle_add(self.original_row.set_subtitle, text)),
                      self.show_original)
        where = Adw.PreferencesGroup(title=_("Storage location"))
        self.dir_row = row(backup_dir(win.config))
        change = Gtk.Button(label=_("Change…"), valign=Gtk.Align.CENTER)
        change.connect("clicked", lambda _b: win.choose_dir(self.update_dir))
        self.dir_row.add_suffix(change)
        where.add(self.dir_row)
        self.prefs.add(where)
        self.loading = Adw.PreferencesGroup(title="" if simple else _("Partitions"))
        self.loading.add(spinner_row(_("One moment…") if simple else _("Reading the partition list…")))
        self.prefs.add(self.loading)
        self.list = PartitionList(self.prefs, self.update_summary)

        toolbar = Adw.ToolbarView(content=self.prefs)
        toolbar.add_top_bar(Adw.HeaderBar())
        toolbar.add_top_bar(self.banner)
        bottom = Gtk.Box(spacing=12, margin_start=12, margin_end=12, margin_top=6, margin_bottom=6)
        self.summary = Gtk.Label(xalign=0, hexpand=True, wrap=True, css_classes=["dim-label"])
        bottom.append(self.summary)
        self.backup_button = Gtk.Button(label=_("Create backup"), css_classes=["suggested-action", "pill"],
                                        sensitive=False)
        self.backup_button.connect("clicked", self.on_backup)
        bottom.append(self.backup_button)
        toolbar.add_bottom_bar(bottom)
        self.set_child(toolbar)
        in_thread(device.load_parts, self.show_parts)

    def update_dir(self):
        self.dir_row.set_title(backup_dir(self.win.config))

    def show_original(self, result, error):
        self.original_spinner.set_visible(False)
        self.searching = False
        if error:
            self.original_row.set_subtitle(str(error))
        elif result is None:
            self.original_row.set_subtitle(_("Not found on the update server; the backup is made without it."))
        else:
            self.original = result
            self.original_row.set_subtitle(_("{source}, checksum matches").format(source=result[1]))
        self.update_summary()
        return False

    def show_parts(self, parts, error):
        self.prefs.remove(self.loading)
        if error:
            self.banner.set_title(_("Could not read the partition list: {error}").format(error=error))
            self.banner.set_revealed(True)
            return False
        self.parts = parts
        if self.simple:
            group = Adw.PreferencesGroup(title=_("What is backed up"))
            r = row(_("Everything Plinius overwrites"), _("{size}; packed, the backup is mostly much smaller.").format(
                size=size_text(sum(p.size for p in self.selection()))))
            r.add_prefix(Gtk.Image(icon_name="phone-symbolic"))
            group.add(r)
            self.prefs.add(group)
            self.update_summary()
            return False
        items = []
        for p in parts:
            subtitle = [size_text(p.size)]
            if p.kind:
                subtitle.append(describe(p.kind, p.detail))
            if p.busy != "-":
                subtitle.append(BUSY.get(p.busy, p.busy))
            if not p.restorable:
                subtitle.append(_("backup only"))
            if self.select is None:
                chosen = p.group in DEFAULT_GROUPS
            else:
                chosen = self.select == WHOLE_PHONE or p.name in self.select
            items.append((p.name, p.group, p.name, " · ".join(subtitle), chosen, None))
        self.list.show(items)
        return False

    def selection(self):
        if self.simple:
            return [p for p in self.parts if p.name in self.select]
        chosen = set(self.list.selected())
        return [p for p in self.parts if p.name in chosen]

    def update_summary(self):
        parts = self.selection()
        total = sum(p.size for p in parts)
        text = ngettext("{n} partition selected, {size}", "{n} partitions selected, {size}",
                        len(parts)).format(n=len(parts), size=size_text(total))
        # Without the original the backup holds the rescue system there, and that is no way back
        waiting = self.searching and any(p.name == self.pending["partition"] for p in parts)
        if waiting:
            text += " · " + _("Waiting for the original of {name}…").format(name=self.pending["partition"])
        if self.simple:
            text = _("{size} to back up").format(size=size_text(total)) if parts else ""
            lost = self.pending and not self.searching and not self.original and \
                any(p.name == self.pending["partition"] for p in parts)
            if waiting:
                text += " · " + _("Getting the last part from the update server…")
            elif lost:
                text += " · " + _("A part is not on the update server, so this backup is no way back. Advanced in "
                                  "the menu has more ways.")
        self.summary.set_label(text)
        self.backup_button.set_sensitive(bool(parts) and not waiting and self.device.key in self.win.scanner.devices)

    def on_devices(self, devices):
        gone = self.device.key not in self.win.scanner.devices
        if gone:
            self.banner.set_title(_("The phone was disconnected."))
            self.banner.set_revealed(True)
        self.update_summary()

    def on_backup(self, _button):
        """Warn about mounted partitions, then check the free space, then start the backup."""
        parts = self.selection()
        busy = [p.name for p in parts if p.busy == "mounted"]
        if busy and not self.device.rescue:
            alert(self.win, _("Some partitions are in use"),
                  _("{names} are mounted by the running system and can change while they are read. Their "
                    "backup may be inconsistent. For a consistent backup, start the rescue system from the "
                    "bootloader.").format(names=", ".join(busy)),
                  [("cancel", _("Cancel")), ("go", _("Back up anyway"))],
                  lambda rid: rid == "go" and self.check_space(parts))
        else:
            self.check_space(parts)

    def check_space(self, parts):
        base = backup_dir(self.win.config)
        os.makedirs(base, exist_ok=True)
        total, free = sum(p.size for p in parts), shutil.disk_usage(base).free
        if free < total:
            alert(self.win, _("Possibly not enough space"),
                  _("The selected partitions hold {total}, but only {free} are free in {dir}. Backups are "
                    "compressed and often much smaller. Continue anyway?").format(
                      total=size_text(total), free=size_text(free), dir=base),
                  [("cancel", _("Cancel")), ("go", _("Continue"))],
                  lambda rid: rid == "go" and self.start_backup(parts, base))
        else:
            self.start_backup(parts, base)

    def start_backup(self, parts, base):
        """Back up into <base>/<phone>_<serial>/<timestamp> on an OperationPage."""
        d = self.device
        stamp = datetime.datetime.now().strftime("%Y-%m-%d_%H-%M-%S")
        target = os.path.join(base, safe_name(f"{d.title()}_{d.serial or 'unknown'}"), stamp)
        page = OperationPage(_("Creating backup"), "document-save-symbolic")
        job = Job(page)
        self.win.nav.push(page)
        self.win.scanner.busy.add(d.key)

        def work():
            try:
                # The original of the partition the rescue system occupies, if found by then
                rescue_in = self.pending["partition"] if self.pending and d.rescue else ""
                run_backup(job, d, parts, target, rescue_in, self.original)
                return "ok"
            except Cancelled:
                try:
                    delete_backup(target)
                except OSError:
                    pass
                return "cancelled"

        def done(result, error):
            self.win.scanner.busy.discard(d.key)
            self.win.refresh_backups()
            # Back to the phone's list of backups, where the new one is now
            finished = lambda: self.win.back_to_phone(d)
            if result == "ok":
                page.finish(True, _("Backup created"), target,
                            [(_("Show folder"), lambda: open_folder(self.win, target), None),
                             (_("Done"), finished, "suggested-action")])
            elif result == "cancelled":
                page.finish(False, _("Backup cancelled"), _("Nothing was saved."),
                            [(_("Back"), lambda: self.win.nav.pop(), None)])
            else:
                page.finish(False, _("Backup failed"),
                            _("{error}\n\nThe partitions saved so far are kept in {dir}.").format(
                                error=error, dir=target),
                            [(_("Back"), finished, None)])
            return False

        in_thread(work, done)


class BackupPage(Adw.NavigationPage):
    """One backup: info, check/delete, and restoring it to a connected phone."""

    def __init__(self, win, backup):
        super().__init__(title=backup.title())
        self.win, self.backup = win, backup
        self.targets, self.target_parts = None, {}
        self.prefs = Adw.PreferencesPage()
        d = backup.device
        info = Adw.PreferencesGroup(title=_("Backup"))
        # One row per installed system; without any, the system the backup was made from
        systems = [(system_place(s), system_text(s)) for s in backup.systems()]
        if not systems and d.get("os_id") != RESCUE_ID:
            systems = [(_("System"), d.get("os"))]
        for title, value in ((_("Phone"), backup.title()), (_("Serial number"), d.get("serial")), *systems,
                             (_("Created"), backup.created_text()),
                             (_("Size on disk"), size_text(backup.disk_size())), (_("Folder"), backup.path)):
            info.add(info_row(title, value))
        if not backup.complete:
            r = row(_("Incomplete"), _("This backup was interrupted. Only the listed partitions were saved."))
            r.add_prefix(Gtk.Image(icon_name="dialog-warning-symbolic"))
            info.add(r)
        self.prefs.add(info)

        actions = Adw.PreferencesGroup()
        for title, icon, callback in ((_("Check backup"), "emblem-ok-symbolic", self.on_verify),
                                      (_("Show folder"), "folder-open-symbolic",
                                       lambda *_: open_folder(win, backup.path)),
                                      (_("Delete backup"), "user-trash-symbolic", self.on_delete)):
            b = Adw.ButtonRow(title=title, start_icon_name=icon)
            b.connect("activated", callback)
            actions.add(b)
        self.prefs.add(actions)

        restore = Adw.PreferencesGroup(title=_("Restore"),
                                       description=_("Select a connected phone and the partitions to write back."))
        self.target_row = Adw.ComboRow(title=_("Phone"), model=Gtk.StringList())
        self.target_row.connect("notify::selected", self.on_target)
        restore.add(self.target_row)
        self.prefs.add(restore)
        self.list = PartitionList(self.prefs, self.update_summary)

        toolbar = Adw.ToolbarView(content=self.prefs)
        toolbar.add_top_bar(Adw.HeaderBar())
        bottom = Gtk.Box(spacing=12, margin_start=12, margin_end=12, margin_top=6, margin_bottom=6)
        self.summary = Gtk.Label(xalign=0, hexpand=True, wrap=True, css_classes=["dim-label"])
        bottom.append(self.summary)
        self.restore_button = Gtk.Button(label=_("Restore…"), css_classes=["destructive-action", "pill"],
                                         sensitive=False)
        self.restore_button.connect("clicked", self.on_restore)
        bottom.append(self.restore_button)
        toolbar.add_bottom_bar(bottom)
        self.set_child(toolbar)
        self.on_devices(win.scanner.visible())

    def target(self):
        i = self.target_row.get_selected()
        return self.targets[i] if self.targets and 0 <= i < len(self.targets) else None

    def on_devices(self, devices):
        current = self.target() if self.targets else None
        targets = [d for d in devices if d.can_write]
        if self.targets is not None and [d.key for d in targets] == [d.key for d in self.targets]:
            return
        self.targets = targets
        # Serial number only if several phones have the same name
        titles = [d.title() for d in targets]
        names = [f"{t} · {d.serial}" if titles.count(t) > 1 and d.serial else t
                 for t, d in zip(titles, targets)] or [_("No phone connected")]
        # set_model emits notify::selected; call on_target only once afterwards
        self.target_row.handler_block_by_func(self.on_target)
        self.target_row.set_model(Gtk.StringList.new(names))
        keys = [d.key for d in targets]
        if current and current.key in keys:
            self.target_row.set_selected(keys.index(current.key))
        self.target_row.handler_unblock_by_func(self.on_target)
        self.on_target()

    def on_target(self, *_args):
        """Load the selected phone's partition list and mark what cannot be restored."""
        device = self.target()
        self.target_parts = {}
        if device is None:
            self.show_entries(None)
            return
        if not same_model(self.backup, device):
            self.show_entries(device, _("This backup belongs to a {backup}, but the connected phone is a {device}.")
                              .format(backup=self.backup.title(), device=device.title()))
            return

        def done(parts, error):
            if self.target() is not device:
                return False
            if error:
                self.show_entries(device, _("Could not read the partition list: {error}").format(error=error))
            else:
                self.target_parts = {p.name: p for p in parts}
                self.show_entries(device)
            return False

        # Nothing is selectable until this phone's list is there (otherwise the old selection would apply)
        self.show_entries(device, _("Reading the partition list…"))
        self.summary.set_label(_("Reading the partition list…"))
        in_thread(device.load_parts, done)

    def show_entries(self, device, blocked_all=None):
        items = []
        for e in self.backup.entries:
            subtitle = f"{size_text(e['size'])} · {describe(e.get('kind', ''), e.get('detail', ''))}"
            if is_critical(e["name"]):
                subtitle += " · " + _("bootloader, only with confirmation")
            if e.get("busy", "-") != "-":
                subtitle += " · " + _("saved while in use")
            if device is None:
                blocked = _("Connect a phone to restore.")
            else:
                blocked = blocked_all or restore_problem(e, self.backup, device, self.target_parts.get(e["name"]))
            # Only for sorting into sections; restore_problem does not trust the manifest's group
            group = e["group"] if e.get("group") in GROUPS else group_of(e["name"])
            items.append((e["name"], group, e["name"], subtitle, False, blocked))
        self.list.show(items)

    def entries(self):
        chosen = set(self.list.selected())
        return [e for e in self.backup.entries if e["name"] in chosen]

    def update_summary(self):
        entries = self.entries()
        if self.target() is None:
            self.summary.set_label(_("Connect the phone with a USB cable to restore this backup."))
        else:
            self.summary.set_label(ngettext("{n} partition selected, {size}", "{n} partitions selected, {size}",
                                            len(entries)).format(n=len(entries),
                                                                 size=size_text(sum(e["size"] for e in entries))))
        self.restore_button.set_sensitive(bool(entries) and self.target() is not None)

    def on_verify(self, *_args):
        page = OperationPage(_("Checking backup"), "emblem-ok-symbolic")
        job = Job(page)
        self.win.nav.push(page)

        def work():
            try:
                return run_verify(job, self.backup)
            except Cancelled:
                return None

        def done(bad, error):
            back = [(_("Back"), lambda: self.win.nav.pop(), "suggested-action")]
            if error:
                page.finish(False, _("Check failed"), error, back)
            elif bad is None:
                page.finish(False, _("Check cancelled"), "", back)
            elif bad:
                page.finish(False, _("Backup damaged"),
                            _("These partitions do not match their checksum: {names}").format(names=", ".join(bad)),
                            back)
            else:
                page.finish(True, _("Backup is intact"), _("All partitions match their checksums."), back)
            return False

        in_thread(work, done)

    def on_delete(self, *_args):
        def response(rid):
            if rid == "delete":
                # Only the backup's own files, never the folder's other content (see delete_backup)
                try:
                    delete_backup(self.backup.path)
                    message = _("Backup deleted")
                except OSError as e:
                    message = _("The backup could not be deleted completely: {error}").format(error=e)
                self.win.refresh_backups()
                self.win.nav.pop()
                self.win.toast(message)

        alert(self.win, _("Delete backup?"),
              _("The backup from {date} is deleted from {dir}. This cannot be undone.").format(
                  date=self.backup.created_text(), dir=self.backup.path),
              [("cancel", _("Cancel")), ("delete", _("Delete"))], response, Adw.ResponseAppearance.DESTRUCTIVE)

    def on_restore(self, _button):
        """Confirmation dialog; critical partitions also need the "I understand the risk" box."""
        device, entries = self.target(), self.entries()
        names = ", ".join(e["name"] for e in entries)
        body = _("The current content of these partitions on the {device} is overwritten: {names}\n\n"
                 "This cannot be undone. Do not disconnect the cable until it is finished.").format(
                     device=device.title(), names=names)
        if not same_phone(self.backup, device):
            body += "\n\n" + _("Note: this backup was made on a different phone (serial number {serial}).").format(
                serial=self.backup.device.get("serial") or "–")
        critical = [e["name"] for e in entries if is_critical(e["name"])]
        confirm = None
        if critical:
            body += "\n\n" + _("{names} belong to the bootloader and its security settings. Writing an older "
                               "version after a system update can make the phone unable to start for good "
                               "(anti-rollback), and an old seccfg can lock the bootloader again. Only restore "
                               "them if they match the system installed now.").format(names=", ".join(critical))
            confirm = Gtk.CheckButton(label=_("I understand the risk"))
        dialog = alert(self.win, ngettext("Restore {n} partition?", "Restore {n} partitions?", len(entries)).format(
            n=len(entries)), body, [("cancel", _("Cancel")), ("restore", _("Restore"))],
            lambda rid: rid == "restore" and self.start_restore(device, entries),
            Adw.ResponseAppearance.DESTRUCTIVE, extra=confirm)
        if confirm:
            dialog.set_response_enabled("restore", False)
            dialog.set_default_response("cancel")
            confirm.connect("toggled", lambda c: dialog.set_response_enabled("restore", c.get_active()))

    def start_restore(self, device, entries):
        page = OperationPage(_("Restoring backup"), "document-revert-symbolic")
        job = Job(page)
        self.win.nav.push(page)
        self.win.scanner.busy.add(device.key)

        def work():
            try:
                run_restore(job, self.backup, entries, device)
                return "ok"
            except Cancelled:
                return "cancelled"

        def reboot():
            in_thread(device.access.reboot, lambda *_a: False)
            self.win.nav.pop()
            self.win.toast(_("The phone is restarting"))

        def done(result, error):
            self.win.scanner.busy.discard(device.key)
            device.parts = None
            back = (_("Back"), lambda: self.win.nav.pop(), None)
            if result == "ok":
                page.finish(True, _("Backup restored"), _("Restart the phone to use the restored partitions."),
                            [back, (_("Restart phone"), reboot, "suggested-action")])
            elif result == "cancelled":
                page.finish(False, _("Restore cancelled"),
                            _("The partition being written may now be incomplete. Restore it again before "
                              "restarting the phone."), [back])
            else:
                page.finish(False, _("Restore failed"), error, [back])
            self.on_target()
            return False

        in_thread(work, done)


# BackupCreatePage with every partition chosen
WHOLE_PHONE = "whole"


def backup_group(win, device, names, text, empty=()):
    """Which of names a backup of this run of the rescue system holds (see missing_backup), with the ways to
    back up the rest: these partitions alone or the whole phone. Returns (group, missing)."""
    missing = missing_backup(win.backups, device, names, empty)
    pending = pending_rescue(win.config, device.serial)
    rescue_in = pending["partition"] if pending else ""
    group = Adw.PreferencesGroup(title=_("Back up first"), description=text + " " + (_(
        "A backup made in this run of the rescue system counts: of these partitions alone, or of the whole phone.")
        if missing else _("A backup made in this run of the rescue system holds them.")))
    for name in names:
        if name in empty:
            r = row(name, _("Erased when the bootloader was unlocked: nothing to back up"))
        elif name not in missing:
            r = row(name, _("Backed up"))
        elif name == rescue_in:
            r = row(name, _("Not backed up yet. It counts with the original only, not with the rescue system."))
        else:
            r = row(name, _("Not backed up yet"))
        ok = name not in missing
        r.add_prefix(Gtk.Image(icon_name="object-select-symbolic" if ok else "dialog-warning-symbolic",
                               css_classes=["success" if ok else "warning"]))
        group.add(r)
    if missing:
        group.add(button_row(_("Back up these partitions…"), "document-save-symbolic",
                             lambda: win.push(BackupCreatePage(win, device, select=missing)), suggested=True,
                             sensitive=device.can_read))
        group.add(button_row(_("Back up the whole phone…"), "drive-harddisk-symbolic",
                             lambda: win.push(BackupCreatePage(win, device, select=WHOLE_PHONE)),
                             sensitive=device.can_read))
    return group, missing


def check_row(title, subtitle, state):
    """A row of a checklist; state True (fine), False (needs something), None (not known)."""
    r = row(title, subtitle)
    icon, css = {True: ("object-select-symbolic", "success"), False: ("dialog-warning-symbolic", "warning"),
                 None: ("dialog-question-symbolic", "dim-label")}[state]
    r.add_prefix(Gtk.Image(icon_name=icon, css_classes=[css]))
    return r


def button_row(title, icon, callback, suggested=False, sensitive=True):
    """Adw.ButtonRow; callback without arguments."""
    button = Adw.ButtonRow(title=title, start_icon_name=icon, sensitive=sensitive)
    if suggested:
        button.add_css_class("suggested-action")
    button.connect("activated", lambda *_a: callback())
    return button


def spinner_row(title):
    r = row(title)
    r.add_prefix(Adw.Spinner())
    return r


def unlock_steps(first_suffix=None):
    """How to unlock the bootloader of the Plinius; the app does the last steps itself."""
    return (
        (_("Restart the phone into its normal system (Volla OS or Android)."), first_suffix) if first_suffix else
        _("Restart the phone into its normal system (Volla OS or Android)."),
        _("Open Settings → About phone and tap “Build number” seven times until the developer options are "
          "turned on."),
        _("Open Settings → System → Developer options and turn on “OEM unlocking”."),
        _("Start the bootloader again: turn the phone off, hold Volume down and Power until a menu appears, "
          "select “fastboot” with Volume down and confirm with Power."),
        _("Click “Unlock bootloader” below and confirm on the phone with Volume up."),
        _("The app then formats the data partition. Without this step Volla OS keeps restarting."),
    )


def add_layout_groups(prefs, device, layout):
    """What is installed where, in plain terms: the phone's storage and the memory card."""
    group = phone_group = Adw.PreferencesGroup(title=_("On the phone"))
    for s in layout["android"]:
        r = row(s["name"], " · ".join(x for x in (system_place(s), f"Android {s['android']}" if s.get("android") else "",
                                                  _("build {number}").format(number=s["build"]) if s.get("build") else "",
                                                  _("security patch {date}").format(date=s["patch"]) if s.get("patch") else "")
                                      if x))
        r.add_prefix(Gtk.Image(icon_name="phone-symbolic"))
        group.add(r)
    if not layout["android"]:
        group.add(row(_("Android or Volla OS"), _("The version shows once the rescue system runs.")))
    names = {"super": _("System"), "userdata": _("User data")}
    for p in layout["storage"]:
        group.add(row(names[p.name], f"{p.name} · {size_text(p.size)}"))
    prefs.add(group)

    card = layout["card"]
    if card is None:
        if layout["complete"]:
            prefs.add(Adw.PreferencesGroup(title=_("Memory card"), description=_("No memory card found.")))
        return
    group = Adw.PreferencesGroup(title=_("Memory card"), description=_("{size}, of which {free} are free").format(
        size=size_text(card["size"]), free=size_text(card["free"])))
    used = set()
    for e in card["entries"]:
        if e["own_system"]:
            continue
        s = e["system"]
        here = phone_group if s and s.get("internal") else group
        if s:
            used.add(s["number"])
        if e["data"]:
            used.add(e["data"]["number"])
        version = system_text(s["system"]) if s and s.get("system") else ""
        lines = [version] if version else []
        if s:
            lines.append(_("System: partition {number}, {size}").format(number=s["number"], size=size_text(s["size"])))
        if e["data"]:
            lines.append(_("Data: partition {number}, {size}").format(number=e["data"]["number"],
                                                                      size=size_text(e["data"]["size"])))
        r = row(e["title"] or _("Unnamed system"), " · ".join(lines))
        r.add_prefix(Gtk.Image(icon_name="media-removable-symbolic"))
        if s and s.get("running"):
            r.add_suffix(Gtk.Label(label=_("running now"), css_classes=["dim-label"]))
        here.add(r)
    for p in card["parts"]:
        if p.get("internal"):
            continue
        # The partition with the boot entries belongs to no system and is not worth a line
        if p["number"] not in used and p["name"] != card.get("settings"):
            group.add(row(_("Partition {number}").format(number=p["number"]),
                          " · ".join(x for x in (size_text(p["size"]),
                                                 system_text(p["system"]) if p.get("system") else _("no system found"))
                                     if x)))
    prefs.add(group)


def place_text(place):
    """One line about a place: its partitions, with the space in use."""
    lines = []
    for label, part in ((_("System"), place["system"]), (_("Data"), place["data"])):
        fs = part.get("fs")
        size = _("{used} of {size} in use").format(used=size_text(fs["used"]), size=size_text(part["size"])) \
            if fs else size_text(part["size"])
        lines.append(_("{label}: partition {number}, {size}").format(label=label, number=part["number"], size=size))
    return " · ".join(lines)


class PlacePage(Adw.NavigationPage):
    """One system on the memory card: what depends on it, and what can be done with its place."""

    def __init__(self, change, place):
        super().__init__(title=place["title"] or _("Unnamed system"))
        self.change, self.win, self.device, self.place = change, change.win, change.device, place
        self.card = self.device.layout["card"]
        prefs = Adw.PreferencesPage()
        info = Adw.PreferencesGroup(title=place["title"] or _("Unnamed system"), description=place_text(place))
        version = place["system"].get("system")
        if version:
            info.add(row(system_text(version)))
        for text in place_warnings(self.card, place):
            info.add(check_row(text, "", False))
        others = uses_kernel_of(self.card, place)
        if others:
            info.add(row(_("{others} starts with the kernel of this system. It stays in place.").format(
                others=", ".join(others))))
        prefs.add(info)

        install = Adw.PreferencesGroup(title=_("Install a system here"), description=_(
            "Replaces the system on this place with an image file. The kernel stays."))
        install.add(button_row(_("Choose image…"), "document-open-symbolic", self.on_choose_image))
        prefs.add(install)

        if self.is_free():
            toolbar = Adw.ToolbarView(content=prefs)
            toolbar.add_top_bar(Adw.HeaderBar())
            self.set_child(toolbar)
            return
        targets = [e for e in card_places(self.card) if e is not place]
        move = Adw.PreferencesGroup(title=_("Move this system"), description=_(
            "Copies it to another place. This place stays as it is until you use it for something else."))
        for target in targets + free_pairs(self.card):
            problem = copy_problem(place["system"], target["system"]) or copy_problem(place["data"], target["data"])
            r = row(target["title"] or _("Free partitions"), problem or place_text(target), activatable=not problem)
            r.add_prefix(Gtk.Image(icon_name="action-unavailable-symbolic" if problem else "go-next-symbolic"))
            if not problem:
                r.connect("activated", lambda _r, t=target: self.confirm_move(t))
            move.add(r)
        if not targets and not free_pairs(self.card):
            move.add(row(_("There is no other place on this memory card.")))
        prefs.add(move)

        if targets:
            swap = Adw.PreferencesGroup(title=_("Swap places"), description=_(
                "Both systems change places, through copies on this PC. They stay there until you delete them."))
            for target in targets:
                problem = next(filter(None, (copy_problem(place["system"], target["system"]),
                                             copy_problem(place["data"], target["data"]),
                                             copy_problem(target["system"], place["system"]),
                                             copy_problem(target["data"], place["data"]))), "")
                r = row(target["title"] or _("Unnamed system"), problem or place_text(target), activatable=not problem)
                r.add_prefix(Gtk.Image(icon_name="action-unavailable-symbolic" if problem else
                                       "object-flip-horizontal-symbolic"))
                if not problem:
                    r.connect("activated", lambda _r, t=target: self.confirm_swap(t))
                swap.add(r)
            prefs.add(swap)
        toolbar = Adw.ToolbarView(content=prefs)
        toolbar.add_top_bar(Adw.HeaderBar())
        self.set_child(toolbar)

    def is_free(self):
        return not self.place["file"]

    def warnings_for(self, *places):
        return "\n\n".join(text for place in places for text in place_warnings(self.card, place))

    def on_choose_image(self):
        dialog = Gtk.FileDialog(title=_("Image of a system"))

        def chosen(dlg, result):
            try:
                path = dlg.open_finish(result).get_path()
            except GLib.Error:
                return
            self.win.toast(_("Checking the image…"))
            image = SystemImage(path)

            def done(_result, error):
                if error or image.problem:
                    image.close()
                    alert(self.win, _("This image cannot be installed"), error or image.problem, [("close", _("Close"))])
                else:
                    self.confirm_install(image)
                return False

            in_thread(image.check, done)

        dialog.open(self.win, None, chosen)

    def confirm_install(self, image):
        place = self.place
        problem = image.place_problem(place["system"])
        if problem:
            image.close()
            alert(self.win, _("This image cannot be installed"), problem, [("close", _("Close"))])
            return
        group = Adw.PreferencesGroup()
        title = Adw.EntryRow(title=_("Name in the boot menu"), text=image.name)
        group.add(title)
        # Somebody else's /home on it: emptying it is never the default
        foreign_home = bool(place_warnings(self.card, place))
        wipe = Adw.SwitchRow(title=_("Empty the data of the old system"), active=not foreign_home,
                             subtitle=_("Old data rarely fits another system."))
        group.add(wipe)
        keep = Adw.SwitchRow(title=_("Keep a copy on this PC"), active=not self.is_free(), sensitive=not self.is_free(),
                             subtitle=_("The way back if the new system does not start."))
        group.add(keep)
        body = _("{new} goes to partitions {system} and {data}, which get a new entry in the boot menu.").format(
            new=image.name, system=place["system"]["number"], data=place["data"]["number"]) if self.is_free() else \
            _("{old} on partition {number} will be overwritten with {new}.").format(
                old=place["title"], number=place["system"]["number"], new=image.name)
        warning = self.warnings_for(place)
        if warning:
            body += "\n\n" + warning

        def response(rid):
            if rid != "install":
                image.close()
                return
            self.start(_("Installing a system"), "system-software-install-symbolic", lambda job: run_install(
                job, self.device, self.card, place, image, wipe.get_active(), title.get_text(), keep.get_active(),
                backup_dir(self.win.config)), _("The system is installed"), _(
                "Restart the phone and choose it in the boot menu."), image.close)

        alert(self.win, _("Install {name}?").format(name=image.name), body,
              [("cancel", _("Cancel")), ("install", _("Install"))], response, Adw.ResponseAppearance.DESTRUCTIVE, extra=group)

    def confirm_move(self, target):
        place = self.place
        group = Adw.PreferencesGroup()
        keep = Adw.SwitchRow(title=_("Keep a copy on this PC"), active=bool(target["file"]),
                             subtitle=_("The way back for what is overwritten."), sensitive=bool(target["file"]))
        group.add(keep)
        if target["file"]:
            body = _("{old} will be overwritten and leaves the boot menu. {new} then starts from there.").format(
                old=target["title"], new=place["title"])
        else:
            body = _("{new} then starts from partitions {system} and {data}.").format(
                new=place["title"], system=target["system"]["number"], data=target["data"]["number"])
        shrink = [p for p, t in ((place["system"], target["system"]), (place["data"], target["data"])) if needs_shrinking(p, t)]
        if shrink:
            body += "\n\n" + _("For copying, the file system on partition {numbers} is made smaller for a while. Its "
                               "contents stay the same.").format(numbers=", ".join(str(p["number"]) for p in shrink))
        warning = self.warnings_for(target)
        if warning:
            body += "\n\n" + warning

        def response(rid):
            if rid == "move":
                self.start(_("Moving a system"), "folder-move-symbolic", lambda job: run_move(
                    job, self.device, self.card, place, target, keep.get_active(), backup_dir(self.win.config)),
                    _("The system is moved"), _("Restart the phone and check that it starts. The old partitions stay "
                                                "as they are until you use them."))

        alert(self.win, _("Move {name}?").format(name=place["title"]), body,
              [("cancel", _("Cancel")), ("move", _("Move"))], response,
              Adw.ResponseAppearance.DESTRUCTIVE if target["file"] else Adw.ResponseAppearance.SUGGESTED, extra=group)

    def confirm_swap(self, target):
        place = self.place
        body = _("{a} and {b} change places. Both are first copied to this PC and checked; only then is anything "
                 "overwritten. If it stops, it can go on from there.").format(a=place["title"], b=target["title"])
        warning = self.warnings_for(place, target)
        if warning:
            body += "\n\n" + warning

        def response(rid):
            if rid != "swap":
                return

            def work(job):
                state = begin_swap(self.device, self.card, place, target, backup_dir(self.win.config))
                run_swap(job, self.device, self.card, state)

            self.start(_("Swapping systems"), "object-flip-horizontal-symbolic", work, _("The systems have swapped places"),
                       _("Restart the phone and check that both start. The copies stay on this PC until you delete them."))

        alert(self.win, _("Swap {a} and {b}?").format(a=place["title"], b=target["title"]), body,
              [("cancel", _("Cancel")), ("swap", _("Swap"))], response, Adw.ResponseAppearance.DESTRUCTIVE)

    def start(self, title, icon, work, done_title, done_text, cleanup=None):
        self.change.run_operation(title, icon, work, done_title, done_text, cleanup)


class FollowingPage(Adw.NavigationPage):
    """A page about one phone that stays with it while it changes between its system, the bootloader
    and the rescue system: those are different entries for the scanner, with the same serial number."""

    def __init__(self, win, device, title):
        super().__init__(title=title)
        self.win, self.device = win, device
        self.toolbar = Adw.ToolbarView()
        self.header = Adw.HeaderBar()
        self.toolbar.add_top_bar(self.header)
        self.set_child(self.toolbar)
        # waiting: the phone is gone from USB; starting: it is on its way into the rescue system
        self.waiting, self.starting = False, False

    def on_devices(self, devices):
        same = [d for d in devices if d.serial and d.serial == self.device.serial] or \
               [d for d in devices if d.key == self.device.key]
        if same:
            # A phone in two modes at once: the entry that can read tells more
            found = next((d for d in same if d.can_read), same[0])
            if found is not self.device:
                self.device, self.waiting = found, False
                self.render()
        elif self.device.key not in self.win.scanner.devices and not self.waiting:
            self.waiting = True
            self.render()

    def new_prefs(self):
        prefs = Adw.PreferencesPage()
        self.set_content(prefs)
        return prefs

    def set_content(self, prefs):
        self.toolbar.set_content(prefs)

    def content(self):
        return self.toolbar.get_content()

    def show_layout(self, prefs, layout):
        """The overview of what is installed (see add_layout_groups)."""
        add_layout_groups(prefs, self.device, layout)

    def add_waiting(self, prefs):
        """While the phone restarts it is gone from USB for a moment."""
        if self.starting:
            prefs.add(Adw.PreferencesGroup(title=_("Choose in the boot menu"), description=_(
                "With a memory card in the phone, its boot menu appears for a few seconds. Choose VollaOS there: "
                "otherwise it starts the system chosen last, and not the rescue system. If that happens, restart "
                "the phone and choose again.")))
        group = Adw.PreferencesGroup()
        group.add(spinner_row(_("Waiting for the phone. If nothing happens, check the cable.")))
        prefs.add(group)

    def load_layout(self, prefs):
        """Show what is installed; read once per connection, then kept."""
        d = self.device
        if d.layout is not None:
            self.show_layout(prefs, d.layout)
            return
        group = Adw.PreferencesGroup()
        group.add(spinner_row(_("Reading what is installed…")))
        prefs.add(group)

        def done(layout, error):
            # The phone may have moved on by then, or the page may show something else
            if self.device is not d or self.content() is not prefs:
                return False
            prefs.remove(group)
            if error:
                prefs.add(Adw.PreferencesGroup(title=_("Could not read what is installed"), description=str(error)))
                return False
            d.layout = layout
            self.show_layout(prefs, layout)
            self.after_layout(prefs)
            return False

        in_thread(lambda: read_layout(d, self.win.config), done)

    def after_layout(self, prefs):
        """Groups that belong below the overview."""

    def backups_changed(self):
        """A backup was made or deleted: what waits for one in the rescue system may go on now."""
        if self.device.rescue and self.device.layout is not None and not getattr(self, "working", False):
            self.render()


# --- The boot menu and how a medium is divided -------------------------------------------------

# Without a memory card the bootloader shows no menu and starts the phone's own system
OWN_ENTRY = {"file": "", "title": "", "own_system": True, "system": None, "data": None, "raw": [], "options": "",
             "kernel": ""}
# Free areas smaller than this are gaps from aligning partitions, not room
FREE_MIN = 1 << 20


def boot_entries(layout):
    """The entries of the boot menu in the order of their files, as the bootloader lists them; without
    a memory card only the phone's own system."""
    card = layout["card"]
    return card["entries"] if card and card["entries"] else [OWN_ENTRY]


def entry_title(entry):
    return entry["title"] or (_("Volla OS") if entry["own_system"] else _("Unnamed system"))


def entry_internal(entry):
    """Whether the entry starts a system in the phone's own storage."""
    return entry["own_system"] or bool(entry["system"] and entry["system"].get("internal"))


def entry_running(device, entry):
    """Whether the phone runs this entry's system right now, as far as the connection tells."""
    if entry["own_system"]:
        return device.mode == "adb" and not device.rescue
    return bool(entry["system"] and entry["system"].get("running"))


def entry_summary(layout, entry):
    """One line about an entry: the system it starts and where it is."""
    if entry["own_system"]:
        active = layout["android"][0] if layout["android"] else None
        text = system_text(active) if active else _("The phone's own system")
    elif entry["system"]:
        text = system_text(entry["system"]["system"]) if entry["system"].get("system") else _("no system found")
    else:
        text = _("Its partitions are not there")
    return " · ".join((text, _("Phone storage") if entry_internal(entry) else _("Memory card")))


def card_segments(card):
    """The memory card from start to end as [(start sector, sectors, partition or None for free room)]."""
    parts = [p for p in card["parts"] if not p.get("internal")]
    segments = [(p["start"], p["sectors"], p) for p in parts]
    segments += [(start, n, None) for start, n in free_areas(card["sectors"], [(p["start"], p["sectors"]) for p in parts])
                 if n * SECTOR >= FREE_MIN]
    return sorted(segments, key=lambda s: s[0])


def part_role(card, part):
    """What a partition of the card is for: (kind, boot entry using it or None). kind is "settings"
    (the boot menu with the kernels), "system", "data" or "" for unused."""
    if part["name"] == card.get("settings"):
        return "settings", None
    for e in card["entries"]:
        if e["system"] is part:
            return "system", e
        if e["data"] is part:
            return "data", e
    return "", None


def part_text(part):
    """The facts of one partition in one line: device, size, use of its file system, type, system."""
    used = part.get("fs")
    bits = [part.get("label") or part["name"],
            _("{used} of {size} in use").format(used=size_text(used["used"]), size=size_text(part["size"]))
            if used else size_text(part["size"])]
    if part.get("type") == GPT_HOME:
        bits.append(_("type Linux /home"))
    if part.get("system"):
        bits.append(system_text(part["system"]))
    if part.get("running"):
        bits.append(_("running now"))
    return " · ".join(bits)


# How strongly each kind of area is painted: the entry shown in the accent colour, the rest in the
# text colour, free room only outlined
SEGMENT_ALPHA = {"system": 1.0, "data": 0.55, "settings": 0.45, "other": 0.22, "free": 0.0}


def segment_color(widget, kind):
    rgba = Adw.StyleManager.get_default().get_accent_color_rgba() if kind in ("system", "data") else widget.get_color()
    return rgba.red, rgba.green, rgba.blue, SEGMENT_ALPHA[kind]


def paint_segment(cr, widget, kind, x, y, w, h):
    """One area of the bar or of a swatch: filled, or outlined when free."""
    radius = min(4, w / 2, h / 2)
    cr.new_sub_path()
    cr.arc(x + w - radius, y + radius, radius, -1.5708, 0)
    cr.arc(x + w - radius, y + h - radius, radius, 0, 1.5708)
    cr.arc(x + radius, y + h - radius, radius, 1.5708, 3.1416)
    cr.arc(x + radius, y + radius, radius, 3.1416, 4.7124)
    cr.close_path()
    if kind == "free":
        rgba = widget.get_color()
        cr.set_source_rgba(rgba.red, rgba.green, rgba.blue, 0.35)
        cr.set_line_width(1)
        cr.set_dash([3, 2])
        cr.stroke()
        cr.set_dash([])
    else:
        cr.set_source_rgba(*segment_color(widget, kind))
        cr.fill()


def swatch(kind):
    """A small square in the colour of an area of the bar, so that list and bar go together."""
    area = Gtk.DrawingArea(content_width=14, content_height=14, valign=Gtk.Align.CENTER)
    area.set_draw_func(lambda a, cr, w, h: paint_segment(cr, a, kind, 0.5, 0.5, w - 1, h - 1))
    return area


def partition_bar(total, segments):
    """The medium as a bar: segments [(start, size, kind)] in proportion to total. Every area gets a
    few pixels at least, so that small partitions such as the boot menu stay visible."""
    area = Gtk.DrawingArea(content_height=28, hexpand=True)

    def draw(a, cr, width, height):
        gap, least = 2, 4
        room = width - gap * (len(segments) - 1) - least * len(segments)
        x = 0.0
        for _start, size, kind in segments:
            w = least + max(0, room) * size / total
            paint_segment(cr, a, kind, x + 0.5, 0.5, w - 1, height - 1)
            x += w + gap

    area.set_draw_func(draw)
    return area


def add_card_partitioning(prefs, card, entry=None):
    """How the memory card is divided, as a bar and as a list; the partitions of entry stand out."""
    group = Adw.PreferencesGroup(title=_("Partitioning of the memory card"), description=_(
        "{size}, of which {free} are free").format(size=size_text(card["size"]), free=size_text(card["free"])))
    segments, rows = [], []
    for start, sectors, part in card_segments(card):
        if part is None:
            kind = "free"
            r = row(_("Free space"), size_text(sectors * SECTOR))
        else:
            role, owner = part_role(card, part)
            if entry is not None and owner is entry:
                kind = role
            else:
                kind = "settings" if role == "settings" else "other"
            if role == "settings":
                use = _("Boot menu and kernels")
            elif owner:
                use = (_("System of {title}") if role == "system" else _("Data of {title}")).format(
                    title=entry_title(owner))
            else:
                use = _("Not used by any boot entry")
            r = row(_("Partition {number}").format(number=part["number"]), " · ".join((use, part_text(part))))
        r.add_prefix(swatch(kind))
        segments.append((start, sectors, kind))
        rows.append(r)
    bar = Gtk.ListBoxRow(activatable=False, selectable=False)
    bar.set_child(Gtk.Box(margin_start=12, margin_end=12, margin_top=12, margin_bottom=12))
    bar.get_child().append(partition_bar(card["sectors"], segments))
    group.add(bar)
    for r in rows:
        group.add(r)
    prefs.add(group)


def add_phone_storage(prefs, layout):
    """The phone's own storage: where its system and data are, and the places the app made there."""
    group = Adw.PreferencesGroup(title=_("Phone storage"))
    names = {"super": _("System"), "userdata": _("User data")}
    for p in layout["storage"]:
        r = row(names[p.name], f"{p.name} · {size_text(p.size)}")
        r.add_prefix(swatch("system" if p.name == "super" else "data"))
        group.add(r)
    card = layout["card"]
    for part in card["parts"] if card else ():
        if part.get("internal"):
            role, owner = part_role(card, part)
            use = (_("System of {title}") if role == "system" else _("Data of {title}")).format(
                title=entry_title(owner)) if owner else _("Not used by any boot entry")
            r = row(part.get("label") or part["name"], " · ".join((use, part_text(part))))
            r.add_prefix(swatch("other"))
            group.add(r)
    if not layout["storage"]:
        group.add(row(_("The partitions show once the rescue system runs.")))
    prefs.add(group)


class BootEntryPage(Adw.NavigationPage):
    """One entry of the boot menu: the system it starts, its partitions, and how its medium is divided.
    Only shows; changing happens on the page for changing systems."""

    def __init__(self, phone, entry):
        super().__init__(title=entry_title(entry))
        d, layout = phone.device, phone.device.layout
        card = layout["card"]
        prefs = Adw.PreferencesPage()
        info = Adw.PreferencesGroup(title=entry_title(entry))
        if entry["own_system"]:
            for s in layout["android"]:
                info.add(info_row(system_place(s), system_text(s)))
            if not layout["android"]:
                info.add(info_row(_("System"), _("The version shows once the rescue system runs.")))
            info.add(info_row(_("Medium"), _("Phone storage")))
        else:
            s = entry["system"]
            info.add(info_row(_("System"), system_text(s["system"]) if s and s.get("system") else _("no system found")))
            info.add(info_row(_("Medium"), _("Phone storage") if entry_internal(entry) else _("Memory card")))
            kernel = entry.get("kernel")
            if kernel and kernel != "null" and card:
                # rom1.conf can start with the kernel of rom0/: then it belongs to the system of rom0.conf
                owner = next((e for e in card["entries"] if e["file"].removesuffix(".conf") == kernel), None)
                text = _("Folder {folder} in the boot menu partition").format(folder=kernel)
                if owner is not None and owner is not entry:
                    text += " · " + _("the kernel of {title}").format(title=entry_title(owner))
                others = uses_kernel_of(card, entry) if any(e is entry for e in card_places(card)) else []
                if others:
                    text += " · " + _("also starts {titles}").format(titles=", ".join(others))
                info.add(info_row(_("Kernel"), text))
        if entry_running(d, entry):
            info.add(info_row(_("State"), _("running now")))
        if entry["file"]:
            info.add(info_row(_("Boot entry"), "db/entries/" + entry["file"]))
        if card and any(e is entry for e in card_places(card)):
            for text in place_warnings(card, entry):
                info.add(check_row(text, "", False))
        prefs.add(info)

        if entry["own_system"]:
            add_phone_storage(prefs, layout)
        else:
            group = Adw.PreferencesGroup(title=_("Partitions"))
            for label, kind, part in ((_("System"), "system", entry["system"]), (_("Data"), "data", entry["data"])):
                if part:
                    r = row(label, _("Partition {number}").format(number=part["number"]) + " · " + part_text(part))
                    r.add_prefix(swatch(kind))
                    group.add(r)
            if not entry["system"] and not entry["data"]:
                group.add(row(_("The partitions of this entry are not on the memory card.")))
            prefs.add(group)
        if entry["raw"]:
            group = Adw.PreferencesGroup(title=_("Boot entry"), description=_("As the bootloader reads it."))
            text = Gtk.Label(label="\n".join(clean_text(line, 1000) for line in entry["raw"]), xalign=0, wrap=True,
                             wrap_mode=Pango.WrapMode.WORD_CHAR, selectable=True, css_classes=["monospace"],
                             margin_start=12, margin_end=12, margin_top=12, margin_bottom=12)
            holder = Gtk.ListBoxRow(activatable=False, selectable=False, child=text)
            group.add(holder)
            prefs.add(group)
        if card and not entry_internal(entry):
            add_card_partitioning(prefs, card, entry)
        toolbar = Adw.ToolbarView(content=prefs)
        toolbar.add_top_bar(Adw.HeaderBar())
        self.set_child(toolbar)


class CardPage(Adw.NavigationPage):
    """The memory card as a whole: how it is divided."""

    def __init__(self, card):
        super().__init__(title=_("Memory card"))
        prefs = Adw.PreferencesPage()
        add_card_partitioning(prefs, card)
        toolbar = Adw.ToolbarView(content=prefs)
        toolbar.add_top_bar(Adw.HeaderBar())
        self.set_child(toolbar)


def shown_entries(layout):
    """The boot menu entries worth showing: none while nothing about them is known yet."""
    return boot_entries(layout) if layout["card"] or layout["complete"] or layout["android"] else []


def boot_menu_prefs(phone):
    """The Boot menu tab of a phone page: one row per entry, leading to what it starts and where, and
    the memory card."""
    d, layout = phone.device, phone.device.layout
    card = layout["card"]
    if card and card["entries"]:
        text = _("The systems the phone offers when it starts, in this order.")
    elif layout["complete"]:
        text = _("Without a memory card the phone shows no boot menu and starts its own system.")
    else:
        text = _("The boot menu is on the memory card. It shows once the rescue system runs, or with an "
                 "administrator login to Linux on the phone.")
    prefs = Adw.PreferencesPage()
    group = Adw.PreferencesGroup(title=_("Boot menu"), description=text)
    for e in shown_entries(layout):
        r = row(entry_title(e), entry_summary(layout, e), activatable=True)
        r.add_prefix(Gtk.Image(icon_name="phone-symbolic" if entry_internal(e) else "media-removable-symbolic"))
        if entry_running(d, e):
            r.add_suffix(Gtk.Label(label=_("running now"), css_classes=["dim-label"]))
        r.add_suffix(Gtk.Image(icon_name="go-next-symbolic"))
        r.connect("activated", lambda _r, e=e: phone.win.push(BootEntryPage(phone, e)))
        group.add(r)
    prefs.add(group)
    if card:
        group = Adw.PreferencesGroup()
        r = row(_("Memory card"), _("{size}, of which {free} are free").format(
            size=size_text(card["size"]), free=size_text(card["free"])), activatable=True)
        r.add_prefix(Gtk.Image(icon_name="media-removable-symbolic"))
        r.add_suffix(Gtk.Image(icon_name="go-next-symbolic"))
        r.connect("activated", lambda _r: phone.win.push(CardPage(card)))
        group.add(r)
        prefs.add(group)
    if card and not layout["complete"]:
        prefs.add(Adw.PreferencesGroup(description=_(
            "The complete picture, including the memory card, shows once the rescue system runs.")))
    return prefs


def belongs_to(backup, device):
    """Whether a backup was made of this phone: by serial number, or by name for a phone without one."""
    if device.serial:
        return backup.device.get("serial") == device.serial
    return not backup.device.get("serial") and backup.title() == device.title()


def offline_device(serial, name, config):
    """A phone known from earlier, not connected now: enough for its page and its backups."""
    d = Device("offline:" + serial, "offline", info={"serial": serial})
    d.profile = next((p for p in PROFILES if p.id == config.get("known", {}).get(serial)), None)
    if not d.profile:
        d.info["model"] = name
    return d


class PhonePage(FollowingPage):
    """One phone, in two parts: its systems (the entries of its boot menu, with what is needed to get
    there) and its backups. Stays with the phone while it restarts (see FollowingPage)."""

    def __init__(self, win, device):
        super().__init__(win, device, device.title())
        self.stack = Adw.ViewStack()
        self.systems = Adw.Bin()
        self.stack.add_titled_with_icon(self.systems, "systems", _("Systems"), "view-list-symbolic")
        self.boot_menu = Adw.Bin()
        self.stack.add_titled_with_icon(self.boot_menu, "boot-menu", _("Boot menu"), "view-list-ordered-symbolic")
        self.stack.add_titled_with_icon(self.build_backups(), "backups", _("Backups"), "drive-harddisk-symbolic")
        switcher = Adw.ViewSwitcher(stack=self.stack, policy=Adw.ViewSwitcherPolicy.WIDE)
        self.header.set_title_widget(switcher)
        self.toolbar.set_content(self.stack)
        # Three tabs do not fit next to the window buttons in a narrow window: there they move to the bottom
        bar = Adw.ViewSwitcherBar(stack=self.stack)
        self.toolbar.add_bottom_bar(bar)
        narrow = Adw.Breakpoint.new(Adw.BreakpointCondition.parse("max-width: 550sp"))
        narrow.add_setter(switcher, "visible", False)
        narrow.add_setter(bar, "reveal", True)
        self.set_child(None)
        holder = Adw.BreakpointBin(child=self.toolbar, width_request=360, height_request=294)
        holder.add_breakpoint(narrow)
        self.set_child(holder)
        self.waiting = device.mode == "offline"
        self.render()
        self.refresh_backups()

    def set_content(self, prefs):
        self.systems.set_child(prefs)

    def content(self):
        return self.systems.get_child()

    def on_devices(self, devices):
        super().on_devices(devices)
        self.update_create()

    # Systems

    def render(self):
        d, prefs = self.device, self.new_prefs()
        self.update_create()
        self.update_boot_menu()
        if self.waiting:
            if d.mode == "offline":
                group = Adw.PreferencesGroup(title=d.title(), description=_(
                    "Not connected. Connect the phone with a USB cable to see its systems. Its backups are on the "
                    "Backups tab."))
                group.add(spinner_row(_("Searching…")))
                prefs.add(group)
            else:
                self.add_waiting(prefs)
            return
        plinius, unlocked = is_plinius(d), bootloader_open(d)
        checks = Adw.PreferencesGroup(title=d.title(), description=d.mode_text())
        checks.add(check_row(_("The tools work"), "", True))
        checks.add(check_row(_("This is a Volla Phone Plinius") if plinius is not False else
                             _("This is not a Volla Phone Plinius"),
                             "" if plinius else (_("Not known yet in this mode.") if plinius is None else
                                                 _("Backing up and restoring works, changing systems is only made "
                                                   "for the Plinius.")), plinius))
        if plinius is not False:
            checks.add(check_row({True: _("The bootloader is unlocked"), False: _("The bootloader is locked"),
                                  None: _("Whether the bootloader is unlocked is not known yet")}[unlocked],
                                 "", unlocked))
        prefs.add(checks)
        if d.login:
            group = Adw.PreferencesGroup(description=d.problem)
            group.add(button_row(_("Log in…"), "dialog-password-symbolic", lambda: self.win.login(d), suggested=True))
            prefs.add(group)
        if d.problem and not d.access:
            prefs.add(Adw.PreferencesGroup(description=d.problem))
        elif plinius is False:
            self.add_expert(prefs)
        elif unlocked is False:
            self.add_unlock(prefs)
        elif unlocked is None:
            self.add_find_out(prefs)
        else:
            self.load_layout(prefs)
            if d.layout is not None:
                self.after_layout(prefs)

    def add_expert(self, prefs):
        group = Adw.PreferencesGroup(description=_("Backing up and restoring works on the Backups tab."))
        group.add(button_row(_("Rescue system and bootloader"), "system-reboot-symbolic",
                             lambda: self.win.push(RescuePage(self.win, self.device))))
        prefs.add(group)

    def add_unlock(self, prefs):
        d = self.device
        restart = None
        if d.mode != "fastboot":
            # This is step 4 for a phone that is still in its system: steps 1 to 3 happen on the phone
            steps = unlock_steps()[1:]
        else:
            restart = Gtk.Button(label=_("Restart"), valign=Gtk.Align.CENTER)
            restart.connect("clicked", lambda _b: self.restart_phone(""))
            steps = unlock_steps(restart)
        prefs.add(steps_group(_("Unlock the bootloader"), _(
            "Changing systems needs an unlocked bootloader. Unlocking erases all personal data on the phone: apps, "
            "photos, messages and accounts. Device data such as the IMEI is kept. Copy anything you still need off "
            "the phone first."), steps))
        group = Adw.PreferencesGroup()
        if d.mode == "fastboot":
            group.add(button_row(_("Continue to unlocking"), "changes-allow-symbolic",
                                 lambda: self.win.push(RescuePage(self.win, d)), suggested=True))
        else:
            # adb can do this without root, ssh cannot
            group.add(button_row(_("Restart into bootloader"), "system-reboot-symbolic",
                                 lambda: self.restart_phone("bootloader"),
                                 sensitive=d.mode == "adb" or d.access.root is not None))
        prefs.add(group)

    def add_find_out(self, prefs):
        """The running system does not say: only the bootloader can tell."""
        d = self.device
        group = Adw.PreferencesGroup(description=_(
            "The phone's system does not tell whether the bootloader is unlocked. The bootloader itself does."))
        if d.access and (d.mode == "adb" or d.access.root is not None):
            group.add(button_row(_("Restart into bootloader"), "system-reboot-symbolic",
                                 lambda: self.restart_phone("bootloader"), suggested=True))
            prefs.add(group)
        else:
            prefs.add(group)
            prefs.add(steps_group(_("Start the bootloader"), None, fastboot_steps()))

    def show_layout(self, prefs, layout):
        """Nothing above the actions: the boot menu has a page of its own (see after_layout)."""

    def after_layout(self, prefs):
        d = self.device
        pending = pending_rescue(self.win.config, d.serial)
        if pending and (d.rescue or d.mode == "fastboot"):
            group = Adw.PreferencesGroup(title=_("Rescue system"), description=_(
                "The rescue system is in {name}, so the phone does not start its own system until the original is "
                "written back.").format(name=pending["partition"]))
            group.add(button_row(_("Write original back and restart"), "system-reboot-symbolic",
                                 lambda: self.win.push(RescuePage(self.win, d)), suggested=True))
            prefs.add(group)
        group = Adw.PreferencesGroup()
        group.add(button_row(_("Change or install systems"), "system-software-install-symbolic",
                             lambda: self.win.push(ChangePage(self.win, d)), suggested=not pending))
        group.add(button_row(_("Rescue system and bootloader"), "system-reboot-symbolic",
                             lambda: self.win.push(RescuePage(self.win, d))))
        prefs.add(group)
        self.update_boot_menu()

    def update_boot_menu(self):
        """The Boot menu tab: filled once the layout is read, until then a note."""
        d = self.device
        if not self.waiting and d.layout is not None:
            self.boot_menu.set_child(boot_menu_prefs(self))
            return
        prefs = Adw.PreferencesPage()
        prefs.add(Adw.PreferencesGroup(title=_("Boot menu"), description=_(
            "The boot menu shows once the phone is connected and what is installed has been read.")))
        self.boot_menu.set_child(prefs)

    def restart_phone(self, target):
        in_thread(lambda: self.device.access.reboot(target), lambda *_a: False)
        self.win.toast(_("The phone is restarting"))

    # Backups

    def build_backups(self):
        self.backups_prefs = Adw.PreferencesPage()
        where = Adw.PreferencesGroup(title=_("Storage location"))
        self.where_row = row(backup_dir(self.win.config))
        change = Gtk.Button(label=_("Change…"), valign=Gtk.Align.CENTER)
        change.connect("clicked", lambda _b: self.win.choose_dir())
        self.where_row.add_suffix(change)
        where.add(self.where_row)
        self.backups_prefs.add(where)
        self.create_group = Adw.PreferencesGroup()
        self.create_button = button_row(_("Create backup…"), "document-save-symbolic",
                                        lambda: self.win.push(BackupCreatePage(self.win, self.device)), suggested=True)
        self.create_group.add(self.create_button)
        self.backups_prefs.add(self.create_group)
        self.backup_group = Adw.PreferencesGroup()
        self.backups_prefs.add(self.backup_group)
        return self.backups_prefs

    def update_create(self):
        """Whether a backup can be made now, and if not, why."""
        d = self.device
        if d.key not in self.win.scanner.devices:
            text = _("Connect the phone to create a backup.")
        elif not d.can_read:
            text = d.problem or _("The bootloader cannot read partitions. Start the rescue system on the Systems "
                                  "tab, or the phone's own system.")
        elif not d.rescue:
            text = _("For a consistent backup of all partitions, start the rescue system on the Systems tab first.")
        else:
            text = ""
        self.create_group.set_description(text)
        self.create_button.set_sensitive(d.key in self.win.scanner.devices and d.can_read)

    def refresh_backups(self):
        """Only the backups of this phone, newest first."""
        self.where_row.set_title(backup_dir(self.win.config))
        self.backups_prefs.remove(self.backup_group)
        self.backup_group = Adw.PreferencesGroup(title=_("Backups of this phone"))
        backups = [b for b in self.win.backups if belongs_to(b, self.device)]
        for b in backups:
            n = len(b.entries)
            subtitle = [ngettext("{n} partition", "{n} partitions", n).format(n=n), size_text(b.disk_size())]
            if b.systems_text():
                subtitle.append(b.systems_text())
            if not b.complete:
                subtitle.append(_("incomplete"))
            r = row(b.created_text(), " · ".join(subtitle), activatable=True)
            r.add_prefix(Gtk.Image(icon_name="drive-harddisk-symbolic"))
            r.add_suffix(Gtk.Image(icon_name="go-next-symbolic"))
            r.connect("activated", lambda _r, b=b: self.win.push(BackupPage(self.win, b)))
            self.backup_group.add(r)
        if not backups:
            self.backup_group.add(row(_("No backups of this phone yet")))
        self.backups_prefs.add(self.backup_group)


class ChangePage(FollowingPage):
    """The way to changing systems: into the bootloader, start the rescue system, see the systems."""

    STEPS = 3

    def __init__(self, win, device):
        super().__init__(win, device, _("Change systems"))
        self.starting = False
        self.status = None
        self.render()

    def step_rows(self, prefs, current):
        """The three steps, the current one highlighted, so that the way stays visible."""
        group = Adw.PreferencesGroup(description=_(
            "Your systems stay untouched until you decide otherwise. The rescue system only runs while you need it."))
        names = (_("Start the bootloader"), _("Start the rescue system"), _("See and change the systems"))
        for n, name in enumerate(names):
            r = row(name)
            if n < current:
                r.add_prefix(Gtk.Image(icon_name="object-select-symbolic", css_classes=["success"]))
            else:
                r.add_prefix(Gtk.Label(label=str(n + 1), width_chars=2,
                                       css_classes=["title-4", "accent"] if n == current else ["title-4", "dim-label"]))
            group.add(r)
        prefs.add(group)

    def render(self):
        d, prefs = self.device, self.new_prefs()
        if self.waiting or self.starting and not d.rescue:
            self.step_rows(prefs, 1 if self.starting else 0)
            self.add_waiting(prefs)
            return
        self.starting = False
        if d.rescue:
            self.step_rows(prefs, 2)
            self.load_layout(prefs)
            if d.layout is not None:
                self.after_layout(prefs)
        elif d.mode == "fastboot":
            self.step_rows(prefs, 1)
            self.add_start(prefs)
        else:
            self.step_rows(prefs, 0)
            self.add_bootloader(prefs)

    def add_bootloader(self, prefs):
        d = self.device
        if d.access and (d.mode == "adb" or d.access.root is not None):
            group = Adw.PreferencesGroup(title=_("Start the bootloader"), description=_(
                "The phone restarts into its bootloader. Nothing on it changes."))
            group.add(button_row(_("Restart into bootloader"), "system-reboot-symbolic",
                                 self.restart_bootloader, suggested=True))
            prefs.add(group)
        else:
            prefs.add(steps_group(_("Start the bootloader"), None, fastboot_steps()))
        self.add_backup_hint(prefs)

    def add_backup_hint(self, prefs):
        group = Adw.PreferencesGroup(title=_("Back up first"), description=_(
            "A backup is the way back if something goes wrong. Internal partitions such as the IMEI data cannot be "
            "restored from anywhere else."))
        group.add(button_row(_("Create backup…"), "document-save-symbolic",
                             lambda: self.win.push(BackupCreatePage(self.win, self.device)),
                             sensitive=self.device.can_read))
        prefs.add(group)

    def restart_bootloader(self):
        d, config = self.device, self.win.config
        in_thread(lambda: (remember_init_boot(d, config), d.access.reboot("bootloader")), lambda *_a: False)
        self.win.toast(_("The phone is restarting"))

    def add_start(self, prefs):
        d = self.device
        if not d.can_write:
            prefs.add(Adw.PreferencesGroup(title=_("The bootloader is locked"), description=_(
                "Go back one page: it explains how to unlock it.")))
            return
        partition = rescue_partition(d)
        if partition:
            text = _("This phone's bootloader cannot start a system from memory. The rescue system is therefore "
                     "written to {name} until you are done, and the app writes the original back afterwards. It "
                     "takes the original from the update server or a file you choose, and only if it matches the "
                     "checksum the phone expects.").format(name=partition)
        else:
            text = _("Starts a small system only in memory; nothing is written to the phone.")
        kernel = None if partition else next(iter(kernel_sources(d, backup_dir(self.win.config))), (None, None))[1]
        group = Adw.PreferencesGroup(title=_("Start the rescue system"), description=text)
        self.status = spinner_row("")
        self.status.set_visible(False)
        group.add(self.status)
        if partition or kernel:
            self.start_button = button_row(_("Start rescue system"), "media-playback-start-symbolic",
                                           lambda: self.start(partition, kernel), suggested=True)
            group.add(self.start_button)
        else:
            # Which file holds the kernel is decided on the detailed page
            group.add(row(_("No boot image found in the backups of this phone. Choose a boot image file.")))
            group.add(button_row(_("Choose file…"), "document-open-symbolic",
                                 lambda: self.win.push(RescuePage(self.win, d)), suggested=True))
        prefs.add(group)

    def start(self, partition, kernel):
        d, scanner = self.device, self.win.scanner
        self.start_button.set_sensitive(False)
        self.status.set_visible(True)
        step = lambda text: GLib.idle_add(self.status.set_title, text)
        scanner.busy.add(d.key)

        def done(_result, error):
            scanner.busy.discard(d.key)
            if error:
                self.status.set_visible(False)
                self.start_button.set_sensitive(True)
                alert(self.win, _("The rescue system could not be started"), error, [("close", _("Close"))])
                return False
            self.starting = True
            self.render()
            scanner.refresh(d.key)
            return False

        in_thread(lambda: flash_rescue(d, self.win.config, step) if partition else
                  start_rescue(d, self.win.config, kernel), done)

    def add_systems(self, prefs, card):
        """Rows that lead to what can be done with each system."""
        group = Adw.PreferencesGroup(title=_("Change a system"), description=_(
            "Choose a system to install another one on its place, to move it, or to swap it with another one."))
        for place in free_pairs(card):
            r = row(_("Free place"), place_text(place), activatable=True)
            r.add_prefix(Gtk.Image(icon_name="list-add-symbolic"))
            r.add_suffix(Gtk.Image(icon_name="go-next-symbolic"))
            r.connect("activated", lambda _r, p=place: self.win.push(PlacePage(self, p)))
            group.add(r)
        for place in card_places(card):
            warned = bool(place_warnings(card, place))
            r = row(place["title"] or _("Unnamed system"), place_text(place), activatable=True)
            r.add_prefix(Gtk.Image(icon_name="dialog-warning-symbolic" if warned else "media-removable-symbolic",
                                   css_classes=["warning"] if warned else []))
            r.add_suffix(Gtk.Image(icon_name="go-next-symbolic"))
            r.connect("activated", lambda _r, p=place: self.win.push(PlacePage(self, p)))
            group.add(r)
        if not card_places(card):
            group.add(row(_("There is no system on this memory card yet.")))
        prefs.add(group)
        self.add_room(prefs, card)
        states = load_states(backup_dir(self.win.config), self.device.serial)
        if states:
            copies = Adw.PreferencesGroup(title=_("Copies on this PC"))
            for state in states:
                self.add_copy_row(copies, state, card)
            prefs.add(copies)

    def add_room(self, prefs, card):
        """Stufe 5: room on the card, from file systems that have much more than they use."""
        group = Adw.PreferencesGroup(title=_("Make room on the memory card"), description=_(
            "{free} are free. A partition that uses little of its space can become smaller; the room can then "
            "hold a new place.").format(free=size_text(card["free"])))
        for part in card["parts"]:
            fs = part.get("fs")
            if part.get("internal") or not fs or fs["used"] * 2 + (1 << 30) >= part["size"]:
                continue
            r = row(_("Make partition {number} smaller").format(number=part["number"]),
                    _("{used} of {size} in use").format(used=size_text(fs["used"]), size=size_text(part["size"])), activatable=True)
            r.add_prefix(Gtk.Image(icon_name="drive-harddisk-symbolic"))
            r.connect("activated", lambda _r, p=part: self.confirm_shrink(card, p))
            group.add(r)
        if card["largest_free"] >= 2 << 30:
            r = row(_("Add a new place"), _("Two partitions for a system and its data, up to {size} together.").format(
                size=size_text(card["largest_free"])), activatable=True)
            r.add_prefix(Gtk.Image(icon_name="list-add-symbolic"))
            r.connect("activated", lambda _r: self.confirm_add_place(card))
            group.add(r)
        prefs.add(group)

    def confirm_shrink(self, card, part):
        fs = part["fs"]
        floor = fs["used"] + fs["used"] // 8 + (16 << 20)
        low, high = max(1.0, round(floor / (1 << 30) + 0.5)), part["size"] / (1 << 30)
        choice = Adw.SpinRow.new_with_range(low, max(low, high - 1), 1)
        choice.set_title(_("New size in GiB"))
        choice.set_value(max(low, min(high - 1, round(high / 2))))
        keep = Adw.SwitchRow(title=_("Keep a copy on this PC"), active=True,
                             subtitle=_("Of what the partition holds, in case this goes wrong."))
        group = Adw.PreferencesGroup()
        group.add(choice)
        group.add(keep)

        def response(rid):
            if rid == "go":
                new_size = int(choice.get_value()) << 30
                self.run_operation(_("Making room"), "drive-harddisk-symbolic", lambda job: run_shrink(
                    job, self.device, card, part, new_size, keep.get_active(), backup_dir(self.win.config)),
                    _("There is more room now"), _("The system on this partition stays as it was."))

        alert(self.win, _("Make partition {number} smaller?").format(number=part["number"]), _(
            "Its contents stay. It takes a while, and it must not be stopped halfway: keep the phone connected."),
              [("cancel", _("Cancel")), ("go", _("Make smaller"))], response, Adw.ResponseAppearance.SUGGESTED, extra=group)

    def confirm_add_place(self, card):
        top = card["largest_free"] / (1 << 30)
        system = Adw.SpinRow.new_with_range(1, max(1, top - 1), 1)
        system.set_title(_("System in GiB"))
        system.set_value(min(16, max(1, top - 1)))
        data = Adw.SpinRow.new_with_range(1, max(1, top - 1), 1)
        data.set_title(_("Data in GiB"))
        data.set_value(max(1, min(top - 1, top - system.get_value() - 1)))
        group = Adw.PreferencesGroup()
        group.add(system)
        group.add(data)

        def response(rid):
            if rid == "go":
                sizes = int(system.get_value()) << 30, int(data.get_value()) << 30
                self.run_operation(_("Adding a place"), "list-add-symbolic",
                                   lambda job: run_add_place(job, self.device, card, *sizes),
                                   _("The new place is ready"), _("You can now install or move a system there."))

        alert(self.win, _("Add a new place"), _("The new partitions are empty and do not touch anything else."),
              [("cancel", _("Cancel")), ("go", _("Add"))], response, Adw.ResponseAppearance.SUGGESTED, extra=group)

    def add_own_storage(self, prefs, card):
        """What changes the phone's own storage: places there and a system instead of Volla OS, each only once a
        backup holds what it overwrites (see missing_backup)."""
        d = self.device
        if not d.rescue or not is_plinius(d):
            return
        pending = pending_rescue(self.win.config, d.serial)
        known = pending and re.fullmatch(r"init_boot_[ab]", pending["partition"])
        names = phone_changes(pending["partition"][len("init_boot"):]) if known else INTERNAL_CHANGES
        group, missing = backup_group(self.win, d, names, _(
            "Places on the phone itself and a system instead of Volla OS overwrite these partitions."))
        prefs.add(group)
        if card:
            self.add_internal(prefs, card, not any(n in missing for n in INTERNAL_CHANGES))
        self.add_phone_install(prefs, bool(known) and not missing)

    def add_phone_install(self, prefs, backed_up):
        """A system instead of Volla OS, in the phone's own storage. Works without a memory card."""
        group = Adw.PreferencesGroup(title=_("Install on the phone itself"), description=_(
            "Replaces Volla OS with a system from an image file. It then starts without a memory card, from storage "
            "that is much faster. All data of Volla OS is erased. Nobody has tried this on a real phone yet."))
        group.add(button_row(_("Choose image…"), "document-open-symbolic", self.on_phone_image, sensitive=backed_up))
        prefs.add(group)

    def on_phone_image(self):
        dialog = Gtk.FileDialog(title=_("Image of a system"))

        def chosen(dlg, result):
            try:
                path = dlg.open_finish(result).get_path()
            except GLib.Error:
                return
            self.win.toast(_("Checking the image…"))
            image = SystemImage(path)

            def done(_result, error):
                problem = error or image.problem or (image.phone_problem() if not error else "")
                if problem:
                    image.close()
                    alert(self.win, _("This image cannot be installed"), problem, [("close", _("Close"))])
                else:
                    self.confirm_phone_install(image)
                return False

            in_thread(image.check, done)

        dialog.open(self.win, None, chosen)

    def confirm_phone_install(self, image):
        size = Adw.SpinRow.new_with_range(max(2, image.size / (1 << 30)), 200, 1)
        size.set_title(_("System in GiB"))
        size.set_subtitle(_("The rest of the storage is for your data."))
        size.set_value(max(PHONE_SYSTEM_DEFAULT, image.size) / (1 << 30))
        sure = Adw.SwitchRow(title=_("I have a backup and accept the loss"),
                             subtitle=_("All data of Volla OS on this phone will be erased."))
        group = Adw.PreferencesGroup()
        group.add(size)
        group.add(sure)

        def response(rid):
            if rid != "go":
                image.close()
                return
            if not sure.get_active():
                image.close()
                self.win.toast(_("Nothing was changed: the switch was not turned on."))
                return
            bytes_ = int(size.get_value()) << 30
            problem = phone_install_problem(self.device, self.win.config, image, bytes_)
            if problem:
                image.close()
                alert(self.win, _("That is not possible"), problem, [("close", _("Close"))])
                return
            self.run_operation(_("Installing on the phone"), "system-software-install-symbolic",
                               lambda job: run_install_phone(job, self.device, self.win.config, image, bytes_),
                               _("The system is installed"), _(
                "The phone is restarting. Without a memory card it starts the new system. With one, choose "
                "the entry VollaOS in the boot menu: it now starts the new system. Other entries stay as they are."),
                               image.close)

        alert(self.win, _("Replace Volla OS with {name}?").format(name=image.name), _(
            "Volla OS can no longer start, and all its data is erased. The way back is a backup of it, or the Volla OS "
            "package. The bootloader and the partition table stay as they are, and so do systems on the memory card."),
              [("cancel", _("Cancel")), ("go", _("Replace Volla OS"))], response, Adw.ResponseAppearance.DESTRUCTIVE,
              extra=group)

    def add_internal(self, prefs, card, backed_up):
        """Stufe 6: places in the phone's own storage."""
        if not card.get("userdata"):
            return
        group = Adw.PreferencesGroup(title=_("Places on the phone itself"), description=_(
            "An experiment. This takes room from Volla OS and erases all its data. The boot menu stays on the memory "
            "card, so it is needed for these systems too."))
        room = internal_room(card)
        r = row(_("Make places on the phone"), _("Up to {size} can be taken from Volla OS.").format(size=size_text(room)),
                activatable=room >= 2 << 30 and backed_up, sensitive=backed_up)
        r.add_prefix(Gtk.Image(icon_name="dialog-warning-symbolic", css_classes=["warning"]))
        if room >= 2 << 30 and backed_up:
            r.connect("activated", lambda _r: self.confirm_internal(card))
        group.add(r)
        prefs.add(group)

    def confirm_internal(self, card):
        top = internal_room(card) / (1 << 30)
        count = Adw.SpinRow.new_with_range(1, 3, 1)
        count.set_title(_("How many places"))
        system = Adw.SpinRow.new_with_range(2, max(2, top), 1)
        system.set_title(_("System in GiB, each"))
        system.set_value(min(16, top))
        data = Adw.SpinRow.new_with_range(1, max(1, top), 1)
        data.set_title(_("Data in GiB, each"))
        data.set_value(min(32, top))
        sure = Adw.SwitchRow(title=_("I have a backup and accept the loss"),
                             subtitle=_("All data of Volla OS on this phone will be erased."))
        group = Adw.PreferencesGroup()
        for widget in (count, system, data, sure):
            group.add(widget)

        def response(rid):
            if rid != "go":
                return
            if not sure.get_active():
                self.win.toast(_("Nothing was changed: the switch was not turned on."))
                return
            sizes = int(count.get_value()), int(system.get_value()) << 30, int(data.get_value()) << 30
            problem = internal_problem(self.device, card, self.win.config, *sizes)
            if problem:
                alert(self.win, _("That is not possible"), problem, [("close", _("Close"))])
                return
            self.run_operation(_("Making places on the phone"), "dialog-warning-symbolic", lambda job: run_internal_places(
                job, self.device, card, self.win.config, *sizes, backup_dir(self.win.config)),
                _("The places are ready"), _(
                "Volla OS will be formatted when you write the original back. Check that it starts, before you install "
                "anything: nobody has tried this on a real phone yet."))

        alert(self.win, _("Make places on the phone?"), _(
            "An experiment: it is not known yet whether Volla OS and its updates get along with this. All data of Volla "
            "OS is erased. The app saves the partition table first and can put it back from here, but the data stays "
            "gone. Back up what you need first."),
              [("cancel", _("Cancel")), ("go", _("Make places"))], response, Adw.ResponseAppearance.DESTRUCTIVE, extra=group)

    def add_copy_row(self, group, state, card):
        titles = " · ".join(str(p.get("title") or "") for p in state.get("places", []))
        if state.get("kind") == "swap" and not state.get("done"):
            r = row(_("Unfinished swap: {titles}").format(titles=titles), str(state.get("created", "")), activatable=True)
            r.add_prefix(Gtk.Image(icon_name="dialog-warning-symbolic", css_classes=["warning"]))
            r.connect("activated", lambda _r: self.run_operation(
                _("Swapping systems"), "object-flip-horizontal-symbolic",
                lambda job: run_swap(job, self.device, card, state), _("The systems have swapped places"),
                _("Restart the phone and check that both start. The copies stay on this PC until you delete them.")))
        elif state.get("kind") == "copy":
            r = row(titles, str(state.get("created", "")), activatable=True)
            r.add_prefix(Gtk.Image(icon_name="document-revert-symbolic"))

            def put_back(_row):
                def response(rid):
                    if rid == "back":
                        self.run_operation(_("Putting a system back"), "document-revert-symbolic",
                                           lambda job: run_put_back(job, self.device, card, state),
                                           _("The system is back"), _("Restart the phone and check that it starts."))
                alert(self.win, _("Put {name} back?").format(name=titles), _(
                    "What is on its partitions now will be overwritten."), [("cancel", _("Cancel")), ("back", _("Put back"))],
                      response, Adw.ResponseAppearance.DESTRUCTIVE)
            r.connect("activated", put_back)
        elif state.get("kind") == "internal" and state.get("changed") and not state.get("restored"):
            r = row(_("Partition table from before the places on the phone"), str(state.get("created", "")), activatable=True)
            r.add_prefix(Gtk.Image(icon_name="document-revert-symbolic"))

            def back_table(_row):
                def response(rid):
                    if rid == "back":
                        self.run_operation(_("Putting the partition table back"), "document-revert-symbolic",
                                           lambda job: run_restore_table(job, self.device, card, self.win.config, state),
                                           _("The partition table is back"), _(
                                               "Volla OS will be formatted when you write the original back."))
                alert(self.win, _("Put the partition table back?"), _(
                    "The places on the phone and the systems on them are gone afterwards, and Volla OS is formatted once "
                    "more."), [("cancel", _("Cancel")), ("back", _("Put back"))], response, Adw.ResponseAppearance.DESTRUCTIVE)
            r.connect("activated", back_table)
        elif state.get("kind") == "internal":
            return
        elif state.get("kind") == "partition":
            r = row(titles, _("Kept in {dir}").format(dir=state.get("folder", "")))
        else:
            r = row(titles, _("Finished swap, kept in {dir}").format(dir=state.get("folder", "")))
        group.add(r)

    def run_operation(self, title, icon, work, done_title, done_text, cleanup=None):
        """Runs work(job) on an OperationPage, then shows what is on the card now."""
        d, win = self.device, self.win
        page = OperationPage(title, icon)
        job = Job(page)
        win.nav.push(page)
        win.scanner.busy.add(d.key)

        def run():
            try:
                work(job)
                return "ok"
            except Cancelled:
                return "cancelled"

        def back():
            d.layout = None
            win.nav.pop_to_page(self)
            self.render()

        def done(result, error):
            win.scanner.busy.discard(d.key)
            if cleanup:
                cleanup()
            if result == "ok":
                page.finish(True, done_title, done_text, [(_("Done"), back, "suggested-action")])
            elif result == "cancelled":
                page.finish(False, _("Cancelled"), _(
                    "The boot menu still shows what it showed before. The partition that was being written may be "
                    "incomplete, and a copy on this PC stays."), [(_("Back"), back, None)])
            else:
                page.finish(False, title, _("{error}\n\nThe boot menu changes only as the last step, so it still "
                                            "shows what it showed before.").format(error=error), [(_("Back"), back, None)])
            return False

        in_thread(run, done)

    def after_layout(self, prefs):
        d = self.device
        if d.layout["card"]:
            self.add_systems(prefs, d.layout["card"])
        self.add_own_storage(prefs, d.layout["card"])
        pending = pending_rescue(self.win.config, d.serial)
        group = Adw.PreferencesGroup(title=_("When you are done"))
        if pending:
            group.set_description(_("The rescue system is in {name}, so the phone does not start its own system until "
                                    "the original is written back.").format(name=pending["partition"]))
            group.add(button_row(_("Write original back and restart"), "system-reboot-symbolic",
                                 lambda: self.win.push(RescuePage(self.win, d)), suggested=True))
        else:
            group.add(button_row(_("Restart phone"), "system-reboot-symbolic",
                                 lambda: in_thread(lambda: d.access.reboot(""), lambda *_a: False)))
        prefs.add(group)


