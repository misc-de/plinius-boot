class StepBar(Adw.Bin):
    """① Connect — ② Check — ③ Download — ④ Install: the current step in the accent color, the ones before
    it ticked, and the download also when it is done early. Under a name a detail such as the progress."""

    def __init__(self, current=0):
        super().__init__()
        grid = Gtk.Grid(row_spacing=6)
        self.set_child(Adw.Clamp(maximum_size=560, margin_top=12, margin_bottom=12, margin_start=12, margin_end=12,
                                 child=grid))
        self.dots, self.lines, self.names, self.details = [], [], [], []
        for n, name in enumerate(STEPS):
            dot = Gtk.Stack(halign=Gtk.Align.CENTER, valign=Gtk.Align.CENTER)
            dot.add_named(Gtk.Label(label=str(n + 1)), "number")
            dot.add_named(Gtk.Image(icon_name="object-select-symbolic"), "done")
            dot.add_css_class("step-dot")
            label = Gtk.Label(label=name, justify=Gtk.Justification.CENTER)
            label.add_css_class("step-name")
            detail = Gtk.Label(visible=False)
            detail.add_css_class("step-name")
            grid.attach(dot, 2 * n, 0, 1, 1)
            grid.attach(label, 2 * n, 1, 1, 1)
            grid.attach(detail, 2 * n, 2, 1, 1)
            self.dots.append(dot)
            self.names.append(label)
            self.details.append(detail)
            if n:
                line = Gtk.Box(valign=Gtk.Align.CENTER, hexpand=True, width_request=12, margin_start=4, margin_end=4)
                line.add_css_class("step-line")
                grid.attach(line, 2 * n - 1, 0, 1, 1)
                self.lines.append(line)
        self.set_step(current)

    def set_step(self, current, finished=False, done_too=()):
        """current is one of CONNECT to INSTALL; finished ticks all, done_too ticks steps after current."""
        for n, (dot, label) in enumerate(zip(self.dots, self.names)):
            done = n < current or finished or n in done_too
            dot.set_visible_child_name("done" if done else "number")
            for widget in (dot, label):
                for css, on in (("done", done), ("current", n == current and not finished)):
                    (widget.add_css_class if on else widget.remove_css_class)(css)
        for n, line in enumerate(self.lines, 1):
            (line.add_css_class if n <= current or finished else line.remove_css_class)("done")

    def set_detail(self, step, text):
        self.details[step].set_label(text)
        self.details[step].set_visible(bool(text))


