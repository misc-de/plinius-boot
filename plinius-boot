def in_thread(work, done):
    """work() in the background, then done(result, error text) in the GTK thread."""
    def target():
        try:
            result, error = work(), None
        except Exception as e:
            traceback.print_exc()
            result, error = None, str(e)
        GLib.idle_add(done, result, error)
    threading.Thread(target=target, daemon=True).start()


class PartitionList:
    """Partitions by group in an Adw.PreferencesPage: one collapsed row per group, whose check box
    selects the whole group; expanded, it shows the partitions with their own check boxes."""

    def __init__(self, page, on_change):
        self.page, self.on_change = page, on_change
        self.group, self.checks, self.alls = None, {}, []

    def clear(self):
        if self.group:
            self.page.remove(self.group)
        self.group, self.checks, self.alls = None, {}, []

    def show(self, items, selectable=True):
        """items: [(key, group, title, subtitle, preselected, reason for blocking or None)]"""
        self.clear()
        self.group = Adw.PreferencesGroup()
        for gid in GROUP_ORDER:
            members = [it for it in items if it[1] == gid]
            if not members:
                continue
            title, description = GROUPS[gid]
            count = ngettext("{n} partition", "{n} partitions", len(members)).format(n=len(members))
            expander = Adw.ExpanderRow(title=title, subtitle=f"{count} · {description}", use_markup=False)
            checks = []
            for key, _gid, name, subtitle, selected, blocked in members:
                r = row(name, blocked or subtitle)
                if blocked:
                    r.add_css_class("dim-label")
                if selectable:
                    check = Gtk.CheckButton(active=selected and not blocked, sensitive=not blocked,
                                            valign=Gtk.Align.CENTER)
                    check.connect("toggled", self.toggled)
                    r.add_prefix(check)
                    r.set_activatable_widget(check)
                    if not blocked:
                        checks.append((key, check))
                        self.checks[key] = check
                expander.add_row(r)
            if selectable and checks:
                # In the collapsed row: clicking the box selects the group, clicking the row expands it
                all_check = Gtk.CheckButton(valign=Gtk.Align.CENTER, tooltip_text=_("All"))
                all_check.connect("toggled", self.toggle_all, checks)
                expander.add_prefix(all_check)
                self.alls.append((all_check, checks))
            self.group.add(expander)
        self.page.add(self.group)
        self.sync_all()
        self.on_change()

    def toggle_all(self, all_check, checks):
        if getattr(all_check, "syncing", False):
            return
        # Read once: every member's "toggled" runs sync_all, which resets the box after the first one
        state = all_check.get_active()
        for _key, check in checks:
            check.set_active(state)

    def sync_all(self):
        """Set each group's box from its members (inconsistent if mixed) without triggering toggle_all."""
        for all_check, checks in self.alls:
            active = [c.get_active() for _k, c in checks]
            all_check.syncing = True
            all_check.set_active(all(active))
            all_check.set_inconsistent(any(active) and not all(active))
            all_check.syncing = False

    def toggled(self, _check):
        self.sync_all()
        self.on_change()

    def selected(self):
        return [k for k, c in self.checks.items() if c.get_active()]


class StepPlan:
    """Where an operation is among its steps [(text, bytes)]. A report names its step by the text; a text that
    is no step (a part of one) keeps the current step, and the plan never goes back. The bar moves one share
    per step, within a step that moves bytes by those; only such a step has a rate and a time left."""

    def __init__(self, steps):
        self.steps = [(text, max(0, int(size or 0))) for text, size in steps]
        self.current, self.start_done, self.start_time = -1, 0, 0.0

    def update(self, done, text, now):
        """(index of the current step, fraction of the whole, (bytes per second, seconds left) or None)"""
        texts = [t for t, _s in self.steps]
        if text in texts:
            i = texts.index(text, max(self.current, 0)) if text in texts[max(self.current, 0):] else self.current
            if i > self.current:
                self.current, self.start_done, self.start_time = i, done, now
        if self.current < 0:
            return -1, 0.0, None
        size = self.steps[self.current][1]
        moved = max(0, done - self.start_done)
        inner = min(1.0, moved / size) if size else 0.0
        fraction = (self.current + inner) / len(self.steps)
        elapsed = now - self.start_time
        eta = None
        if size and 0 < moved < size and elapsed > 3:
            rate = moved / elapsed
            eta = (rate, (size - moved) / rate)
        return self.current, fraction, eta

    def finish(self):
        self.current = len(self.steps)


class OperationPage(Adw.NavigationPage):
    """Progress of an operation with Cancel; at the end the result and buttons."""

    def __init__(self, title, icon):
        super().__init__(title=title, can_pop=False)
        self.job = None
        self.started = time.monotonic()
        self.status = Adw.StatusPage(icon_name=icon, title=title)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        self.step = Gtk.Label(wrap=True, justify=Gtk.Justification.CENTER)
        self.bar = Gtk.ProgressBar(show_text=True)
        self.eta = Gtk.Label(css_classes=["dim-label"])
        # The steps of the operation, once it names them (Job.plan)
        self.plan, self.plan_rows, self.last = None, [], (0, 0, "")
        self.steps_list = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE, css_classes=["boxed-list"],
                                      visible=False)
        self.log = Gtk.TextView(editable=False, monospace=True, wrap_mode=Gtk.WrapMode.WORD_CHAR,
                                cursor_visible=False, top_margin=6, bottom_margin=6, left_margin=6)
        scroller = Gtk.ScrolledWindow(child=self.log, min_content_height=160, css_classes=["card"])
        expander = Gtk.Expander(label=_("Details"), child=scroller)
        self.buttons = Gtk.Box(halign=Gtk.Align.CENTER, spacing=12, margin_top=12)
        self.cancel_button = Gtk.Button(label=_("Cancel"), css_classes=["pill"])
        self.cancel_button.connect("clicked", self.on_cancel)
        self.buttons.append(self.cancel_button)
        for w in (self.step, self.bar, self.eta, self.steps_list, expander, self.buttons):
            box.append(w)
        self.status.set_child(Adw.Clamp(maximum_size=520, child=box))
        toolbar = Adw.ToolbarView(content=self.status)
        toolbar.add_top_bar(Adw.HeaderBar(show_back_button=False))
        self.set_child(toolbar)

    def on_cancel(self, _button):
        if self.job:
            self.cancel_button.set_sensitive(False)
            self.step.set_label(_("Cancelling…"))
            self.job.cancel()

    def set_plan(self, steps):
        """Lists the steps; the one reported last before counts already."""
        self.plan = StepPlan(steps)
        for r in self.plan_rows:
            self.steps_list.remove(r)
        self.plan_rows = []
        for text, _size in self.plan.steps:
            r = Adw.ActionRow(title=text)
            r.icon = Gtk.Image()
            r.add_prefix(r.icon)
            self.steps_list.append(r)
            self.plan_rows.append(r)
        self.steps_list.set_visible(bool(self.plan_rows))
        self.progress(*self.last)
        return False

    def show_steps(self, current, failed=False):
        """Done ones ticked, the current one marked (a warning if it failed), the ones to come dimmed."""
        for i, r in enumerate(self.plan_rows):
            if i < current:
                r.icon.set_from_icon_name("emblem-ok-symbolic")
            elif i == current:
                r.icon.set_from_icon_name("dialog-warning-symbolic" if failed else "media-playback-start-symbolic")
            else:
                r.icon.set_from_icon_name("content-loading-symbolic")
            if i > current:
                r.add_css_class("dim-label")
            else:
                r.remove_css_class("dim-label")

    def show_eta(self, rate, left):
        mins = max(1, round(left / 60))
        self.eta.set_label(_("{rate}/s, about {left} left").format(
            rate=size_text(int(rate)), left=ngettext("{n} minute", "{n} minutes", mins).format(n=mins)))
        self.eta.set_visible(True)

    def progress(self, done, total, text):
        self.last = (done, total, text)
        if text:
            self.step.set_label(text)
        now = time.monotonic()
        if self.plan:
            current, fraction, eta = self.plan.update(done, text, now)
            self.show_steps(current)
            self.bar.set_fraction(min(fraction, 1))
            if eta:
                self.show_eta(*eta)
            else:
                self.eta.set_visible(False)
            return False
        fraction = done / total if total else 0
        self.bar.set_fraction(min(fraction, 1))
        elapsed = now - self.started
        # A rate and a time left only while bytes are still to come: not at 100 %, not for a step without bytes
        if done and total and done < total and elapsed > 3:
            rate = done / elapsed
            self.show_eta(rate, int((total - done) / rate) if rate else 0)
        else:
            self.eta.set_visible(False)
        return False

    def add_line(self, text):
        buf = self.log.get_buffer()
        buf.insert(buf.get_end_iter(), text + "\n")
        return False

    def finish(self, ok, title, text, buttons):
        """buttons: [(text, callback, style)]"""
        self.set_can_pop(True)
        self.status.set_icon_name("emblem-ok-symbolic" if ok else "dialog-warning-symbolic")
        self.status.set_title(title)
        notes = self.job.notes if self.job else []
        self.step.set_label("\n\n".join([text] + notes) if text and notes else text or "\n\n".join(notes))
        if self.plan:
            if ok:
                self.plan.finish()
                self.bar.set_fraction(1)
            self.show_steps(self.plan.current, failed=not ok)
        self.bar.set_visible(ok)
        self.eta.set_visible(False)
        self.buttons.remove(self.cancel_button)
        for label, callback, style in buttons:
            b = Gtk.Button(label=label, css_classes=["pill"] + ([style] if style else []))
            b.connect("clicked", lambda _b, c=callback: c())
            self.buttons.append(b)
        return False


def expected_original(device, config, pending):
    """Hash descriptor of the original of the partition the rescue system occupies (see avb_hashes):
    read from the phone's vbmeta in the rescue system and remembered, so that it can also be checked
    from fastboot. Returns (partition name without slot, descriptor)."""
    name = re.sub(r"_[ab]$", "", pending["partition"])
    if device.rescue:
        suffix = pending["partition"][len(name):]
        inside = read_phone_system(device, config)
        # vbmeta describes Volla OS whatever was installed later: its checksum only fits Android. Anything
        # else needs its own init_boot as this app saw it; Volla OS's would stop it from starting
        expected = known_init_boot(config, device.serial, suffix[1:], inside["kind"])
        if not expected and inside["kind"] in ("android", "unknown"):
            vbmeta = "vbmeta" + suffix
            head = next((p.head for p in device.load_parts() if p.name == vbmeta), b"")
            expected = avb_hashes(head).get(name)
            if not expected:
                raise Failed(_("The phone's {vbmeta} holds no checksum for {name}.").format(vbmeta=vbmeta, name=name))
        if not expected:
            raise Failed(_("Inside the phone is {system}, not Volla OS, and the app never saw its {name}: writing "
                           "the one of Volla OS back would stop it from starting. The rescue system stays. Write "
                           "the right {name} back from a file under Advanced, Rescue system.").format(
                system=inside["name"] or _("the current system"), name=name))
        if pending.get("expected") != expected:
            pending["expected"] = expected
            save_config(config)
    if not pending.get("expected"):
        raise Failed(_("Start the rescue system once more, so that the app can read which {name} the phone "
                       "expects.").format(name=name))
    return name, pending["expected"]


def look_for_original(device, config, pending, step):
    """The original of the occupied partition from the update server or the files kept earlier
    (see find_original), or None."""
    name, expected = expected_original(device, config, pending)
    return find_original(device.serial, name, expected, device.profile.ota_index if device.profile else "", step)


