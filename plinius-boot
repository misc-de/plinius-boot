# Program, a command that proves it runs, what it is for. Run at every start, because a program can
# be there and still not work.
TOOLS = (
    ("adb", ["adb", "start-server"], lambda: _("Talks to Android on the phone")),
    ("fastboot", ["fastboot", "--version"], lambda: _("Talks to the phone's bootloader")),
    ("ssh", ["ssh", "-V"], lambda: _("Talks to Linux and the rescue system on the phone")),
    ("ssh-keygen", ["ssh-keygen", "-?"], lambda: _("Creates the key for the rescue system")),
    ("ip", ["ip", "-V"], lambda: _("Finds the phone's USB network")),
)
# Packages per system family, for the hint what to install
PACKAGES = {
    "arch": ("sudo pacman -S", {"adb": "android-tools", "fastboot": "android-tools", "ssh": "openssh",
                                "ssh-keygen": "openssh", "ip": "iproute2"}),
    "debian": ("sudo apt install", {"adb": "adb", "fastboot": "fastboot", "ssh": "openssh-client",
                                    "ssh-keygen": "openssh-client", "ip": "iproute2"}),
    "fedora": ("sudo dnf install", {"adb": "android-tools", "fastboot": "android-tools", "ssh": "openssh-clients",
                                    "ssh-keygen": "openssh-clients", "ip": "iproute"}),
}
# The rules that let a normal user open phones over USB
UDEV_PACKAGES = {"arch": "android-udev", "debian": "android-sdk-platform-tools-common", "fedora": "android-tools"}


def check_tools():
    """[(name, purpose, problem)], problem empty if the program runs. ssh-keygen knows no harmless
    option, it answers "-?" with an error: only "not there" and "cannot be run" count for it."""
    results = []
    for name, command, purpose in TOOLS:
        rc, out, err = run(command, timeout=20)
        if rc == 127:
            problem = _("Not installed.")
        elif rc == 126:
            problem = _("Cannot be run.")
        elif rc == 124:
            problem = _("Does not answer.")
        elif rc != 0 and name != "ssh-keygen":
            problem = _("Does not work: {error}").format(error=clean_text((err or out).strip(), 160))
        else:
            problem = ""
        results.append((name, purpose(), problem))
    return results


def system_family(os_release="/etc/os-release"):
    """"arch", "debian", "fedora" or "" for the system the app runs on, from ID and ID_LIKE."""
    try:
        with open(os_release) as f:
            kv = dict(line.strip().split("=", 1) for line in f if "=" in line)
    except OSError:
        return ""
    ids = (kv.get("ID", "") + " " + kv.get("ID_LIKE", "")).replace('"', "").split()
    return next((family for family in ("arch", "debian", "fedora") if family in ids
                 or (family == "fedora" and "rhel" in ids) or (family == "debian" and "ubuntu" in ids)), "")


def install_hint(names, family):
    """The command that installs the given tools on this system, or "" if the system is not known."""
    if family not in PACKAGES:
        return ""
    command, packages = PACKAGES[family]
    return command + " " + " ".join(dict.fromkeys(packages[n] for n in names))


def usb_blocked(sysfs="/sys/bus/usb/devices", dev="/dev/bus/usb"):
    """Whether a phone in adb or fastboot mode is on USB that this user may not open: the app then
    finds nothing, and nothing else would say why. Android's interface is vendor class ff, subclass
    42, protocol 1 (adb) or 3 (fastboot)."""
    def read(path):
        try:
            with open(path) as f:
                return f.read().strip()
        except OSError:
            return ""
    for interface in glob.glob(os.path.join(sysfs, "*:*")):
        if (read(os.path.join(interface, "bInterfaceClass")) == "ff"
                and read(os.path.join(interface, "bInterfaceSubClass")) == "42"
                and read(os.path.join(interface, "bInterfaceProtocol")) in ("01", "03")):
            device = os.path.dirname(os.path.realpath(interface))
            bus, number = read(os.path.join(device, "busnum")), read(os.path.join(device, "devnum"))
            if bus.isdigit() and number.isdigit():
                node = os.path.join(dev, f"{int(bus):03d}", f"{int(number):03d}")
                if not os.access(node, os.R_OK | os.W_OK):
                    return True
    return False


def is_plinius(device):
    """Whether this is the phone the guided flow is made for. None if the connection cannot tell yet."""
    if device.profile:
        return device.profile.id.startswith("volla-plinius")
    return None if device.rescue or device.mode == "fastboot" or not device.access else False


def bootloader_open(device):
    """True if the bootloader is unlocked, False if locked, None if this connection cannot tell.
    The running system shows it through Verified Boot: orange is unlocked, green or yellow is locked."""
    if device.rescue:
        return True
    if device.mode == "fastboot" and device.access:
        return {"yes": True, "no": False}.get(device.access.vars.get("unlocked"))
    state = device.info.get("verified_boot", "")
    if state:
        return state == "orange"
    return {"0": True, "1": False}.get(device.info.get("flash_locked", ""))


# Runs on the phone as root and changes nothing: the memory card by its numbers, because the Volla Boot
# Manager leaves its partitions without names, so they are not in the partition list. Partitions in use
# are read where they are mounted, others mounted read-only without journal replay (noload).
# Sizes are in units of 512 bytes, as in sysfs, whatever the sector size of the disk.
# Output by tabs: D disk sectors / G the start of the disk as base64 / P partition start sectors /
# U userdata disk start sectors sector-size partitions / I place-in-the-phone label start sectors /
# F partition blocks block-size free-blocks / O partition key=value / E file line / S the partition with
# the boot entries / A a system using systemd's gpt-auto generator / R the partition the running system
# came from.
CARD_SCRIPT = r"""
m=$(mktemp -d /tmp/plinius-card.XXXXXX) || exit 1
# read_part DEVICE: file system, systems and boot entries of one partition
read_part() {
	n=$1
	dumpe2fs -h "/dev/$n" 2>/dev/null | awk -F: -v n="$n" '
		/^Block count/ { b = $2 + 0 } /^Free blocks/ { f = $2 + 0 } /^Block size/ { s = $2 + 0 }
		END { if (b) printf "F\t%s\t%d\t%d\t%d\n", n, b, s, f }'
	dir=$(awk -v d="/dev/$n" '$1 == d { print $2; exit }' /proc/mounts)
	if [ -z "$dir" ]; then
		mount -t ext4 -o ro,noload "/dev/$n" "$m" 2>/dev/null || return 0
		dir=$m
	fi
	for f in etc/os-release usr/lib/os-release; do
		t=$dir/$f
		l=$(readlink "$t") && case $l in /*) t=$dir$l ;; esac
		[ -f "$t" ] || continue
		grep -E '^(NAME|PRETTY_NAME|VERSION_ID|BUILD_ID|IMAGE_VERSION)=' "$t" |
			while read -r line; do printf 'O\t%s\t%s\n' "$n" "$line"; done
		break
	done
	c=$dir/etc/system-image/channel.ini
	[ -f "$c" ] && grep -E '^(channel|build_number): ' "$c" | sed 's/: */=/' |
		while read -r line; do printf 'O\t%s\t%s\n' "$n" "$line"; done
	g=systemd/system-generators/systemd-gpt-auto-generator
	[ -e "$dir/usr/lib/$g" ] && [ ! -e "$dir/etc/$g" ] && printf 'A\t%s\n' "$n"
	[ -f "$dir/db/db.conf" ] && printf 'S\t%s\n' "$n"
	for f in "$dir"/db/entries/*.conf; do
		[ -f "$f" ] || continue
		while read -r line; do printf 'E\t%s\t%s\n' "${f##*/}" "$line"; done < "$f"
	done
	[ "$dir" = "$m" ] && umount "$m"
}
for b in /sys/block/mmcblk*; do
	[ "$(cat "$b/device/type" 2>/dev/null)" = SD ] || continue
	d=${b##*/}
	printf 'D\t%s\t%s\n' "$d" "$(cat "$b/size")"
	printf 'G\t%s\n' "$(dd if="/dev/$d" bs=512 count=34 2>/dev/null | base64 | tr -d '\n')"
	r=$(sed -n 's/.*systempart=\(\/dev\/[a-z0-9]*\).*/\1/p' /proc/cmdline)
	[ -n "$r" ] && printf 'R\t%s\n' "${r##*/}"
	for p in "$b/$d"*; do
		[ -e "$p/start" ] || continue
		n=${p##*/}
		printf 'P\t%s\t%s\t%s\n' "$n" "$(cat "$p/start")" "$(cat "$p/size")"
		read_part "$n"
	done
done
# The phone's own storage: where userdata is, and the places the app made there
u=$(readlink -f /dev/disk/by-partlabel/userdata 2>/dev/null)
u=${u##*/}
if [ -n "$u" ] && [ -e "/sys/class/block/$u/start" ]; then
	d=$(basename "$(dirname "$(readlink -f "/sys/class/block/$u")")")
	printf 'U\t%s\t%s\t%s\t%s\t%s\t%s\n' "$u" "$d" "$(cat "/sys/class/block/$u/start")" "$(cat "/sys/class/block/$u/size")" \
		"$(cat "/sys/block/$d/queue/logical_block_size")" "$(ls -d "/sys/block/$d/$d"* | wc -l)"
	for p in "/sys/block/$d/$d"*; do
		[ -e "$p/start" ] || continue
		n=${p##*/}
		l=$(sed -n 's/^PARTNAME=//p' "$p/uevent")
		case $l in
			plinius_*)
				printf 'I\t%s\t%s\t%s\t%s\n' "$n" "$l" "$(cat "$p/start")" "$(cat "$p/size")"
				read_part "$n"
				;;
		esac
	done
fi
rmdir "$m"
"""

SECTOR = 512
# The GPT type "Linux /home", which systemd mounts by itself; the Volla Boot Manager gives it to data
GPT_HOME = "933ac7e1-2eb4-4f13-b844-0e14e2aef915"
# GPT reserves 34 sectors at the end of a disk, and partitions start after the first MiB
GPT_FIRST, GPT_RESERVED = 2048, 34


def free_areas(sectors, parts):
    """Free areas of a disk as [(start sector, sectors)], from its size and [(start, sectors)]."""
    areas, position = [], GPT_FIRST
    for start, size in sorted(parts):
        if start > position:
            areas.append((position, start - position))
        position = max(position, start + size)
    end = sectors - GPT_RESERVED
    if end > position:
        areas.append((position, end - position))
    return areas


INTERNAL_PART_RE = re.compile(r"(sd|vd)[a-z]+\d+")
# Partitions the app made in the phone's own storage are known by these names, and only those can be written
LABEL_RE = re.compile(r"plinius_(sys|dat)\d{1,2}")


def boot_path(part):
    """How the kernel finds a partition. In the phone's storage by name, because the Halium ramdisk has
    by-partlabel for super as well, and the letter of the disk could change between kernels."""
    return "/dev/disk/by-partlabel/" + part["label"] if part.get("internal") else "/dev/" + part["name"]


def gpt_types(head, sector=SECTOR):
    """{partition number: type GUID} from the start of a disk; empty if it holds no sane GPT."""
    if head[sector:sector + 8] != b"EFI PART" or len(head) < 2 * sector + 128:
        return {}
    lba, count, size = struct.unpack_from("<QII", head, sector + 72)
    if size < 128 or size > 4096 or lba < 2:
        return {}
    types = {}
    for i in range(min(count, 256)):
        at = lba * sector + i * size
        raw = head[at:at + 16]
        if len(raw) < 16:
            break
        if any(raw):
            a, b, c = struct.unpack_from("<IHH", raw)
            rest = raw[8:].hex()
            types[i + 1] = f"{a:08x}-{b:04x}-{c:04x}-{rest[:4]}-{rest[4:]}"
    return types


def parse_card(out):
    """The memory card from the CARD_SCRIPT output, or None without one. The phone is not trusted:
    what does not look like expected is dropped, texts are cleaned, and nothing goes into a command."""
    disk, sectors, running, parts, files, settings, head, userdata = "", 0, "", {}, {}, "", b"", None
    for line in out.splitlines():
        f = line.split("\t")
        if f[0] == "D" and len(f) == 3 and re.fullmatch(r"mmcblk\d+", f[1]) and f[2].isdigit() and not disk:
            disk, sectors = f[1], int(f[2])
        elif f[0] == "R" and len(f) == 2:
            running = f[1]
        elif f[0] == "G" and len(f) == 2:
            try:
                head = base64.b64decode(f[1])
            except ValueError:
                head = b""
        elif f[0] == "S" and len(f) == 2 and f[1] in parts:
            settings = f[1]
        elif f[0] == "A" and len(f) == 2 and f[1] in parts:
            parts[f[1]]["gpt_auto"] = True
        elif f[0] == "F" and len(f) == 5 and f[1] in parts and all(x.isdigit() for x in f[2:]):
            blocks, size, free = int(f[2]), int(f[3]), int(f[4])
            if size and free <= blocks:
                parts[f[1]]["fs"] = {"blocks": blocks, "block_size": size, "bytes": blocks * size,
                                     "used": (blocks - free) * size}
        elif f[0] == "P" and len(f) == 4 and re.fullmatch(r"mmcblk\d+p\d+", f[1]) and f[2].isdigit() and f[3].isdigit():
            parts[f[1]] = {"name": f[1], "number": int(f[1].rpartition("p")[2]), "start": int(f[2]),
                           "size": int(f[3]) * SECTOR, "sectors": int(f[3]), "os": {}}
        elif f[0] == "U" and len(f) == 7 and INTERNAL_PART_RE.fullmatch(f[1]) and all(x.isdigit() for x in f[3:]) \
                and re.fullmatch(r"(sd|vd)[a-z]+", f[2]):
            userdata = {"name": f[1], "number": int(re.search(r"\d+$", f[1])[0]), "disk": f[2], "start": int(f[3]),
                        "sectors": int(f[4]), "size": int(f[4]) * SECTOR, "sector_size": int(f[5]), "count": int(f[6])}
        elif f[0] == "I" and len(f) == 5 and INTERNAL_PART_RE.fullmatch(f[1]) and LABEL_RE.fullmatch(f[2]) \
                and f[3].isdigit() and f[4].isdigit():
            parts[f[1]] = {"name": f[1], "number": int(re.search(r"\d+$", f[1])[0]), "start": int(f[3]), "sectors": int(f[4]),
                           "size": int(f[4]) * SECTOR, "os": {}, "label": f[2], "internal": True}
        elif f[0] == "O" and len(f) == 3 and f[1] in parts and "=" in f[2]:
            key, _eq, value = f[2].partition("=")
            parts[f[1]]["os"][key] = value.strip().strip('"')
        elif f[0] == "E" and len(f) == 3 and re.fullmatch(r"[A-Za-z0-9_.-]{1,64}\.conf", f[1]):
            key, _sep, value = f[2].partition(" ")
            entry = files.setdefault(f[1], {"raw": []})
            entry[key] = value.strip()
            entry["raw"].append(f[2])
    if not disk:
        return None
    by_number = {p["number"]: p for p in parts.values() if not p.get("internal")}
    by_path = {boot_path(p): p for p in parts.values()}
    for p in parts.values():
        found = parse_systems("".join(f"{p['name']}\t{k}={v}\n" for k, v in p["os"].items()),
                              [Partition(p["name"], p["name"], p["size"])])
        p["system"] = found[0] if found else None
        p["running"] = p["name"] == running
    entries = []
    for name, kv in sorted(files.items()):
        # "xpart 4:5" is system and data; the Android entry says "real", which is the phone's own system
        m = re.fullmatch(r"(\d+):(\d+)", kv.get("xpart", ""))
        # What the kernel is told counts; xpart can only name partitions of the card
        booted = dict(re.findall(r"\b(systempart|datapart)=(\S+)", kv.get("options", "")))
        entries.append({"file": name, "title": clean_text(kv.get("title", ""), 60),
                        "own_system": kv.get("xtype") == "droid", "raw": kv["raw"],
                        "options": clean_text(kv.get("options", ""), 1000),
                        "kernel": kv.get("linux", "").partition("/")[0],
                        "system": by_path.get(booted.get("systempart")) or (by_number.get(int(m[1])) if m else None),
                        "data": by_path.get(booted.get("datapart")) or (by_number.get(int(m[2])) if m else None)})
    free = free_areas(sectors, [(p["start"], p["sectors"]) for p in parts.values() if not p.get("internal")])
    types = gpt_types(head)
    for p in parts.values():
        p["type"] = types.get(p["number"], "")
    return {"disk": disk, "size": sectors * SECTOR, "parts": sorted(parts.values(), key=lambda p: p["number"]),
            "settings": settings, "userdata": userdata, "sectors": sectors,
            "entries": entries, "free": sum(s for _start, s in free) * SECTOR,
            "largest_free": max((s for _start, s in free), default=0) * SECTOR}


# Runs in the rescue system after plinius-partlinks, as root, and changes nothing: what the phone's own
# storage holds. vbmeta keeps saying Volla OS whatever was installed later, so the app looks into userdata,
# mounted read-only (ext4 without journal replay, or f2fs as Android has it): a rootfs.img there is a Linux
# system (one of this app, or another port), with its os-release read from it the same way; user-data and
# system-data are Ubuntu Touch; app, data, media and misc are Android. Output: key=value lines.
PHONE_SYSTEM_SCRIPT = r"""
d=/dev/disk/by-partlabel/userdata
[ -b "$d" ] || exit 0
if [ "$(dd if="$d" bs=4 count=1 2>/dev/null)" = LUKS ]; then echo fs=luks; exit 0; fi
m=$(mktemp -d /tmp/plinius-phone.XXXXXX) || exit 1
if mount -t ext4 -o ro,noload "$d" "$m" 2>/dev/null; then echo fs=ext4
elif mount -t f2fs -o ro "$d" "$m" 2>/dev/null; then echo fs=f2fs
else rmdir "$m"; echo fs=unknown; exit 0; fi
for x in rootfs.img ubuntu.img user-data system-data android-data app data media misc; do
	[ -e "$m/$x" ] && echo "has=$x"
done
if [ -f "$m/rootfs.img" ] && i=$(mktemp -d /tmp/plinius-rootfs.XXXXXX); then
	if mount -t ext4 -o ro,noload,loop "$m/rootfs.img" "$i" 2>/dev/null; then
		for f in etc/os-release usr/lib/os-release; do
			t=$i/$f
			l=$(readlink "$t") && case $l in /*) t=$i$l ;; esac
			[ -f "$t" ] || continue
			grep -E '^(NAME|PRETTY_NAME)=' "$t"
			break
		done
		[ -f "$i/etc/system-image/channel.ini" ] && echo channel=yes
		umount "$i"
	fi
	rmdir "$i"
fi
umount "$m"
rmdir "$m"
"""


def phone_system(out, android, own=False):
    """What runs in the phone itself, from PHONE_SYSTEM_SCRIPT: {"kind": "plinius", "ubuntu", "linux",
    "android" or "unknown", "name": its name or ""}. android: android_systems of the phone, which name the
    Android build; own: this app installed a system in the phone (config "phone_system"). Kernel updates
    change its boot partition, so that is no sign; a backup of Volla OS restored since shows as Android."""
    kv, has = {}, set()
    for line in out.splitlines():
        key, eq, value = line.partition("=")
        if not eq:
            continue
        value = clean_text(value.strip().strip('"'))
        if key == "has":
            has.add(value)
        else:
            kv[key] = value
    linux = kv.get("PRETTY_NAME") or kv.get("NAME") or ""
    if own and ("rootfs.img" in has or kv.get("fs") == "luks"):
        return {"kind": "plinius", "name": linux or "Plinius"}
    if kv.get("channel") or "ubuntu.img" in has or {"user-data", "system-data"} & has:
        return {"kind": "ubuntu", "name": "Ubuntu Touch"}
    # Android encrypts per file, never the whole partition: LUKS is a Linux system, whose name is inside
    if "rootfs.img" in has or kv.get("fs") == "luks":
        return {"kind": "linux", "name": linux}
    # Without a system of its own in userdata the phone starts Android from super, with its data or anew
    if {"app", "data", "media", "misc"} & has or kv.get("fs") in ("ext4", "f2fs") and not has:
        return {"kind": "android", "name": android[0]["name"] if android else "Android"}
    return {"kind": "unknown", "name": ""}


def read_phone_system(device, config=None, android=()):
    """phone_system of a phone in the rescue system; unknown if it cannot be read."""
    access = device.access
    own = bool(config and isinstance(config.get("phone_system", {}).get(device.serial), dict))
    try:
        run_checked(access, "plinius-partlinks", 120, _("Reading the partition table"))
        rc, out, _err = access.run_root(PHONE_SYSTEM_SCRIPT, 300)
    except (Failed, OSError, ValueError):
        return {"kind": "unknown", "name": ""}
    return phone_system(out if rc == 0 else "", list(android), own)


def read_layout(device, config=None):
    """What is installed where, as far as this connection can tell. Only reads. "complete" is False if
    only the rescue system or an administrator login could tell more. "phone": what runs in the phone
    itself (see phone_system), known in the rescue system only."""
    layout = {"android": [], "storage": [], "card": None, "complete": False, "phone": None}
    if not device.access:
        return layout
    parts = []
    if device.can_read or device.mode == "fastboot":
        parts = device.load_parts()
    by_name = {p.name: p for p in parts}
    layout["android"] = android_systems({p.name: p.head for p in parts if p.head}, device.info.get("slot", ""))
    layout["storage"] = [by_name[n] for n in ("super", "userdata") if n in by_name]
    if device.can_read:
        layout["card"] = device.access.card()
        layout["complete"] = True
    if device.rescue and device.can_read:
        layout["phone"] = read_phone_system(device, config, layout["android"])
    return layout


class ShellAccess:
    """Common part of ssh and adb: a shell on the phone, root command prefix in self.root (None = no root)."""

    root = None
    can_read = property(lambda self: self.root is not None)
    can_write = property(lambda self: self.root is not None)

    def info(self):
        rc, out, _err = self.run_root(INFO_SCRIPT) if self.root is not None else self.run_user(INFO_SCRIPT)
        return parse_info(out) if rc == 0 else {}

    def partitions(self):
        # Without root only the heads are missing (kind "not checked")
        script = LIST_SCRIPT
        rc, out, err = self.run_root(script, 180) if self.root is not None else self.run_user(script, 180)
        if rc != 0 and not out:
            raise RuntimeError(err.strip() or _("Could not read the partition list."))
        return parse_partitions(out)

    def linux_systems(self, parts):
        """Linux systems on the ext4 partitions that nothing has mounted (see SYSTEMS_SCRIPT); root only."""
        paths = [p.path for p in parts if p.kind == "ext4" and p.busy == "-" and PATH_RE.match(p.path)]
        if self.root is None or not paths:
            return []
        rc, out, _err = self.run_root("set -- " + " ".join(paths) + "\n" + SYSTEMS_SCRIPT, 120)
        return parse_systems(out, parts) if rc == 0 else []

    def card(self):
        """The memory card with its systems (see CARD_SCRIPT), or None; root only."""
        if self.root is None:
            return None
        _rc, out, _err = self.run_root(CARD_SCRIPT, 120)
        return parse_card(out)

    def checksum(self, path, size):
        # Drop the device's buffers so the data is read from the medium and not from the cache
        rc, out, err = self.run_root(f"blockdev --flushbufs {path} 2>/dev/null; head -c {int(size)} {path} | sha256sum",
                                     600 + size // 10_000_000)
        return out.split()[0] if rc == 0 and out.split() else None


def askpass_env(password):
    """Environment for ssh that supplies the password via SSH_ASKPASS (no terminal needed)."""
    os.makedirs(RUNTIME, mode=0o700, exist_ok=True)
    helper = os.path.join(RUNTIME, "askpass")
    if not os.path.exists(helper):
        with open(helper, "w") as f:
            f.write('#!/bin/sh\nprintf "%s\\n" "$PLINIUS_BOOT_PASSWORD"\n')
        os.chmod(helper, 0o700)
    return dict(os.environ, SSH_ASKPASS=helper, SSH_ASKPASS_REQUIRE="force", PLINIUS_BOOT_PASSWORD=password)


def auth_methods(err):
    """The ways of logging in an SSH server still offers, from ssh's "Permission denied (publickey,password)."
    None if the message does not name them."""
    m = re.search(r"Permission denied \(([a-z0-9@.,-]*)\)", err)
    return set(m.group(1).split(",")) - {""} if m else None


def takes_password(methods):
    """Whether a password can log in where the server offers methods (see auth_methods); unknown counts as
    yes, so a server that says nothing keeps the login."""
    return methods is None or bool(methods & {"password", "keyboard-interactive"})


class SshAccess(ShellAccess):
    """Linux on the phone (or the rescue system) over ssh; root via sudo."""

    mode = "ssh"

    def __init__(self, host, user, port=22, password=None, usbnet=True, link=None):
        if not valid_user(user):
            raise ValueError(f"invalid user name: {user!r}")
        self.host, self.user, self.port, self.password, self.usbnet = host, user, port, password, usbnet
        self.methods = None
        # USB network interface the phone was found on (see usbnet_link); the password only goes there
        self.link = (link or usbnet_link()) if usbnet else None
        self.env = askpass_env(password) if password else None

    def command(self, remote):
        cmd = ["ssh", "-p", str(self.port), "-o", "ConnectTimeout=5", "-o", "ServerAliveInterval=10",
               "-o", "BatchMode=" + ("no" if self.password else "yes")]
        if self.usbnet:
            # Every phone on the cable has the same address, so host keys inevitably change
            cmd += ["-o", "StrictHostKeyChecking=no", "-o", "UserKnownHostsFile=/dev/null", "-o", "LogLevel=ERROR"]
            # -i replaces the default keys, so list all existing ones explicitly
            for key in SSH_KEYS:
                if os.path.exists(key):
                    cmd += ["-i", key]
        else:
            cmd += ["-o", "StrictHostKeyChecking=accept-new"]
        if self.password:
            # Host keys are not checked on the USB network: send the password only over the same USB
            # interface it was entered for. A phone plugged in since then gets a new interface.
            if self.usbnet and (self.link is None or usbnet_link() != self.link):
                raise Failed(_("The phone was disconnected."))
            cmd += ["-o", "NumberOfPasswordPrompts=1"]
        # "--": the destination is never taken as an option
        return cmd + ["--", f"{self.user}@{self.host}", remote]

    def check(self):
        """"ok", "auth" (login rejected) or "unreachable". After "auth", self.methods holds the ways of
        logging in the server named (see takes_password)."""
        rc, _out, err = run(self.command("true"), timeout=15, env=self.env)
        if rc == 0:
            return "ok"
        if "Permission denied" not in err:
            return "unreachable"
        self.methods = auth_methods(err)
        return "auth"

    def detect_root(self):
        """Set self.root: "" (logged in as root), a sudo prefix, or None (no root)."""
        # Test with sh, because everything runs as "sudo ... sh" (sudo rules can apply per command).
        # "if" keeps the exit code 0 without sudo (rescue system), so rc only reports a failed login.
        rc, out, _err = run(self.command("id -u; if sudo -n sh -c true 2>/dev/null; then echo sudo; fi"),
                            env=self.env)
        words = out.split()
        if rc != 0:
            self.root = None
        elif words[:1] == ["0"]:
            self.root = ""
        elif "sudo" in words:
            self.root = "sudo -n "
        elif self.password:
            # The password goes in as the first line on stdin. If sudo did not ask for it, that line
            # would end up in the data; so only if the prompt demonstrably appears (marker in stderr).
            # -k: never use cached credentials.
            rc, _out, err = run(self.command("sudo -k -S -p 'plinius-boot-sudo:' sh -c true"),
                                input=(self.password + "\n").encode(), env=self.env)
            self.root = "sudo -k -S -p '' " if rc == 0 and "plinius-boot-sudo:" in err else None

    def stdin_prefix(self):
        """Password line for "sudo -S", sent ahead of every stdin stream; empty otherwise."""
        return (self.password + "\n").encode() if self.root and " -S " in self.root else b""

    def run_user(self, script, timeout=60):
        return run(self.command("sh"), input=script.encode(), timeout=timeout, env=self.env)

    def run_root(self, script, timeout=60):
        return run(self.command(self.root + "sh"), input=self.stdin_prefix() + script.encode(),
                   timeout=timeout, env=self.env)

    def reader(self, path, size):
        """Process that streams the first size bytes of path to its stdout."""
        p = subprocess.Popen(self.command(f"{self.root}head -c {int(size)} {path}"), stdin=subprocess.PIPE,
                             stdout=subprocess.PIPE, stderr=subprocess.PIPE, env=self.env)
        p.stdin.write(self.stdin_prefix())
        p.stdin.close()
        return p

    def writer(self, path):
        """Process that writes its stdin to path on the phone, then syncs."""
        p = subprocess.Popen(self.command(f"{self.root}sh -c 'cat > {path} && sync'"), stdin=subprocess.PIPE,
                             stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, env=self.env)
        p.stdin.write(self.stdin_prefix())
        return p

    def reboot(self, target=""):
        """Reboot; target "bootloader" boots into fastboot. The rescue system has neither systemd nor
        a reboot that takes a target, but its own plinius-reboot."""
        if target:
            cmd = f"systemctl reboot --reboot-argument={target} 2>/dev/null || reboot {target}"
        else:
            cmd = "systemctl reboot 2>/dev/null || { sync; reboot -f; }"
        cmd = f"if command -v plinius-reboot >/dev/null; then plinius-reboot {target}; else {cmd}; fi"
        run(self.command(f"{self.root}sh -c {shlex.quote(cmd)}"), input=self.stdin_prefix(), env=self.env,
            timeout=20)


class AdbAccess(ShellAccess):
    """Android via adb. Reading partitions only works with root (adb root or su). Untested."""

    mode = "adb"

    def __init__(self, serial):
        self.serial = serial

    def adb(self, *args):
        return ["adb", "-s", self.serial, *args]

    def wrap(self, cmd):
        """cmd as root: as is after "adb root", otherwise through su."""
        return cmd if self.root == "" else f"su -c {shlex.quote(cmd)}"

    def detect_root(self):
        rc, out, _err = run(self.adb("shell", "id -u; su -c 'id -u' 2>/dev/null"))
        words = out.split()
        if rc == 0 and words[:1] == ["0"]:
            self.root = ""
        elif rc == 0 and "0" in words[1:]:
            self.root = "su"

    def run_user(self, script, timeout=60):
        return run(self.adb("shell", "sh"), input=script.encode(), timeout=timeout)

    def run_root(self, script, timeout=60):
        return run(self.adb("shell", self.wrap("sh")), input=script.encode(), timeout=timeout)

    def reader(self, path, size):
        # exec-out mixes stderr into the data stream
        return subprocess.Popen(self.adb("exec-out", self.wrap(f"head -c {int(size)} {path} 2>/dev/null")),
                                stdin=subprocess.DEVNULL,
                                stdout=subprocess.PIPE, stderr=subprocess.PIPE)

    def writer(self, path):
        return subprocess.Popen(self.adb("exec-in", self.wrap(f"sh -c 'cat > {path} && sync'")),
                                stdin=subprocess.PIPE, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)

    def reboot(self, target=""):
        run(self.adb("reboot", *([target] if target else [])))


class FastbootAccess:
    """Bootloader or fastbootd: restore only (fastboot cannot read partitions)."""

    mode = "fastboot"
    can_read = False

    def __init__(self, serial):
        self.serial = serial
        self.vars, self.sizes, self.logical = {}, {}, set()
        # Only asked while locked: True/False from "flashing get_unlock_ability", None if unknown
        self.unlock_ability = None

    def fb(self, *args):
        return ["fastboot", "-s", self.serial, *args]

    def load(self):
        """Read the bootloader variables, partition sizes and logical partitions via getvar."""
        # Also used to re-check before writing: carry nothing over from last time
        self.vars, self.sizes, self.logical = {}, {}, set()
        _rc, out, err = run(self.fb("getvar", "all"), timeout=30)
        for line in (out + err).splitlines():
            line = line.strip()
            if not line.startswith("(bootloader)"):
                continue
            line = line[len("(bootloader)"):].strip()
            for prefix, target in (("partition-size:", self.sizes), ("is-logical:", None)):
                if line.startswith(prefix):
                    name, _sep, value = line[len(prefix):].rpartition(":")
                    name, value = name.strip(), value.strip()
                    if target is None:
                        if value == "yes":
                            self.logical.add(name)
                    else:
                        try:
                            target[name] = int(value, 16)
                        except ValueError:
                            pass
                    break
            else:
                key, _sep, value = line.partition(":")
                self.vars.setdefault(key.strip(), value.strip())
        if not self.vars:
            # Some bootloaders do not support "getvar all"
            for key in ("product", "serialno", "unlocked", "current-slot", "is-userspace"):
                _rc, out, err = run(self.fb("getvar", key), timeout=10)
                m = re.search(rf"^{key}:\s*(.*)$", out + err, re.M)
                if m:
                    self.vars[key] = m.group(1).strip()

    # Only on an explicit "yes": without an answer the state is unknown
    can_write = property(lambda self: self.vars.get("unlocked") == "yes")

    def info(self):
        userspace = self.vars.get("is-userspace") == "yes"
        return {
            "codename": self.vars.get("product", ""),
            "serial": self.vars.get("serialno") or self.serial,
            "slot": self.vars.get("current-slot", ""),
            "os": "fastbootd" if userspace else _("Bootloader"),
        }

    def partitions(self):
        # Physical partitions only; logical ones (inside super) are skipped, as are names that are
        # not valid partition names (they are passed to fastboot as an argument)
        return [Partition(name, name, size) for name, size in sorted(self.sizes.items())
                if name not in self.logical and valid_name(name) and not is_boot_area(name)]

    def get_unlock_ability(self):
        """Whether "flashing unlock" is allowed, i.e. OEM unlocking is turned on in the phone's system."""
        _rc, out, err = run(self.fb("flashing", "get_unlock_ability"), timeout=10)
        # lk (MediaTek): "unlock_ability is true", AOSP: "get_unlock_ability: 1"
        m = re.search(r"unlock_ability(?::|\s+is)?\s*(\w+)", out + err)
        return {"true": True, "1": True, "false": False, "0": False}.get(m.group(1).lower()) if m else None

    def unlocked(self):
        """Ask the bootloader again; the cached vars stay as they are."""
        _rc, out, err = run(self.fb("getvar", "unlocked"), timeout=10)
        return bool(re.search(r"^unlocked:\s*yes\s*$", out + err, re.M))

    def flash(self, name, path):
        return subprocess.Popen(self.fb("flash", name, path), stdin=subprocess.DEVNULL,
                                stdout=subprocess.PIPE, stderr=subprocess.STDOUT)

    def reboot(self, target=""):
        run(self.fb("reboot", *([target] if target else [])))


class Device:
    """A phone found in one mode. Without access it is listed only, with problem saying why."""

    def __init__(self, key, mode, access=None, info=None, problem="", login=None, keys_only=False):
        self.key, self.mode, self.access = key, mode, access
        self.info = info or {}
        self.profile = find_profile(self.info)
        self.problem = problem
        # (host, port, usbnet, USB link) of the SSH target when a login is missing
        self.login = login
        # The system lets in SSH keys only (our Arch image): no password helps, the way in is the rescue
        # system from the bootloader
        self.keys_only = keys_only
        self.parts = None
        # What is installed where (see read_layout), read once per connection
        self.layout = None
        self.lock = threading.Lock()

    can_read = property(lambda self: bool(self.access) and self.access.can_read)
    can_write = property(lambda self: bool(self.access) and self.access.can_write)
    serial = property(lambda self: self.info.get("serial", ""))
    rescue = property(lambda self: self.info.get("os_id") == RESCUE_ID)

    def mode_text(self):
        return MODES["rescue"] if self.rescue else MODES[self.mode]

    def title(self):
        if self.profile:
            return self.profile.name
        name = " ".join(x for x in (self.info.get("manufacturer"), self.info.get("model")) if x)
        return name or _("Unknown phone")

    def load_parts(self, reload=False):
        """Partition list, cached; safe to call from several threads."""
        with self.lock:
            if self.parts is None or reload:
                self.parts = self.access.partitions()
            return self.parts


def adb_devices():
    """[(serial, state)] from "adb devices"."""
    rc, out, _err = run(["adb", "devices"], timeout=15)
    if rc != 0:
        return []
    return [tuple(line.split()[:2]) for line in out.splitlines()[1:] if len(line.split()) >= 2]


def fastboot_devices():
    rc, out, _err = run(["fastboot", "devices"], timeout=15)
    return [line.split()[0] for line in out.splitlines() if line.strip()] if rc == 0 else []


def mtk_usb():
    """USB paths of MediaTek devices in BROM or preloader mode."""
    found = set()
    for vendor in glob.glob("/sys/bus/usb/devices/*/idVendor"):
        d = os.path.dirname(vendor)
        try:
            with open(vendor) as f, open(os.path.join(d, "idProduct")) as g:
                if f.read().strip() == "0e8d" and g.read().strip() in ("0003", "2000"):
                    found.add(os.path.basename(d))
        except OSError:
            pass
    return found


def usbnet_link():
    """The USB network interface through which the PC reaches the phones' address, as "name:index",
    or None. Only a direct route over a USB network adapter counts: a normal network that happens to
    use 10.15.19.* never gets a login attempt or a password. The index changes whenever the interface
    is created again (cable pulled, another phone)."""
    rc, out, _err = run(["ip", "-o", "-4", "route", "get", USBNET_HOST], timeout=5)
    m = re.search(r"\bdev ([A-Za-z0-9_.-]+)", out)
    if rc != 0 or not m or " via " in out or "src" + USBNET_NET not in out:
        return None
    sysfs = os.path.join("/sys/class/net", m.group(1))
    # The adapter's device is a USB interface (wired and Wi-Fi adapters are PCI, SDIO, ...)
    if os.path.realpath(os.path.join(sysfs, "device", "subsystem")) != "/sys/bus/usb":
        return None
    try:
        with open(os.path.join(sysfs, "ifindex")) as f:
            return f"{m.group(1)}:{f.read().strip()}"
    except OSError:
        return None


def dev_ssh_target():
    """PLINIUS_BOOT_SSH=user@host[:port], development only (Wi-Fi)."""
    value = os.environ.get("PLINIUS_BOOT_SSH", "")
    m = re.match(r"^([^@]+)@([^:]+)(?::(\d+))?$", value)
    return (m.group(2), int(m.group(3) or 22), [m.group(1)], False) if m else None


def probe_ssh(access, key):
    """Device for a working SSH login; without root it keeps a login button for the password."""
    access.detect_root()
    info = access.info()
    if info.get("os_id") == RESCUE_ID and access.root == "":
        install_rescue_tools(access)
    problem = "" if access.root is not None else _(
        "No administrator access. Log in with your password so the app can use sudo.")
    return Device(key, "ssh", access, info, problem,
                  login=(access.host, access.port, access.usbnet, access.link) if access.root is None else None)


def probe_adb(serial, state):
    """Device for an "adb devices" entry; usable only with root."""
    key = "adb:" + serial
    if state == "unauthorized":
        return Device(key, "adb", info={"serial": serial},
                      problem=_("Unlock the phone and allow USB debugging in the prompt shown there."))
    if state not in ("device", "recovery"):
        return Device(key, "adb", info={"serial": serial}, problem=_("The phone is not ready yet."))
    access = AdbAccess(serial)
    access.detect_root()
    problem = "" if access.root is not None else _(
        "Android does not allow reading the partitions without root. Restart the phone into the bootloader "
        "and start the rescue system there, or start a Linux system on the phone.")
    return Device(key, "adb", access, access.info() or {"serial": serial}, problem)


def probe_fastboot(serial):
    """Device in fastboot; writable only if the bootloader reports itself as unlocked."""
    access = FastbootAccess(serial)
    access.load()
    problem = _("In fastboot mode backups can only be restored, not created.")
    if access.vars.get("unlocked") == "no":
        access.unlock_ability = access.get_unlock_ability()
        problem = _("The bootloader is locked. Unlock it to start the rescue system or restore backups.")
    elif not access.can_write:
        problem = _("The bootloader does not report whether it is unlocked. Restoring is not possible.")
    return Device("fastboot:" + serial, "fastboot", access, access.info(), problem)


class Scanner(threading.Thread):
    """Looks for phones every few seconds and reports changes to on_change (in the GTK thread)."""

    INTERVAL = 3

    def __init__(self, config, on_change):
        super().__init__(daemon=True)
        self.config, self.on_change = config, on_change
        self.devices = {}
        self.passwords = {}        # (host, user) -> password, only kept in memory
        self.busy = set()          # devices with a running operation: do not probe again
        self.stale = set()         # fastboot devices whose state changed: probe them again
        self.wake = threading.Event()
        self.mtk_seen = set()
        self.ssh_checked = {}      # host -> time of the last check
        self.reprobe = False       # log in to SSH devices again (after a password was entered)
        self.usb_link = None       # USB network interface of the last round (see usbnet_link)
        self.usb_blocked = False   # a phone is on USB that this user may not open (see usb_blocked)

    def rescan(self):
        """Scan again right away, including new SSH logins."""
        self.ssh_checked.clear()
        self.reprobe = True
        self.wake.set()

    def refresh(self, key):
        """Probe this device again in the next round instead of keeping it as it is."""
        self.stale.add(key)
        self.rescan()

    def run(self):
        while True:
            try:
                self.scan()
            except Exception:
                traceback.print_exc()
            self.wake.wait(self.INTERVAL)
            self.wake.clear()

    def ssh_targets(self, link):
        """[(host, port, users, usbnet)]: the USB network if it is up (link, see usbnet_link), plus the
        development host. Invalid user names (from the config or the environment) are skipped."""
        targets = []
        if link:
            users = [self.config.get("usbnet_user")] + list(USBNET_USERS)
            targets.append((USBNET_HOST, 22, list(dict.fromkeys(u for u in users if valid_user(u))), True))
        dev = dev_ssh_target()
        if dev and all(valid_user(u) for u in dev[2]):
            targets.append(dev)
        return targets

    def scan_ssh(self, old, new):
        """Add SSH devices to new; rate-limited, since every probe is a full ssh login."""
        now = time.monotonic()
        reprobe, self.reprobe = self.reprobe, False
        link = usbnet_link()
        relink = link != self.usb_link
        if relink:
            # USB network gone or created again (cable pulled, another phone): forget its passwords, so
            # a phone plugged in later never receives the previous phone's password
            self.usb_link = link
            for k in list(self.passwords):
                if k[0] == USBNET_HOST:
                    self.passwords.pop(k, None)
        for host, port, users, usbnet in self.ssh_targets(link):
            prefix = f"ssh:{host}:{port}"
            known = [d for k, d in old.items() if k.startswith(prefix)]
            if any(d.key in new for d in known):
                continue
            if reprobe or (usbnet and relink):
                known = []
            # Ping a known device only every 15 s, retry a failed login at most every 30 s
            last = self.ssh_checked.get(host, 0)
            if known and known[0].access and now - last < 15:
                new[known[0].key] = known[0]
                continue
            if known and not known[0].access and now - last < 30:
                new[known[0].key] = known[0]
                continue
            self.ssh_checked[host] = now
            if known and known[0].access and known[0].access.check() == "ok":
                new[known[0].key] = known[0]
                continue
            states, refused = [], []
            for user in users:
                access = SshAccess(host, user, port, self.passwords.get((host, user)), usbnet, link)
                state = access.check()
                states.append(state)
                if state == "auth":
                    refused.append(access)
                if state == "ok":
                    d = probe_ssh(access, f"{prefix}:{user}")
                    new[d.key] = d
                    break
            else:
                if refused and not any(takes_password(a.methods) for a in refused):
                    new[prefix] = Device(prefix, "ssh", problem=_(
                        "Its system lets in SSH keys only, no password. Start the bootloader on the phone; "
                        "the app then starts the rescue system there."), keys_only=True)
                elif refused:
                    new[prefix] = Device(prefix, "ssh", problem=_("Log in to read the partitions."),
                                         login=(host, port, usbnet, link))

    def scan(self):
        """One round over adb, fastboot, MediaTek USB and ssh; busy devices are kept unchanged."""
        old = self.devices
        new = {k: d for k, d in old.items() if k in self.busy}
        for serial, state in adb_devices():
            key = "adb:" + serial
            if key not in new:
                d = old.get(key)
                new[key] = d if d and getattr(d, "adb_state", None) == state else probe_adb(serial, state)
                new[key].adb_state = state
        for serial in fastboot_devices():
            key = "fastboot:" + serial
            if key not in new:
                cached = None if key in self.stale else old.get(key)
                self.stale.discard(key)
                new[key] = cached or probe_fastboot(serial)
        # The preloader shows up briefly on every boot; only show it from the second round on
        seen = mtk_usb()
        for path in seen & self.mtk_seen:
            key = "brom:" + path
            new[key] = old.get(key) or Device(key, "brom", problem=_(
                "The phone is in MediaTek download mode. This app cannot use this mode. Disconnect the cable "
                "and hold the power button to restart the phone."))
        self.mtk_seen = seen
        self.scan_ssh(old, new)
        blocked = usb_blocked()
        if blocked != self.usb_blocked:
            self.usb_blocked = blocked
            GLib.idle_add(self.on_change)
        for d in new.values():
            if d is not old.get(d.key):
                self.remember(d)
        if new.keys() != old.keys() or any(new[k] is not old[k] for k in new):
            self.devices = new
            GLib.idle_add(self.on_change)

    def remember(self, device):
        """Remember the profile per serial number: in fastboot and in the rescue system model and codename are missing.
        Likewise the accent colour of the phone's desktop, for the logo of the rescue system (written in fastboot)."""
        known = self.config.setdefault("known", {})
        if device.profile and device.serial:
            # What Volla OS said about this phone stays true under a system that knows less (see PROFILES)
            if known.get(device.serial) == "volla-plinius-plus" and device.profile.id == "volla-plinius":
                device.profile = next(p for p in PROFILES if p.id == known[device.serial])
            if known.get(device.serial) != device.profile.id:
                known[device.serial] = device.profile.id
                save_config(self.config)
        elif device.serial in known:
            device.profile = next((p for p in PROFILES if p.id == known[device.serial]), None)
        accents = self.config.setdefault("accent", {})
        accent = device.info.get("accent")
        if device.serial and accent in ACCENT_COLORS and accents.get(device.serial) != accent:
            accents[device.serial] = accent
            save_config(self.config)

    def visible(self):
        """Without duplicates: if the same phone (serial number) is connected readable, its other entries are
        dropped (except fastboot)."""
        devices = list(self.devices.values())
        readable = {d.serial for d in devices if d.can_read and d.serial}
        shown = [d for d in devices if d.can_read or d.mode == "fastboot" or not d.serial
                 or d.serial not in readable]
        return sorted(shown, key=lambda d: (d.title(), d.key))


# --- Rescue system ---------------------------------------------------------------------------

def rescue_ramdisk():
    """Path of the rescue ramdisk: the installed one first, then the build tree; None if missing."""
    return next((os.path.realpath(p) for p in RESCUE_RAMDISKS if os.path.exists(p)), None)


def rescue_tools():
    """Path of the tools archive for the rescue system, like rescue_ramdisk(); None if missing."""
    return next((os.path.realpath(p) for p in RESCUE_TOOLS if os.path.exists(p)), None)


def install_rescue_tools(access):
    """Unpacks cryptsetup and dmsetup (rescue/mkrescue.sh) into the running rescue system, so that an
    encrypted data partition can be opened and checked there. They do not fit into its ramdisk: the
    bootloader loads at most 22,020,096 bytes, vendor ramdisk included. The rescue system runs from
    RAM, so they are gone after the next start and come again with the next login of the app. Only
    a missing or different archive is sent; a failure is not an error of the login. True if in place."""
    path = rescue_tools()
    if not path:
        return False
    with open(path, "rb") as f:
        data = f.read()
    digest = hashlib.sha256(data).hexdigest()
    stamp = RESCUE_TOOLS_DIR + "/SHA256"
    rc, out, _err = access.run_root(f"cat {stamp} 2>/dev/null")
    if rc == 0 and out.strip() == digest:
        return True
    # The stamp only after a complete unpack, so a broken transfer is sent again
    rc, _out, err = run(access.command(f"tar -xzf - -C / && echo {digest} > {stamp}"), input=data,
                        timeout=120, env=access.env)
    if rc != 0:
        print(f"Rescue tools not installed: {err.strip()}", file=sys.stderr)
    return rc == 0


def rescue_key():
    """Public part of the app's own SSH key for the rescue system; creates the key if needed."""
    if not os.path.exists(RESCUE_KEY):
        os.makedirs(os.path.dirname(RESCUE_KEY), exist_ok=True)
        subprocess.run(["ssh-keygen", "-q", "-t", "ed25519", "-N", "", "-C", "plinius-boot rescue",
                        "-f", RESCUE_KEY], check=True)
    with open(RESCUE_KEY + ".pub", "rb") as f:
        return f.read()


def cpio_newc(entries):
    """cpio archive (newc) from [(path, mode, data[, (major, minor)])], as the kernel unpacks it as initramfs."""
    out = bytearray()
    for ino, (name, mode, data, *rdev) in enumerate(entries + [("TRAILER!!!", 0, b"")], 1):
        name = name.encode() + b"\0"
        major, minor = rdev[0] if rdev else (0, 0)
        fields = (ino, mode, 0, 0, 1, 0, len(data), 0, 0, major, minor, len(name), 0)
        out += b"070701" + b"".join(b"%08X" % v for v in fields) + name
        out += b"\0" * (-len(out) % 4) + data
        out += b"\0" * (-len(out) % 4)
    return bytes(out)


LZ4_LEGACY_MAGIC = struct.pack("<I", 0x184C2102)


def lz4_legacy(data):
    """data as an LZ4 legacy stream (the format of Android ramdisks), stored without compression:
    every block is a single run of literals, which any LZ4 decoder accepts."""
    out = bytearray(LZ4_LEGACY_MAGIC)
    # The kernel's decoder expects blocks of at most 8 MiB uncompressed
    for i in range(0, len(data), 8 << 20):
        chunk = data[i:i + (8 << 20)]
        n = len(chunk)
        block = bytearray([min(n, 15) << 4])
        if n >= 15:
            block += b"\xff" * ((n - 15) // 255) + bytes([(n - 15) % 255])
        block += chunk
        out += struct.pack("<I", len(block)) + block
    return bytes(out)


def rescue_ramdisk_data(serial="", accent=""):
    """Ramdisk of the rescue system, followed by a second archive with the app's SSH key, the
    serial number from fastboot (the rescue system has no getprop, and with header v4 the serial
    number is not in the cmdline) and the accent colour of the phone's desktop for its logo.
    Both are LZ4 legacy streams: the kernel cannot find the end of one, so whatever follows the
    vendor ramdisk (LZ4 legacy on the Plinius) must start with the LZ4 magic number again."""
    path = rescue_ramdisk()
    if not path:
        raise Failed(_("The rescue system is not built yet (rescue/mkrescue.sh)."))
    with open(path, "rb") as f:
        data = f.read()
    if not data.startswith(LZ4_LEGACY_MAGIC):
        raise Failed(_("The rescue system is not built yet (rescue/mkrescue.sh)."))
    # The kernel needs /dev/console before the first mount; mkrescue.sh cannot create device nodes without root
    entries = [("dev", 0o40755, b""), ("dev/console", 0o20600, b"", (5, 1)),
               ("root", 0o40700, b""), ("root/.ssh", 0o40700, b""),
               ("root/.ssh/authorized_keys", 0o100600, rescue_key())]
    if re.fullmatch(r"[A-Za-z0-9._-]{1,64}", serial):
        entries += [("etc", 0o40755, b""), ("etc/plinius-rescue-serial", 0o100644, serial.encode() + b"\n")]
    if accent in ACCENT_COLORS:
        if not any(e[0] == "etc" for e in entries):
            entries.append(("etc", 0o40755, b""))
        entries.append(("etc/plinius-rescue-accent", 0o100644, ACCENT_COLORS[accent].encode() + b"\n"))
    return data + lz4_legacy(cpio_newc(entries))


def rescue_boot_image(image, ramdisk):
    """Boot image with the rescue system's ramdisk instead of its own; kernel, dtb and cmdline stay.
    With header v3/v4 the bootloader still loads the vendor ramdisk (modules) in front of it."""
    if image[:8] != b"ANDROID!":
        raise Failed(_("This is not an Android boot image."))

    def u32(offset):
        return struct.unpack_from("<I", image, offset)[0]

    version = u32(40)
    if version >= 3:
        page, kernel_size = 4096, u32(8)
        sections = [image[page:page + kernel_size], ramdisk]
        header = bytearray(image[:page])
        struct.pack_into("<I", header, 12, len(ramdisk))
        if version >= 4:
            struct.pack_into("<I", header, 1580, 0)   # drop the boot signature
    else:
        # v0-v2: kernel, ramdisk, second, recovery_dtbo (v1), dtb (v2), each padded to the page size
        page = u32(36)
        sizes = [u32(8), u32(16), u32(24)] + ([u32(1632)] if version >= 1 else []) + ([u32(1648)] if version >= 2 else [])
        sections, offset = [], page
        for size in sizes:
            sections.append(image[offset:offset + size])
            offset += size + (-size % page)
        kernel_size = sizes[0]
        sections[1] = ramdisk
        header = bytearray(image[:page])
        struct.pack_into("<I", header, 16, len(ramdisk))
        # id as in mkbootimg: SHA-1 over all sections including their sizes
        sha = hashlib.sha1()
        for data in sections:
            sha.update(data)
            sha.update(struct.pack("<I", len(data)))
        header[576:608] = sha.digest().ljust(32, b"\0")
    if not kernel_size:
        raise Failed(_("This boot image contains no kernel."))
    return bytes(header) + b"".join(data + b"\0" * (-len(data) % page) for data in sections)


def read_image(path, limit=256 << 20):
    """Content of an image file (zstd unpacked), at most limit bytes."""
    _head, compressed = read_head(path)
    with (zstd.open if compressed else open)(path, "rb") as f:
        return f.read(limit)


def read_backup_image(path, size, sha256):
    """Content of an image file from a backup, if it holds exactly size bytes with this checksum.
    Read once into memory, so what was checked is what gets used."""
    try:
        with open_regular(path) as raw, zstd.open(raw, "rb") as f:
            data = f.read(size + 1)
    except (OSError, EOFError, zstd.ZstdError) as err:
        raise Failed(_("The boot image in the backup cannot be read ({error}).").format(error=err))
    if len(data) != size or hashlib.sha256(data).hexdigest() != sha256:
        raise Failed(_("The boot image in the backup is damaged (checksum does not match)."))
    return data


def kernel_sources(device, base):
    """Boot images with a kernel from backups of this phone, best first (active slot, then newest):
    [(text, (path, size, sha256))]. Only backups created on this PC count (signed manifest, see
    signed_here); a backup folder on a stick or share must not choose what the phone boots. The
    checksum is compared when the image is used (read_backup_image)."""
    slot = device.info.get("slot")
    found = []
    for b in list_backups(base):
        if not device.serial or b.device.get("serial") != device.serial or not signed_here(b.data):
            continue
        for e in b.entries:
            if (e.get("kind") == "boot" and re.fullmatch(r"boot(_[ab])?", e["name"]) and e["size"] <= 256 << 20
                    and os.path.isfile(b.file(e)) and not os.path.islink(b.file(e))):
                text = _("{name} from the backup of {date}").format(name=e["name"], date=b.created_text())
                found.append((e["name"] != f"boot_{slot}", -b.created().timestamp(), text,
                              (b.file(e), e["size"], e["sha256"])))
    return [(text, kernel) for _slot, _age, text, kernel in sorted(found)]


def start_rescue(device, config, kernel):
    """Boot the rescue system once with "fastboot boot"; nothing is written to the phone.
    kernel: (path, size, sha256) from kernel_sources, or (path, None, None) for a file the user chose."""
    path, size, sha256 = kernel
    data = read_image(path) if sha256 is None else read_backup_image(path, size, sha256)
    image = rescue_boot_image(data, rescue_ramdisk_data(device.serial, config.get("accent", {}).get(device.serial, "")))
    out = os.path.join(cache_dir(), "rescue-boot.img")
    with open(out, "wb") as f:
        f.write(image)
    rc, stdout, stderr = run(device.access.fb("boot", out), timeout=180)
    if rc != 0:
        raise Failed(_("fastboot could not start the rescue system: {error}").format(
            error=(stdout + stderr).strip() or rc))


def unlock_bootloader(device, step):
    """Unlock the bootloader and format userdata; erases all user data. The phone asks for confirmation
    itself. step(text) reports progress (from this thread)."""
    access = device.access
    step(_("Confirm on the phone: press Volume up to unlock."))
    # Returns once the question on the phone is answered
    rc, out, err = run(access.fb("flashing", "unlock"), timeout=300)
    if rc != 0:
        raise Failed(_("The bootloader was not unlocked: {error}").format(error=(out + err).strip() or rc))
    # lk reports the new state only a few seconds later, after restarting by itself if need be
    step(_("Waiting for the bootloader…"))
    deadline = time.monotonic() + 120
    while not access.unlocked():
        if time.monotonic() > deadline:
            raise Failed(_("The phone does not report itself as unlocked. If the question on the phone was "
                           "declined, start again. Otherwise restart the phone into the bootloader and check "
                           "it here again."))
        time.sleep(3)
    # The bootloader only erases userdata without formatting it; Volla OS would then keep restarting
    step(_("Formatting the data partition…"))
    rc, out, err = run(access.fb("-w"), timeout=600)
    if rc != 0:
        raise Failed(_("The bootloader is unlocked, but the data partition could not be formatted: {error}\n"
                       "Run “fastboot -w” in the bootloader, otherwise Volla OS keeps restarting.").format(
                           error=(out + err).strip() or rc))


# --- Rescue system in init_boot ------------------------------------------------------------
# lk of the Plinius Plus has no "fastboot boot", and it takes the ramdisk from init_boot (the kernel
# from boot, the modules from vendor_boot). So the rescue system is written to init_boot of the
# active slot for as long as it is needed, and the original goes back afterwards. The original comes
# from the update server (only that partition is downloaded from the package) or from a file, and it
# is written only if it matches the checksum that the phone's own vbmeta holds for it. Until then the
# config remembers the partition ("rescue_in"), because the phone does not start its system without it.

def protobuf_fields(data):
    """(field number, value) of a protobuf message: int for varints, bytes for everything else."""
    p = 0
    while p < len(data):
        key, p = _varint(data, p)
        kind = key & 7
        if kind == 0:
            value, p = _varint(data, p)
        elif kind == 2:
            n, p = _varint(data, p)
            value, p = data[p:p + n], p + n
        elif kind in (1, 5):
            n = 8 if kind == 1 else 4
            value, p = data[p:p + n], p + n
        else:
            raise ValueError(f"protobuf wire type {kind}")
        yield key >> 3, value


def _varint(data, p):
    value = shift = 0
    while True:
        if p >= len(data) or shift > 63:
            raise ValueError("truncated varint")
        c = data[p]
        p += 1
        value |= (c & 0x7f) << shift
        shift += 7
        if c < 0x80:
            return value, p


def payload_partition(read, size, name, limit=64 << 20):
    """Partition name from a full A/B update package: a zip with payload.bin stored uncompressed.
    read(offset, n) returns bytes of the package, size is its length. Only the payload's manifest
    and the data of that partition are read; both are checked against the manifest's checksums."""
    # End of central directory (zip64 if present), then payload.bin in the central directory
    tail_start = max(0, size - 65536)
    tail = read(tail_start, size - tail_start)
    i = tail.rfind(b"PK\x06\x06")
    if i >= 0:
        cd_size, cd_offset = struct.unpack_from("<QQ", tail, i + 40)
    else:
        i = tail.rfind(b"PK\x05\x06")
        if i < 0:
            raise Failed(_("This is not an update package (zip)."))
        cd_size, cd_offset = struct.unpack_from("<II", tail, i + 12)
    if cd_size > 16 << 20 or cd_offset + cd_size > size:
        raise Failed(_("This is not an update package (zip)."))
    cd, p, offset = read(cd_offset, cd_size), 0, None
    while cd[p:p + 4] == b"PK\x01\x02":
        method, = struct.unpack_from("<H", cd, p + 10)
        nlen, elen, clen = struct.unpack_from("<HHH", cd, p + 28)
        offset, = struct.unpack_from("<I", cd, p + 42)
        entry, extra = cd[p + 46:p + 46 + nlen], cd[p + 46 + nlen:p + 46 + nlen + elen]
        if entry == b"payload.bin":
            if method != 0:
                raise Failed(_("The update package has no usable payload.bin."))
            if offset == 0xFFFFFFFF:
                # zip64: the offset is the last field of the extra block 1
                q = 0
                while q + 4 <= len(extra):
                    hid, hlen = struct.unpack_from("<HH", extra, q)
                    if hid == 1 and hlen >= 8:
                        offset, = struct.unpack_from("<Q", extra, q + 4 + hlen - 8)
                    q += 4 + hlen
            break
        p += 46 + nlen + elen + clen
        offset = None
    if offset is None:
        raise Failed(_("The update package has no usable payload.bin."))
    local = read(offset, 30)
    base = offset + 30 + sum(struct.unpack_from("<HH", local, 26))

    # payload.bin: "CrAU", version 2, manifest size, signature size, manifest, signature, data
    head = read(base, 24)
    if head[:4] != b"CrAU" or struct.unpack_from(">Q", head, 4)[0] != 2:
        raise Failed(_("The update package has no usable payload.bin."))
    manifest_size, signature_size = struct.unpack_from(">QI", head, 12)
    if manifest_size > 16 << 20:
        raise Failed(_("The update package has no usable payload.bin."))
    manifest = read(base + 24, manifest_size)
    blobs = base + 24 + manifest_size + signature_size
    block = next((v for f, v in protobuf_fields(manifest) if f == 3 and isinstance(v, int)), 4096)
    for f, update in protobuf_fields(manifest):
        # DeltaArchiveManifest.partitions: name (1), new_partition_info (7: size, hash), operations (8)
        fields = list(protobuf_fields(update)) if f == 13 else []
        if (1, name.encode()) not in fields:
            continue
        info = dict(protobuf_fields(next(v for k, v in fields if k == 7)))
        part_size, part_hash = info.get(1, 0), info.get(2, b"")
        if not 0 < part_size <= limit:
            raise Failed(_("{name} in the update package is too large.").format(name=name))
        out = bytearray(part_size)
        for k, op in fields:
            if k != 8:
                continue
            # type (1), data offset (2) and length (3), target extents (6), data checksum (8)
            o = {}
            for ok, ov in protobuf_fields(op):
                o.setdefault(ok, []).append(ov)
            kind = o.get(1, [0])[0]
            if kind == 6:   # ZERO: the buffer is zero already
                continue
            length = o.get(3, [0])[0]
            if length > limit:
                raise Failed(_("{name} in the update package is too large.").format(name=name))
            data = read(blobs + o.get(2, [0])[0], length)
            if 8 in o and not hmac.compare_digest(hashlib.sha256(data).digest(), o[8][0]):
                raise Failed(_("The update package is damaged (checksum does not match)."))
            # REPLACE, REPLACE_BZ, REPLACE_XZ, ZSTD; anything else is a delta (incremental package)
            if kind == 1:
                data = bz2.decompress(data)
            elif kind == 8:
                data = lzma.decompress(data)
            elif kind == 14:
                data = zstd.decompress(data)
            elif kind != 0:
                raise Failed(_("This is an incremental update package; only full packages contain {name}.").format(
                    name=name))
            q = 0
            for extent in o.get(6, []):
                e = dict(protobuf_fields(extent))
                start, n = e.get(1, 0) * block, e.get(2, 0) * block
                if start + n > part_size:
                    raise Failed(_("The update package is damaged (checksum does not match)."))
                out[start:start + n] = data[q:q + n].ljust(n, b"\0")
                q += n
        if not hmac.compare_digest(hashlib.sha256(out).digest(), part_hash):
            raise Failed(_("The update package is damaged (checksum does not match)."))
        return bytes(out)
    raise Failed(_("The update package contains no {name}.").format(name=name))


def http_reader(url):
    """(read(offset, n), size) of a file on a web server with range requests."""
    def read(offset, n):
        if n <= 0:
            return b""
        request = urllib.request.Request(url, headers={"Range": f"bytes={offset}-{offset + n - 1}"})
        with urllib.request.urlopen(request, timeout=60) as r:
            if r.status != 206:
                raise OSError(f"{url}: no range support")
            data = r.read(n + 1)
        if len(data) != n:
            raise OSError(f"{url}: {len(data)} instead of {n} bytes")
        return data

    with urllib.request.urlopen(urllib.request.Request(url, method="HEAD"), timeout=30) as r:
        return read, int(r.headers["Content-Length"])


def file_reader(f):
    """(read(offset, n), size) of an open file."""
    def read(offset, n):
        f.seek(offset)
        return f.read(n)
    return read, os.fstat(f.fileno()).st_size


def ota_packages(index):
    """Full update packages that the server lists at index (LineageOS updater format), newest first:
    [(file name, url)]. Only https links on the same server count."""
    with urllib.request.urlopen(index, timeout=30) as r:
        data = json.loads(r.read(1 << 20))
    host = urllib.parse.urlsplit(index).netloc
    found = []
    for e in data.get("response", []) if isinstance(data, dict) else []:
        if not isinstance(e, dict) or not isinstance(e.get("url"), str):
            continue
        u = urllib.parse.urlsplit(e["url"])
        name = e.get("filename")
        if u.scheme == "https" and u.netloc == host and isinstance(name, str) and type(e.get("datetime")) is int:
            found.append((e["datetime"], clean_text(name), e["url"]))
    return [(name, url) for _time, name, url in sorted(found, reverse=True)]


def originals_dir(serial):
    path = os.path.join(ORIGINALS, safe_name(serial))
    os.makedirs(path, mode=0o700, exist_ok=True)
    return path


def keep_candidate(serial, name, source, data):
    """Store an image that may be the original of partition name (without slot), source says where it
    came from (package or file name). Whether it is the original is decided when it is used."""
    path = os.path.join(originals_dir(serial),
                        f"{name}--{safe_name(source)}--{hashlib.sha256(data).hexdigest()[:16]}.img")
    if not os.path.exists(path):
        # A leftover of an interrupted run would block create_private
        if os.path.lexists(path + ".tmp"):
            os.remove(path + ".tmp")
        with create_private(path + ".tmp") as f:
            f.write(data)
        os.replace(path + ".tmp", path)


def candidates(serial, name):
    """Stored images for partition name, newest first: [(source, path)]."""
    found = []
    for path in glob.glob(os.path.join(originals_dir(serial), glob.escape(name) + "--*--*.img")):
        source = os.path.basename(path)[len(name) + 2:].rsplit("--", 1)[0]
        found.append((os.path.getmtime(path), source, path))
    return [(source, path) for _time, source, path in sorted(found, reverse=True)]


def read_candidate(path, limit=64 << 20):
    try:
        with open_regular(path) as f:
            return f.read(limit)
    except OSError:
        return b""


def find_original(serial, name, expected, index="", step=lambda _text: None):
    """(data, source) of the image of partition name (without slot) that matches the hash descriptor
    expected (see avb_hashes): among the stored candidates first, then in the packages on the update
    server, newest first, each downloaded once and kept. None if there is none."""
    for source, path in candidates(serial, name):
        data = read_candidate(path)
        if matches_hash(data, expected):
            return data, source
    if not index:
        return None
    known = {source for source, _path in candidates(serial, name)}
    step(_("Asking the update server…"))
    for package, url in ota_packages(index):
        if safe_name(package) in known:
            continue
        step(_("Downloading {name} from {package}…").format(name=name, package=package))
        data = payload_partition(*http_reader(url), name)
        keep_candidate(serial, name, package, data)
        if matches_hash(data, expected):
            return data, package
    return None


def original_from_file(serial, name, expected, path):
    """(data, source) from a file chosen by the user: the image itself or a full update package. It
    is kept only if it matches expected."""
    with open_regular(path) as f:
        if f.read(4) == b"PK\x03\x04":
            data = payload_partition(*file_reader(f), name)
        else:
            f.seek(0)
            data = f.read(64 << 20)
    source = os.path.basename(path)
    if not matches_hash(data, expected):
        raise Failed(_("{file} is not the original {name} of this phone: its checksum does not match the "
                       "one the phone expects.").format(file=source, name=name))
    keep_candidate(serial, name, source, data)
    return data, source


def rescue_partition(device):
    """Partition of the active slot the rescue system goes into (e.g. init_boot_b), or "" if this phone
    starts it with "fastboot boot"."""
    name = device.profile.rescue_partition if device.profile else ""
    slot = device.info.get("slot", "")
    return f"{name}_{slot}" if name and slot else name


def pending_rescue(config, serial):
    """The config entry of a phone whose rescue partition still holds the rescue system, or None."""
    entry = config.get("rescue_in", {}).get(serial) if serial else None
    return entry if isinstance(entry, dict) and isinstance(entry.get("partition"), str) else None


def rescue_init_boot_image(template, ramdisk):
    """init_boot image (header v3/v4, no kernel) with the rescue system's ramdisk; the header comes from
    an init_boot image of the phone (template), so that it carries a matching security patch level."""
    if template[:8] != b"ANDROID!" or struct.unpack_from("<I", template, 40)[0] < 3 \
            or struct.unpack_from("<I", template, 8)[0] != 0:
        raise Failed(_("This is not an init_boot image."))
    header = bytearray(template[:4096])
    struct.pack_into("<I", header, 12, len(ramdisk))
    if struct.unpack_from("<I", template, 40)[0] >= 4:
        struct.pack_into("<I", header, 1580, 0)   # drop the boot signature
    return bytes(header) + ramdisk + b"\0" * (-len(ramdisk) % 4096)


def flash_rescue(device, config, step):
    """Write the rescue system to init_boot of the active slot and restart into it."""
    access, serial = device.access, device.serial
    name = device.profile.rescue_partition
    access.load()
    if access.vars.get("unlocked") != "yes":
        raise Failed(_("The bootloader is locked."))
    device.info["slot"] = access.vars.get("current-slot", "")
    partition = rescue_partition(device)
    if partition not in access.sizes:
        raise Failed(_("This phone has no partition {name}.").format(name=partition))
    # Any init_boot of this phone serves as the template, the one with the newest patch level (os_version,
    # low 11 bits); the newest from the update server otherwise
    images = [data for _source, path in candidates(serial, name) if (data := read_candidate(path))[:8] == b"ANDROID!"]
    template = max(images, key=lambda data: struct.unpack_from("<I", data, 16)[0] & 0x7ff, default=None)
    if template is None and device.profile.ota_index:
        step(_("Asking the update server…"))
        package, url = next(iter(ota_packages(device.profile.ota_index)), (None, None))
        if package:
            step(_("Downloading {name} from {package}…").format(name=name, package=package))
            template = payload_partition(*http_reader(url), name)
            keep_candidate(serial, name, package, template)
    if template is None:
        raise Failed(_("No {name} of this phone is known and the update server cannot be reached. Without "
                       "one the app could not write the original back later.").format(name=name))
    image = rescue_init_boot_image(template, rescue_ramdisk_data(serial, config.get("accent", {}).get(serial, "")))
    if len(image) > access.sizes[partition]:
        raise Failed(_("The rescue system does not fit into {name}.").format(name=partition))
    out = os.path.join(cache_dir(), "rescue-init_boot.img")
    with open(out, "wb") as f:
        f.write(image)
    # Remembered before writing: from now on the phone only starts the rescue system
    config.setdefault("rescue_in", {})[serial] = {"partition": partition}
    save_config(config)
    step(_("Writing the rescue system to {name}…").format(name=partition))
    proc = access.flash(partition, out)
    output = proc.communicate(timeout=180)[0].decode(errors="replace")
    if proc.returncode != 0:
        raise Failed(_("fastboot could not write {name}: {error}").format(name=partition, error=output.strip()))
    access.reboot()


def write_original(device, config, original, step):
    """Leave the rescue system: restart into the bootloader if needed, write the original back to the
    rescue partition and start the phone's own system. original: (data, source) from find_original."""
    serial = device.serial
    pending = pending_rescue(config, serial)
    if not pending:
        raise Failed(_("The app does not know which partition holds the rescue system."))
    partition, (data, _source) = pending["partition"], original
    if not matches_hash(data, pending.get("expected")):
        raise Failed(_("The original does not match the checksum the phone expects."))
    # The rescue system itself is never an original, wherever it came from
    if any(mark in data for mark in RESCUE_MARKS):
        raise Failed(_("The image to write back is this app's rescue system, not the original. Nothing was "
                       "written."))
    if device.mode == "fastboot":
        access = device.access
    else:
        step(_("Restarting into the bootloader…"))
        device.access.reboot("bootloader")
        deadline = time.monotonic() + 120
        while serial not in fastboot_devices():
            if time.monotonic() > deadline:
                raise Failed(_("The phone did not appear in the bootloader. Start it there by hand (Power and "
                               "Volume down) and write the original back from the phone's page."))
            time.sleep(2)
        access = FastbootAccess(serial)
    access.load()
    slot = access.vars.get("current-slot", "")
    if access.vars.get("unlocked") != "yes" or (slot and not partition.endswith("_" + slot)) \
            or access.sizes.get(partition, 0) < len(data):
        raise Failed(_("The phone in the bootloader is not in the expected state (slot {slot}, partition "
                       "{name}). Nothing was written.").format(slot=slot or "–", name=partition))
    out = os.path.join(cache_dir(), "original.img")
    if os.path.lexists(out):
        os.remove(out)
    with create_private(out) as f:
        f.write(data)
    step(_("Writing the original {name}…").format(name=partition))
    proc = access.flash(partition, out)
    output = proc.communicate(timeout=180)[0].decode(errors="replace")
    os.remove(out)
    if proc.returncode != 0:
        raise Failed(_("fastboot could not write {name}: {error}").format(name=partition, error=output.strip()))
    format_userdata_if_needed(access, config, serial, step)
    del config["rescue_in"][serial]
    save_config(config)
    step(_("Starting the phone…"))
    access.reboot()


# --- Backups -------------------------------------------------------------------------------

_key_lock = threading.Lock()


def manifest_key(create=False):
    """This PC's random key for signing manifests (32 bytes, 0600 in the config folder); None if there
    is none yet and create is False."""
    with _key_lock:
        try:
            with open_regular(MANIFEST_KEY) as f:
                key = f.read(64)
            return key if len(key) == 32 else None
        except FileNotFoundError:
            if not create:
                return None
        os.makedirs(os.path.dirname(MANIFEST_KEY), mode=0o700, exist_ok=True)
        key = os.urandom(32)
        with create_private(MANIFEST_KEY) as f:
            f.write(key)
            f.flush()
            os.fsync(f.fileno())
        return key


def manifest_mac(data, key):
    """HMAC-SHA256 of a manifest without its "hmac" field, over a canonical JSON form (sorted keys)."""
    content = json.dumps({k: v for k, v in data.items() if k != "hmac"}, sort_keys=True,
                         separators=(",", ":"), ensure_ascii=True)
    return hmac.new(key, content.encode(), hashlib.sha256).hexdigest()


def sign_manifest(data):
    """Add the "hmac" field to a manifest created here; without a usable key it stays unsigned."""
    try:
        key = manifest_key(create=True)
    except OSError:
        key = None
    data.pop("hmac", None)
    if key:
        data["hmac"] = manifest_mac(data, key)


def signed_here(data):
    """Whether the manifest was created on this PC and not changed since (valid "hmac" field)."""
    try:
        key = manifest_key()
    except OSError:
        return False
    mac = data.get("hmac")
    return bool(key) and isinstance(mac, str) and hmac.compare_digest(mac.encode(),
                                                                      manifest_mac(data, key).encode())


def valid_entries(entries):
    """The usable entries of a manifest's partition list: a valid and unique name (see NAME_RE), a size
    and a SHA-256 checksum, text fields as text. Anything else is dropped."""
    found, names = [], set()
    for e in entries if isinstance(entries, list) else []:
        if (isinstance(e, dict) and valid_name(e.get("name")) and e["name"] not in names
                and type(e.get("size")) is int and e["size"] >= 0
                and isinstance(e.get("sha256"), str) and re.fullmatch(r"[0-9a-f]{64}", e["sha256"])
                and all(isinstance(e.get(k, ""), str) for k in ("kind", "detail", "group", "busy"))):
            names.add(e["name"])
            found.append(e)
    return found


class Backup:
    """A backup folder and its manifest. The manifest is not trusted: whoever can write to the
    folder (stick, share) can change it, so only its well-formed entries are used and file names
    and checks are derived from the partition names."""

    def __init__(self, path, data):
        self.path, self.data = path, data
        device = data.get("device")
        self.device = {k: v for k, v in device.items() if isinstance(v, str)} if isinstance(device, dict) else {}
        self.entries = valid_entries(data.get("partitions"))
        self.complete = data.get("complete") is True
        self._systems, self._rescue = None, {}

    def holds_rescue(self, entry):
        """Whether the entry's image is a rescue system written by this app instead of the original
        (see flash_rescue): marked in the manifest, or, for backups made before that, recognized by
        the app's key in the ramdisk (RESCUE_MARKS). Only boot images are looked at."""
        if entry.get("rescue") is True:
            return True
        if entry.get("kind") not in ("boot", "init_boot") or entry["size"] > 128 << 20:
            return False
        if entry["name"] not in self._rescue:
            try:
                with self.open(entry) as raw, zstd.open(raw, "rb") as f:
                    data = f.read(entry["size"])
                    self._rescue[entry["name"]] = any(mark in data for mark in RESCUE_MARKS)
            except (OSError, EOFError, ValueError, zstd.ZstdError):
                self._rescue[entry["name"]] = False
        return self._rescue[entry["name"]]

    def systems(self):
        """The systems installed when the backup was made (manifest "systems", see run_backup). Older
        backups have none: then the Android builds from the vbmeta images in the folder."""
        if self._systems is None:
            if "systems" in self.data:
                self._systems = clean_systems(self.data["systems"])
            else:
                images = {}
                for e in self.entries:
                    if re.fullmatch(r"vbmeta(_system)?(_[a-z])?", e["name"]):
                        try:
                            with self.open(e) as raw, zstd.open(raw, "rb") as f:
                                images[e["name"]] = f.read(65536)
                        except (OSError, EOFError, ValueError, zstd.ZstdError):
                            pass
                self._systems = android_systems(images, self.device.get("slot", ""))
        return self._systems

    def systems_text(self):
        """Short form for the list: the active Android build and the Linux systems, else the system the
        backup was made from (not the rescue system, that says nothing about the phone)."""
        texts = [system_text(s) for s in self.systems() if s.get("active") or not s.get("slot")]
        if not texts and self.device.get("os_id") != RESCUE_ID and self.device.get("os"):
            texts = [self.device["os"]]
        return " · ".join(texts)

    def title(self):
        return self.device.get("name") or _("Unknown phone")

    def created(self):
        try:
            return datetime.datetime.fromisoformat(self.data["created"]).astimezone()
        except (KeyError, ValueError, TypeError, OverflowError):
            return datetime.datetime.fromtimestamp(os.path.getmtime(self.path)).astimezone()

    def created_text(self):
        return self.created().strftime("%x, %H:%M")

    def disk_size(self):
        total = 0
        for name in os.listdir(self.path):
            try:
                total += os.lstat(os.path.join(self.path, name)).st_size
            except OSError:
                pass
        return total

    def file(self, entry):
        """Image file of an entry: always <name>.img.zst in the backup folder. The manifest's "file"
        field is not used, it could point anywhere."""
        if not valid_name(entry["name"]):
            raise ValueError(f"invalid partition name: {entry['name']!r}")
        return os.path.join(self.path, entry["name"] + ".img.zst")

    def open(self, entry):
        """The entry's image file opened for reading; symlinks are refused (see open_regular)."""
        return open_regular(self.file(entry))


def subdirs(path):
    """Subfolders of path, without symlinks to folders; empty if path cannot be read."""
    try:
        with os.scandir(path) as it:
            return sorted(e.path for e in it if e.is_dir(follow_symlinks=False))
    except OSError:
        return []


def list_backups(base):
    """All backups in <base>/<phone>/<time> (as start_backup creates them), newest first. Only this
    depth counts: a manifest.json in base or in a phone folder must never make that folder a backup,
    which could then be deleted."""
    found = []
    for phone in subdirs(base):
        for path in subdirs(phone):
            try:
                with open_regular(os.path.join(path, MANIFEST)) as f:
                    data = json.loads(f.read(MANIFEST_MAX))
            except (OSError, ValueError, RecursionError):
                continue
            if isinstance(data, dict):
                found.append(Backup(path, data))
    return sorted(found, key=lambda b: b.created(), reverse=True)


def delete_backup(path):
    """Delete a backup folder: only the files the app writes there (manifest, images, unfinished
    files), then the folder if it is empty now. Anything else stays, so a folder that is not a
    backup is never wiped. Raises OSError if something could not be deleted."""
    for name in os.listdir(path):
        full = os.path.join(path, name)
        if ((name in (MANIFEST, MANIFEST + ".tmp") or name.endswith((".img.zst", ".part")))
                and not stat.S_ISDIR(os.lstat(full).st_mode)):
            os.unlink(full)
    os.rmdir(path)


def same_model(backup, device):
    """Does the backup match the device type? Unknown phones: same serial number."""
    profile = backup.device.get("profile")
    if profile and device.profile:
        return same_profile(profile, device.profile.id)
    return same_phone(backup, device)


def restore_problem(entry, backup, device, target):
    """Why this partition cannot be restored, or None. Decided from the partition name and the phone's
    current partition list, never from the manifest's "restorable" or "group" fields (see Backup)."""
    if is_boot_area(entry["name"]) or (target is not None and not target.restorable):
        return _("Backup only. Restoring this area is not supported.")
    if backup.holds_rescue(entry):
        return _("Holds the rescue system, not the original. Restoring it would keep the phone from starting.")
    if target is None:
        return _("Not present on this phone.")
    if target.size and target.size != entry["size"]:
        return _("The partition has a different size on this phone.")
    if target.busy != "-":
        return _("In use by the running system. Restore it in fastboot mode.")
    # Without a serial number on both sides, "the same device" cannot be proven
    if group_of(entry["name"]) == UNIQUE and not same_phone(backup, device):
        return _("Belongs to another phone. Restoring it would copy that phone's IMEI and MAC addresses.")
    return None


def same_phone(backup, device):
    """Same physical phone by serial number; never true without one."""
    return bool(device.serial) and backup.device.get("serial") == device.serial


def check_identity(device):
    """Check the serial number freshly read from the phone: a different phone may be on the cable by
    now (same address in the USB network)."""
    access = device.access
    if access.mode == "fastboot":
        access.load()
    serial = access.info().get("serial", "")
    if serial != device.serial:
        raise Failed(_("A different phone is connected now (serial number {serial}). Nothing was changed.")
                     .format(serial=serial or "–"))


def zstd_writer(path):
    """New zstd file opened for writing, readable only by the user (backups hold keys and passwords);
    multithreaded if the zstd library supports it."""
    workers = min(4, os.cpu_count() or 1) if zstd.CompressionParameter.nb_workers.bounds()[1] > 0 else 0
    options = {zstd.CompressionParameter.compression_level: 3}
    if workers > 1:
        options[zstd.CompressionParameter.nb_workers] = workers
    # Create it first: 0600, never through a symlink, never over an existing file
    create_private(path).close()
    return zstd.open(path, "wb", options=options)


def read_head(path):
    """(first 8 KiB, compressed) of an image file; zstd-compressed files are unpacked."""
    with open(path, "rb") as f:
        magic = f.read(4)
    if magic == b"\x28\xb5\x2f\xfd":
        with zstd.open(path, "rb") as f:
            return f.read(8192), True
    with open(path, "rb") as f:
        return f.read(8192), False


class Cancelled(Exception):
    """The user cancelled the operation."""


class Failed(Exception):
    """The operation failed; the message is shown to the user."""


class Job:
    """Runs in its own thread; reports progress to an OperationPage."""

    def __init__(self, page):
        self.page = page
        self.cancelled = False
        self.proc = None
        # Notes for the end of the operation, e.g. from take_vendor
        self.notes = []
        # The step last written to the details: each new one goes there with the time
        self.last_step = None
        page.job = self

    def plan(self, steps):
        """The steps still to come, [(text, bytes it moves or 0)], in the order report names them: the page
        lists them and moves its bar from one to the next."""
        GLib.idle_add(self.page.set_plan, list(steps))

    def report(self, done, total, text):
        if text and text != self.last_step:
            self.last_step = text
            self.log(f"{time.strftime('%H:%M:%S')}  {text}")
        GLib.idle_add(self.page.progress, done, total, text)

    def log(self, text):
        GLib.idle_add(self.page.add_line, text)

    def cancel(self):
        self.cancelled = True
        if self.proc and self.proc.poll() is None:
            self.proc.kill()

    def check(self):
        if self.cancelled:
            raise Cancelled()

    def copy(self, read, write, hasher, done, total, text, limit):
        """Copy read() to write() (if given) in chunks while hashing, at most limit bytes; returns the
        new done count. The caller checks that exactly limit bytes came and nothing more is left."""
        end = done + limit
        while done < end:
            self.check()
            chunk = read(min(CHUNK, end - done))
            if not chunk:
                break
            hasher.update(chunk)
            if write:
                write(chunk)
            done += len(chunk)
            self.report(done, total, text)
        return done

    def transfer(self, src, dst, limit):
        """Copy at most limit bytes from file src to file dst, without progress; returns the count."""
        n = 0
        while n < limit:
            self.check()
            chunk = src.read(min(CHUNK, limit - n))
            if not chunk:
                break
            dst.write(chunk)
            n += len(chunk)
        return n


def fsync_path(path):
    """fsync a file or directory by path."""
    fd = os.open(path, os.O_RDONLY)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def run_backup(job, device, parts, target, rescue_in="", original=None):
    """Reads the partitions into a new folder target. Folders and files are readable only by the user:
    a backup holds keys, passwords and personal data.
    rescue_in: the partition that holds the rescue system (see flash_rescue). Its backup gets the
    original instead if original (data, source from find_original) has the partition's size; else
    the entry is marked "rescue" and is never restored."""
    check_identity(device)
    os.makedirs(os.path.dirname(target), mode=0o700, exist_ok=True)
    os.makedirs(target, mode=0o700)
    # What is installed, from the whole phone, not only the selected partitions
    everything = device.load_parts()
    systems = android_systems({p.name: p.head for p in everything if p.head}, device.info.get("slot", ""))
    try:
        systems += device.access.linux_systems(everything)
    except (OSError, subprocess.SubprocessError, Failed):
        pass
    manifest = {
        "format": 1,
        "app": f"plinius-boot {VERSION}",
        "created": datetime.datetime.now().astimezone().isoformat(timespec="seconds"),
        "device": dict(device.info, name=device.title(), profile=device.profile.id if device.profile else "",
                       connection=device.mode),
        "systems": systems,
        "partitions": [],
        "complete": False,
    }

    def save():
        # On disk first, then visible: "complete" must never arrive before the data.
        # Signed, so that this PC later recognizes the backup as its own (kernel_sources).
        sign_manifest(manifest)
        with create_private(os.path.join(target, MANIFEST + ".tmp"), "w") as f:
            json.dump(manifest, f, indent=1)
            f.flush()
            os.fsync(f.fileno())
        os.replace(os.path.join(target, MANIFEST + ".tmp"), os.path.join(target, MANIFEST))
        fsync_path(target)

    save()
    total, done = sum(p.size for p in parts), 0
    for i, p in enumerate(parts, 1):
        text = _("Saving {name} ({i} of {n})").format(name=p.name, i=i, n=len(parts))
        out = os.path.join(target, p.name + ".img.zst")
        # Names come from the phone: never a path, never over a file that is already there (repeated name)
        if not valid_name(p.name) or os.path.lexists(out) or os.path.lexists(out + ".part"):
            raise Failed(_("Reading {name} failed: {error}").format(
                name=p.name, error=_("the partition name is invalid or appears twice")))
        hasher, start, extra = hashlib.sha256(), done, {}
        if p.name == rescue_in and original and len(original[0]) == p.size:
            # The rescue system occupies this partition: save the original (checked against vbmeta)
            with zstd_writer(out + ".part") as f:
                done = job.copy(io.BytesIO(original[0]).read, f.write, hasher, done, total, text, p.size)
            extra = {"replaced": original[1]}
        else:
            if p.name == rescue_in:
                extra = {"rescue": True}
            proc = job.proc = device.access.reader(p.path, p.size)
            with zstd_writer(out + ".part") as f:
                done = job.copy(proc.stdout.read, f.write, hasher, done, total, text, p.size)
            # "head -c" ends after size bytes; a phone that keeps sending is not waited for (full disk)
            more = proc.stdout.read(1)
            if more:
                proc.kill()
            rc, err = proc.wait(), proc.stderr.read().decode(errors="replace").strip()
            if more:
                raise Failed(_("Reading {name} failed: {error}").format(
                    name=p.name, error=_("the phone sent more data than the partition holds")))
            if rc != 0 or done - start != p.size:
                raise Failed(_("Reading {name} failed: {error}").format(
                    name=p.name, error=err or _("the data is incomplete")))
            # adb exec-out does not report the return code of the remote side: recompute on the phone
            if device.mode == "adb" and device.access.checksum(p.path, p.size) != hasher.hexdigest():
                raise Failed(_("Reading {name} failed: {error}").format(
                    name=p.name, error=_("the checksum on the phone does not match")))
        fsync_path(out + ".part")
        os.rename(out + ".part", out)
        manifest["partitions"].append({
            "name": p.name, "size": p.size, "sha256": hasher.hexdigest(), "file": os.path.basename(out),
            "kind": p.kind, "detail": p.detail, "group": p.group, "restorable": p.restorable,
            # Saved while mounted: the file system may be inconsistent
            "busy": p.busy, **extra,
        })
        save()
        job.log(_("{name}: {size}, saved as {file}").format(name=p.name, size=size_text(p.size),
                                                            file=size_text(os.path.getsize(out))))
    manifest["complete"] = True
    save()


def run_verify(job, backup):
    """List of damaged or missing partitions."""
    total, done, bad = sum(e["size"] for e in backup.entries), 0, []
    for i, e in enumerate(backup.entries, 1):
        text = _("Checking {name} ({i} of {n})").format(name=e["name"], i=i, n=len(backup.entries))
        hasher, start = hashlib.sha256(), done
        try:
            # Never more than the manifest's size: a manipulated file could unpack endlessly
            with backup.open(e) as raw, zstd.open(raw, "rb") as f:
                done = job.copy(f.read, None, hasher, done, total, text, e["size"])
                longer = bool(f.read(1))
        except (OSError, EOFError, zstd.ZstdError) as err:
            # EOFError: file truncated
            job.log(f"{e['name']}: {err}")
            bad.append(e["name"])
            done = start + e["size"]
            continue
        if longer or hasher.hexdigest() != e["sha256"] or done - start != e["size"]:
            bad.append(e["name"])
            job.log(_("{name}: checksum does not match").format(name=e["name"]))
            done = start + e["size"]
        else:
            job.log(_("{name}: OK").format(name=e["name"]))
    return bad


def run_restore(job, backup, entries, device):
    """Writes the backup entries to the device: per partition verify the backup, write it, then
    verify it on the phone (except fastboot, which cannot read back)."""
    access = device.access
    fastboot = access.mode == "fastboot"
    # Repeat every check of the UI against the serial number and partition list as of now:
    # the UI's list may come from an earlier state or from a different phone.
    job.report(0, 1, _("Reading the partition list…"))
    check_identity(device)
    targets = {p.name: p for p in device.load_parts(reload=True)}
    if not same_model(backup, device):
        raise Failed(_("This backup belongs to a {backup}, but the connected phone is a {device}.")
                     .format(backup=backup.title(), device=device.title()))
    for e in entries:
        problem = restore_problem(e, backup, device, targets.get(e["name"]))
        if problem:
            raise Failed(_("{name}: {problem} Nothing was written.").format(name=e["name"], problem=problem))
    total, done = 2 * sum(e["size"] for e in entries), 0
    for i, e in enumerate(entries, 1):
        name, size, target = e["name"], e["size"], targets[e["name"]]
        # 1. Verify the backup before anything is written, from a private temporary copy that is then
        # written exactly as checked: on a stick or share the file could change in between. fastboot
        # gets the data unpacked, ssh and adb the compressed file. Never more than size bytes are
        # unpacked (a manipulated file could unpack endlessly).
        text = _("Checking {name} ({i} of {n})").format(name=name, i=i, n=len(entries))
        job.report(done, total, text)
        hasher, start = hashlib.sha256(), done
        tmp = None
        try:
            try:
                with backup.open(e) as src:
                    packed = os.fstat(src.fileno()).st_size
                    # zstd adds well under 1 % to data it cannot compress
                    if packed > size + size // 64 + (1 << 20):
                        raise Failed(_("The backup of {name} is damaged (the file is too large). "
                                       "Nothing was written to this partition.").format(name=name))
                    if shutil.disk_usage(cache_dir()).free < (size if fastboot else packed) + (256 << 20):
                        raise Failed(_("Not enough free space in {dir} for a temporary copy of {name}.")
                                     .format(dir=CACHE, name=name))
                    tmp = tempfile.NamedTemporaryFile(dir=CACHE, suffix=".img" if fastboot else ".img.zst",
                                                      delete=False)
                    if fastboot:
                        with zstd.open(src, "rb") as f:
                            done = job.copy(f.read, tmp.write, hasher, done, total, text, size)
                            longer = bool(f.read(1))
                    else:
                        job.transfer(src, tmp, packed)
                if not fastboot:
                    tmp.flush()
                    tmp.seek(0)
                    with zstd.open(tmp.file, "rb") as f:
                        done = job.copy(f.read, None, hasher, done, total, text, size)
                        longer = bool(f.read(1))
            except (OSError, EOFError, zstd.ZstdError) as err:
                raise Failed(_("The backup of {name} cannot be read ({error}). Nothing was written to this "
                               "partition.").format(name=name, error=err))
            if fastboot:
                tmp.close()
            if longer or done - start != size or hasher.hexdigest() != e["sha256"]:
                raise Failed(_("The backup of {name} is damaged (checksum does not match). "
                               "Nothing was written to this partition.").format(name=name))
            # 2. Write
            text = _("Writing {name} ({i} of {n})").format(name=name, i=i, n=len(entries))
            job.log(text)
            if fastboot:
                job.report(done, total, text)
                proc = job.proc = access.flash(name, tmp.name)
                for line in proc.stdout:
                    job.log(line.decode(errors="replace").rstrip())
                if proc.wait() != 0:
                    job.check()
                    raise Failed(_("fastboot could not write {name}.").format(name=name))
                done += size
                continue
            proc = job.proc = access.writer(target.path)
            try:
                tmp.seek(0)
                with zstd.open(tmp.file, "rb") as f:
                    done = job.copy(f.read, proc.stdin.write, hashlib.sha256(), done, total, text, size)
                proc.stdin.close()
            except BrokenPipeError:
                pass
            rc, err = proc.wait(), proc.stderr.read().decode(errors="replace").strip()
            job.check()
            if rc != 0:
                raise Failed(_("Writing {name} failed: {error}").format(name=name, error=err or rc))
            # 3. Recompute the checksum on the phone
            text = _("Verifying {name} on the phone").format(name=name)
            job.report(done, total, text)
            if access.checksum(target.path, size) != e["sha256"]:
                raise Failed(_("{name} was written, but the content on the phone does not match the backup.")
                             .format(name=name))
            job.log(_("{name}: written and verified").format(name=name))
        finally:
            if tmp:
                tmp.close()
                os.unlink(tmp.name)


