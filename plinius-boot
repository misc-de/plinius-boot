class Profile:
    """Known phone. Recognized by its device tree (compatible), codename or model.
    rescue_partition: the bootloader has no "fastboot boot", the rescue system goes into this partition
    of the active slot for a while (see flash_rescue). ota_index: the update server's list of full
    packages (LineageOS updater format), where the original of that partition comes from."""

    def __init__(self, id, name, compatibles=(), codenames=(), models=(), rescue_partition="", ota_index=""):
        self.id, self.name = id, name
        self.compatibles, self.codenames, self.models = compatibles, codenames, models
        self.rescue_partition, self.ota_index = rescue_partition, ota_index

    def matches(self, info):
        compatible = info.get("compatible", "").split()
        codename = info.get("codename", "").lower()
        model = info.get("model", "").lower()
        return (any(c in compatible for c in self.compatibles)
                or codename in self.codenames
                or any(model == m or model.endswith(" " + m) for m in self.models))


