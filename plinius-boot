CRYPT_ALPHABET = "./0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"
# Which bytes of the SHA-512 digest make up each group of four characters (Drepper's specification)
SHA512_GROUPS = ((0, 21, 42), (22, 43, 1), (44, 2, 23), (3, 24, 45), (25, 46, 4), (47, 5, 26), (6, 27, 48),
                 (28, 49, 7), (50, 8, 29), (9, 30, 51), (31, 52, 10), (53, 11, 32), (12, 33, 54), (34, 55, 13),
                 (56, 14, 35), (15, 36, 57), (37, 58, 16), (59, 17, 38), (18, 39, 60), (40, 61, 19), (62, 20, 41))


def sha512_crypt(password, salt=None):
    """crypt(3) with $6$ and 5000 rounds, as /etc/shadow takes it. Python lost its crypt module in 3.13,
    and the Flatpak runtime has no tool for it, so this follows Ulrich Drepper's specification."""
    if salt is None:
        salt = "".join(CRYPT_ALPHABET[b % 64] for b in os.urandom(16))
    p, s = password.encode(), salt.encode()[:16]
    b = hashlib.sha512(p + s + p).digest()
    a = hashlib.sha512(p + s + b * (len(p) // 64) + b[:len(p) % 64])
    n = len(p)
    while n:
        a.update(b if n & 1 else p)
        n >>= 1
    c = a.digest()
    dp = hashlib.sha512(p * len(p)).digest()
    pbytes = dp * (len(p) // 64) + dp[:len(p) % 64]
    ds = hashlib.sha512(s * (16 + c[0])).digest()
    sbytes = ds * (len(s) // 64) + ds[:len(s) % 64]
    for i in range(5000):
        h = hashlib.sha512(pbytes if i & 1 else c)
        if i % 3:
            h.update(sbytes)
        if i % 7:
            h.update(pbytes)
        h.update(c if i & 1 else pbytes)
        c = h.digest()
    out = []
    for i, j, k in SHA512_GROUPS:
        v = c[i] << 16 | c[j] << 8 | c[k]
        for _n in range(4):
            out.append(CRYPT_ALPHABET[v & 63])
            v >>= 6
    out += [CRYPT_ALPHABET[c[63] & 63], CRYPT_ALPHABET[c[63] >> 6]]
    return f"$6${s.decode()}${''.join(out)}"


def pin_problem(pin, again):
    """Why these PINs cannot be used, or "". Phosh unlocks with digits."""
    if not PIN_RE.fullmatch(pin):
        return _("The PIN needs 4 to 12 digits.")
    if pin != again:
        return _("The two PINs are not the same.")
    return ""


def set_pin(access, source, pin_hash, loop=False):
    """Sets the password of the image's user in the system that was just written: source is its partition,
    or with loop its file. Only the hash goes to the phone. The line of the user must already be there."""
    if not re.fullmatch(r"\$6\$[./0-9A-Za-z]{1,16}\$[./0-9A-Za-z]{86}", pin_hash):
        raise Failed(_("The PIN could not be prepared."))
    if not re.fullmatch(r"/[A-Za-z0-9_./-]+", source):
        raise Failed(_("The name of a partition is not valid."))
    days = int(time.time() // 86400)
    run_checked(access, f"""set -e
m=$(mktemp -d /tmp/plinius-pin.XXXXXX)
mount -t ext4 {"-o loop " if loop else ""}{source} "$m"
trap 'umount "$m"; rmdir "$m"' EXIT
s=$m/etc/shadow
grep -q '^{IMAGE_USER}:' "$s"
awk -F: -v OFS=: -v h='{pin_hash}' -v d={days} '$1 == "{IMAGE_USER}" {{ $2 = h; $3 = d }} {{ print }}' "$s" > "$s.new"
chown 0:0 "$s.new"
chmod 600 "$s.new"
mv "$s.new" "$s"
sync
""", 300, _("Setting the PIN"))


