PHONE_DATA_MIN = 2 << 30


class Ext4Reader:
    """Finds and reads files in an ext4 image on the PC, without mounting it and without e2fsprogs,
    which not every system has (the Flatpak runtime does not). Only what real images use: extents and
    linear reading of directories, which also works for hashed ones."""

    MAGIC, EXTENTS_FLAG, INCOMPAT_64BIT = 0xEF53, 0x80000, 0x80
    S_IFMT, S_IFLNK = 0xF000, 0xA000
    ROOT = 2

    def __init__(self, f):
        self.f = f
        f.seek(1024)
        sb = f.read(1024)
        if len(sb) < 1024 or struct.unpack_from("<H", sb, 0x38)[0] != self.MAGIC:
            raise ValueError("not ext4")
        self.block_size = 1024 << struct.unpack_from("<I", sb, 0x18)[0]
        self.first_data = struct.unpack_from("<I", sb, 0x14)[0]
        self.inodes_per_group = struct.unpack_from("<I", sb, 0x28)[0]
        self.inode_size = struct.unpack_from("<H", sb, 0x58)[0]
        self.wide = bool(struct.unpack_from("<I", sb, 0x60)[0] & self.INCOMPAT_64BIT)
        self.desc_size = max(32, struct.unpack_from("<H", sb, 0xFE)[0]) if self.wide else 32
        blocks = struct.unpack_from("<I", sb, 0x04)[0]
        if self.wide:
            blocks |= struct.unpack_from("<I", sb, 0x150)[0] << 32
        self.size = blocks * self.block_size

    def read_at(self, offset, size):
        self.f.seek(offset)
        return self.f.read(size)

    def inode(self, number):
        group, index = (number - 1) // self.inodes_per_group, (number - 1) % self.inodes_per_group
        desc = self.read_at((self.first_data + 1) * self.block_size + group * self.desc_size, self.desc_size)
        table = struct.unpack_from("<I", desc, 8)[0]
        if self.wide and self.desc_size >= 0x2C:
            table |= struct.unpack_from("<I", desc, 0x28)[0] << 32
        return self.read_at(table * self.block_size + index * self.inode_size, self.inode_size)

    def extents(self, node, depth_limit=8):
        """(physical block, blocks) of a node of the extent tree, in order."""
        magic, entries, _max, depth = struct.unpack_from("<HHHH", node, 0)
        if magic != 0xF30A or depth_limit == 0:
            raise ValueError("no extents")
        for i in range(entries):
            at = 12 + i * 12
            if depth == 0:
                _logical, length, high, low = struct.unpack_from("<IHHI", node, at)
                # Above 32768 the extent is allocated but not written yet
                yield (high << 32 | low, length if length <= 32768 else length - 32768)
            else:
                _logical, low, high = struct.unpack_from("<IIH", node, at)
                yield from self.extents(self.read_at((high << 32 | low) * self.block_size, self.block_size),
                                        depth_limit - 1)

    def contents(self, inode, limit=1 << 22):
        size = struct.unpack_from("<I", inode, 4)[0]
        mode = struct.unpack_from("<H", inode, 0)[0]
        # A short link is kept in the inode itself
        if mode & self.S_IFMT == self.S_IFLNK and size < 60:
            return inode[0x28:0x28 + size]
        if not struct.unpack_from("<I", inode, 0x20)[0] & self.EXTENTS_FLAG:
            raise ValueError("no extents")
        data = bytearray()
        for block, count in self.extents(inode[0x28:0x28 + 60]):
            data += self.read_at(block * self.block_size, min(count * self.block_size, limit - len(data)))
            if len(data) >= limit:
                break
        return bytes(data[:min(size, limit)])

    def child(self, directory, name):
        data, at = self.contents(directory), 0
        while at + 8 <= len(data):
            number, length, name_length = struct.unpack_from("<IHB", data, at)
            if length < 8:
                break
            if number and data[at + 8:at + 8 + name_length] == name:
                return number
            at += length
        return None

    def lookup(self, path, links=8):
        """The inode of a path, following links inside the image; None if it does not exist."""
        current = self.inode(self.ROOT)
        parts = [p.encode() for p in path.split("/") if p]
        while parts:
            number = self.child(current, parts.pop(0))
            if number is None:
                return None
            node = self.inode(number)
            if struct.unpack_from("<H", node, 0)[0] & self.S_IFMT == self.S_IFLNK:
                if links == 0:
                    return None
                target = self.contents(node).split(b"/")
                # An absolute link starts over at the root of the image, a relative one stays here
                if self.contents(node).startswith(b"/"):
                    current = self.inode(self.ROOT)
                parts = [p for p in target if p and p != b"."] + parts
                links -= 1
                continue
            current = node
        return current

    def read_file(self, path):
        node = self.lookup(path)
        return None if node is None else self.contents(node)

    def extent_map(self, node, depth_limit=8):
        """(logical block, physical block, blocks) of an extent tree. Unlike extents() it says where a
        piece belongs, which matters for files with holes."""
        magic, entries, _max, depth = struct.unpack_from("<HHHH", node, 0)
        if magic != 0xF30A or depth_limit == 0:
            raise ValueError("no extents")
        for i in range(entries):
            at = 12 + i * 12
            if depth == 0:
                logical, length, high, low = struct.unpack_from("<IHHI", node, at)
                yield logical, high << 32 | low, length if length <= 32768 else length - 32768
            else:
                _logical, low, high = struct.unpack_from("<IIH", node, at)
                yield from self.extent_map(self.read_at((high << 32 | low) * self.block_size, self.block_size),
                                           depth_limit - 1)

    def open_file(self, path):
        """A file of the image to read from start to end, or None if it does not exist."""
        node = self.lookup(path)
        return None if node is None else Ext4File(self, node)


class Ext4File:
    """Reads a big file of an ext4 image in order, without loading it. Holes read as zeros."""

    def __init__(self, ext4, inode):
        if not struct.unpack_from("<I", inode, 0x20)[0] & ext4.EXTENTS_FLAG:
            raise ValueError("no extents")
        self.ext4, self.at = ext4, 0
        self.size = struct.unpack_from("<I", inode, 4)[0] | struct.unpack_from("<I", inode, 0x6C)[0] << 32
        self.pieces = sorted(ext4.extent_map(inode[0x28:0x28 + 60]))

    def read_exact(self, count):
        """count bytes, or what is left of the file: read() stops at the end of each piece."""
        parts = []
        while count > 0 and (chunk := self.read(count)):
            parts.append(chunk)
            count -= len(chunk)
        return b"".join(parts)

    def read(self, count):
        """Up to count bytes, at most to the end of the current piece or hole."""
        count = min(count, self.size - self.at)
        if count <= 0:
            return b""
        size = self.ext4.block_size
        for logical, physical, blocks in self.pieces:
            start, end = logical * size, (logical + blocks) * size
            if self.at < start:
                # In a hole, up to the next piece
                count = min(count, start - self.at)
                break
            if self.at < end:
                count = min(count, end - self.at)
                data = self.ext4.read_at(physical * size + self.at - start, count)
                if len(data) != count:
                    raise EOFError("the image is shorter than its file system")
                self.at += count
                return data
        self.at += count
        return bytes(count)


class SystemImage:
    """An image file that is to become a system: checked before anything on the phone changes. A
    compressed one is unpacked to a private temporary file first, because finding files needs to
    jump around in it; what is written is then exactly what was checked."""

    def __init__(self, path):
        self.path, self.temporary = path, None
        self.size, self.block_size, self.name, self.problem = 0, 0, "", ""
        # The phone asks for the PIN at its first start (FIRST_START_MARK)
        self.first_start = False
        # What the image wants from Volla OS on the phone (vendor_pins)
        self.vendor = {}

    def place_problem(self, part):
        """Why this image cannot go to a system partition, or ""."""
        if self.size > part["size"]:
            return _("This image needs {need}, but partition {number} holds {size}. Nothing was changed.").format(
                need=size_text(self.size), number=part["number"], size=size_text(part["size"]))
        if part.get("internal") and self.block_size < INTERNAL_BLOCK:
            return _("This image has blocks of {size} bytes, and the phone's own storage needs {need}. It would not "
                     "start there. Nothing was changed.").format(size=self.block_size, need=INTERNAL_BLOCK)
        return ""

    def check(self, job=None):
        """Fills in size, name and problem; problem is empty if the image is usable."""
        try:
            with open(self.path, "rb") as f:
                compressed = f.read(4) == b"\x28\xb5\x2f\xfd"
            if compressed:
                self.unpack(job)
            with open(self.temporary or self.path, "rb") as f:
                ext4 = Ext4Reader(f)
                self.size, self.block_size = ext4.size, ext4.block_size
                for name in IMAGE_NEEDS:
                    if ext4.lookup(name) is None:
                        self.problem = _("This image lacks {name}, so it cannot start on this phone.").format(name=name)
                        return
                release = ext4.read_file("etc/os-release") or ext4.read_file("usr/lib/os-release")
                if not release:
                    self.problem = _("This image has no os-release, so it is not a Linux system.")
                    return
                values = dict(line.split("=", 1) for line in release.decode(errors="replace").splitlines() if "=" in line)
                self.name = clean_text(values.get("PRETTY_NAME") or values.get("NAME") or "Linux", 60)
                self.first_start = ext4.lookup(FIRST_START_MARK) is not None
                self.vendor = vendor_pins(ext4)
                if os.fstat(f.fileno()).st_size < self.size:
                    self.problem = _("This image is incomplete.")
        except (OSError, EOFError, ValueError, struct.error, zstd.ZstdError) as err:
            self.problem = _("This is not a usable ext4 image ({error}).").format(error=err)

    def unpack(self, job):
        """Into the cache, private to the user; the size limit is the free space, minus a reserve."""
        tmp = tempfile.NamedTemporaryFile(dir=cache_dir(), suffix=".img", delete=False)
        self.temporary = tmp.name
        limit = shutil.disk_usage(cache_dir()).free - (1 << 30)
        with tmp, zstd.open(self.path, "rb") as f:
            written = 0
            while chunk := f.read(CHUNK):
                if job:
                    job.check()
                written += len(chunk)
                if written > limit:
                    raise OSError(_("Not enough free space in {dir} to unpack it.").format(dir=CACHE))
                tmp.write(chunk)

    def open(self):
        return open(self.temporary or self.path, "rb")

    def phone_problem(self):
        """Why this image cannot replace the system in the phone's own storage, or ""."""
        with self.open() as f:
            ext4 = Ext4Reader(f)
            for name, magic in PHONE_BOOT_MAGIC.items():
                file = ext4.open_file(f"{PHONE_BOOT_DIR}/{name}.img")
                if file is None:
                    return _("This image does not bring {name}, so it can only go on the memory card.").format(
                        name=name + ".img")
                head = file.read_exact(4096)
                if head[:len(magic)] != magic:
                    return _("{name} in this image is not a boot image.").format(name=name + ".img")
                # Handled first by the ramdisk: with it, the system would be looked for in Volla's partitions
                if name == "vendor_boot" and b"systempart=" in head[VENDOR_CMDLINE[0]:sum(VENDOR_CMDLINE)]:
                    return _("{name} in this image still names a system partition, so the system on the data "
                             "partition would never start.").format(name=name + ".img")
        return ""

    def close(self):
        if self.temporary:
            try:
                os.unlink(self.temporary)
            except OSError:
                pass
            self.temporary = None


def part_path(part):
    """The device of a partition from parse_card, checked again: it goes into a command. In the phone's
    own storage only partitions the app made itself pass, so nothing else there can ever be written."""
    path = "/dev/" + part["name"]
    if part.get("internal"):
        if INTERNAL_PART_RE.fullmatch(part["name"]) and LABEL_RE.fullmatch(part.get("label", "")):
            return path
    elif PART_PATH_RE.match(path):
        return path
    raise Failed(_("The name of a partition is not valid."))


def card_places(card):
    """The systems on the card that have a place of their own: a boot entry with system and data."""
    return [e for e in card["entries"] if not e["own_system"] and e["system"] and e["data"]]


def free_pairs(card):
    """Partitions nothing uses, in pairs: places a system can move to."""
    used = {p["name"] for e in card["entries"] for p in (e["system"], e["data"]) if p}
    pairs = []
    # On one disk only: a system with its data on another medium would hang on both
    for internal in (False, True):
        unused = [p for p in card["parts"] if bool(p.get("internal")) == internal and p["name"] not in used
                  and p["name"] != card.get("settings")]
        pairs += [{"file": "", "title": "", "system": a, "data": b, "own_system": False, "raw": []}
                  for a, b in zip(unused[0::2], unused[1::2])]
    return pairs


def home_users(card):
    """{partition number: [titles]}: which other systems use a partition as their /home without any
    configuration saying so. systemd's gpt-auto generator mounts the first partition of the type
    "Linux /home" on the disk it booted from. The Volla Boot Manager gives that type to every data
    partition, so a system can end up on the data of another one."""
    homes = sorted(p["number"] for p in card["parts"] if p.get("type") == GPT_HOME)
    if not homes:
        return {}
    found = {}
    for e in card_places(card):
        if e["system"].get("gpt_auto") and "systemd.gpt_auto=0" not in e.get("options", "") and homes[0] != e["data"]["number"]:
            found.setdefault(homes[0], []).append(e["title"] or _("Unnamed system"))
    return found


def place_warnings(card, place):
    """What the user must know before changing a place, as far as the phone shows it."""
    warnings = []
    users = home_users(card)
    for part in (place["system"], place["data"]):
        for title in users.get(part["number"], ()):
            warnings.append(_("{title} keeps its /home on partition {number}. Overwriting or emptying it deletes "
                              "the personal files of {title}.").format(title=title, number=part["number"]))
    return warnings


def uses_kernel_of(card, place):
    """Other systems that start with the kernel from the folder of this entry (rom0.conf has rom0/);
    it is never changed here."""
    folder = place["file"].removesuffix(".conf")
    return [e["title"] for e in card_places(card) if e is not place and e.get("kernel") == folder]


def run_checked(access, script, timeout, what):
    """Runs a command as root on the phone; a failure names the step."""
    rc, out, err = access.run_root(script, timeout)
    if rc != 0:
        raise Failed(_("{what} failed: {error}").format(what=what, error=clean_text(err or out or rc, 300)))
    return out


def fresh_card(device, expected):
    """Reads the card again just before writing: the plan may come from an earlier state or even from
    another phone (same address on the USB network). The partitions and entries must be unchanged."""
    if not device.rescue:
        raise Failed(_("This only works in the rescue system. Nothing was changed."))
    check_identity(device)
    card = device.access.card()
    shape = lambda c: ([(p["name"], p["start"], p["sectors"]) for p in c["parts"]],
                       [(e["file"], e["raw"]) for e in c["entries"]])
    if not card or shape(card) != shape(expected):
        raise Failed(_("The memory card has changed since it was read. Nothing was changed."))
    return card


def fs_blocks(access, part):
    """The current size of the file system in a partition as (blocks, block size)."""
    out = run_checked(access, f"dumpe2fs -h {part_path(part)} 2>/dev/null", 120, _("Reading the file system"))
    values = dict(line.split(":", 1) for line in out.splitlines() if ":" in line)
    try:
        return int(values["Block count"]), int(values["Block size"])
    except (KeyError, ValueError):
        raise Failed(_("Partition {number} holds no readable file system.").format(number=part["number"]))


def fs_repair(access, part):
    """e2fsck: 0 is clean, 1 and 2 mean it corrected something; everything above is a real problem."""
    path = part_path(part)
    rc, out, err = access.run_root(f"e2fsck -fy {path} >/dev/null 2>&1; echo $?", 7200)
    code = out.strip()
    if rc != 0 or code not in ("0", "1", "2"):
        raise Failed(_("The file system on partition {number} has errors (e2fsck {code}).").format(
            number=part["number"], code=code or err.strip()))


def fs_resize(access, part, blocks=None):
    """resize2fs: to the size of the partition, to the given blocks, or to the minimum (0)."""
    path = part_path(part)
    what = _("Resizing the file system")
    if blocks == 0:
        run_checked(access, f"resize2fs -M {path} 2>&1", 14400, what)
    else:
        run_checked(access, f"resize2fs {path} {int(blocks) if blocks else ''} 2>&1", 14400, what)


def needs_shrinking(source, target):
    """Whether the file system must be made smaller first, so that it fits, or because copying the empty
    part of a big one would take many hours (an SD card writes about 3 MB/s)."""
    fs = source.get("fs")
    return bool(fs) and (fs["bytes"] > target["size"] or fs["bytes"] > 2 * fs["used"] + (1 << 30))


def copy_problem(source, target):
    """Why a partition cannot go to target, or ""."""
    fs = source.get("fs")
    if fs and target.get("internal") and fs["block_size"] < INTERNAL_BLOCK:
        return _("Partition {source} has blocks of {size} bytes, and the phone's own storage needs {need}.").format(
            source=source["number"], size=fs["block_size"], need=INTERNAL_BLOCK)
    if fs:
        # resize2fs needs some room above the used blocks; it says at the time whether it was enough
        if fs["used"] + fs["used"] // 8 + (16 << 20) > target["size"]:
            return _("Partition {source} holds {used}, which does not fit into partition {target} ({size}).").format(
                source=source["number"], used=size_text(fs["used"]), target=target["number"], size=size_text(target["size"]))
    elif source["size"] > target["size"]:
        # Encrypted or unknown: only as a whole
        return _("Partition {source} cannot be made smaller, and it does not fit into partition {target}.").format(
            source=source["number"], target=target["number"])
    return ""


def entry_text(place, title=None, system=None, data=None):
    """The boot entry as text with the given changes; every other line stays as it is. Nothing from
    the phone or the user gets a line of its own: titles lose control characters."""
    lines = []
    for line in place["raw"]:
        key, _sep, value = line.partition(" ")
        if key == "title" and title is not None:
            line = "title " + (clean_text(title, 60) or place["title"])
        elif key == "xpart" and system:
            line = f"xpart {system['number']}:{data['number']}"
        elif key == "options" and system:
            part_path(system), part_path(data)
            value = re.sub(r"systempart=\S+", "systempart=" + boot_path(system), value)
            value = re.sub(r"datapart=\S+", "datapart=" + boot_path(data), value)
            line = "options " + value
        lines.append(line)
    return "\n".join(lines) + "\n"


def write_entries(access, card, entries, removed=()):
    """Writes boot entries: each to a new file, synced, then renamed, so that the bootloader finds either
    the old one or the new one. Entries of systems that are gone move to db/removed, and stay readable."""
    settings = card.get("settings")
    if not settings or not re.fullmatch(r"mmcblk\d+p\d+", settings):
        raise Failed(_("The memory card has no partition with boot entries."))
    script = ["set -e", 'm=$(mktemp -d /tmp/plinius-entries.XXXXXX)', f"mount -t ext4 /dev/{settings} \"$m\"",
              "trap 'umount \"$m\"; rmdir \"$m\"' EXIT"]
    for name, text in entries.items():
        if not ENTRY_FILE_RE.match(name):
            raise Failed(_("The name of a boot entry is not valid."))
        data = base64.b64encode(text.encode()).decode()
        script += [f"echo {data} | base64 -d > \"$m/db/entries/{name}.new\"",
                   f"chown 1000:1000 \"$m/db/entries/{name}.new\"", f"chmod 600 \"$m/db/entries/{name}.new\"",
                   "sync", f"mv \"$m/db/entries/{name}.new\" \"$m/db/entries/{name}\"", "sync"]
    for name in removed:
        if not ENTRY_FILE_RE.match(name):
            raise Failed(_("The name of a boot entry is not valid."))
        script += ['mkdir -p "$m/db/removed"', f"mv \"$m/db/entries/{name}\" \"$m/db/removed/{name}\"", "sync"]
    run_checked(access, "\n".join(script) + "\n", 120, _("Writing the boot entries"))


def send_to_partition(job, access, read, part, size, done, total, text):
    """Writes size bytes from read() to a partition, then has the phone compute the checksum of what
    is really there. Returns (done, sha256)."""
    proc = job.proc = access.writer(part_path(part))
    hasher, start = hashlib.sha256(), done
    try:
        done = job.copy(read, proc.stdin.write, hasher, done, total, text, size)
        proc.stdin.close()
    except (BrokenPipeError, ValueError):
        pass
    rc, err = proc.wait(), proc.stderr.read().decode(errors="replace").strip()
    job.check()
    if rc != 0 or done - start != size:
        raise Failed(_("Writing partition {number} failed: {error}").format(
            number=part["number"], error=clean_text(err or _("the data is incomplete"), 300)))
    job.report(done, total, _("Verifying partition {number} on the phone").format(number=part["number"]))
    if access.checksum(part_path(part), size) != hasher.hexdigest():
        raise Failed(_("Partition {number} was written, but what is on the phone does not match.").format(
            number=part["number"]))
    return done, hasher.hexdigest()


def read_from_partition(job, access, part, size, write, done, total, text):
    """Reads size bytes of a partition into write(). Returns (done, sha256)."""
    proc = job.proc = access.reader(part_path(part), size)
    hasher, start = hashlib.sha256(), done
    done = job.copy(proc.stdout.read, write, hasher, done, total, text, size)
    more = proc.stdout.read(1)
    if more:
        proc.kill()
    rc, err = proc.wait(), proc.stderr.read().decode(errors="replace").strip()
    job.check()
    if more or rc != 0 or done - start != size:
        raise Failed(_("Reading partition {number} failed: {error}").format(
            number=part["number"], error=clean_text(err or _("the data is incomplete"), 300)))
    return done, hasher.hexdigest()


def copy_partition(job, access, source, target, size, done, total, text):
    """Copies directly from partition to partition, through the PC: that gives progress and a way to
    cancel, and the SD card is much slower than USB anyway. Returns done."""
    reader = access.reader(part_path(source), size)
    try:
        done, sha = send_to_partition(job, access, reader.stdout.read, target, size, done, total, text)
    finally:
        if reader.poll() is None:
            reader.kill()
        reader.wait()
    return done


def finish_filesystem(access, part, opaque=False):
    """After writing: repair, then let the file system use the whole partition."""
    if not opaque:
        fs_repair(access, part)
        fs_resize(access, part)


def with_small_source(access, source, target, work):
    """Runs work(bytes) with the file system of source at a size that fits target. A smaller file system
    has the same contents; it gets its old size back in any case, also after a failure or a cancel."""
    if not source.get("fs"):
        return work(source["size"])
    blocks, block_size = fs_blocks(access, source)
    if not needs_shrinking(source, target):
        return work(blocks * block_size)
    fs_repair(access, source)
    fs_resize(access, source, 0)
    try:
        small, block_size = fs_blocks(access, source)
        if small * block_size > target["size"]:
            raise Failed(_("Partition {source} does not fit into partition {target}, even at its smallest.").format(
                source=source["number"], target=target["number"]))
        return work(small * block_size)
    finally:
        fs_resize(access, source, blocks)


# A copy on the PC: <backups>/Systems_<serial>/<time>/ with state.json and one .img.zst per partition.
# state.json says what is finished, so that a swap can go on where it stopped. These folders have no
# manifest.json, so they do not appear among the backups and are not offered for restoring.
STATE = "state.json"


def new_state(device, base, kind, places):
    stamp = datetime.datetime.now().strftime("%Y-%m-%d_%H-%M-%S")
    folder = os.path.join(base, safe_name(f"Systems_{device.serial or 'unknown'}"), stamp)
    os.makedirs(folder, mode=0o700)
    state = {"kind": kind, "serial": device.serial, "folder": folder, "created": stamp, "done": False, "app": APP_NAME,
             "places": [{"file": p["file"], "title": p["title"], "raw": p["raw"],
                         "system": p["system"]["number"], "data": p["data"]["number"]} for p in places],
             "partitions": {}, "written": []}
    save_state(state)
    return state


def save_state(state):
    path = os.path.join(state["folder"], STATE)
    with create_private(path + ".tmp", "w") as f:
        json.dump(state, f, indent=1)
        f.flush()
        os.fsync(f.fileno())
    os.replace(path + ".tmp", path)
    fsync_path(state["folder"])


def load_states(base, serial):
    """The copies of this phone on this PC, newest first; what cannot be read is left out."""
    states = []
    for folder in subdirs(os.path.join(base, safe_name(f"Systems_{serial or 'unknown'}"))):
        try:
            with open_regular(os.path.join(folder, STATE)) as f:
                state = json.loads(f.read(MANIFEST_MAX))
        except (OSError, ValueError, RecursionError):
            continue
        if isinstance(state, dict) and state.get("serial") == serial and isinstance(state.get("partitions"), dict):
            # Where it is now counts, not where it was when written
            state["folder"] = folder
            states.append(state)
    return sorted(states, key=lambda s: str(s.get("created")), reverse=True)


def save_partition(job, access, state, part, limit_to, done, total):
    """Saves a partition into a state folder and proves it by reading the file back. limit_to: the
    partition it will go to, or None to keep the size. Returns done."""
    key = str(part["number"])
    saved = state["partitions"].get(key)
    if saved:
        return done + saved["bytes"]
    text = _("Saving partition {number}").format(number=part["number"])

    def work(size):
        name = f"partition-{part['number']}.img.zst"
        out = os.path.join(state["folder"], name)
        with zstd_writer(out + ".part") as f:
            end, sha = read_from_partition(job, access, part, size, f.write, done, total, text)
        hasher = hashlib.sha256()
        with zstd.open(out + ".part", "rb") as f:
            while chunk := f.read(CHUNK):
                job.check()
                hasher.update(chunk)
        if hasher.hexdigest() != sha:
            raise Failed(_("The copy of partition {number} on this PC is damaged.").format(number=part["number"]))
        fsync_path(out + ".part")
        os.rename(out + ".part", out)
        state["partitions"][key] = {"file": name, "bytes": size, "sha256": sha, "start": part["start"],
                                    "sectors": part["sectors"], "opaque": not part.get("fs")}
        save_state(state)
        return end

    if limit_to:
        return with_small_source(access, part, limit_to, work)
    return with_small_source(access, part, part, work) if not part.get("fs") else work(part["fs"]["bytes"])


def write_saved(job, access, state, source_number, target, done, total):
    """Writes a saved partition to target, checked first against its checksum. Returns done."""
    saved = state["partitions"][str(source_number)]
    path = os.path.join(state["folder"], os.path.basename(saved["file"]))
    if saved["bytes"] > target["size"]:
        raise Failed(_("The copy of partition {number} does not fit.").format(number=source_number))
    hasher = hashlib.sha256()
    with zstd.open(path, "rb") as f:
        while chunk := f.read(CHUNK):
            job.check()
            hasher.update(chunk)
    if hasher.hexdigest() != saved["sha256"]:
        raise Failed(_("The copy of partition {number} on this PC is damaged. Nothing was written from it.").format(
            number=source_number))
    text = _("Writing partition {number}").format(number=target["number"])
    with zstd.open(path, "rb") as f:
        done, _sha = send_to_partition(job, access, f.read, target, saved["bytes"], done, total, text)
    finish_filesystem(access, target, saved.get("opaque"))
    return done


def required_space(places):
    """What copies of these places may need on the PC; zstd usually needs less."""
    total = 0
    for place in places:
        for part in (place["system"], place["data"]):
            total += part["fs"]["used"] if part.get("fs") else part["size"]
    return total + (1 << 30)


def check_space(base, places):
    os.makedirs(base, exist_ok=True)
    need, free = required_space(places), shutil.disk_usage(base).free
    if free < need:
        raise Failed(_("Copies of these systems may need {need} on this PC, but only {free} are free in {dir}. "
                       "Nothing was changed.").format(need=size_text(need), free=size_text(free), dir=base))


def run_install(job, device, card, place, image, wipe_data, title, keep_copy, base):
    """Installs a checked image on the place of an existing system. The entry changes last, except for
    its title: until then a cancel leaves the old system's entry, with a system no longer whole."""
    access = device.access
    card = fresh_card(device, card)
    if place["file"]:
        place = next(e for e in card_places(card) if e["file"] == place["file"])
    else:
        by_name = {p["name"]: p for p in card["parts"]}
        place = dict(place, system=by_name[place["system"]["name"]], data=by_name[place["data"]["name"]])
    if image.problem:
        raise Failed(image.problem)
    system, data = place["system"], place["data"]
    problem = image.place_problem(system)
    if problem:
        raise Failed(problem)
    saving = [system] + ([data] if wipe_data else [])
    total, done = image.size + sum(p["fs"]["bytes"] if p.get("fs") else p["size"] for p in saving) * bool(keep_copy), 0
    # A free place holds nothing to keep
    keep_copy = keep_copy and bool(place["file"])
    if keep_copy:
        check_space(base, [place])
        state = new_state(device, base, "copy", [place])
        for part in saving:
            done = save_partition(job, access, state, part, None, done, total)
        job.log(_("The old system is saved in {dir}.").format(dir=state["folder"]))
    with image.open() as f:
        done, _sha = send_to_partition(job, access, f.read, system, image.size, done, total,
                                       _("Writing the image to partition {number}").format(number=system["number"]))
    job.report(done, total, _("Fitting the file system to the partition"))
    finish_filesystem(access, system)
    if image.vendor:
        job.report(done, total, _("Copying the drivers of Volla OS"))
        job.notes += take_vendor(job, device, part_path(system), image.vendor)
    if wipe_data:
        job.report(done, total, _("Emptying partition {number}").format(number=data["number"]))
        # mkfs.ext4, not mke2fs: the shell of the rescue system prefers the applet of busybox with that
        # name, which only knows ext2. mkfs.ext4 is the real one.
        run_checked(access, f"{MKFS} {part_path(data)} 2>&1", 7200, _("Emptying the data partition"))
    if place["file"]:
        write_entries(access, card, {place["file"]: entry_text(place, title=title)})
    else:
        name, content = new_entry(card, place, title)
        write_entries(access, card, {name: content})
    if keep_copy:
        state["done"] = True
        save_state(state)


def run_move(job, device, card, source, target, keep_copy, base):
    """Copies a system to another place; the old one stays whole until the user has started the new
    one. If the target held a system, its entry moves to db/removed."""
    access = device.access
    card = fresh_card(device, card)
    pick = lambda p: next((x for x in card["parts"] if x["name"] == p["name"]), None)
    source = next(e for e in card_places(card) if e["file"] == source["file"])
    target = dict(target, system=pick(target["system"]), data=pick(target["data"]))
    pairs = ((source["system"], target["system"]), (source["data"], target["data"]))
    for a, b in pairs:
        problem = copy_problem(a, b)
        if problem:
            raise Failed(problem + " " + _("Nothing was changed."))
    size_of = lambda a, b: (a["fs"]["used"] if needs_shrinking(a, b) else a["fs"]["bytes"]) if a.get("fs") else a["size"]
    total, done = sum(size_of(a, b) for a, b in pairs), 0
    if keep_copy and target["file"]:
        check_space(base, [target])
        total += sum(p["fs"]["bytes"] if p.get("fs") else p["size"] for p in (target["system"], target["data"]))
        state = new_state(device, base, "copy", [target])
        for part in (target["system"], target["data"]):
            done = save_partition(job, access, state, part, None, done, total)
        state["done"] = True
        save_state(state)
    for a, b in pairs:
        def work(size, a=a, b=b):
            nonlocal done, total
            # The estimate is replaced by what the file system really takes now
            total += size - size_of(a, b)
            done = copy_partition(job, access, a, b, size, done, total, _("Copying partition {source} to {target}").format(
                source=a["number"], target=b["number"]))
            finish_filesystem(access, b, not a.get("fs"))
        with_small_source(access, a, b, work)
    write_entries(access, card, {source["file"]: entry_text(source, system=target["system"], data=target["data"])},
                  [target["file"]] if target["file"] else ())


def swap_partitions(card, state):
    """The four (source number, target partition) of a swap, from the saved plan."""
    by_number = {p["number"]: p for p in card["parts"]}
    a, b = state["places"]
    return ((a["system"], by_number[b["system"]]), (a["data"], by_number[b["data"]]),
            (b["system"], by_number[a["system"]]), (b["data"], by_number[a["data"]]))


def begin_swap(device, card, a, b, base):
    """Checks a swap as of now and makes its folder on the PC; nothing on the phone changes."""
    card = fresh_card(device, card)
    a, b = (next(e for e in card_places(card) if e["file"] == p["file"]) for p in (a, b))
    for source, target in ((a["system"], b["system"]), (a["data"], b["data"]), (b["system"], a["system"]),
                           (b["data"], a["data"])):
        problem = copy_problem(source, target)
        if problem:
            raise Failed(problem + " " + _("Nothing was changed."))
    check_space(base, [a, b])
    return new_state(device, base, "swap", [a, b])


def run_swap(job, device, card, state):
    """Two systems change places, through copies on the PC, because they rarely have the same sizes.
    Everything needed is in state.json, so this can go on after a cancel, a lost connection or a new
    start of the app: what is finished is not done again."""
    access = device.access
    current = device.access.card()
    if not device.rescue or not current:
        raise Failed(_("This only works in the rescue system. Nothing was changed."))
    check_identity(device)
    by_number = {p["number"]: p for p in current["parts"]}
    moves = swap_partitions(current, state)
    # The partitions must still be the same ones; the entries may already be new if only the last step failed
    for number, saved in state["partitions"].items():
        part = by_number.get(int(number))
        if not part or (part["start"], part["sectors"]) != (saved["start"], saved["sectors"]):
            raise Failed(_("The memory card has changed since this swap began. Nothing was changed."))
    # All four copies first; until they are there and proven, nothing on the phone is overwritten
    estimate = lambda n, t: by_number[n]["fs"]["used"] if by_number[n].get("fs") else by_number[n]["size"]
    total = 2 * sum(state["partitions"].get(str(n), {}).get("bytes", estimate(n, t)) for n, t in moves)
    done = 0
    for number, target in moves:
        done = save_partition(job, access, state, by_number[number], target, done, total)
    total = 2 * sum(state["partitions"][str(n)]["bytes"] for n, _t in moves)
    done = total // 2
    for number, target in moves:
        size = state["partitions"][str(number)]["bytes"]
        if number in state["written"]:
            done += size
            continue
        done = write_saved(job, access, state, number, target, done, total)
        state["written"].append(number)
        save_state(state)
    a, b = state["places"]
    entries = {}
    for place, other in ((a, b), (b, a)):
        place_like = {"raw": place["raw"], "title": place["title"]}
        entries[place["file"]] = entry_text(place_like, system=by_number[other["system"]], data=by_number[other["data"]])
    write_entries(access, current, entries)
    state["done"] = True
    save_state(state)


def new_entry(card, place, title):
    """(file name, text) of a boot entry for a system on a free place. Kernel, initrd and device tree come
    from an entry that has them: every Halium system starts with the same ones on this phone."""
    template = next((e for e in card_places(card) if e.get("kernel")), None)
    if not template:
        raise Failed(_("A new system needs a kernel from an existing system on the memory card, and there is none."))
    taken = {e["file"] for e in card["entries"]}
    name = next(f"rom{i}.conf" for i in range(2, 100) if f"rom{i}.conf" not in taken)
    # Without the address the other system gets its updates from
    template = dict(template, raw=[line for line in template["raw"] if not line.startswith("xupdate ")])
    return name, entry_text(template, title=title or _("Unnamed system"), system=place["system"], data=place["data"])


# Types of new partitions: the system as the manager makes it; data deliberately not as "Linux /home",
# or systemd would mount it for other systems (see home_users).
GPT_TYPE_SYSTEM, GPT_TYPE_DATA = "8305", "8300"
# -a 1: sgdisk would otherwise move the start of a partition to its own alignment. A partition that is
# made smaller must start exactly where it did; new ones are aligned here (ALIGN).
SGDISK = "sgdisk -a 1"
ALIGN = 2048
# What Volla OS keeps at least when the phone's storage is divided
USERDATA_MIN = 32 << 30


def relist_partitions(access, disk):
    """The kernel reads the table again; nodes and name links follow, also without devtmpfs."""
    run_checked(access, f"blockdev --rereadpt /dev/{disk} 2>&1; plinius-partlinks", 120, _("Reading the partition table"))


def part_geometry(access, name):
    """(start, size) as the kernel sees it now, in units of 512 bytes."""
    if not re.fullmatch(r"[a-z]+\d*p?\d+", name):
        raise Failed(_("The name of a partition is not valid."))
    out = access.run_root(f"cat /sys/class/block/{name}/start /sys/class/block/{name}/size", 30)[1].split()
    return (int(out[0]), int(out[1])) if len(out) == 2 and all(x.isdigit() for x in out) else None


def disk_of(part):
    return re.sub(r"p?\d+$", "", part["name"])


def gpt_info(access, disk, number):
    """(type GUID, unique GUID, name) of a partition, which a changed entry must keep."""
    out = run_checked(access, f"sgdisk -i {int(number)} /dev/{disk} 2>&1", 60, _("Reading the partition table"))
    guid = lambda label: re.search(label + r":\s*([0-9A-Fa-f-]{36})", out)
    name = re.search(r"Partition name: '([^']*)'", out)
    if not guid("Partition GUID code") or not guid("Partition unique GUID"):
        raise Failed(_("Partition {number} cannot be read from the partition table.").format(number=number))
    return guid("Partition GUID code")[1], guid("Partition unique GUID")[1], name[1] if name else ""


def sgdisk_entry(number, first, last, type_guid, unique="", name=""):
    """Options of sgdisk for one partition; first and last in sectors of the disk."""
    options = [f"-n {int(number)}:{int(first)}:{int(last)}", f"-t {int(number)}:{type_guid}"]
    if unique:
        options.append(f"-u {int(number)}:{unique}")
    if name and re.fullmatch(r"[a-z0-9_]{1,32}", name):
        options.append(f"-c {int(number)}:{name}")
    return options


def card_resize_problem(part, new_size):
    """Why a partition on the card cannot become this small, or ""."""
    fs = part.get("fs")
    if not fs:
        return _("Partition {number} holds nothing that can be made smaller.").format(number=part["number"])
    if new_size >= part["size"]:
        return _("That is not smaller than it is now.")
    if fs["used"] + fs["used"] // 8 + (16 << 20) > new_size:
        return _("Partition {number} holds {used}, so it cannot become that small.").format(
            number=part["number"], used=size_text(fs["used"]))
    return ""


def run_shrink(job, device, card, part, new_size, keep_copy, base):
    """Makes a partition on the card smaller: first the file system, then the partition, in this order, or
    the file system would be larger than its partition. Its number and identity stay, entries hang on them."""
    access = device.access
    card = fresh_card(device, card)
    part = next(p for p in card["parts"] if p["name"] == part["name"])
    if part.get("internal"):
        raise Failed(_("The name of a partition is not valid."))
    problem = card_resize_problem(part, new_size)
    if problem:
        raise Failed(problem + " " + _("Nothing was changed."))
    disk = disk_of(part)
    part_path(part)
    if access.run_root(f"cat /sys/block/{disk}/queue/logical_block_size", 30)[1].strip() != str(SECTOR):
        raise Failed(_("The partition table of the memory card looks different than expected. Nothing was changed."))
    sectors = (new_size // SECTOR) // ALIGN * ALIGN
    total, done = part["fs"]["bytes"] if keep_copy else 1, 0
    if keep_copy:
        place = {"file": "", "title": _("Partition {number}").format(number=part["number"]), "raw": [],
                 "system": part, "data": part}
        check_space(base, [{"system": part, "data": {"size": 0}}])
        state = new_state(device, base, "partition", [place])
        done = save_partition(job, access, state, part, None, done, total)
        state["done"] = True
        save_state(state)
    job.report(done, total, _("Making the file system smaller"))
    fs_repair(access, part)
    blocks, block_size = fs_blocks(access, part)
    # A little below the new size; it gets the exact size at the end
    fs_resize(access, part, (sectors * SECTOR - (1 << 20)) // block_size)
    try:
        job.report(done, total, _("Changing the partition table"))
        type_guid, unique, name = gpt_info(access, disk, part["number"])
        options = sgdisk_entry(part["number"], part["start"], part["start"] + sectors - 1, type_guid, unique, name)
        run_checked(access, f"{SGDISK} -d {int(part['number'])} {' '.join(options)} /dev/{disk} 2>&1", 120,
                    _("Changing the partition table"))
        relist_partitions(access, disk)
    except Failed:
        # The table was not changed: the file system gets its old size back
        fs_resize(access, part, blocks)
        raise
    if part_geometry(access, part["name"]) != (part["start"], sectors):
        raise Failed(_("The partition table does not show what was written. Restart the rescue system and check."))
    finish_filesystem(access, part)
    job.check()


def run_add_place(job, device, card, system_size, data_size):
    """Two new partitions in the largest free area of the card, with empty file systems."""
    access = device.access
    card = fresh_card(device, card)
    disk = card["disk"]
    areas = free_areas(card["sectors"], [(p["start"], p["sectors"]) for p in card["parts"] if not p.get("internal")])
    start, length = max(areas, key=lambda a: a[1], default=(0, 0))
    start = -(-start // ALIGN) * ALIGN
    system, data = (system_size // SECTOR) // ALIGN * ALIGN, (data_size // SECTOR) // ALIGN * ALIGN
    if system <= 0 or data <= 0 or start + system + data > start + length:
        raise Failed(_("There is not that much free space on the memory card. Nothing was changed."))
    types = gpt_types_of(access, disk)
    numbers = [n for n in range(1, 129) if n not in types][:2]
    if len(numbers) < 2:
        raise Failed(_("The partition table of the memory card is full."))
    options = sgdisk_entry(numbers[0], start, start + system - 1, GPT_TYPE_SYSTEM) + \
        sgdisk_entry(numbers[1], start + system, start + system + data - 1, GPT_TYPE_DATA)
    job.report(0, 2, _("Changing the partition table"))
    run_checked(access, f"{SGDISK} {' '.join(options)} /dev/{disk} 2>&1", 120, _("Changing the partition table"))
    relist_partitions(access, disk)
    for i, number in enumerate(numbers):
        job.report(i, 2, _("Emptying partition {number}").format(number=number))
        path = {"name": f"{disk}p{number}"}
        run_checked(access, f"{MKFS} {part_path(path)} 2>&1", 7200, _("Emptying the data partition"))


def gpt_types_of(access, disk):
    """The numbers in use in a partition table; sgdisk knows it for any sector size."""
    out = run_checked(access, f"sgdisk -p /dev/{disk} 2>&1", 60, _("Reading the partition table"))
    return {int(m[1]) for m in re.finditer(r"^\s*(\d+)\s+\d+\s+\d+\s", out, re.M)}


# --- A system instead of Volla OS ------------------------------------------------------------------
# The whole of userdata goes to one system: the file rootfs.img, and the rest for data. The partition table,
# the bootloader, super and vbmeta stay as they are, so that fastboot and the way back stay too. Nobody has
# tried this on a real phone yet.

def phone_partition(name):
    """A partition of the phone by its name. Only what this feature writes to can pass."""
    if not re.fullmatch(r"(userdata|(boot|vendor_boot|init_boot)_[ab])", name):
        raise Failed(_("The name of a partition is not valid."))
    return "/dev/disk/by-partlabel/" + name


def phone_changes(suffix):
    """What installing on the phone itself overwrites of Volla OS: the boot partitions of one slot and
    userdata."""
    return ["boot" + suffix, "vendor_boot" + suffix, "init_boot" + suffix, "userdata"]


def missing_backup(backups, device, names, empty=()):
    """The partitions among names that no backup of this run of the rescue system holds yet, in their order.
    Only such a backup counts: in the rescue system nothing is mounted, so its partitions still hold what
    the phone holds now, while an older backup may miss what changed since. Several backups add up, so
    the partitions alone are enough as well as a backup of the whole phone. The partition with the rescue
    system counts only with the original in it (see run_backup). empty: partitions known to hold nothing
    worth keeping, such as userdata right after unlocking the bootloader erased it."""
    boot_id = device.info.get("boot_id", "") if device.rescue else ""
    held = set(empty)
    for b in backups if boot_id else ():
        if not same_phone(b, device) or b.device.get("boot_id") != boot_id or not signed_here(b.data):
            continue
        for e in b.entries:
            if e["name"] in names and e["name"] not in held and os.path.isfile(b.file(e)) and \
                    (e.get("replaced") or not b.holds_rescue(e)):
                held.add(e["name"])
    return [n for n in names if n not in held]


def backup_first(names):
    """The message when a change of the phone's own storage waits for a backup of names."""
    return _("Back up {names} first: that is the way back. Nothing was changed.").format(names=", ".join(names))


def phone_install_problem(device, config, image, system_size):
    """Why this system cannot be installed on the phone itself now, or ""."""
    if not device.rescue:
        return _("This only works in the rescue system. Nothing was changed.")
    if not device.profile or not device.profile.id.startswith("volla-plinius"):
        return _("This is only made for the Volla Phone Plinius.")
    pending = pending_rescue(config, device.serial)
    if not pending or not re.fullmatch(r"init_boot_[ab]", pending["partition"]):
        return _("The app must know which partition holds the rescue system. Start the rescue system from the "
                 "bootloader with this app.")
    if image.size > system_size:
        return _("This image needs {need}, more than the size you chose for the system.").format(
            need=size_text(image.size))
    return image.phone_problem()


def known_init_boot(config, serial, slot, kind):
    """Hash descriptor of the init_boot of the system inside the phone as this app last saw it, or None:
    read from the running system before it restarted into the bootloader (config "init_boot_seen", see
    remember_init_boot), or written by this app when it installed Plinius there (config "phone_system").
    The newer one counts; the latter only for a system of this app (kind "plinius")."""
    found = []
    seen = config.get("init_boot_seen", {}).get(serial)
    if isinstance(seen, dict) and seen.get("slot") == slot and kind in ("plinius", "linux", "ubuntu", "unknown"):
        found.append((seen.get("time", 0), seen.get("init_boot")))
    own = config.get("phone_system", {}).get(serial)
    if isinstance(own, dict) and kind == "plinius":
        found.append((own.get("time", 0), own.get("init_boot")))
    found = [(time_, d) for time_, d in found if isinstance(d, list) and len(d) == 4]
    return max(found, key=lambda f: f[0])[1] if found else None


def remember_init_boot(device, config):
    """Before a running Linux system of the phone restarts into the bootloader, where the rescue system may
    take its init_boot: that init_boot as it is now, kept with its checksum, so that leaving the rescue
    system writes exactly this back (see expected_original). Volla OS needs nothing: its vbmeta names its
    init_boot. Quietly nothing without root or a known slot, and nothing where init_boot is not the running
    system's: while this app's rescue system sits there, for a system started from the memory card, which
    does not use it, and for an image that is this app's rescue system."""
    access, serial, slot = device.access, device.serial, device.info.get("slot")
    if device.mode != "ssh" or device.rescue or not serial or slot not in ("a", "b") or \
            getattr(access, "root", None) is None or pending_rescue(config, serial):
        return None
    path = phone_partition("init_boot_" + slot)
    try:
        cmdline = run_checked(access, "cat /proc/cmdline", 30, _("Reading the partition table"))
        if re.search(r"(^|\s)systempart=/dev/mmcblk", cmdline):
            return None
        size = int(run_checked(access, f"blockdev --getsize64 {path}", 60, _("Reading the partition table")).strip())
        proc = access.reader(path, size)
        data = proc.stdout.read(size + 1)
        proc.wait()
    except (Failed, OSError, ValueError):
        return None
    if len(data) != size or data[:8] != b"ANDROID!" or any(mark in data for mark in RESCUE_MARKS):
        return None
    keep_candidate(serial, "init_boot", "running-system", data)
    descriptor = [size, "sha256", "", hashlib.sha256(data).hexdigest()]
    config.setdefault("init_boot_seen", {})[serial] = {"slot": slot, "time": int(time.time()), "init_boot": descriptor}
    save_config(config)
    return descriptor


def send_phone_file(job, access, read, path, size, done, total, text):
    """Writes size bytes from read() to a path on the phone, then has it compute the checksum of what is
    really there, read back after dropping the caches. Returns (done, sha256)."""
    proc = job.proc = access.writer(path)
    hasher, start = hashlib.sha256(), done
    try:
        done = job.copy(read, proc.stdin.write, hasher, done, total, text, size)
        proc.stdin.close()
    except (BrokenPipeError, ValueError):
        pass
    rc, err = proc.wait(), proc.stderr.read().decode(errors="replace").strip()
    job.check()
    if rc != 0 or done - start != size:
        raise Failed(_("Writing {name} failed: {error}").format(
            name=path, error=clean_text(err or _("the data is incomplete"), 300)))
    job.report(done, total, _("Verifying {name} on the phone").format(name=path))
    run_checked(access, "sync; echo 3 > /proc/sys/vm/drop_caches", 600, _("Verifying"))
    if access.checksum(path, size) != hasher.hexdigest():
        raise Failed(_("{name} was written, but what is on the phone does not match.").format(name=path))
    return done, hasher.hexdigest()


def run_install_phone(job, device, config, image, system_size, restart=True, pin_hash=None, empty=(), language=None):
    """Puts a system in place of Volla OS. Until the last step the phone still starts the rescue system, so
    a failure or a cancel can simply be repeated. Each file goes in under another name and is renamed last,
    and init_boot, which holds the rescue system, is written last of all. Only once a backup holds what it
    overwrites (see missing_backup; empty is passed on)."""
    access, serial = device.access, device.serial
    problem = phone_install_problem(device, config, image, system_size)
    if problem:
        raise Failed(problem)
    check_identity(device)
    suffix = pending_rescue(config, serial)["partition"][len("init_boot"):]
    missing = missing_backup(list_backups(backup_dir(config)), device, phone_changes(suffix), empty)
    if missing:
        raise Failed(backup_first(missing))
    run_checked(access, "plinius-partlinks", 120, _("Reading the partition table"))
    data_path = phone_partition("userdata")
    room = int(run_checked(access, f"blockdev --getsize64 {data_path}", 60, _("Reading the partition table")).strip())
    if room < system_size + PHONE_DATA_MIN:
        raise Failed(_("The phone's data partition holds {size}, too little for this system. Nothing was "
                       "changed.").format(size=size_text(room)))
    with image.open() as source:
        ext4 = Ext4Reader(source)
        boot = {name: ext4.open_file(f"{PHONE_BOOT_DIR}/{name}.img") for name in PHONE_BOOT_MAGIC}
        boot = {name: file.read_exact(file.size) for name, file in boot.items()}
        for name, data in boot.items():
            path = phone_partition(name + suffix)
            have = int(run_checked(access, f"blockdev --getsize64 {path}", 60, _("Reading the partition table")).strip())
            if len(data) > have:
                raise Failed(_("{name} does not fit into its partition. Nothing was changed.").format(name=name))
        android = ext4.open_file(IMAGE_NEEDS[0])
        crypt = ext4.lookup(PHONE_CRYPT_MARK) is not None
        total, done = image.size + android.size + sum(map(len, boot.values())), 0
        steps = [(_("Formatting the phone's data partition"), 0), (_("Writing the Android image"), android.size),
                 (_("Writing the system"), image.size), (_("Fitting the file system to the size you chose"), 0)]
        steps += [(t, 0) for t, on in ((_("Setting the PIN"), pin_hash), (_("Setting the language"), language),
                                       (_("Copying the drivers of Volla OS"), image.vendor)) if on]
        steps += [(_("Writing {name}").format(name=name), len(boot[name])) for name in ("boot", "vendor_boot", "init_boot")]
        job.plan(steps)
        job.report(0, total, _("Formatting the phone's data partition"))
        run_checked(access, f"{MKFS} {data_path} 2>&1", 7200, _("Formatting the phone's data partition"))
        run_checked(access, f"mkdir -p {PHONE_MOUNT} && mount -t ext4 {data_path} {PHONE_MOUNT}", 120,
                    _("Mounting the phone's data partition"))
        try:
            rootfs = f"{PHONE_MOUNT}/{PHONE_ROOTFS}"
            done, _sha = send_phone_file(job, access, android.read, f"{PHONE_MOUNT}/{PHONE_ANDROID}.new", android.size,
                                         done, total, _("Writing the Android image"))
            with image.open() as f:
                done, _sha = send_phone_file(job, access, f.read, rootfs + ".new", image.size, done, total,
                                             _("Writing the system"))
            job.report(done, total, _("Fitting the file system to the size you chose"))
            run_checked(access, f"truncate -s {int(system_size)} {rootfs}.new", 120, _("Resizing the file system"))
            code = run_checked(access, f"e2fsck -fy {rootfs}.new >/dev/null 2>&1; echo $?", 7200,
                               _("Checking the file system")).strip()
            if code not in ("0", "1", "2"):
                raise Failed(_("The file system of the system has errors (e2fsck {code}).").format(code=code))
            run_checked(access, f"resize2fs {rootfs}.new 2>&1", 14400, _("Resizing the file system"))
            if pin_hash:
                job.report(done, total, _("Setting the PIN"))
                set_pin(access, f"{rootfs}.new", pin_hash, loop=True)
            if language:
                job.report(done, total, _("Setting the language"))
                set_language(access, f"{rootfs}.new", language, loop=True, beside=PHONE_MOUNT if crypt else "")
            if image.vendor:
                job.report(done, total, _("Copying the drivers of Volla OS"))
                job.notes += take_vendor(job, device, f"{rootfs}.new", image.vendor, loop=True)
            run_checked(access, f"cd {PHONE_MOUNT} && mv {PHONE_ANDROID}.new {PHONE_ANDROID} && mv {PHONE_ROOTFS}.new "
                        f"{PHONE_ROOTFS} && sync", 600, _("Writing the system"))
            if crypt:
                run_checked(access, f"echo fresh > {PHONE_MOUNT}/{PHONE_CRYPT_REQUEST} && sync", 60,
                            _("Writing the system"))
        finally:
            access.run_root(f"cd /; umount {PHONE_MOUNT}; rmdir {PHONE_MOUNT}", 300)
    # From here on the slot changes. Without init_boot the phone still starts the rescue system.
    for name in ("boot", "vendor_boot", "init_boot"):
        done, _sha = send_phone_file(job, access, io.BytesIO(boot[name]).read, phone_partition(name + suffix),
                                     len(boot[name]), done, total, _("Writing {name}").format(name=name))
    # The rescue system is gone. Writing "the original" back would now break the new system
    keep_candidate(serial, "init_boot", "installed-system", boot["init_boot"])
    config.setdefault("phone_system", {})[serial] = {
        "boot_size": len(boot["boot"]), "boot_sha": hashlib.sha256(boot["boot"]).hexdigest(),
        "init_boot": [len(boot["init_boot"]), "sha256", "", hashlib.sha256(boot["init_boot"]).hexdigest()],
        "time": int(time.time())}
    del config["rescue_in"][serial]
    config.get("format_userdata", {}).pop(serial, None)
    save_config(config)
    if restart:
        access.reboot()


# --- Places in the phone's own storage: an experiment ---------------------------------------------------
# userdata is the only room there, and it cannot be made smaller keeping its contents (f2fs, encrypted):
# Volla OS loses its data. Boot entries stay on the memory card, the bootloader reads them nowhere else.
# Not known yet from a real phone: whether Volla OS and its updates get along with the changed table. So
# the table is saved first, the way back is built in, and the UI calls it what it is.

# What making places there erases; the partition table is saved by the app itself (see run_internal_places)
INTERNAL_CHANGES = ["userdata"]


def internal_room(card):
    """How much of userdata may become places."""
    userdata = card.get("userdata")
    return max(0, userdata["size"] - USERDATA_MIN) if userdata else 0


def internal_problem(device, card, config, count, system_size, data_size):
    """Why places cannot be made in the phone's storage, or ""."""
    userdata = card.get("userdata")
    if not userdata:
        return _("The partition userdata was not found on this phone.")
    if not device.profile or not device.profile.id.startswith("volla-plinius"):
        return _("This is only made for the Volla Phone Plinius.")
    if not pending_rescue(config, device.serial):
        return _("The app must know the original of the rescue partition, so that it can format userdata afterwards. "
                 "Start the rescue system from the bootloader with this app.")
    if userdata["count"] + 2 * count > 128:
        return _("The partition table of the phone is full.")
    if not card_places(card):
        return _("A new system needs a kernel from an existing system on the memory card, and there is none.")
    if count * (system_size + data_size) > internal_room(card):
        return _("That leaves less than {size} for Volla OS.").format(size=size_text(USERDATA_MIN))
    return ""


def run_internal_places(job, device, card, config, count, system_size, data_size, base):
    """Makes userdata smaller and adds places behind it, all in one change of the table, after saving the
    table on the PC. Volla OS formats nothing itself: the app does that when the phone leaves the rescue system."""
    access = device.access
    card = fresh_card(device, card)
    problem = internal_problem(device, card, config, count, system_size, data_size)
    if problem:
        raise Failed(problem + " " + _("Nothing was changed."))
    missing = missing_backup(list_backups(base), device, INTERNAL_CHANGES)
    if missing:
        raise Failed(backup_first(missing))
    userdata, disk = card["userdata"], card["userdata"]["disk"]
    # sysfs counts in 512 bytes, sgdisk in sectors of the disk: 4096 on the Plinius
    unit = userdata["sector_size"] // SECTOR
    if unit < 1 or userdata["start"] % unit or userdata["sectors"] % unit:
        raise Failed(_("The partition table of the phone looks different than expected. Nothing was changed."))
    state = new_state(device, base, "internal", [])
    state["userdata"] = {k: userdata[k] for k in ("start", "sectors", "disk", "number")}
    job.report(0, 4, _("Saving the partition table"))
    backup = "/tmp/plinius-gpt.bak"
    run_checked(access, f"rm -f {backup}; sgdisk --backup={backup} /dev/{disk} 2>&1", 120, _("Saving the partition table"))
    size = int(run_checked(access, f"wc -c < {backup}", 30, _("Saving the partition table")).strip())
    out = os.path.join(state["folder"], "partition-table.bin")
    proc = job.proc = access.reader(backup, size)
    data = proc.stdout.read()
    if proc.wait() != 0 or len(data) != size or size == 0:
        raise Failed(_("The partition table could not be saved. Nothing was changed."))
    with create_private(out) as f:
        f.write(data)
        f.flush()
        os.fsync(f.fileno())
    state["table"] = {"file": "partition-table.bin", "sha256": hashlib.sha256(data).hexdigest()}
    save_state(state)
    remote = access.run_root(f"sha256sum {backup}", 30)[1].split()
    if not remote or remote[0] != state["table"]["sha256"]:
        raise Failed(_("The partition table could not be saved. Nothing was changed."))

    job.report(1, 4, _("Changing the partition table"))
    type_guid, unique, name = gpt_info(access, disk, userdata["number"])
    if name != "userdata":
        raise Failed(_("The partition table of the phone looks different than expected. Nothing was changed."))
    align = ALIGN // unit
    system, data_sectors = [-(-s // SECTOR // unit // align) * align for s in (system_size, data_size)]
    end = (userdata["start"] + userdata["sectors"]) // unit
    first_free = end - count * (system + data_sectors)
    # The places at the end of userdata, whatever lies behind it stays where it is
    first_free -= first_free % align
    taken = gpt_types_of(access, disk)
    numbers = [n for n in range(1, 129) if n not in taken][:2 * count]
    existing = max([int(p["label"][11:]) for p in card["parts"] if p.get("internal")], default=0)
    options = sgdisk_entry(userdata["number"], userdata["start"] // unit, first_free - 1, type_guid, unique, "userdata")
    at = first_free
    for i in range(count):
        n = existing + i + 1
        options += sgdisk_entry(numbers[2 * i], at, at + system - 1, GPT_TYPE_SYSTEM, name=f"plinius_sys{n}")
        at += system
        options += sgdisk_entry(numbers[2 * i + 1], at, at + data_sectors - 1, GPT_TYPE_DATA, name=f"plinius_dat{n}")
        at += data_sectors
    # One single sgdisk writes all of it at once, or nothing
    run_checked(access, f"{SGDISK} -d {int(userdata['number'])} {' '.join(options)} /dev/{disk} 2>&1", 120,
                _("Changing the partition table"))
    # From here on the table is changed: userdata no longer fits its file system
    config.setdefault("format_userdata", {})[device.serial] = True
    save_config(config)
    state["changed"] = True
    save_state(state)
    relist_partitions(access, disk)
    expected = (userdata["start"], first_free * unit - userdata["start"])
    if part_geometry(access, userdata["name"]) != expected:
        raise Failed(_("The partition table does not show what was written. Put it back under Copies on this PC."))
    job.report(2, 4, _("Emptying the new partitions"))
    for number in numbers:
        path = f"/dev/{disk}{int(number)}"
        if not re.fullmatch(r"/dev/(sd|vd)[a-z]+\d+", path):
            raise Failed(_("The name of a partition is not valid."))
        run_checked(access, f"{MKFS} {path} 2>&1", 7200, _("Emptying the data partition"))
    state["done"] = True
    save_state(state)


def run_restore_table(job, device, card, config, state):
    """The way back: the saved table again, and the boot entries of the systems in those places out of
    the menu. userdata is formatted again when the phone leaves the rescue system."""
    access = device.access
    card = fresh_card(device, card)
    table, userdata = state.get("table") or {}, state.get("userdata") or {}
    if card.get("userdata") is None or userdata.get("disk") != card["userdata"]["disk"]:
        raise Failed(_("The partition table of the phone looks different than expected. Nothing was changed."))
    path = os.path.join(state["folder"], os.path.basename(str(table.get("file"))))
    with open_regular(path) as f:
        data = f.read(1 << 22)
    if hashlib.sha256(data).hexdigest() != table.get("sha256"):
        raise Failed(_("The copy of the partition table on this PC is damaged. Nothing was changed."))
    job.report(0, 3, _("Changing the boot entries"))
    gone = [e["file"] for e in card["entries"] if e["system"] and e["system"].get("internal")]
    if gone:
        write_entries(access, card, {}, gone)
    job.report(1, 3, _("Changing the partition table"))
    backup = "/tmp/plinius-gpt.bak"
    proc = job.proc = access.writer(backup)
    proc.stdin.write(data)
    proc.stdin.close()
    if proc.wait() != 0:
        raise Failed(_("The partition table could not be sent to the phone. Nothing was changed."))
    if access.run_root(f"sha256sum {backup}", 30)[1].split()[:1] != [table["sha256"]]:
        raise Failed(_("The partition table could not be sent to the phone. Nothing was changed."))
    run_checked(access, f"sgdisk --load-backup={backup} /dev/{userdata['disk']} 2>&1", 120,
                _("Changing the partition table"))
    config.setdefault("format_userdata", {})[device.serial] = True
    save_config(config)
    relist_partitions(access, userdata["disk"])
    state["restored"] = True
    save_state(state)


def format_userdata_if_needed(access, config, serial, step):
    """Called in the bootloader on the way out of the rescue system: a changed userdata no longer fits its
    file system, and Volla OS would keep restarting. The same step as after unlocking."""
    if not config.get("format_userdata", {}).get(serial):
        return
    step(_("Formatting the data partition…"))
    rc, out, err = run(access.fb("-w"), timeout=600)
    if rc != 0:
        raise Failed(_("The data partition could not be formatted: {error}\nRun “fastboot -w” in the bootloader, "
                       "otherwise Volla OS keeps restarting.").format(error=(out + err).strip() or rc))
    del config["format_userdata"][serial]
    save_config(config)


def run_put_back(job, device, card, state):
    """Writes a saved system back to the partitions it came from, with its boot entry."""
    access = device.access
    current = fresh_card(device, card)
    by_number = {p["number"]: p for p in current["parts"]}
    for number, saved in state["partitions"].items():
        part = by_number.get(int(number))
        if not part or (part["start"], part["sectors"]) != (saved["start"], saved["sectors"]):
            raise Failed(_("The memory card has changed since this copy was made. Nothing was changed."))
    total, done = sum(s["bytes"] for s in state["partitions"].values()), 0
    for number in state["partitions"]:
        done = write_saved(job, access, state, int(number), by_number[int(number)], done, total)
    place = state["places"][0]
    write_entries(access, current, {place["file"]: "\n".join(place["raw"]) + "\n"})


