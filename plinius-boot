def vendor_pins(ext4):
    """{name: (size, sha256)} of what an image wants from Volla OS on the phone (VENDOR_PINS); {} for an image
    that brings vendor and vendor_dlkm itself."""
    pins = {}
    for line in (ext4.read_file(VENDOR_PINS) or b"").decode(errors="replace").splitlines():
        fields = line.split()
        if len(fields) == 3 and re.fullmatch(r"[0-9a-f]{64}", fields[0]) and fields[1].isdigit() \
                and fields[2] in VENDOR_PARTS and ext4.lookup(f"{VENDOR_DIR}/{fields[2]}.img") is None:
            pins[fields[2]] = (int(fields[1]), fields[0])
    return pins


def lp_geometry(data):
    """(size of one metadata copy, number of slots) from the start of super; ValueError if there is no valid
    geometry."""
    magic, size, checksum, max_size, slots, _block = struct.unpack_from("<II32sIII", data, LP_RESERVED)
    raw = bytearray(data[LP_RESERVED:LP_RESERVED + size])
    raw[8:40] = bytes(32)
    if magic != LP_GEOMETRY_MAGIC or size < 52 or len(raw) != size or hashlib.sha256(raw).digest() != checksum \
            or not 0 < max_size <= 1 << 20 or max_size % LP_SECTOR or not 0 < slots <= 4:
        raise ValueError("no metadata of dynamic partitions")
    return max_size, slots


def lp_partitions(data, slot):
    """{name: {"size", "pieces"}} from the metadata of slot (0 for _a, 1 for _b) at the start of super: pieces
    are (offset in the partition, offset in super, length) in bytes; extents of zeros are no piece. ValueError
    for metadata that does not check out or a partition on another device than super."""
    max_size, slots = lp_geometry(data)
    at = LP_RESERVED + 2 * LP_GEOMETRY_SIZE + min(slot, slots - 1) * max_size
    magic, major, _minor, header_size, header_sum, tables_size, tables_sum = struct.unpack_from(
        "<IHHI32sI32s", data, at)
    if magic != LP_HEADER_MAGIC or major != 10 or not 128 <= header_size <= 256 or header_size + tables_size > max_size:
        raise ValueError("no metadata of dynamic partitions")
    header = bytearray(data[at:at + header_size])
    header[12:44] = bytes(32)
    tables = data[at + header_size:at + header_size + tables_size]
    if len(header) != header_size or len(tables) != tables_size or hashlib.sha256(header).digest() != header_sum \
            or hashlib.sha256(tables).digest() != tables_sum:
        raise ValueError("damaged metadata of dynamic partitions")
    p_at, p_count, p_size, e_at, e_count, e_size = struct.unpack_from("<6I", data, at + 80)
    if p_size < 52 or e_size < 24 or p_at + p_count * p_size > tables_size or e_at + e_count * e_size > tables_size:
        raise ValueError("damaged metadata of dynamic partitions")
    extents = [struct.unpack_from("<QIQI", tables, e_at + i * e_size) for i in range(e_count)]
    partitions = {}
    for i in range(p_count):
        name, _attributes, first, count, _group = struct.unpack_from("<36sIIII", tables, p_at + i * p_size)
        if first + count > e_count:
            raise ValueError("damaged metadata of dynamic partitions")
        pieces, offset = [], 0
        for sectors, kind, target, device in extents[first:first + count]:
            if kind == 0:
                if device != 0:
                    raise ValueError("a partition on another device than super")
                pieces.append((offset, target * LP_SECTOR, sectors * LP_SECTOR))
            elif kind != 1:
                raise ValueError("an unknown kind of extent")
            offset += sectors * LP_SECTOR
        partitions[name.split(b"\0")[0].decode("ascii", "replace")] = {"size": offset, "pieces": pieces}
    return partitions


def dd_block(*values):
    """The largest block size up to 1 MiB that divides every value, for the counts of dd."""
    size = 1 << 20
    while size > 1 and any(v % size for v in values):
        size //= 2
    return size


def vendor_script(source, loop, plan):
    """Shell script that copies the pieces in plan ({name: {"size", "pieces"}}, see lp_partitions) from super to
    VENDOR_DIR of the system in source (as for set_pin) and prints "name sha256" for each. Each file comes in under
    another name and is renamed once whole; a stop leaves none half."""
    if not re.fullmatch(r"/[A-Za-z0-9_./-]+", source):
        raise Failed(_("The name of a partition is not valid."))
    lines = []
    for name, part in plan.items():
        if name not in VENDOR_PARTS:
            raise Failed(_("The name of a partition is not valid."))
        new = f'"$d/{name}.img.new"'
        lines.append(f"rm -f {new}; truncate -s {int(part['size'])} {new}")
        for offset, start, length in part["pieces"]:
            size = dd_block(offset, start, length)
            lines.append(f"dd if={SUPER} of={new} bs={size} skip={start // size} seek={offset // size} "
                         f"count={length // size} conv=notrunc 2>/dev/null")
        lines.append(f'echo "{name} $(sha256sum < {new} | cut -c1-64)"')
        lines.append(f'mv {new} "$d/{name}.img"')
    return f"""set -e
m=$(mktemp -d /tmp/plinius-vendor.XXXXXX)
mount -t ext4 {"-o loop " if loop else ""}{source} "$m"
d="$m/{VENDOR_DIR}"
trap 'rm -f "$d"/*.img.new; umount "$m"; rmdir "$m"' EXIT
mkdir -p "$d"
""" + "\n".join(lines) + "\nsync\n"


def read_phone(access, path, size):
    """The first size bytes of path on the phone."""
    proc = access.reader(path, size)
    data = proc.stdout.read(size + 1)
    proc.wait()
    if len(data) != size:
        raise Failed(_("{path} could not be read.").format(path=path))
    return data


def take_vendor(job, device, source, pins, loop=False):
    """Copies vendor and vendor_dlkm of Volla OS on this phone into the system just written (source as for
    set_pin), for an image that wants them (pins, see vendor_pins). The slot is the one Volla OS started from.
    Nothing here stops the installation: the phone is backed up, and without a copy Plinius takes them from
    Volla OS's partitions as it starts. Returns the notes for the end, each also in the log."""
    if not pins:
        return []
    access, notes = device.access, []

    def note(text):
        notes.append(text)
        job.log(text)

    slot = device.info.get("slot") if device.info.get("slot") in ("a", "b") else "a"
    other = "b" if slot == "a" else "a"
    try:
        run_checked(access, "plinius-partlinks", 120, _("Reading the partition table"))
        max_size, slots = lp_geometry(read_phone(access, SUPER, LP_RESERVED + 2 * LP_GEOMETRY_SIZE))
        parts = lp_partitions(read_phone(access, SUPER, LP_RESERVED + 2 * LP_GEOMETRY_SIZE + slots * max_size),
                              1 if slot == "b" else 0)
    except (Failed, OSError, ValueError, struct.error):
        note(_("The partitions of Volla OS (super) could not be read, so vendor and vendor_dlkm were not copied. "
               "Plinius takes them from Volla OS's partitions as it starts."))
        return notes
    plan, unfinished = {}, False
    for name in pins:
        key = next((k for k in (f"{name}_{slot}", f"{name}_{other}", name) if parts.get(k, {}).get("pieces")), "")
        if key:
            plan[name] = parts[key]
            # Virtual A/B: until Volla OS has merged an update, the new contents are partly in a -cow partition
            unfinished = unfinished or f"{key}-cow" in parts
        else:
            note(_("{name} was not found among the partitions of Volla OS on this phone. Some of the hardware may "
                   "not work.").format(name=name))
    if not plan:
        return notes
    try:
        out = run_checked(access, vendor_script(source, loop, plan), 3600, _("Copying the drivers of Volla OS"))
    except Failed as err:
        note(_("vendor and vendor_dlkm could not be copied ({error}). Plinius takes them from Volla OS's "
               "partitions as it starts.").format(error=err))
        return notes
    got = dict(line.split() for line in out.splitlines() if len(line.split()) == 2)
    differ = [name for name in plan if got.get(name) != pins[name][1]]
    # An update Volla OS has not merged only matters if the copy differs: the checksum says what was taken
    if differ and unfinished:
        note(_("Volla OS on this phone has not finished an update, so its drivers may be copied as they were before "
               "it. If some of the hardware does not work: bring Volla OS back from the backup, start it once until "
               "the update is done and install Plinius again."))
    elif unfinished:
        job.log(_("Volla OS has not finished an update, but its drivers are the ones Plinius was tested with."))
    for name in differ if not unfinished else ():
        note(_("{name} of Volla OS on this phone is not the one Plinius was tested with. It was taken all the "
               "same. If some of the hardware does not work: bring Volla OS back from the backup, update it to "
               "its newest version and install Plinius again.").format(name=name))
    return notes


def latest_image(index=IMAGE_INDEX):
    """The newest image on the download server as {"version", "name", "url", "size", "sha256"}, or None if
    there is none yet. Only an https link on the same server counts, and the name becomes a file name."""
    try:
        with urllib.request.urlopen(index, timeout=30) as r:
            data = json.loads(r.read(1 << 16))
    except urllib.error.HTTPError as err:
        if err.code == 404:
            return None
        raise
    if not isinstance(data, dict):
        raise Failed(_("The download server sent something unexpected."))
    url = data.get("url")
    parts = urllib.parse.urlsplit(url) if isinstance(url, str) else None
    name = os.path.basename(parts.path) if parts else ""
    size, sha = data.get("size"), data.get("sha256")
    if not parts or parts.scheme != "https" or parts.netloc != urllib.parse.urlsplit(index).netloc \
            or not IMAGE_NAME_RE.fullmatch(name) or type(size) is not int or not 0 < size < 1 << 40 \
            or not isinstance(sha, str) or not re.fullmatch(r"[0-9a-f]{64}", sha):
        raise Failed(_("The download server sent something unexpected."))
    return {"version": clean_text(str(data.get("version", "")), 40), "name": name, "url": url, "size": size,
            "sha256": sha}


def file_sha256(job, path, size, text):
    hasher, done = hashlib.sha256(), 0
    with open_regular(path) as f:
        job.copy(f.read, None, hasher, done, size, text, size)
    return hasher.hexdigest()


def download_image(job, info, folder=IMAGES):
    """Downloads the image from latest_image into folder, going on where an earlier try stopped, and
    returns its path once the checksum matches. A damaged download is deleted."""
    os.makedirs(folder, mode=0o700, exist_ok=True)
    path = os.path.join(folder, info["name"])
    part, total = path + ".part", info["size"]
    if os.path.isfile(path) and os.path.getsize(path) == total:
        if file_sha256(job, path, total, _("Checking the image that was downloaded earlier")) == info["sha256"]:
            prune_images(path, folder)
            return path
        os.remove(path)
    hasher, have = hashlib.sha256(), 0
    if os.path.isfile(part):
        have = os.path.getsize(part)
        if have <= total:
            with open_regular(part) as f:
                job.copy(f.read, None, hasher, 0, total, _("Checking what was downloaded so far"), have)
        else:
            hasher, have = hashlib.sha256(), 0
    request = urllib.request.Request(info["url"], headers={"Range": f"bytes={have}-"} if have else {})
    with urllib.request.urlopen(request, timeout=60) as r:
        if have and r.status != 206:
            hasher, have = hashlib.sha256(), 0
        with open(part, "ab" if have else "wb") as f:
            os.fchmod(f.fileno(), 0o600)
            done = job.copy(r.read, f.write, hasher, have, total, _("Downloading Plinius"), total - have)
            more = r.read(1)
            f.flush()
            os.fsync(f.fileno())
    if more:
        os.remove(part)
        raise Failed(_("The download is larger than the server said. Nothing was kept."))
    if done != total:
        raise Failed(_("The download stopped before the end. Try again: it goes on where it stopped."))
    if hasher.hexdigest() != info["sha256"]:
        os.remove(part)
        raise Failed(_("The downloaded image is damaged: its checksum does not match. It was deleted, try again."))
    os.rename(part, path)
    prune_images(path, folder)
    return path


KEEP_IMAGES = 2


def prune_images(newest, folder=IMAGES, keep=KEEP_IMAGES):
    """Keeps keep images in folder: newest, which was just downloaded and checked, and the ones
    downloaded last before it (a new image a day would fill the disk otherwise). Unfinished downloads
    of other images go too: the server no longer offers them. Only the app's own folder is touched,
    never an image chosen as a file."""
    try:
        names = os.listdir(folder)
    except OSError:
        return
    others = []
    for name in names:
        full = os.path.join(folder, name)
        if full == newest or not os.path.isfile(full) or os.path.islink(full):
            continue
        if IMAGE_NAME_RE.fullmatch(name):
            others.append(full)
        elif name.endswith(".part") and IMAGE_NAME_RE.fullmatch(name[:-5]):
            try:
                os.remove(full)
            except OSError:
                pass
    others.sort(key=os.path.getmtime, reverse=True)
    for old in others[max(keep - 1, 0):]:
        try:
            os.remove(old)
        except OSError:
            pass


def downloaded_images(folder=IMAGES):
    """Images downloaded earlier and complete, newest first."""
    try:
        names = [n for n in os.listdir(folder) if IMAGE_NAME_RE.fullmatch(n)]
    except OSError:
        return []
    return sorted((os.path.join(folder, n) for n in names), key=os.path.getmtime, reverse=True)


def card_image_problem(image):
    """Why this image cannot start from the memory card, or "": it must bring its own kernel."""
    with image.open() as f:
        ext4 = Ext4Reader(f)
        for name in IMAGE_KERNEL:
            if ext4.lookup(f"{PHONE_BOOT_DIR}/{name}") is None:
                return _("This image does not bring {name}, so it cannot start from the memory card.").format(
                    name=name)
    return ""


def card_system_size(image, room):
    """Size of a new system partition in room bytes: the image with room to grow, at most
    PHONE_SYSTEM_DEFAULT, half the room on a small card, and never so much that the data gets less than
    CARD_DATA_MIN. 0 if it does not fit."""
    need = image.size + CARD_SYSTEM_ROOM
    if room < need + CARD_DATA_MIN:
        return 0
    size = max(need, min(PHONE_SYSTEM_DEFAULT, room - CARD_DATA_MIN, room // 2))
    return -(-size // (ALIGN * SECTOR)) * ALIGN * SECTOR


def card_settings_size(sectors):
    """abm_settings as the Volla Boot Manager makes it: a 41st of the card, 512 MiB to 4 GiB."""
    size = ((sectors - ALIGN) // 41 + ALIGN) * SECTOR
    return min(CARD_SETTINGS_MAX, max(CARD_SETTINGS_MIN, size)) // (ALIGN * SECTOR) * ALIGN * SECTOR


def card_need(image):
    """The smallest card that can take this image on its own."""
    return CARD_SETTINGS_MIN + image.size + CARD_SYSTEM_ROOM + CARD_DATA_MIN + (2 << 20)


def card_size_hint(need):
    """need as the size a card is sold with: a card of "16 GB" holds a little less than 16 × 10⁹ bytes."""
    gb = next((n for n in (8, 16, 32, 64, 128, 256, 512, 1024) if n * 990_000_000 >= need), need // 10 ** 9 + 1)
    return _("{n} GB").format(n=gb)


def card_choices(card, image):
    """The ways this image can go onto the memory card, the one to suggest first, as dicts with "kind":
    "free" (unused partitions, nothing is lost), "add" (free space, nothing is lost), "replace" (on the place
    of a system, which is lost) and "fresh" (set up anew: everything on the card is lost)."""
    choices = []
    if card["settings"]:
        for place in free_pairs(card):
            if not place["system"].get("internal") and not image.place_problem(place["system"]) \
                    and place["data"]["size"] >= 1 << 30:
                choices.append({"kind": "free", "place": place})
                break
        if not choices:
            # Aligning the start may cost up to a MiB of the area
            room = card["largest_free"] - (1 << 20)
            system = card_system_size(image, room)
            if system:
                choices.append({"kind": "add", "system": system, "data": room - system})
        for place in card_places(card):
            if not place["system"].get("internal") and not image.place_problem(place["system"]):
                choices.append({"kind": "replace", "place": place, "warnings": place_warnings(card, place)})
    settings = card_settings_size(card["sectors"])
    room = (card["sectors"] - GPT_FIRST - GPT_RESERVED) * SECTOR - settings
    system = card_system_size(image, room)
    if system:
        choices.append({"kind": "fresh", "settings": settings, "system": system})
    return choices


def wizard_card_choices(card, choices):
    """The ways onto the card the guided installation offers: setting up anew, which erases everything, only
    for a card without a boot menu and without systems. Otherwise that is left to the Advanced pages."""
    has_systems = card["settings"] or any(p.get("system") and not p.get("internal") for p in card["parts"])
    return [c for c in choices if c["kind"] != "fresh" or not has_systems]


def card_contents(card):
    """What is on a card now, for the warning before it is set up anew."""
    systems = [p["system"]["name"] for p in card["parts"] if p.get("system") and not p.get("internal")]
    count = len([p for p in card["parts"] if not p.get("internal")])
    if not count:
        return _("It holds no partitions.")
    text = ngettext("It holds {n} partition.", "It holds {n} partitions.", count).format(n=count)
    if systems:
        text += " " + _("Systems on it: {names}.").format(names=", ".join(systems))
    return text


def setup_card(job, access, card, settings, system):
    """A new partition table on the card: abm_settings with db.conf and the entry for Volla OS, a system
    partition and the rest for data, both empty. Everything that was on the card is gone."""
    disk = card["disk"]
    if not re.fullmatch(r"mmcblk\d+", disk):
        raise Failed(_("The name of a partition is not valid."))
    if access.run_root(f"cat /sys/block/{disk}/queue/logical_block_size", 30)[1].strip() != str(SECTOR):
        raise Failed(_("The partition table of the memory card looks different than expected. Nothing was changed."))
    first, s, n = GPT_FIRST, settings // SECTOR, system // SECTOR
    options = sgdisk_entry(1, first, first + s - 1, GPT_TYPE_SETTINGS, name="abm_settings") + \
        sgdisk_entry(2, first + s, first + s + n - 1, GPT_TYPE_SYSTEM) + [f"-n 3:{first + s + n}:0", f"-t 3:{GPT_TYPE_DATA}"]
    job.report(0, 3, _("Setting up the memory card"))
    # An MBR (as on a card from the shop) or an old GPT: both go, as with the manager's --mbrtogpt --clear
    access.run_root(f"sgdisk --zap-all /dev/{disk} >/dev/null 2>&1", 120)
    run_checked(access, f"{SGDISK} -o {' '.join(options)} /dev/{disk} 2>&1", 120, _("Changing the partition table"))
    relist_partitions(access, disk)
    if part_geometry(access, f"{disk}p1") != (first, s) or part_geometry(access, f"{disk}p2") != (first + s, n):
        raise Failed(_("The partition table does not show what was written. Restart the rescue system and check."))
    job.report(1, 3, _("Setting up the memory card"))
    # The bootloader reads abm_settings with lwext4, which refuses the incompatible feature csum_seed; the
    # mke2fs of the rescue system turns it on by itself (measured in QEMU)
    settings_path = part_path({"name": f"{disk}p1"})
    entries = base64.b64encode(REAL_ENTRY.encode()).decode()
    db = base64.b64encode(DB_CONF.encode()).decode()
    run_checked(access, f"""set -e
{MKFS} -O ^metadata_csum_seed {settings_path} >/dev/null 2>&1
m=$(mktemp -d /tmp/plinius-settings.XXXXXX)
mount -t ext4 {settings_path} "$m"
trap 'umount "$m"; rmdir "$m"' EXIT
mkdir -p "$m/db/entries"
echo {db} | base64 -d > "$m/db/db.conf"
echo {entries} | base64 -d > "$m/db/entries/real.conf"
chown 1000:1000 "$m/db/db.conf" "$m/db/entries/real.conf"
chmod 600 "$m/db/db.conf" "$m/db/entries/real.conf"
sync
""", 600, _("Setting up the memory card"))
    job.report(2, 3, _("Emptying partition {number}").format(number=3))
    run_checked(access, f"{MKFS} {part_path({'name': f'{disk}p3'})} 2>&1", 7200, _("Emptying the data partition"))


class RemoteBlocks:
    """A partition on the phone as a file that can only be read, for Ext4Reader: each read that is not
    in the cache is one dd over the connection. Made for a few small reads."""

    BLOCK = 4096

    def __init__(self, access, path):
        if not PATH_RE.match(path):
            raise Failed(_("The name of a partition is not valid."))
        self.access, self.path, self.at, self.blocks = access, path, 0, {}

    def seek(self, at):
        self.at = at

    def read(self, n):
        first, last = self.at // self.BLOCK, (self.at + n - 1) // self.BLOCK
        missing = [b for b in range(first, last + 1) if b not in self.blocks]
        if missing:
            start, count = missing[0], missing[-1] - missing[0] + 1
            if count > 4096:
                raise Failed(_("Reading the boot entries failed."))
            out = run_checked(self.access, f"dd if={self.path} bs={self.BLOCK} skip={start} count={count} 2>/dev/null "
                              "| base64", 120, _("Reading the boot entries"))
            data = base64.b64decode("".join(out.split()))
            for i in range(count):
                self.blocks[start + i] = data[i * self.BLOCK:(i + 1) * self.BLOCK]
        data = b"".join(self.blocks[b] for b in range(first, last + 1))
        offset = self.at - first * self.BLOCK
        self.at += n
        return data[offset:offset + n]


def entry_order(access, settings):
    """The boot entries in the order the bootloader counts them: lwext4 goes through the directory as it is
    stored and counts regular files only. Linux lists a directory with a hash index in another order, so it
    is read here from the partition itself. The partition must not be mounted."""
    ext4 = Ext4Reader(RemoteBlocks(access, part_path({"name": settings})))
    node = ext4.lookup("db/entries")
    if node is None:
        raise Failed(_("The memory card has no partition with boot entries."))
    data, at, names = ext4.contents(node), 0, []
    while at + 8 <= len(data):
        number, length, name_length, kind = struct.unpack_from("<IHBB", data, at)
        if length < 8:
            break
        if number and kind == 1:
            names.append(data[at + 8:at + 8 + name_length].decode(errors="replace"))
        at += length
    return names


def set_last_index(access, settings, name):
    """Makes the bootloader start this entry by itself: db/last_index holds its number, written as the
    bootloader does (the number, then zeros up to 128 bytes, which it reads in one go)."""
    order = entry_order(access, settings)
    if name not in order:
        raise Failed(_("The new boot entry is not on the memory card."))
    index = str(order.index(name))
    run_checked(access, f"""set -e
m=$(mktemp -d /tmp/plinius-entries.XXXXXX)
mount -t ext4 {part_path({"name": settings})} "$m"
trap 'umount "$m"; rmdir "$m"' EXIT
{{ printf %s {index}; head -c {128 - len(index)} /dev/zero; }} > "$m/db/last_index.new"
chown 1000:1000 "$m/db/last_index.new"
chmod 600 "$m/db/last_index.new"
sync
mv "$m/db/last_index.new" "$m/db/last_index"
sync
""", 120, _("Writing the boot entries"))
    return int(index)


def kernel_folder(card):
    """A folder for the kernel of a new system that no entry uses: plinius, plinius2 and so on."""
    taken = {e.get("kernel") for e in card["entries"]} | {e["file"].removesuffix(".conf") for e in card["entries"]}
    return next(f"plinius{i if i > 1 else ''}" for i in range(1, 100) if f"plinius{i if i > 1 else ''}" not in taken)


def copy_kernel(job, access, settings, folder, image, done, total):
    """Kernel and ramdisk from the image into the folder of its entry on abm_settings, each checked on
    the phone. Returns done."""
    if not re.fullmatch(r"plinius\d*", folder):
        raise Failed(_("The name of a boot entry is not valid."))
    mount = "/run/plinius-settings"
    # A stop in an earlier run may have left it mounted there
    run_checked(access, f"umount {mount} 2>/dev/null; mkdir -p {mount} && mount -t ext4 {part_path({'name': settings})} {mount} && "
                f"mkdir -p {mount}/{folder}", 120, _("Copying the kernel"))
    try:
        with image.open() as f:
            ext4 = Ext4Reader(f)
            for name in IMAGE_KERNEL:
                file = ext4.open_file(f"{PHONE_BOOT_DIR}/{name}")
                done, _sha = send_phone_file(job, access, file.read, f"{mount}/{folder}/{name}", file.size, done,
                                             total, _("Copying the kernel"))
    finally:
        access.run_root(f"sync; umount {mount}; rmdir {mount}", 120)
    return done


def kernel_size(image):
    with image.open() as f:
        ext4 = Ext4Reader(f)
        return sum(ext4.open_file(f"{PHONE_BOOT_DIR}/{name}").size for name in IMAGE_KERNEL)


# The name of a system this app puts on the card, in the boot menu: what starts there, not the project's name
CARD_TITLE = "Arch Linux"
# Where the data partition of a new system on the card is mounted, for the request to encrypt
CARD_DATA_MOUNT = "/run/plinius-card-data"


def card_title(card, place):
    """The title of the entry for a system put on place: CARD_TITLE, or "(SD)" and then a number added when
    another entry of the menu has that name already. The entry the system replaces does not count."""
    taken = {e["title"].casefold() for e in card["entries"] if e["file"] != place["file"]}
    names = [CARD_TITLE, f"{CARD_TITLE} (SD)"] + [f"{CARD_TITLE} (SD {i})" for i in range(2, 100)]
    return next((n for n in names if n.casefold() not in taken), CARD_TITLE)


def card_entry_text(title, folder, system, data):
    """A boot entry for a system with its own kernel, in the form the Volla Boot Manager uses."""
    part_path(system), part_path(data)
    return "\n".join((f"title {clean_text(title, 60) or CARD_TITLE}", f"linux {folder}/zImage",
                      f"initrd {folder}/initrd.cpio.gz", f"dtb {folder}/dtb.dtb",
                      f"options {ENTRY_OPTIONS} systempart={boot_path(system)} datapart={boot_path(data)}",
                      "xtype UT", f"xpart {system['number']}:{data['number']}")) + "\n"


def run_install_card(job, device, card, choice, image, title, pin_hash, language=None, then=()):
    """Puts the image on the memory card as choice says (see card_choices), with its own kernel and the
    PIN, and makes it the system the boot menu starts by itself. The entry is written last: until then a
    stop leaves the menu as it was, except for a card that was set up anew, which then starts Volla OS.
    title: of the entry, None for card_title. An image with plinius-crypt asks at its first start whether
    to encrypt, as inside the phone (PHONE_CRYPT_MARK). then: the steps that follow it, for the list of steps
    (see Job.plan)."""
    access = device.access
    card = fresh_card(device, card)
    if image.problem:
        raise Failed(image.problem)
    problem = card_image_problem(image)
    if problem:
        raise Failed(problem)
    kind, wipe = choice["kind"], choice["kind"] not in ("fresh", "add")
    job.plan(card_steps(kind, image, wipe, pin_hash, language) + list(then))
    if kind == "fresh":
        setup_card(job, access, card, choice["settings"], choice["system"])
        card = access.card()
        by_number = {p["number"]: p for p in (card or {}).get("parts", [])}
        if not card or not card["settings"] or 2 not in by_number or 3 not in by_number:
            raise Failed(_("The memory card was set up, but it does not show what was written."))
        place = {"file": "", "system": by_number[2], "data": by_number[3]}
    elif kind == "add":
        before = {p["name"] for p in card["parts"]}
        run_add_place(job, device, card, choice["system"], choice["data"])
        card = access.card()
        new = sorted((p for p in card["parts"] if p["name"] not in before and not p.get("internal")),
                     key=lambda p: p["start"])
        if len(new) != 2:
            raise Failed(_("The new place is not on the memory card."))
        place = {"file": "", "system": new[0], "data": new[1]}
    elif kind == "free":
        by_name = {p["name"]: p for p in card["parts"]}
        place = {"file": "", "system": by_name[choice["place"]["system"]["name"]],
                 "data": by_name[choice["place"]["data"]["name"]]}
    elif kind == "replace":
        place = next(e for e in card_places(card) if e["file"] == choice["place"]["file"])
    else:
        raise Failed(_("That is not possible"))
    system, data = place["system"], place["data"]
    problem = image.place_problem(system)
    if problem:
        raise Failed(problem)
    title = title or card_title(card, place)
    with image.open() as f:
        crypt = Ext4Reader(f).lookup(PHONE_CRYPT_MARK) is not None
    total = image.size + kernel_size(image)
    with image.open() as f:
        done, _sha = send_to_partition(job, access, f.read, system, image.size, 0, total,
                                       _("Writing Plinius to the memory card"))
    job.report(done, total, _("Fitting the file system to the partition"))
    finish_filesystem(access, system)
    if wipe:
        job.report(done, total, _("Emptying the data partition"))
        run_checked(access, f"{MKFS} {part_path(data)} 2>&1", 7200, _("Emptying the data partition"))
    if pin_hash:
        job.report(done, total, _("Setting the PIN"))
        set_pin(access, part_path(system), pin_hash)
    if crypt:
        # The request "fresh" on the data partition, empty by now, and the language of the prompt next to it:
        # the card's ramdisk (halium-unlock) looks for both on the partition datapart= names
        mount = CARD_DATA_MOUNT
        run_checked(access, f"umount {mount} 2>/dev/null; mkdir -p {mount} && mount -t ext4 {part_path(data)} {mount}",
                    120, _("Writing the system"))
        try:
            if language:
                job.report(done, total, _("Setting the language"))
                set_language(access, part_path(system), language, beside=mount)
            run_checked(access, f"echo fresh > {mount}/{PHONE_CRYPT_REQUEST} && sync", 60, _("Writing the system"))
        finally:
            access.run_root(f"sync; umount {mount}; rmdir {mount}", 120)
    elif language:
        job.report(done, total, _("Setting the language"))
        set_language(access, part_path(system), language)
    if image.vendor:
        job.report(done, total, _("Copying the drivers of Volla OS"))
        job.notes += take_vendor(job, device, part_path(system), image.vendor)
    # A system of this app on that place leaves its kernel folder to the new one, if nobody else uses it
    old = place.get("kernel") or ""
    if kind == "replace" and re.fullmatch(r"plinius\d*", old) and \
            not any(e is not place and e.get("kernel") == old for e in card["entries"]):
        folder = old
    else:
        folder = kernel_folder(card)
    done = copy_kernel(job, access, card["settings"], folder, image, done, total)
    name = place["file"] or f"{folder}.conf"
    job.report(done, total, _("Writing the boot entries"))
    write_entries(access, card, {name: card_entry_text(title, folder, system, data)})
    set_last_index(access, card["settings"], name)
    return name


def card_steps(kind, image, wipe, pin_hash, language):
    """The steps of run_install_card in the order it reports them, [(text, bytes)] (see Job.plan)."""
    steps = []
    if kind == "fresh":
        steps.append((_("Setting up the memory card"), 0))
    elif kind == "add":
        steps.append((_("Changing the partition table"), 0))
    steps += [(_("Writing Plinius to the memory card"), image.size),
              (_("Fitting the file system to the partition"), 0)]
    if wipe:
        steps.append((_("Emptying the data partition"), 0))
    if pin_hash:
        steps.append((_("Setting the PIN"), 0))
    if language:
        steps.append((_("Setting the language"), 0))
    if image.vendor:
        steps.append((_("Copying the drivers of Volla OS"), 0))
    return steps + [(_("Copying the kernel"), kernel_size(image)), (_("Writing the boot entries"), 0)]


def leave_steps(device, config):
    """The steps of leave_rescue, if the phone is to leave the rescue system (see Job.plan)."""
    if not pending_rescue(config, device.serial):
        return []
    return [(_("Restarting into the bootloader…"), 0), (_("Starting the phone…"), 0)]


def leave_rescue(job, device, config):
    """After installing on the card: the original init_boot back, from the update server or the files kept
    earlier, and the phone starts. False if the original was not found; the phone then stays in the
    rescue system and the Rescue page takes a file."""
    pending = pending_rescue(config, device.serial)
    if not pending:
        return True
    step = lambda text: job.report(0, 0, text)
    original = look_for_original(device, config, pending, step)
    if original is None:
        return False
    write_original(device, config, original, step)
    return True


