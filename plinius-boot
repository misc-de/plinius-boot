def valid_name(name):
    """Whether a partition name can be used as a file name in a backup folder (see NAME_RE)."""
    return isinstance(name, str) and NAME_RE.fullmatch(name) is not None and ".." not in name


def valid_user(user):
    """Whether a user name can be used for ssh (see USER_RE)."""
    return isinstance(user, str) and USER_RE.fullmatch(user) is not None


def is_boot_area(name):
    """Whether the name is that of a raw area outside the partitions (GPT header, preloader)."""
    return name.startswith(BOOT_AREA_PREFIXES)


def is_critical(name):
    """Whether restoring this partition needs explicit confirmation (see CRITICAL_NAMES)."""
    return re.sub(r"_[ab]$", "", name) in CRITICAL_NAMES


def group_of(name):
    """Group of a partition by name (A/B slot suffix ignored); unknown names count as BOOT."""
    base = re.sub(r"_[ab]$", "", name)
    if base in UNIQUE_NAMES:
        return UNIQUE
    if base in SYSTEM_NAMES:
        return SYSTEM
    if base in DATA_NAMES:
        return DATA
    if base in OTHER_NAMES:
        return OTHER
    return BOOT


def detect(head):
    """(kind, detail) from the first 8 KiB of a partition or image file; kind is a key of KINDS."""
    if not head:
        return "", ""
    if not head.strip(b"\0"):
        return "empty", ""
    if head[:8] == b"ANDROID!" and len(head) >= 44:
        kernel, version = struct.unpack_from("<I", head, 8)[0], struct.unpack_from("<I", head, 40)[0]
        # init_boot is a v4 boot image without a kernel
        return ("init_boot" if version >= 3 and kernel == 0 else "boot"), f"v{version}"
    if head[:8] == b"VNDRBOOT" and len(head) >= 12:
        return "vendor_boot", "v%d" % struct.unpack_from("<I", head, 8)[0]
    if head[:4] == b"AVB0":
        return "vbmeta", ""
    if head[:4] == b"\x3a\xff\x26\xed":
        return "sparse", ""
    if head[:6] == b"LUKS\xba\xbe":
        return "luks", ""
    if head.startswith((b"UFS_BOOT", b"EMMC_BOOT", b"COMBO_BOOT")):
        return "preloader", ""
    if head[:4] == b"\x88\x16\x88\x58":
        # MediaTek header (lk, tee, md1img, logo ...): name from byte 8
        return "mtk", head[8:40].split(b"\0")[0].decode("ascii", "replace")
    if head[:4] == b"\xd7\xb7\xab\x1e":
        return "dtbo", ""
    if head[:4] == b"\xd0\x0d\xfe\xed":
        return "dtb", ""
    if head[:4] == b"\x7fELF":
        return "elf", ""
    if b"EFI PART" in (head[512:520], head[4096:4104]):
        return "gpt", ""
    if head[4096:4100] == struct.pack("<I", 0x616C4467):
        return "super", ""
    if head[1080:1082] == b"\x53\xef":
        return "ext4", head[1144:1160].split(b"\0")[0].decode("utf-8", "replace")
    if head[1024:1028] == struct.pack("<I", 0xF2F52010):
        return "f2fs", ""
    if any(head[o:o + 8] == b"LABELONE" for o in (0, 512, 1024, 1536)):
        return "lvm", ""
    return "data", ""


def describe(kind, detail=""):
    text = KINDS.get(kind, KINDS["data"])
    return f"{text} ({detail})" if detail else text


# --- Installed systems ---------------------------------------------------------------------
# A backup records which systems were on the phone, not just when it was made: the Android build
# of each slot from vbmeta, Linux systems (Ubuntu Touch, Arch) from the os-release on their ext4
# partitions. Everything here comes from the phone or a manifest: text only, short and printable.

def clean_text(value, limit=100):
    text = "".join(c for c in str(value) if c.isprintable()).strip().strip("\"'").strip()
    return text[:limit]


def avb_descriptors(data):
    """(tag, body) of each descriptor of a vbmeta image ("AVB0"); nothing if it is malformed."""
    if data[:4] != b"AVB0" or len(data) < 256:
        return
    # Header: authentication and auxiliary block sizes at 12, descriptors (in the auxiliary block) at 96
    auth, aux = struct.unpack_from(">QQ", data, 12)
    offset, size = struct.unpack_from(">QQ", data, 96)
    p = 256 + auth + offset
    end = min(p + size, 256 + auth + aux, len(data))
    while p + 16 <= end:
        tag, length = struct.unpack_from(">QQ", data, p)
        if p + 16 + length > end:
            return
        yield tag, data[p + 16:p + 16 + length]
        p += 16 + length


def avb_properties(data):
    """Property descriptors {key: value} of a vbmeta image; {} if there are none or it is malformed."""
    props = {}
    for tag, body in avb_descriptors(data):
        if tag == 0 and len(body) >= 16:
            # Key and value lengths, then key, NUL, value, NUL
            klen, vlen = struct.unpack_from(">QQ", body)
            if 17 + klen + vlen <= len(body):
                props[body[16:16 + klen].decode("utf-8", "replace")] = \
                    body[17 + klen:17 + klen + vlen].decode("utf-8", "replace")
    return props


def avb_hashes(data):
    """Hash descriptors of a vbmeta image: {partition: [image size, algorithm, salt, digest]}, salt and
    digest in hex. With these the bootloader checks boot images such as init_boot."""
    found = {}
    for tag, body in avb_descriptors(data):
        if tag != 2 or len(body) < 116:
            continue
        # Image size, algorithm, lengths of name, salt and digest, flags, 60 reserved bytes
        size, = struct.unpack_from(">Q", body)
        algorithm = body[8:40].split(b"\0")[0].decode("ascii", "replace")
        nlen, slen, dlen, _flags = struct.unpack_from(">IIII", body, 40)
        name = body[116:116 + nlen].decode("utf-8", "replace")
        salt = body[116 + nlen:116 + nlen + slen]
        digest = body[116 + nlen + slen:116 + nlen + slen + dlen]
        if algorithm in ("sha256", "sha512") and dlen and len(digest) == dlen:
            found[name] = [size, algorithm, salt.hex(), digest.hex()]
    return found


def matches_hash(image, expected):
    """Whether image is the one a hash descriptor (see avb_hashes) describes."""
    try:
        size, algorithm, salt, digest = expected
        return (len(image) >= size and algorithm in ("sha256", "sha512") and hmac.compare_digest(
            hashlib.new(algorithm, bytes.fromhex(salt) + image[:size]).hexdigest(), digest))
    except (TypeError, ValueError):
        return False


def android_systems(images, active=""):
    """The Android builds that vbmeta images ({partition name: data}) describe, one per slot that has
    a fingerprint, the active slot first. vbmeta_system carries the system's fingerprint and security
    patch; vbmeta (boot images) fills in where it is missing."""
    slots = {}
    # vbmeta before vbmeta_system, so that the latter wins
    for name in sorted(images, key=lambda n: "_system" in n):
        m = re.fullmatch(r"vbmeta(_system)?(?:_([a-z]))?", name)
        if m:
            slots.setdefault(m[2] or "", {}).update(avb_properties(images[name]))
    systems = []
    for slot, props in slots.items():
        def prop(suffix):
            return props.get("com.android.build.system" + suffix) or next(
                (v for k, v in sorted(props.items()) if k.endswith(suffix)), "")
        # brand/product/device:release/id/incremental:type/tags
        m = re.match(r"[^/]*/[^/]*/[^:]*:([^/]*)/([^/]*)/([^:]*):", prop(".fingerprint"))
        if not m:
            continue
        release, build_id, incremental = m.groups()
        # Volla OS numbers its builds "<n>-volla-<version>", n as on its OTA server
        v = re.fullmatch(r"(\d+)-([a-z]+)-(\d+(?:\.\d+)*)", incremental)
        systems.append({
            "kind": "android",
            "name": f"{v[2].capitalize()} OS {v[3]}" if v else "Android",
            "build": v[1] if v else f"{build_id} {incremental}",
            "android": release, "patch": prop(".security_patch"), "slot": slot, "active": slot == active,
        })
    systems = [{k: v if k == "active" else clean_text(v) for k, v in s.items()} for s in systems]
    return sorted(systems, key=lambda s: (not s["active"], s["slot"]))


# Runs on the phone as root after "set -- <ext4 partitions>": the os-release of each (and Ubuntu
# Touch's channel.ini), mounted read-only without journal replay (noload), so that nothing on it
# changes, and unmounted before the next one. Output: <path> TAB <key>=<value>.
SYSTEMS_SCRIPT = r"""
m=$(mktemp -d /tmp/plinius-systems.XXXXXX) || exit 1
for dev in "$@"; do
	mount -t ext4 -o ro,noload "$dev" "$m" 2>/dev/null || continue
	for f in etc/os-release usr/lib/os-release; do
		t=$m/$f
		# An absolute link points into the partition, not into the running system
		l=$(readlink "$t") && case $l in /*) t=$m$l ;; esac
		[ -f "$t" ] || continue
		grep -E '^(NAME|PRETTY_NAME|VERSION_ID|BUILD_ID|IMAGE_VERSION)=' "$t"
		break
	done | while read -r line; do printf '%s\t%s\n' "$dev" "$line"; done
	c=$m/etc/system-image/channel.ini
	[ -f "$c" ] && grep -E '^(channel|build_number): ' "$c" | sed 's/: */=/' |
		while read -r line; do printf '%s\t%s\n' "$dev" "$line"; done
	umount "$m"
done
rmdir "$m"
"""


def parse_systems(out, parts):
    """Linux systems from the SYSTEMS_SCRIPT output, one per partition with an os-release."""
    names = {p.path: p.name for p in parts}
    found = {}
    for line in out.splitlines():
        path, _tab, pair = line.partition("\t")
        key, eq, value = pair.partition("=")
        if path in names and eq:
            found.setdefault(path, {})[key] = clean_text(value)
    systems = []
    for path, kv in found.items():
        if kv.get("channel"):
            # Ubuntu Touch: series and track from the channel, e.g. 20.04/arm64/android9plus/stable
            channel = kv["channel"].split("/")
            s = {"name": "Ubuntu Touch", "version": channel[0],
                 "channel": channel[-1] if len(channel) > 1 else "", "build": kv.get("build_number", "")}
        else:
            name = kv.get("PRETTY_NAME") or kv.get("NAME") or "Linux"
            version = kv.get("IMAGE_VERSION") or kv.get("VERSION_ID") or kv.get("BUILD_ID", "")
            # Rolling releases (Arch) say BUILD_ID=rolling; a version already in the name is not repeated
            if version == "rolling" or version in name:
                version = ""
            s = {"name": name, "version": version}
        systems.append(dict(s, kind="linux", partition=names[path]))
    return systems


def clean_systems(systems):
    """A manifest's "systems" list with known fields only (text, "active" a boolean)."""
    keys = ("kind", "name", "version", "channel", "build", "android", "patch", "slot", "partition")
    found = []
    for s in systems[:16] if isinstance(systems, list) else []:
        if isinstance(s, dict):
            found.append({k: clean_text(s[k]) for k in keys if isinstance(s.get(k), str)} |
                         {"active": s.get("active") is True})
    return found


def system_text(s):
    """One line for a system, e.g. "Volla OS 16.0, build 124, Android 16, security patch 2026-10-01"."""
    parts = [" ".join(x for x in (s.get("name"), s.get("version")) if x) or "Linux"]
    if s.get("channel"):
        parts.append(s["channel"])
    if s.get("build"):
        parts.append(_("build {number}").format(number=s["build"]))
    if s.get("android"):
        parts.append(f"Android {s['android']}")
    if s.get("patch"):
        parts.append(_("security patch {date}").format(date=s["patch"]))
    return ", ".join(parts)


def system_place(s):
    """Where a system is installed: its slot or partition."""
    if s.get("partition"):
        return _("Partition {name}").format(name=s["partition"])
    if s.get("slot"):
        return (_("Slot {slot} (active)") if s.get("active") else _("Slot {slot}")).format(slot=s["slot"])
    return _("System")


def run(cmd, input=None, timeout=30, env=None):
    """(return code, stdout, stderr) as text; missing program 127, timeout 124."""
    try:
        p = subprocess.run(cmd, input=input, capture_output=True, timeout=timeout, env=env)
    except FileNotFoundError:
        return 127, "", f"{cmd[0]}: not found"
    except PermissionError:
        return 126, "", f"{cmd[0]}: permission denied"
    except subprocess.TimeoutExpired:
        return 124, "", "timeout"
    return p.returncode, p.stdout.decode(errors="replace"), p.stderr.decode(errors="replace")


def load_config():
    try:
        with open(CONFIG) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


_config_lock = threading.Lock()


def save_config(config):
    # Called from the scanner thread and from the UI
    with _config_lock:
        os.makedirs(os.path.dirname(CONFIG), exist_ok=True)
        with open(CONFIG + ".tmp", "w") as f:
            json.dump(config, f, indent=1)
        os.replace(CONFIG + ".tmp", CONFIG)


def open_regular(path):
    """Open a regular file for reading, never through a symlink: a backup folder on a stick or share
    could otherwise point the app at any file of the user (keys, /dev/...). FIFOs and devices are refused too."""
    # O_NONBLOCK: opening a FIFO must not hang; it has no effect on regular files
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    try:
        if not stat.S_ISREG(os.fstat(fd).st_mode):
            raise OSError(errno.EINVAL, _("Not a regular file"), path)
        os.set_blocking(fd, True)
        return os.fdopen(fd, "rb")
    except BaseException:
        os.close(fd)
        raise


def create_private(path, mode="wb"):
    """Create a new file only the user can read (0600); never follows a symlink or overwrites anything."""
    return os.fdopen(os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600), mode)


def cache_dir():
    """The app's cache folder (temporary copies of partitions), private to the user."""
    os.makedirs(CACHE, mode=0o700, exist_ok=True)
    return CACHE


def backup_dir(config):
    return config.get("backup_dir") or DEFAULT_DIR


def safe_name(text):
    return re.sub(r"[^A-Za-z0-9._-]+", "-", text).strip("-") or "phone"


def size_text(n):
