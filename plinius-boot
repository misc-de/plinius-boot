# One line per partition: type, name, path, size, busy, disk, medium, head (base64).
# Type P = partition with a GPT name, T = start of a disk up to the first partition (GPT),
# B = boot area without partitions (preloader).
LIST_SCRIPT = r"""
# Rescue system: wait (at most 40 s) until its /init has created the partition links, then add
# partitions that only appeared after that
i=0
while [ -e /run/plinius-rescue-starting ] && [ $i -lt 40 ]; do sleep 1; i=$((i + 1)); done
command -v plinius-partlinks >/dev/null && plinius-partlinks
dir=/dev/disk/by-partlabel
[ -d $dir ] || dir=/dev/block/by-name
[ -d $dir ] || dir=/dev/block/platform/bootdevice/by-name
# Mounts often go through by-name links or happen in other namespaces (Android container), so
# use major:minor from the mountinfo of all processes instead of the names in /proc/mounts
mounted=$(cat /proc/[0-9]*/mountinfo 2>/dev/null | cut -d' ' -f3 | sort -u)
swaps=$(tail -n +2 /proc/swaps 2>/dev/null | while read -r s _rest; do readlink -f "$s"; done)
busy() {
	mm=$(cat /sys/class/block/$1/dev 2>/dev/null)
	[ -n "$mm" ] && echo "$mounted" | grep -qx "$mm" && { echo mounted; return; }
	echo "$swaps" | grep -qx "/dev/$1" && { echo swap; return; }
	[ -n "$(ls /sys/class/block/$1/holders 2>/dev/null)" ] && { echo holders; return; }
	echo -
}
medium() {
	[ "$(cat /sys/block/$1/device/type 2>/dev/null)" = SD ] && echo sd || echo intern
}
head64() {
	dd if="$1" bs=8192 count=1 2>/dev/null | base64 | tr -d '\n'
	echo
}
for l in $dir/*; do
	[ -e "$l" ] || continue
	# Skip aliases such as FuriOS' boot -> boot_a
	case $(readlink "$l") in */by-partlabel/*|*/by-name/*) continue ;; esac
	dev=$(basename "$(readlink -f "$l")")
	[ -e /sys/class/block/$dev/size ] || continue
	disk=$(basename "$(dirname "$(readlink -f /sys/class/block/$dev)")")
	printf 'P\t%s\t%s\t%s\t%s\t%s\t%s\t' "$(basename "$l")" "$l" "$(( $(cat /sys/class/block/$dev/size) * 512 ))" \
		"$(busy $dev)" "$disk" "$(medium $disk)"
	head64 "$l"
	disks="$disks $disk"
done
for disk in $(echo $disks | tr ' ' '\n' | sort -u); do
	start=$(cat /sys/block/$disk/$disk*/start 2>/dev/null | sort -n | head -n 1)
	[ -n "$start" ] || continue
	printf 'T\t%s\t%s\t%s\t-\t%s\t%s\t' "$disk" "/dev/$disk" "$(( start * 512 ))" "$disk" "$(medium $disk)"
	head64 /dev/$disk
done
for b in /sys/block/sd* /sys/block/mmcblk*boot*; do
	[ -e $b/size ] || continue
	dev=${b##*/}
	s=$(( $(cat $b/size) * 512 ))
	[ $s -gt 0 ] && [ $s -le 67108864 ] || continue
	ls -d $b/$dev* >/dev/null 2>&1 && continue
	printf 'B\t%s\t%s\t%s\t-\t%s\tintern\t' "$dev" "/dev/$dev" "$s" "$dev"
	head64 /dev/$dev
done
"""


class Partition:
    """A partition or raw area on the phone. boot_area (GPT header, preloader) is backup only."""

    def __init__(self, name, path, size, busy="-", disk="", medium="intern", head=b"", boot_area=False):
        self.name, self.path, self.size, self.busy, self.disk = name, path, size, busy, disk
        self.kind, self.detail = detect(head)
        # vbmeta describes the installed Android build (see android_systems)
        self.head = head if self.kind == "vbmeta" else b""
        self.restorable = not boot_area
        if medium == "sd":
            self.group = SDCARD
        elif boot_area:
            self.group = BOOT
        else:
            self.group = group_of(name)


def parse_partitions(out):
    """Partitions from the LIST_SCRIPT output; malformed lines, unexpected paths, names that are not
    usable as file names (see NAME_RE) and repeated names are dropped."""
    parts, names = [], set()
    for line in out.splitlines():
        f = line.split("\t")
        if len(f) != 8 or f[0] not in ("P", "T", "B") or not PATH_RE.match(f[2]):
            continue
        typ, name, path, size, busy, disk, medium, head = f
        try:
            head = base64.b64decode(head) if head else b""
            size = int(size)
        except ValueError:
            continue
        if typ == "B":
            # Only boot LUs/areas holding a preloader; the name must not clash with GPT names
            if detect(head)[0] != "preloader":
                continue
            p = Partition(f"preloader-{name}", path, size, head=head, boot_area=True)
        elif typ == "T":
            p = Partition(f"partition-table-{name}", path, size, disk=disk, medium=medium, head=head,
                          boot_area=True)
        elif is_boot_area(name):
            # A GPT name must not pose as a backup-only area
            continue
        else:
            p = Partition(name, path, size, busy, disk, medium, head)
        # The first one wins: a second partition of the same name would overwrite its backup file
        if size < 0 or not valid_name(p.name) or p.name in names:
            continue
        names.add(p.name)
        parts.append(p)
    return parts


def parse_info(out):
    """Device info from the INFO_SCRIPT output, including the kernel cmdline and bootconfig."""
    kv = dict(line.split("=", 1) for line in out.splitlines() if "=" in line)
    args = dict(a.split("=", 1) for a in (kv.get("cmdline", "") + " " + kv.get("bootconfig", "")).split() if "=" in a)
    compatible = kv.get("compatible", "").strip()
    soc = next((c.split(",", 1)[1].upper() for c in compatible.split() if c.startswith("mediatek,")), "")
    os_id = kv.get("osid", "")
    return {
        "model": kv.get("model") or kv.get("model2", ""),
        "codename": kv.get("codename", ""),
        "manufacturer": kv.get("manufacturer", ""),
        "serial": (kv.get("serial") or kv.get("rescueserial") or args.get("androidboot.serialno")
                   or args.get("furiboot.serialno", "")),
        # Not "in memory": on phones without "fastboot boot" it occupies a partition (see flash_rescue)
        "os": _("Rescue system") if os_id == RESCUE_ID else kv.get("os", "").strip(),
        "os_id": os_id,
        "slot": args.get("androidboot.slot_suffix", "").lstrip("_"),
        "compatible": compatible,
        "soc": f"MediaTek {soc}" if soc else "",
        "accent": kv.get("accent", "").strip("'"),
        "verified_boot": args.get("androidboot.verifiedbootstate") or kv.get("verifiedboot", ""),
        "flash_locked": args.get("androidboot.flash.locked") or kv.get("flashlocked", ""),
        "boot_id": kv.get("bootid", "").strip(),
    }


