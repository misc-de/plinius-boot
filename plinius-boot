def source_locale():
    """Started from the source tree: compile *.po into ~/.cache and return that locale dir, else None."""
    pos = glob.glob(os.path.join(HERE, "po", "*.po"))
    if not pos or HERE.startswith("/usr/"):
        return None
    base = os.path.join(GLib.get_user_cache_dir(), "plinius-boot", "locale")
    for po in pos:
        lang = os.path.basename(po)[:-3]
        mo = os.path.join(base, lang, "LC_MESSAGES", "plinius-boot.mo")
        if not os.path.exists(mo) or os.path.getmtime(mo) < os.path.getmtime(po):
            os.makedirs(os.path.dirname(mo), exist_ok=True)
            subprocess.run(["msgfmt", "-o", mo, po], check=False)
    return base


